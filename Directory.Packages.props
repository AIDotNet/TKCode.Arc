<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Avalonia" Version="$(AvaloniaVersionRange)" />
        <PackageVersion Include="Avalonia.Browser" Version="$(AvaloniaVersionRange)" />
        <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersionRange)" />
        <PackageVersion Include="Avalonia.iOS" Version="$(AvaloniaVersionRange)" />
        <PackageVersion Include="Avalonia.Android" Version="$(AvaloniaVersionRange)" />
        <PackageVersion Include="Avalonia.Headless" Version="$(AvaloniaVersionRange)" />
        <PackageVersion Include="Avalonia.Headless.XUnit" Version="$(AvaloniaVersionRange)" />
        <PackageVersion Include="Avalonia.Markup.Xaml.Loader" Version="$(AvaloniaVersionRange)" />
        <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersionRange)" />
        <PackageVersion Include="Avalonia.Diagnostics" Version="$(AvaloniaVersionRange)" />
        <PackageVersion Include="Avalonia.Skia" Version="$(AvaloniaVersionRange)" />
        <!-- StreamMark (src/TKCode.Arc.StreamMark*, moved in from its own repository in 1.3.0; native incremental Markdown parser, zero Markdig dependency). -->
        <PackageVersion Include="TextMateSharp" Version="2.0.5" />
        <PackageVersion Include="TextMateSharp.Grammars" Version="2.0.5" />
        <PackageVersion Include="Mermaider" Version="0.18.0" />
        <!-- Svg.Skia 5.2.x needs SkiaSharp 4 / HarfBuzzSharp 14, which Avalonia 12 does not ship: Svg.Skia and Svg.Animation
             stay on 5.1.1 (SkiaSharp 3, the same native libraries as Avalonia). Its managed parts take 5.2.3 for the Svg.Model
             TypeDescriptor fix, without which a NativeAOT publish warns IL2026. Pinned here, so transitive pinning holds the
             apps that reference TKCode.Arc.StreamMark.Mermaid to the same set. -->
        <PackageVersion Include="Svg.Skia" Version="5.1.1" />
        <PackageVersion Include="Svg.Animation" Version="5.1.1" />
        <PackageVersion Include="Svg.Model" Version="5.2.3" />
        <PackageVersion Include="Svg.Custom" Version="5.2.3" />
        <PackageVersion Include="ShimSkiaSharp" Version="5.2.3" />
        <PackageVersion Include="Svg.SceneGraph" Version="5.2.3" />
        <!-- Roslyn for the source generators that ship inside Foundation and Icons.Lucide (and the gallery's). Keep it at the
             compiler of the oldest SDK apps build with (.NET 10 SDK: Roslyn 5.9); a newer one makes those compilers
             refuse to load the generators (CS9057). -->
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
        <!-- Tracks each package's public API in PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt (#146). -->
        <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
        <!-- Tests -->
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <!-- xunit stays on 3.x: Avalonia.Headless.XUnit (12.2.0, the latest) is built on xunit.v3 3.2.2, and under xunit 4 the
             headless test projects discover no tests at all, without an error. Move when Avalonia ships one for xunit 4. -->
        <PackageVersion Include="xunit.v3" Version="3.2.2" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
        <PackageVersion Include="Shouldly" Version="4.3.0" />
        <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
        <!-- Base theme tests: ArcBaseTheme must yield to these themes. -->
        <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersionRange)" />
        <PackageVersion Include="Avalonia.Themes.Simple" Version="$(AvaloniaVersionRange)" />
    </ItemGroup>
</Project>
