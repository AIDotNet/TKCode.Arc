<Project>
    <ItemGroup Condition="'$(IsTestProject)' == 'true'">
        <Using Include="Xunit" />
        <Using Include="Shouldly" />
    </ItemGroup>
    <!-- Projects that declare tokens ([ControlDesignToken]) or control themes (Themes/*Theme.axaml) set
         ArcFoundationGenerator=true: they run the Foundation generator as an analyzer and import Foundation's targets
         (theme files become AvaloniaResource items; design/architecture/foundation.md section 5.4). A package consumer
         gets both from the TKCode.Arc.Foundation package. -->
    <ItemGroup Condition="'$(ArcFoundationGenerator)' == 'true'">
        <ProjectReference Include="$(ArcRepositoryRoot)src/TKCode.Arc.Foundation.Generators/TKCode.Arc.Foundation.Generators.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>
    <Import Project="$(ArcRepositoryRoot)src/TKCode.Arc.Foundation/buildTransitive/TKCode.Arc.Foundation.targets"
            Condition="'$(ArcFoundationGenerator)' == 'true'" />
    <!-- Projects that use TKCode.Arc.Icons.Lucide set ArcLucideGenerator=true: the Lucide generator compiles the icons
         they use into them (a package consumer gets the generator and targets from the package). -->
    <ItemGroup Condition="'$(ArcLucideGenerator)' == 'true'">
        <ProjectReference Include="$(ArcRepositoryRoot)src/TKCode.Arc.Icons.Lucide.Generators/TKCode.Arc.Icons.Lucide.Generators.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>
    <Import Project="$(ArcRepositoryRoot)src/TKCode.Arc.Icons.Lucide/buildTransitive/TKCode.Arc.Icons.Lucide.targets"
            Condition="'$(ArcLucideGenerator)' == 'true'" />
    <!-- Public API tracking (#146): every packable library lists its public surface in PublicAPI.Shipped.txt (what released
         packages contain) and PublicAPI.Unshipped.txt (added since). A public member missing from both, or listed but gone,
         fails the build (RS0016, RS0017). At a stable release the Unshipped lines move to Shipped. -->
    <PropertyGroup>
        <ArcPublicApi Condition="'$(ArcPublicApi)' == '' And '$(IsPackable)' != 'false' And '$(IsTestProject)' != 'true' And '$(IsRoslynComponent)' != 'true' And '$(PackageType)' != 'Template'">true</ArcPublicApi>
    </PropertyGroup>
    <PropertyGroup Condition="'$(ArcPublicApi)' == 'true'">
        <!-- Only the tracking: a public member missing from the files (RS0016) or listed but gone (RS0017). The analyzer's
             design rules (optional parameters, oblivious types, constructors) are not what this is for. -->
        <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
        <NoWarn>$(NoWarn);RS0022;RS0026;RS0027;RS0041</NoWarn>
    </PropertyGroup>
    <ItemGroup Condition="'$(ArcPublicApi)' == 'true'">
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
        <AdditionalFiles Include="$(MSBuildProjectDirectory)/PublicAPI.Shipped.txt" />
        <AdditionalFiles Include="$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt" />
    </ItemGroup>
</Project>
