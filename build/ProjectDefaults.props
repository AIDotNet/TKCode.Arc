<Project>
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <WarningsAsErrors>Nullable</WarningsAsErrors>
        <NoWarn>$(NoWarn);CS1591;AVA3001;AVALONIA_X11_CSD</NoWarn>
        <ArcTargetFrameworks>net8.0;net10.0;net11.0</ArcTargetFrameworks>
        <ArcTestTargetFramework Condition="'$(ArcTestTargetFramework)' == ''">net10.0</ArcTestTargetFramework>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <IsTestProject Condition="$(MSBuildProjectName.EndsWith('.Tests'))">true</IsTestProject>
        <!-- A library is a project under the repository's src/ folder. Both paths are normalized (separators, trailing
             slash) before the prefix test, so this holds on Windows and when the clone itself sits under a src/ folder. -->
        <_ArcSrcDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..', 'src'))</_ArcSrcDirectory>
        <ArcIsLibrary Condition="'$(ArcIsLibrary)' == '' and $([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)').StartsWith('$(_ArcSrcDirectory)'))">true</ArcIsLibrary>
        <!-- Generated sources written to disk for reading (below) are never compiled again, whatever the project kind. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);GeneratedFiles/**</DefaultItemExcludes>
    </PropertyGroup>

    <PropertyGroup Condition="'$(ArcIsLibrary)' == 'true'">
        <IsPackable>true</IsPackable>
        <IsTrimmable>true</IsTrimmable>
        <IsAotCompatible>true</IsAotCompatible>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <!-- One folder per target framework, so the inner builds never write the same file. -->
        <CompilerGeneratedFilesOutputPath>GeneratedFiles/$(TargetFramework)</CompilerGeneratedFilesOutputPath>
    </PropertyGroup>

    <PropertyGroup Condition="'$(ArcIsLibrary)' != 'true'">
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- StreamMark's packages keep the rule they had in their own repository: a trimming or AOT warning is an error. -->
    <PropertyGroup Condition="'$(ArcIsLibrary)' == 'true' and $(MSBuildProjectName.StartsWith('TKCode.Arc.StreamMark'))">
        <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2050;IL2055;IL2057;IL2058;IL2059;IL2060;IL2067;IL2070;IL2072;IL2075;IL2077;IL2080;IL2087;IL2090;IL2091;IL2104;IL3000;IL3050;IL3051;IL3053</WarningsAsErrors>
    </PropertyGroup>
</Project>
