<Project>
    <PropertyGroup>
        <ArcVersion>1.1.0-preview.7</ArcVersion>
        <AvaloniaVersion>12.1.5</AvaloniaVersion>
        <!-- What the packages ask of Avalonia: this version or any later 12.x (#97). Restore picks the lowest match, so the
             repository still builds against AvaloniaVersion, while apps may move to newer Avalonia 12 releases. -->
        <AvaloniaVersionRange>[$(AvaloniaVersion), 13.0.0)</AvaloniaVersionRange>
    </PropertyGroup>
</Project>
