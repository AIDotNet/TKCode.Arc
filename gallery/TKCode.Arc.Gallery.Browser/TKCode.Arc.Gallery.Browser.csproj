<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
    <PropertyGroup>
        <TargetFramework>net11.0-browser</TargetFramework>
        <RootNamespace>TKCode.Arc.Gallery.Browser</RootNamespace>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);CS0436</NoWarn>
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
        <!-- Skia's WebAssembly code is linked only with WasmBuildNative (needs the wasm-tools workload). -->
        <WasmBuildNative>true</WasmBuildNative>
        <!-- .NET 11 links with Emscripten 6, and the Onigwrap package (TextMateSharp's Oniguruma) has WebAssembly archives only up
             to Emscripten 3.1.56. Its targets take native/onigwrap/<Emscripten version>/st/libonigwrap.a from here instead, built
             from the same sources by tools/onigwrap/build-wasm.sh (run it again when a .NET update brings another Emscripten). -->
        <OnigwrapWasmLibraryPath>$(MSBuildThisFileDirectory)native/onigwrap</OnigwrapWasmLibraryPath>
        <!-- Publishing trims the app with ILLink; builds and dotnet run do not. -p:PublishTrimmed=false publishes untrimmed; the
             boot-list pruning below then applies instead. -->
        <PublishTrimmed Condition="'$(PublishTrimmed)' == '' And '$(_IsPublishing)' == 'true'">true</PublishTrimmed>
        <!-- A Release publish also compiles the .NET code ahead of time to WebAssembly (the SDK allows it only for a trimmed publish;
             the wasm-tools workload brings the compiler). Measured 2026-10-30 on .NET 11 in headless Edge with the CPU four times
             slower than an M5: opening the Changelog guide (StreamMark parsing and laying out a long document) kept the main thread
             busy about 3.7 s interpreted and 1.2 to 1.35 s compiled. Builds and dotnet run stay interpreted; -p:ArcAot=false publishes
             interpreted. The compiling happens in the SDK's nested publish build, which clears _IsPublishing and passes it on as
             _WasmIsPublishing. The 0.3.0-preview.5 build that crashed at startup ("memory access out of bounds", 2026-10-24) was the
             AtomUI one; the .NET 11 build without AtomUI starts and walks the pages. -->
        <RunAOTCompilation Condition="'$(RunAOTCompilation)' == '' And '$(ArcAot)' != 'false' And ('$(_IsPublishing)' == 'true' Or '$(_WasmIsPublishing)' == 'true') And '$(PublishTrimmed)' == 'true' And '$(Configuration)' == 'Release'">true</RunAOTCompilation>
        <!-- Publishing also shrinks the boot list (ArcWasmUnusedAssembly and ArcWasmLazyAssembly below); builds and dotnet run keep
             everything. -p:ArcWasmPrune=false publishes with everything, -p:ArcWasmPrune=true shrinks a build as well. -->
        <ArcWasmPrune Condition="'$(ArcWasmPrune)' == ''">$(_IsPublishing)</ArcWasmPrune>
        <!-- LazyAssemblies and the other browser interop use JSImport. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia.Browser" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <ProjectReference Include="../TKCode.Arc.Gallery/TKCode.Arc.Gallery.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.Fonts/TKCode.Arc.Fonts.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.Audio.Browser/TKCode.Arc.Audio.Browser.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.Icons.Lucide/TKCode.Arc.Icons.Lucide.csproj" />
    </ItemGroup>
    <!-- .NET 11 WebAssembly needs Skia and HarfBuzz compiled with a newer Emscripten than the SkiaSharp 3.119 that Avalonia 12.1 brings:
         the versions Avalonia.Browser takes for net11.0-browser on its main branch (AvaloniaUI/Avalonia#22196, Avalonia 12.2), whose
         archives are built with Emscripten 5.0.6 and link with the workload's 6.x. SkiaSharp 4.152 to 4.154 pick their 3.1.56 archives
         for .NET 11 again (mono/SkiaSharp#5082); move on once a release ships Emscripten 6 archives (mono/SkiaSharp#5271). -->
    <ItemGroup>
        <PackageReference Include="SkiaSharp" VersionOverride="4.151.2" />
        <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" VersionOverride="4.151.2" />
        <PackageReference Include="HarfBuzzSharp" VersionOverride="14.2.1.200" />
        <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" VersionOverride="14.2.1.200" />
    </ItemGroup>
    <ItemGroup>
        <StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
    </ItemGroup>

    <!-- Compiled ahead of time, these would make half of the native code (Blocks 61 MB of objects, Special 31, the Gallery's pages and
         demos 26; all of the rest 114) for UI that is built once when its page opens. They stay interpreted, like the whole app
         before; the controls, Avalonia, Skia, StreamMark and the runtime are compiled. Measured 2026-10-30 (brotli, headless Edge,
         CPU four times slower): startup download 14.4 MB interpreted, 22.0 MB like this, 29.0 MB with everything compiled; opening
         the Changelog guide 3.7 s / 1.0 s / 1.2 s of main-thread work, opening the Blocks section 2.5 s / 2.0 s / 2.0 s. The SDK's item
         for assemblies "too big to compile" (WasmApp.Common.targets) is internal, so check it after a .NET update: if it disappears,
         everything is compiled again and the startup download grows. -p:ArcAotEverything=true compiles these too. -->
    <ItemGroup Condition="'$(ArcAotEverything)' != 'true'">
        <_AOT_InternalForceInterpretAssemblies Include="TKCode.Arc.Blocks.dll;TKCode.Arc.Special.dll;TKCode.Arc.Gallery.dll" />
    </ItemGroup>

    <!-- The two lists below are for a publish without trimming (-p:PublishTrimmed=false). A trimmed publish needs neither: ILLink drops what
         nothing uses, and an assembly loaded on demand would meet a trimmed runtime that no longer has the members it calls.
         Without trimming, every assembly of the runtime pack and of every package reference goes into the boot list and is
         downloaded at startup. These come with the Avalonia package and are never loaded in the browser. Avalonia.OpenGL,
         .Metal and .Vulkan are NOT in this list: Avalonia.Skia loads them. Pass -p:ArcWasmPrune=false to publish with
         everything. -->
    <ItemGroup>
        <ArcWasmUnusedAssembly Include="Avalonia.Dialogs;Avalonia.DesignerSupport;Avalonia.Remote.Protocol;Avalonia.MicroCom;MicroCom.Runtime" />
        <!-- The docs screenshots and the pages' text: resources of these assemblies in a desktop host, files under wwwroot/shots and
             wwwroot/content here. -->
        <ArcWasmUnusedAssembly Include="TKCode.Arc.Gallery.Shots;TKCode.Arc.Gallery.Content" />
    </ItemGroup>

    <!-- Runtime-pack assemblies that no assembly of the app, its packages or the runtime pack itself references by type
         (the types an assembly defines or forwards are matched by full name against every kept assembly's type
         references, then closed over the runtime pack). Assemblies the browser loads are all outside this list; facades
         are kept. Re-check after an Avalonia or StreamMark upgrade, or when the app starts to use a new BCL
         area: a pruned assembly that is needed fails at run time with FileNotFoundException, not at build time. -->
    <ItemGroup>
        <ArcWasmUnusedAssembly Include="System.Private.DataContractSerialization;System.Text.Encoding.CodePages;System.Linq.AsyncEnumerable;Microsoft.VisualBasic.Core;Microsoft.CSharp" />
        <ArcWasmUnusedAssembly Include="System.Threading.Tasks.Dataflow;System.Threading.Tasks.Parallel;System.Threading.Channels" />
        <ArcWasmUnusedAssembly Include="System.Net.WebSockets;System.Net.WebSockets.Client;System.Net.Mail;System.Net.Sockets;System.Net.HttpListener;System.Net.Http.Json;System.Net.WebClient" />
        <ArcWasmUnusedAssembly Include="System.Net.NetworkInformation;System.Net.ServerSentEvents;System.Net.Quic;System.Net.Ping;System.Net.NameResolution;System.Net.WebProxy" />
        <ArcWasmUnusedAssembly Include="System.Security.AccessControl;System.Security.Claims;System.Security.Principal.Windows;System.Threading.AccessControl;Microsoft.Win32.Registry" />
        <ArcWasmUnusedAssembly Include="System.IO.Compression.ZipFile;System.IO.Compression.Brotli;System.IO.Pipes;System.IO.Pipes.AccessControl;System.IO.IsolatedStorage;System.Formats.Tar" />
        <ArcWasmUnusedAssembly Include="System.IO.FileSystem.Watcher;System.IO.FileSystem.AccessControl;System.IO.FileSystem.DriveInfo" />
        <ArcWasmUnusedAssembly Include="System.Reflection.DispatchProxy;System.Diagnostics.TextWriterTraceListener;System.Web.HttpUtility;System.ComponentModel.EventBasedAsync;System.Xml.XPath.XDocument" />
    </ItemGroup>

    <!-- Assemblies a session may never touch (the Lucide glyphs). They stay out of the boot list
         and are published as wwwroot/_lazy/<Name>.dll; the first time the runtime asks for one, LazyAssemblies fetches it
         (main.js, arc-lazy module), so a visitor who never reaches them never downloads them. An assembly with P/Invokes into
         the statically linked native libraries (SkiaSharp, HarfBuzzSharp, Onigwrap) must not be listed here: the P/Invoke
         table is built from the boot list. -->
    <ItemGroup>
        <ArcWasmLazyAssembly Include="TKCode.Arc.Icons.Lucide" />
    </ItemGroup>

    <!-- The WebAssembly SDK builds the boot list (build and publish) and the P/Invoke scan from ReferenceCopyLocalPaths, so
         removing the items here keeps them out of both. -->
    <Target Name="ArcPruneWasmAssemblies" AfterTargets="ResolveReferences" Condition="'$(ArcWasmPrune)' == 'true'">
        <!-- Trimmed: only the screenshots and the pages' text are left out. Nothing refers to their assemblies by code, so ILLink would
             drop them anyway; leaving them out here and setting the switches below makes the site fetch the pictures and pages as files. -->
        <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
            <_ArcWasmLeftOutNames>;TKCode.Arc.Gallery.Shots;TKCode.Arc.Gallery.Content;</_ArcWasmLeftOutNames>
        </PropertyGroup>
        <PropertyGroup Condition="'$(PublishTrimmed)' != 'true'">
            <_ArcWasmLazyNames>;@(ArcWasmLazyAssembly);</_ArcWasmLazyNames>
            <_ArcWasmLeftOutNames>;@(ArcWasmUnusedAssembly);@(ArcWasmLazyAssembly);</_ArcWasmLeftOutNames>
        </PropertyGroup>
        <ItemGroup>
            <_ArcWasmPrunedFile Include="@(ReferenceCopyLocalPaths)"
                                Condition="'%(Extension)' == '.dll' And $(_ArcWasmLeftOutNames.Contains(';%(Filename);'))" />
            <_ArcWasmLazyFile Include="@(ReferenceCopyLocalPaths)"
                              Condition="'%(Extension)' == '.dll' And $(_ArcWasmLazyNames.Contains(';%(Filename);'))" />
            <ReferenceCopyLocalPaths Remove="@(_ArcWasmPrunedFile)" />
        </ItemGroup>
        <!-- Program reads these switches: with the screenshots assembly gone, HttpShotSource fetches the pictures; with the content
             assembly gone, HttpTextSource fetches a page's text when it is shown. -->
        <ItemGroup>
            <RuntimeHostConfigurationOption Include="Arc.Gallery.ShotsOverHttp" Value="true" />
            <RuntimeHostConfigurationOption Include="Arc.Gallery.TextsOverHttp" Value="true" />
            <!-- Program installs LazyAssemblies only when some assemblies were left out to be fetched. -->
            <RuntimeHostConfigurationOption Include="Arc.Gallery.LazyAssemblies" Value="true" Condition="'$(PublishTrimmed)' != 'true'" />
        </ItemGroup>
        <Message Importance="high" Text="Arc: left @(_ArcWasmPrunedFile->Count()) assemblies out of the WebAssembly boot list, @(_ArcWasmLazyFile->Count()) of them to load on demand" />
    </Target>

    <!-- The screenshots of the docs pages, served as files (HttpShotSource): wwwroot/shots/Docs/<Category>/<Component>/images/<Name>.webp. -->
    <ItemGroup>
        <Content Include="../TKCode.Arc.Gallery/Docs/**/images/*.webp" Link="wwwroot/shots/Docs/%(RecursiveDir)%(Filename)%(Extension)" />
        <Content Include="../TKCode.Arc.Gallery/Guides/**/images/*.webp" Link="wwwroot/shots/Guides/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <!-- The text of the docs pages and guides, served as files (HttpTextSource): wwwroot/content/Docs/<Category>/<Component>/<language>.md
         and wwwroot/content/Guides/<Page>/<language>.md. -->
    <ItemGroup>
        <Content Include="../TKCode.Arc.Gallery/Docs/**/*.md" Link="wwwroot/content/Docs/%(RecursiveDir)%(Filename)%(Extension)" />
        <Content Include="../TKCode.Arc.Gallery/Guides/**/*.md" Link="wwwroot/content/Guides/%(RecursiveDir)%(Filename)%(Extension)" />
        <!-- The map outlines of the Choropleth explorer demos (HttpMapSource): wwwroot/content/Demos/Blocks/ChoroplethExplorer/Maps/map-*.txt. -->
        <Content Include="../TKCode.Arc.Gallery/Demos/Blocks/ChoroplethExplorer/Maps/*.txt" Link="wwwroot/content/Demos/Blocks/ChoroplethExplorer/Maps/%(Filename)%(Extension)" />
    </ItemGroup>

    <Target Name="ArcCopyLazyAssemblies" AfterTargets="Publish" Condition="'$(WasmBuildingForNestedPublish)' != 'true' And '@(_ArcWasmLazyFile)' != ''">
        <Copy SourceFiles="@(_ArcWasmLazyFile)" DestinationFolder="$(PublishDir)wwwroot/_lazy" SkipUnchangedFiles="true" />
    </Target>
</Project>
