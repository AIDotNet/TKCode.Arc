<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(ArcTargetFrameworks)</TargetFrameworks>
        <RootNamespace>TKCode.Arc.Gallery.Content</RootNamespace>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" />
    </ItemGroup>

    <!-- The text of the docs pages and of the Docs-section guides (Docs/GalleryTexts): Docs/<Category>/<Component>/<language>.md
         and Guides/<Page>/<language>.md in the gallery project, where they are written. They live in an assembly of their own,
         like the screenshots, so a host that serves them as files (the WebAssembly host) can leave the assembly out: every page in
         three languages was most of the gallery assembly, and a visitor reads a few pages in one language. -->
    <ItemGroup>
        <AvaloniaResource Include="../TKCode.Arc.Gallery/Docs/**/*.md" Link="Docs/%(RecursiveDir)%(Filename)%(Extension)" />
        <AvaloniaResource Include="../TKCode.Arc.Gallery/Guides/**/*.md" Link="Guides/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <!-- The source of every demo, which its Code tab and "Copy page" show (GalleryDemoFile): Demos/<Category>/<Component>/<Name>.axaml
         and its code-behind, each under its own path plus .txt, so they are plain text here and not compiled as XAML again.
         They were string constants of the gallery assembly: several megabytes that every host loaded at startup. -->
    <ItemGroup>
        <AvaloniaResource Include="../TKCode.Arc.Gallery/Demos/**/*.axaml" Link="Demos/%(RecursiveDir)%(Filename)%(Extension).txt" />
        <AvaloniaResource Include="../TKCode.Arc.Gallery/Demos/**/*.axaml.cs" Link="Demos/%(RecursiveDir)%(Filename)%(Extension).txt" />
    </ItemGroup>

    <!-- The outlines of the Choropleth explorer demos (public domain: US Census cartographic boundaries, Natural Earth admin-1),
         read and parsed on demand by ChoroplethExplorerDemoData; the block itself contains no map. The WebAssembly host serves
         them as files (wwwroot/content/Demos/...) and reads one when its area is first shown. -->
    <ItemGroup>
        <AvaloniaResource Include="../TKCode.Arc.Gallery/Demos/Blocks/ChoroplethExplorer/Maps/*.txt" Link="Demos/Blocks/ChoroplethExplorer/Maps/%(Filename)%(Extension)" />
    </ItemGroup>
</Project>
