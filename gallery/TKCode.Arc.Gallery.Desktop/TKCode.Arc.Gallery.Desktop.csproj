<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFrameworks>$(ArcTargetFrameworks)</TargetFrameworks>
        <RootNamespace>TKCode.Arc.Gallery.Desktop</RootNamespace>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);CS0436</NoWarn>
        <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
        <ApplicationManifest Condition="'$(OS)' == 'Windows_NT'"></ApplicationManifest>
        <!-- Icon of the Windows executable. The macOS bundle icon is Assets/AppIcon.icns (tools/macos/bundle.sh). -->
        <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="AtomUI.Desktop.Controls" />
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <ProjectReference Include="../TKCode.Arc.Gallery/TKCode.Arc.Gallery.csproj" />
        <ProjectReference Include="../TKCode.Arc.Gallery.Shots/TKCode.Arc.Gallery.Shots.csproj" />
        <ProjectReference Include="../TKCode.Arc.Gallery.Content/TKCode.Arc.Gallery.Content.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.Fonts/TKCode.Arc.Fonts.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.Icons.Lucide/TKCode.Arc.Icons.Lucide.csproj" />
    </ItemGroup>
</Project>
