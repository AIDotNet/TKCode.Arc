<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             xmlns:generic="using:System.Collections.Generic"
             x:Class="TKCode.Arc.Gallery.Demos.ChatThreadStreamingMarkdownReplyDemo">
    <StackPanel Spacing="12">
        <Border Height="560"
                MaxWidth="640"
                CornerRadius="26"
                BorderThickness="1"
                ClipToBounds="True"
                Background="{arc:ArcDesignTokenResource Surface}"
                BorderBrush="{arc:ArcDesignTokenResource Border}">
            <arc:ChatThread x:Name="Chat"
                            Label="Assistant"
                            CurrentUserId="me"
                            Placeholder="Ask anything"
                            IsAttachmentEnabled="False"
                            SendRequested="OnSendRequested">
                <arc:ChatThread.Participants>
                    <generic:List x:TypeArguments="arc:ChatParticipant">
                        <arc:ChatParticipant Id="me" Name="Alex Kim" />
                        <arc:ChatParticipant Id="arc" Name="Arc Assistant" />
                    </generic:List>
                </arc:ChatThread.Participants>
            </arc:ChatThread>
        </Border>
        <arc:Button Content="Stream a reply" HorizontalAlignment="Center" Click="OnStreamClick" />
    </StackPanel>
</UserControl>
