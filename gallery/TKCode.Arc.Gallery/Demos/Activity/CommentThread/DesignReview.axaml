<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.CommentThreadDesignReviewDemo">
    <StackPanel Spacing="12">
        <Border MaxWidth="520">
            <arc:CommentThread Title="Hero headline"
                               CurrentUser="{x:Static demos:CommentThreadDemoData.Ana}"
                               Comments="{x:Static demos:CommentThreadDemoData.Review}"
                               CommentsChanged="OnCommentsChanged"
                               ResolvedChanged="OnResolvedChanged" />
        </Border>
        <TextBlock x:Name="Status"
                   Text="Reply, react, edit or delete your own comments, then resolve the thread."
                   FontSize="14"
                   TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
    </StackPanel>
</UserControl>
