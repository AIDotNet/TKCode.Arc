<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.CommentThreadEmptyThreadDemo">
    <Border MaxWidth="520">
        <arc:CommentThread Title="Footer links"
                           CurrentUser="{x:Static demos:CommentThreadDemoData.Ana}"
                           People="{x:Static demos:CommentThreadDemoData.People}" />
    </Border>
</UserControl>
