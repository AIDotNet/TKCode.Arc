<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.CommentThreadNarrowDemo">
    <arc:CommentThread Width="360"
                       HorizontalAlignment="Center"
                       CurrentUser="{x:Static demos:CommentThreadDemoData.Ana}"
                       Comments="{x:Static demos:CommentThreadDemoData.Review}" />
</UserControl>
