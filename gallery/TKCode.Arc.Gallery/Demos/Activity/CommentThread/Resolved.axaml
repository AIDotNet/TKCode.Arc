<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.CommentThreadResolvedDemo">
    <Border MaxWidth="520">
        <arc:CommentThread Title="Pricing table spacing"
                           IsResolved="True"
                           CurrentUser="{x:Static demos:CommentThreadDemoData.Ana}"
                           Comments="{x:Static demos:CommentThreadDemoData.Settled}" />
    </Border>
</UserControl>
