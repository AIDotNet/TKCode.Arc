<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.DataGridBudgetDemo">
    <StackPanel Spacing="12">
        <arc:DataGrid x:Name="BudgetGrid"
                      Label="Budget"
                      ShowRowNumbers="False"
                      ShowSelectionStats="False"
                      MaxViewportHeight="320"
                      ExportFormats="Xlsx">
            <arc:DataGridColumn Key="line" Header="Line item" Width="200" />
            <arc:DataGridColumn Key="q1" Header="Q1" Type="Currency" Width="120" />
            <arc:DataGridColumn Key="q2" Header="Q2" Type="Currency" Width="120" />
            <arc:DataGridColumn Key="notes" Header="Notes" Width="220" IsHidden="True" />
            <arc:DataGrid.BulkActions>
                <arc:DataGridBulkAction Label="Archive" Icon="{x:Static arc:ArcIcons.Archive}" />
            </arc:DataGrid.BulkActions>
        </arc:DataGrid>
        <TextBlock x:Name="Log" Text="Check rows to archive them." Opacity="0.7" />
    </StackPanel>
</UserControl>
