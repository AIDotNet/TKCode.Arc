<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.DataGridCustomCellsDemo">
    <StackPanel Spacing="12">
        <arc:DataGrid x:Name="DealsGrid"
                      Label="Deals"
                      MaxViewportHeight="340"
                      ShowRowNumbers="False"
                      ShowTotals="False">
            <arc:DataGridColumn Key="account" Header="Account" Width="190" IsPinned="True">
                <arc:DataGridColumn.Renderer>
                    <arc:LinkRenderer Part="open" />
                </arc:DataGridColumn.Renderer>
            </arc:DataGridColumn>
            <arc:DataGridColumn Key="stage" Header="Stage" Type="Select" Width="150">
                <arc:DataGridColumn.Renderer>
                    <arc:BadgeRenderer ToneMap="Discovery=Neutral, Proposal=Warning, Negotiation=Accent, Won=Success, Lost=Danger" />
                </arc:DataGridColumn.Renderer>
            </arc:DataGridColumn>
            <arc:DataGridColumn Key="health" Header="Health" Type="Percent" Width="170">
                <arc:DataGridColumn.Renderer>
                    <arc:ProgressRenderer />
                </arc:DataGridColumn.Renderer>
            </arc:DataGridColumn>
            <arc:DataGridColumn Key="region" Header="Region" Type="Select" Width="170" />
            <arc:DataGridColumn Key="active" Header="Active" Type="Boolean" Width="90" />
            <arc:DataGridColumn Key="arr" Header="ARR" Type="Currency" Width="120" />
        </arc:DataGrid>
        <TextBlock x:Name="Log" Text="Click an account name, a checkbox or an action; drag the Health slider with Enter." Opacity="0.7" />
    </StackPanel>
</UserControl>
