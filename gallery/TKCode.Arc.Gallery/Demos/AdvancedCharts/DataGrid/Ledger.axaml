<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.DataGridLedgerDemo">
    <arc:DataGrid x:Name="LedgerGrid"
                  Label="Journal"
                  MaxViewportHeight="420"
                  ExportFormats="Xlsx">
        <arc:DataGridColumn Key="account" Header="Account" Type="Select" Width="170" />
        <arc:DataGridColumn Key="period" Header="Period" Type="Select" Width="110" />
        <arc:DataGridColumn Key="date" Header="Date" Type="Date" Width="130" DateFormat="yyyy-MM-dd" />
        <arc:DataGridColumn Key="memo" Header="Memo" Width="200" />
        <arc:DataGridColumn Key="debit" Header="Debit" Type="Currency" Decimals="2" Width="120" />
        <arc:DataGridColumn Key="credit" Header="Credit" Type="Currency" Decimals="2" Width="120" />
    </arc:DataGrid>
</UserControl>
