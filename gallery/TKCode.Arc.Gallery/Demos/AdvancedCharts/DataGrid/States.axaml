<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.DataGridStatesDemo">
    <StackPanel Spacing="12">
        <arc:Switch x:Name="LoadingSwitch" Content="Loading" />
        <arc:DataGrid Label="Invoices"
                      EmptyMessage="No invoices yet"
                      IsLoading="{Binding #LoadingSwitch.IsChecked}"
                      MaxViewportHeight="280">
            <arc:DataGridColumn Key="invoice" Header="Invoice" Width="140" />
            <arc:DataGridColumn Key="customer" Header="Customer" Width="180" />
            <arc:DataGridColumn Key="due" Header="Due" Type="Date" Width="130" />
            <arc:DataGridColumn Key="amount" Header="Amount" Type="Currency" Width="130" />
        </arc:DataGrid>
    </StackPanel>
</UserControl>
