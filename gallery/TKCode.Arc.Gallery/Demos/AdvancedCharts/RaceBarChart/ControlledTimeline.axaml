<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.RaceBarChartControlledTimelineDemo">
    <StackPanel Spacing="16">
        <arc:RaceBarChart x:Name="Chart"
                          Label="Library card sign-ups by branch"
                          BarCount="5"
                          IsAutoPlay="False" />
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="8" LineSpacing="8">
            <arc:Button x:Name="First" Content="First quarter" Variant="Secondary" />
            <arc:Button x:Name="Previous" Content="Previous" Variant="Secondary" />
            <arc:Button x:Name="Next" Content="Next" Variant="Secondary" />
            <arc:Button x:Name="Last" Content="Last quarter" Variant="Secondary" />
        </WrapPanel>
        <TextBlock x:Name="Log" HorizontalAlignment="Center" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
