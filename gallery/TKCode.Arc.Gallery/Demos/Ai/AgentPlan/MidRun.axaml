<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.AgentPlanMidRunDemo">
    <!-- A plan already running: two steps done, one added by the agent, one failed and waiting for a decision. -->
    <arc:AgentPlan x:Name="Plan"
                   MaxWidth="560"
                   Status="Running"
                   Goal="Speed up the nightly build"
                   StepAction="OnStepAction" />
</UserControl>
