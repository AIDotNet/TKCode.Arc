<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.AgentStatusActionsDemo">
    <!-- Actions says which buttons this app can honor. Here the run can be approved or denied and opened, but not paused,
         stopped or retried, so those buttons never show. -->
    <StackPanel Spacing="14" HorizontalAlignment="Center" Margin="0,0,0,330">
        <arc:AgentStatus Status="NeedsInput"
                         Actions="Approve, Deny, OpenRun"
                         Agent="{x:Static demos:AgentStatusDemoData.CodingAgent}"
                         Activity="{x:Static demos:AgentStatusDemoData.ApprovalRequest}" />
        <arc:AgentStatus Status="Working"
                         Actions="OpenRun"
                         Agent="{x:Static demos:AgentStatusDemoData.ResearchAgent}"
                         Activity="{x:Static demos:AgentStatusDemoData.Reading}" />
    </StackPanel>
</UserControl>
