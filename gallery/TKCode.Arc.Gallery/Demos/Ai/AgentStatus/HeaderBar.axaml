<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.AgentStatusHeaderBarDemo">
    <!-- A header bar that clips its content: the open panel floats over the page instead of being cut off. The left pill
         grows its panel from the start edge, the right one from the end edge. -->
    <Border x:Name="Bar"
            Height="56"
            ClipToBounds="True"
            BorderThickness="1"
            CornerRadius="16"
            Margin="0,0,0,330"
            BorderBrush="{arc:ArcDesignTokenResource Border}"
            Background="{arc:ArcDesignTokenResource Surface}">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0">
            <arc:AgentStatus x:Name="Left" PanelAlignment="Start" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="Release notes"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{arc:ArcDesignTokenResource TextMuted}" />
            <arc:AgentStatus x:Name="Right" Grid.Column="2" PanelAlignment="End" VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
