<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.AgentStatusPreviewDemo">
    <!-- The pill plays a simulated run the demo writes (AgentStatusDemoData: real model names, an invented task). The
         scenario switch and Replay belong to this demo, not to the control: they only change the AgentRunSimulation that
         drives the pill. Without a simulation or data of its own the pill rests at Ready. -->
    <Grid RowDefinitions="Auto,Auto" Height="400">
        <arc:AgentStatus x:Name="Pill" Margin="0,64,0,0" HorizontalAlignment="Center">
            <arc:AgentStatus.Simulation>
                <arc:AgentRunSimulation Scenario="{x:Static demos:AgentStatusDemoData.Coding}" />
            </arc:AgentStatus.Simulation>
        </arc:AgentStatus>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <arc:SegmentedControl x:Name="Scenario" SelectedValue="coding" SelectionChanged="OnScenarioChanged">
                <arc:SegmentedOption Value="coding" Label="Coding agent" />
                <arc:SegmentedOption Value="research" Label="Research agent" />
            </arc:SegmentedControl>
            <arc:Button Variant="Secondary" Size="Small" Click="OnReplay" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <arc:ArcGlyph Data="{x:Static arc:ArcIcons.RotateCcw}" Size="16" />
                    <TextBlock Text="Replay" />
                </StackPanel>
            </arc:Button>
        </StackPanel>
    </Grid>
</UserControl>
