<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.AgentTimelineSpeedsDemo">
    <!-- Four speeds to choose from, starting at double speed. -->
    <arc:AgentTimeline x:Name="Timeline" Speed="2" Margin="0,12"
                       AutoPlay="True" Run="{x:Static demos:AgentTimelineDemoData.IncidentRun}" />
</UserControl>
