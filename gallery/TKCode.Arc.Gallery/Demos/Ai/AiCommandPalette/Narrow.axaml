<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.AiCommandPaletteNarrowDemo">
    <!-- At 380px: labels and meta truncate (meta first), the navigate hint leaves the footer and source chips wrap.
         A shorter results area and the floating shadow suit a popover. -->
    <Border MaxWidth="380" Margin="0,12">
        <arc:AiCommandPalette ResultsHeight="300"
                              AutoPlay="False"
                              IsElevated="True"
                              ModelName="{x:Static demos:AiCommandPaletteDemoData.ModelName}">
            <arc:AiCommandPalette.Simulation>
                <arc:AiCommandPaletteSimulation Items="{x:Static demos:AiCommandPaletteDemoData.Items}"
                                                Questions="{x:Static demos:AiCommandPaletteDemoData.Questions}"
                                                Answers="{x:Static demos:AiCommandPaletteDemoData.Answers}"
                                                SearchQuery="{x:Static demos:AiCommandPaletteDemoData.SearchQuery}" />
            </arc:AiCommandPalette.Simulation>
        </arc:AiCommandPalette>
    </Border>
</UserControl>
