<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.AiMascotReplyHeaderDemo">
    <!-- Inline at 24px next to a reply. The phases are simulated: thinking, writing while the words stream, then done. -->
    <Border MaxWidth="520"
            Margin="0,8"
            Padding="16"
            CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
            BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
            BorderBrush="{arc:ArcDesignTokenResource Border}"
            Background="{arc:ArcDesignTokenResource Surface}">
        <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <arc:AiMascot x:Name="Mascot" Status="Thinking" Size="24" AssistantName="Atlas" FollowPointer="Never" Announce="True" />
                <TextBlock Text="Atlas"
                           VerticalAlignment="Center"
                           FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                           FontSize="{arc:ArcDesignTokenResource TypeSM}"
                           Foreground="{arc:ArcDesignTokenResource Foreground}" />
                <TextBlock x:Name="Phase"
                           Text="Thinking"
                           VerticalAlignment="Center"
                           FontSize="{arc:ArcDesignTokenResource TypeSM}"
                           Foreground="{arc:ArcDesignTokenResource TextMuted}" />
            </StackPanel>
            <TextBlock x:Name="Reply"
                       TextWrapping="Wrap"
                       LineHeight="22"
                       MinHeight="66"
                       FontSize="{arc:ArcDesignTokenResource TypeSM}"
                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
            <arc:Button Content="Ask again" Variant="Secondary" Size="Small" HorizontalAlignment="Left" Click="OnAsk" />
        </StackPanel>
    </Border>
</UserControl>
