<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.AiWorkflowNarrowDemo">
    <!-- In a 380px column the rows grow to 44px with the detail under the title, the status slot narrows to 64px and the
         header wraps to two lines. -->
    <Border MaxWidth="380">
        <arc:AiWorkflow>
            <arc:AiWorkflow.Simulation>
                <arc:AiWorkflowSimulation Title="Escalate urgent support email"
                                          Description="Runs on every new email to support@example.com"
                                          Steps="{x:Static demos:AiWorkflowDemoData.Steps}"
                                          Catalog="{x:Static demos:AiWorkflowDemoData.Catalog}" />
            </arc:AiWorkflow.Simulation>
        </arc:AiWorkflow>
    </Border>
</UserControl>
