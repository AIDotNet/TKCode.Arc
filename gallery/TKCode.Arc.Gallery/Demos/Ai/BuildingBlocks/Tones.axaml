<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.BuildingBlocksTonesDemo">
    <!-- Neutral takes the foreground color; Tint takes any color, here a brand green, and wins over Tone. -->
    <WrapPanel ItemSpacing="24" LineSpacing="24" Margin="0,12">
        <arc:BuildingBlocks Size="Small" Tone="Neutral" />
        <arc:BuildingBlocks Size="Small" Tint="#16A34A" />
    </WrapPanel>
</UserControl>
