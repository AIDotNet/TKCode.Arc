<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ContextWindowReducedMotionDemo">
    <!-- Under reduced motion cells and numbers change at once, a compaction lands right away and every status is still
         announced. -->
    <arc:ContextWindow arc:ArcMotion.Level="Reduced" Margin="0,12" />
</UserControl>
