<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ContextWindowYourSessionDemo">
    <StackPanel Spacing="16" Margin="0,12">
        <!-- Your own models, items, turns and files; the card rewrites Items as it goes and raises an event for each change. -->
        <arc:ContextWindow x:Name="Card"
                           ItemsChanged="OnItemsChanged"
                           Compacted="OnCompacted"
                           ModelChanged="OnModelChanged" />
        <TextBlock x:Name="Log"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Text="Send, attach, compact or switch models: each event is logged here."
                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
    </StackPanel>
</UserControl>
