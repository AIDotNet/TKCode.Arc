<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.DesignToCodeReducedMotionDemo">
    <!-- Under reduced motion there is no scan line and no chunk fade: the regions appear at once, the code arrives a part
         at a time, and the simulation plays once instead of looping. Every step is still announced. -->
    <Panel MaxWidth="760" Margin="0,12">
        <arc:DesignToCode arc:ArcMotion.Level="Reduced">
            <arc:DesignToCode.Simulation>
                <arc:DesignToCodeSimulation Source="{x:Static demos:DesignToCodeDemoData.Source}"
                                            Regions="{x:Static demos:DesignToCodeDemoData.Regions}"
                                            Parts="{x:Static demos:DesignToCodeDemoData.Parts}"
                                            Model="{x:Static demos:DesignToCodeDemoData.Model}"
                                            FileName="PricingCard.tsx"
                                            FrameName="Pricing / Pro card"
                                            PreviewFactory="{x:Static demos:DesignToCodeDemoData.Preview}"
                                            PreviewAction="{x:Static demos:DesignToCodeDemoData.FlipBilling}" />
            </arc:DesignToCode.Simulation>
        </arc:DesignToCode>
    </Panel>
</UserControl>
