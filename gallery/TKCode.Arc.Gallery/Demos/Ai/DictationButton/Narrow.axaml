<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.DictationButtonNarrowDemo">
    <!-- In a 360px column the keyboard hints stay hidden, the model label gives way to the 216px pill while recording and
         error copy is short. The pill keeps its width, so nothing reflows while you speak. -->
    <arc:DictationButton Width="360"
                         HorizontalAlignment="Left"
                         Margin="0,24"
                         AutoPlay="False"
                         Model="{x:Static demos:DictationButtonDemoData.Model}"
                         Placeholder="{x:Static demos:DictationButtonDemoData.Placeholder}">
        <arc:DictationButton.Simulation>
            <arc:SimulatedDictationRecognizer Scripts="{x:Static demos:DictationButtonDemoData.Scripts}" />
        </arc:DictationButton.Simulation>
    </arc:DictationButton>
</UserControl>
