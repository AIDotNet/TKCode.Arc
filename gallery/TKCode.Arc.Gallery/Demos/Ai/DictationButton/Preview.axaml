<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.DictationButtonPreviewDemo">
    <!-- The composer with a simulation: a SimulatedDictationRecognizer speaks three invented scripts
         (DictationButtonDemoData) and the composer plays them on its own (the mic springs into the pill, words stream in
         muted and settle, Insert, send) until you click, type or tab into it; then the mic is yours. Nothing is recorded.
         The model label is a real model, the one the message would go to. It fills its column up to 640px, so its width
         never follows the words. -->
    <arc:DictationButton MaxWidth="640"
                         Margin="0,24"
                         Model="{x:Static demos:DictationButtonDemoData.Model}"
                         Placeholder="{x:Static demos:DictationButtonDemoData.Placeholder}">
        <arc:DictationButton.Simulation>
            <arc:SimulatedDictationRecognizer Scripts="{x:Static demos:DictationButtonDemoData.Scripts}" />
        </arc:DictationButton.Simulation>
    </arc:DictationButton>
</UserControl>
