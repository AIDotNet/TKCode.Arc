<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.DictationButtonReducedMotionDemo">
    <!-- Reduced motion: the pill and the field change size at once, words appear without fading and the waveform stops
         travelling: its bars pulse in place with the voice. Faces still crossfade. -->
    <arc:DictationButton MaxWidth="640"
                         Margin="0,24"
                         AutoPlay="False"
                         arc:ArcMotion.Level="Reduced"
                         Model="{x:Static demos:DictationButtonDemoData.Model}"
                         Placeholder="{x:Static demos:DictationButtonDemoData.Placeholder}">
        <arc:DictationButton.Simulation>
            <arc:SimulatedDictationRecognizer Scripts="{x:Static demos:DictationButtonDemoData.Scripts}" />
        </arc:DictationButton.Simulation>
    </arc:DictationButton>
</UserControl>
