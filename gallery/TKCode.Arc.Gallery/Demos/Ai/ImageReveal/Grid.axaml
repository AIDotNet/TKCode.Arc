<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.ImageRevealGridDemo">
    <!-- Four variations resolve one after another: Small tiles, each with its own simulation over the same three pictures,
         its own seed (which picks its first picture and its grain) and a 420ms stagger, no loop. Generate again changes
         RunKey, so every tile blurs back out and runs again. MaxWidth="Infinity" lets the tiles fill their grid cells
         instead of stopping at 560px. -->
    <StackPanel Spacing="12" MaxWidth="440">
        <UniformGrid Columns="2" ColumnSpacing="8" RowSpacing="8">
            <arc:ImageReveal x:Name="Tile1" Size="Small" Seed="1" IsLooping="False" StartDelay="0:0:0" MaxWidth="Infinity">
                <arc:ImageReveal.Simulation>
                    <arc:ImageRevealSimulation Pictures="{x:Static demos:ImageRevealDemoData.Pictures}" />
                </arc:ImageReveal.Simulation>
            </arc:ImageReveal>
            <arc:ImageReveal x:Name="Tile2" Size="Small" Seed="2" IsLooping="False" StartDelay="0:0:0.42" MaxWidth="Infinity">
                <arc:ImageReveal.Simulation>
                    <arc:ImageRevealSimulation Pictures="{x:Static demos:ImageRevealDemoData.Pictures}" />
                </arc:ImageReveal.Simulation>
            </arc:ImageReveal>
            <arc:ImageReveal x:Name="Tile3" Size="Small" Seed="3" IsLooping="False" StartDelay="0:0:0.84" MaxWidth="Infinity">
                <arc:ImageReveal.Simulation>
                    <arc:ImageRevealSimulation Pictures="{x:Static demos:ImageRevealDemoData.Pictures}" />
                </arc:ImageReveal.Simulation>
            </arc:ImageReveal>
            <arc:ImageReveal x:Name="Tile4" Size="Small" Seed="4" IsLooping="False" StartDelay="0:0:1.26" MaxWidth="Infinity">
                <arc:ImageReveal.Simulation>
                    <arc:ImageRevealSimulation Pictures="{x:Static demos:ImageRevealDemoData.Pictures}" />
                </arc:ImageReveal.Simulation>
            </arc:ImageReveal>
        </UniformGrid>
        <arc:Button Variant="Secondary" Size="Small" HorizontalAlignment="Left" Click="OnGenerateAgain">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.RotateCcw}" Size="16" VerticalAlignment="Center" />
                <TextBlock Text="Generate again" VerticalAlignment="Center" />
            </StackPanel>
        </arc:Button>
    </StackPanel>
</UserControl>
