<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.LiveVisitorsPreviewDemo">
    <!-- With no data the card plays its LiveVisitorsSimulation of an invented site (LiveVisitorsDemoData): arrivals ping on
         the map, the count rolls, the pages reorder and signups tick in. The tabs show the stream's other states, and Empty
         has no data and no simulation; the pause button holds the snapshot. The card fills its container up to 640px, so
         its width never follows the numbers. All traffic is invented. -->
    <StackPanel Spacing="20" MaxWidth="640">
        <arc:SegmentedControl x:Name="State"
                              HorizontalAlignment="Center"
                              SelectedValue="live"
                              SelectionChanged="OnStateChanged">
            <arc:SegmentedOption Value="live" Label="Live" />
            <arc:SegmentedOption Value="connecting" Label="Connecting" />
            <arc:SegmentedOption Value="reconnecting" Label="Reconnecting" />
            <arc:SegmentedOption Value="empty" Label="Empty" />
        </arc:SegmentedControl>
        <arc:LiveVisitors x:Name="Card">
            <arc:LiveVisitors.Simulation>
                <arc:LiveVisitorsSimulation TypicalCount="{x:Static demos:LiveVisitorsDemoData.TypicalCount}"
                                            Cities="{x:Static demos:LiveVisitorsDemoData.Cities}"
                                            SitePages="{x:Static demos:LiveVisitorsDemoData.SitePages}"
                                            Conversions="{x:Static demos:LiveVisitorsDemoData.Conversions}" />
            </arc:LiveVisitors.Simulation>
        </arc:LiveVisitors>
    </StackPanel>
</UserControl>
