<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.MeetingSummaryYourMeetingDemo">
    <!-- Your code owns the notes: it sets Meeting and drives Status, creates the issue or page when an item is sent, and
         hears every check. The tracker here is a stand-in that answers after 700ms; the log shows each event. -->
    <StackPanel Spacing="16" MaxWidth="640">
        <arc:MeetingSummary x:Name="Card"
                            SendRequested="OnSendRequested"
                            ActionItemSent="OnSent"
                            ActionItemChanged="OnChanged"
                            RegenerateRequested="OnRegenerate" />
        <TextBlock x:Name="Log"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="{arc:ArcDesignTokenResource TextMuted}"
                   Text="Check an item or send one to Issues or Docs." />
    </StackPanel>
</UserControl>
