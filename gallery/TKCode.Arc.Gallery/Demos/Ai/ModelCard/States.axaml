<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.ModelCardStatesDemo">
    <!-- Loading shows a pulsing skeleton and disables Compare; an error replaces the body and offers Retry; with no model the
         card keeps its frame and says no model is selected. The card keeps the same size in every state. -->
    <StackPanel Spacing="16" MaxWidth="640">
        <arc:SegmentedControl x:Name="State"
                              HorizontalAlignment="Center"
                              SelectedValue="ready"
                              SelectionChanged="OnStateChanged">
            <arc:SegmentedOption Value="ready" Label="Ready" />
            <arc:SegmentedOption Value="loading" Label="Loading" />
            <arc:SegmentedOption Value="error" Label="Error" />
            <arc:SegmentedOption Value="empty" Label="Empty" />
        </arc:SegmentedControl>
        <arc:ModelCard x:Name="Card"
                       CanRetry="True"
                       Model="{x:Static demos:ModelCardDemoData.Opus}"
                       Rivals="{x:Static demos:ModelCardDemoData.Frontier}"
                       Benchmarks="{x:Static demos:ModelCardDemoData.FrontierBenchmarks}"
                       Labels="{x:Static demos:ModelCardDemoData.Labels}"
                       Note="{x:Static demos:ModelCardDemoData.Note}" />
    </StackPanel>
</UserControl>
