<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.PiiRedactionNarrowDemo">
    <!-- In a 360px column the type cells fall into two rows of two, the gaps tighten, the Simulated tag hides (the status
         still says it) and a long model name truncates in the flow. -->
    <Panel MaxWidth="360" Margin="0,12">
        <arc:PiiRedaction AutoPlay="False">
            <arc:PiiRedaction.Simulation>
                <arc:PiiRedactionSimulation Message="{x:Static demos:PiiRedactionDemoData.Message}"
                                            Names="{x:Static demos:PiiRedactionDemoData.Names}"
                                            Reply="{x:Static demos:PiiRedactionDemoData.Reply}"
                                            ModelName="{x:Static demos:PiiRedactionDemoData.LongModelName}" />
            </arc:PiiRedaction.Simulation>
        </arc:PiiRedaction>
    </Panel>
</UserControl>
