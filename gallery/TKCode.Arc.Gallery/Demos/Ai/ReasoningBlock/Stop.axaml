<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.ReasoningBlockStopDemo">
    <!-- AllowsStop shows a Stop button while the model thinks; stopping reads "Stopped after 4s" and keeps what streamed.
         The model here is a simulation, which Stop ends on its own; with a real model, handle StopRequested, abort the
         request and set Status to Stopped. -->
    <StackPanel Spacing="12" MaxWidth="480">
        <arc:ReasoningBlock x:Name="Block" AllowsStop="True">
            <arc:ReasoningBlock.Simulation>
                <arc:ReasoningBlockSimulation Reasoning="{x:Static demos:ReasoningBlockDemoData.Reasoning}" />
            </arc:ReasoningBlock.Simulation>
        </arc:ReasoningBlock>
        <arc:Button Variant="Ghost" Size="Small" HorizontalAlignment="Left" Click="OnReplay">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.RotateCcw}" Size="16" VerticalAlignment="Center" />
                <TextBlock Text="Replay" VerticalAlignment="Center" />
            </StackPanel>
        </arc:Button>
    </StackPanel>
</UserControl>
