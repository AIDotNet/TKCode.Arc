<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SourceCardsStreamingDemo">
    <!-- Your own search: results are appended to an observable list while Status is Searching with a Total of 5, then the
         status flips to Done and the answer streams in as Content, with [n] citations that highlight their cards. -->
    <StackPanel Spacing="12" MaxWidth="640">
        <arc:SourceCards x:Name="Cards" Status="Searching" Total="5" Max="3">
            <TextBlock x:Name="Answer" TextWrapping="Wrap" LineHeight="22" />
        </arc:SourceCards>
        <arc:Button Variant="Ghost" Size="Small" HorizontalAlignment="Left" Click="OnReplay">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.RotateCcw}" Size="16" VerticalAlignment="Center" />
                <TextBlock Text="Replay" VerticalAlignment="Center" />
            </StackPanel>
        </arc:Button>
    </StackPanel>
</UserControl>
