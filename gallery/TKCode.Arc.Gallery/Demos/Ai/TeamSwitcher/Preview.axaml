<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.TeamSwitcherPreviewDemo">
    <!-- The switcher with a TeamSwitcherSimulation: six invented workspaces and two invites (TeamSwitcherDemoData); every
         action is simulated. Live switches in 650ms; Switching loads Contoso for three seconds; Failed tries Fabrikam and
         goes back with the error; Empty has no workspaces and no simulation. The column is 360px wide at most, so the
         switcher fills it and never follows its content. -->
    <StackPanel Spacing="20" MaxWidth="360" Margin="0,0,0,24">
        <arc:SegmentedControl x:Name="Scenario"
                              HorizontalAlignment="Center"
                              SelectedValue="live"
                              SelectionChanged="OnScenarioChanged">
            <arc:SegmentedOption Value="live" Label="Live" />
            <arc:SegmentedOption Value="switching" Label="Switching" />
            <arc:SegmentedOption Value="failed" Label="Failed" />
            <arc:SegmentedOption Value="empty" Label="Empty" />
        </arc:SegmentedControl>
        <arc:TeamSwitcher x:Name="Switcher">
            <arc:TeamSwitcher.Simulation>
                <arc:TeamSwitcherSimulation Workspaces="{x:Static demos:TeamSwitcherDemoData.Workspaces}"
                                            Invites="{x:Static demos:TeamSwitcherDemoData.Invites}"
                                            CreatedPlan="{x:Static demos:TeamSwitcherDemoData.CreatedPlan}"
                                            CreatedRole="{x:Static demos:TeamSwitcherDemoData.CreatedRole}" />
            </arc:TeamSwitcher.Simulation>
        </arc:TeamSwitcher>
        <TextBlock x:Name="Status"
                   HorizontalAlignment="Center"
                   FontSize="12"
                   Foreground="{arc:ArcDesignTokenResource TextMuted}"
                   Text="Press ⌘/Ctrl+1 to 6 while the switcher has focus." />
    </StackPanel>
</UserControl>
