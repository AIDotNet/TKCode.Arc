<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.TicketRouterPreviewDemo">
    <!-- The router in its main states. Live plays a simulation of an inbox (the demo's data) with the simulated
         classifier (two of its ten tickets wait for review: click one to route it). Error uses a classifier that fails on
         the second ticket, with Retry and Send to review. Caught up runs three tickets of your own without looping and ends
         in "All caught up". Empty has no tickets and no simulation. The card fills its container up to 840px, so its width
         never follows the tickets. The model is real; messages, people and numbers are invented. -->
    <StackPanel Spacing="20" MaxWidth="840">
        <arc:SegmentedControl x:Name="Scenario"
                              HorizontalAlignment="Center"
                              SelectedValue="live"
                              SelectionChanged="OnScenarioChanged">
            <arc:SegmentedOption Value="live" Label="Live" />
            <arc:SegmentedOption Value="error" Label="Error" />
            <arc:SegmentedOption Value="caughtup" Label="Caught up" />
            <arc:SegmentedOption Value="empty" Label="Empty" />
        </arc:SegmentedControl>
        <arc:TicketRouter x:Name="Router">
            <arc:TicketRouter.Simulation>
                <arc:TicketRouterSimulation Model="{x:Static demos:TicketRouterDemoData.Model}"
                                            Lanes="{x:Static demos:TicketRouterDemoData.Lanes}"
                                            Tickets="{x:Static demos:TicketRouterDemoData.Tickets}"
                                            Routed="{x:Static demos:TicketRouterDemoData.Routed}" />
            </arc:TicketRouter.Simulation>
        </arc:TicketRouter>
    </StackPanel>
</UserControl>
