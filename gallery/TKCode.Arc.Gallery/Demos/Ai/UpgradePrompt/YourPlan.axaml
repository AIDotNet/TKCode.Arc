<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.UpgradePromptYourPlanDemo">
    <!-- Seats instead of credits: a Team plan with its own unlocks and limits, starting on monthly billing.
         The plan and its prices belong to an invented product; the shared model is a real one (from the catalog). -->
    <Border MaxWidth="440" Margin="0,12">
        <arc:UpgradePrompt Used="3" Limit="3" Unit="seats" ResetsOn="your next billing date" Interval="Monthly"
                           Title="You've used all 3 seats"
                           Description="Invite the rest of your team with Team, or free up a seat.">
            <arc:UpgradePrompt.Plan>
                <arc:UpgradePromptPlan Name="Team" MonthlyPrice="48" YearlyPrice="40" Currency="USD" Limit="25">
                    <arc:UpgradePromptPlan.Features>
                        <arc:UpgradePromptFeature Id="seats" Label="Up to 25 seats, add more any time"
                                                  Mark="{x:Static arc:ArcIcons.Users}" />
                        <arc:UpgradePromptFeature Id="admin" Label="Roles, SSO and an audit log"
                                                  Mark="{x:Static arc:ArcIcons.ShieldCheck}" />
                        <arc:UpgradePromptFeature Id="shared" Label="{x:Static demos:UpgradePromptDemoData.SharedWorkspace}"
                                                  Mark="{x:Static arc:ArcIcons.Sparkles}" />
                    </arc:UpgradePromptPlan.Features>
                    <arc:UpgradePromptPlan.Limits>
                        <arc:UpgradePromptLimit Label="Seats" Value="25" />
                        <arc:UpgradePromptLimit Label="AI credits" Value="10,000 a month" />
                        <arc:UpgradePromptLimit Label="Audit log" Value="1 year" />
                    </arc:UpgradePromptPlan.Limits>
                </arc:UpgradePromptPlan>
            </arc:UpgradePrompt.Plan>
        </arc:UpgradePrompt>
    </Border>
</UserControl>
