<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.NowPlayingHostDrivenDemo">
    <!-- Your own queue (a podcast with three episodes) and your own controls. The buttons below call the player's methods;
         the log shows the events a real audio element would follow: PlayingChanged (play or pause it), IndexChanged (load
         the episode), SeekRequested (set its position) and ExpandedChanged. "Jump to 10:00" sets CurrentTime, the way
         real audio reports its position. -->
    <StackPanel Spacing="18" Height="560">
        <Grid Height="430">
            <arc:NowPlaying x:Name="Player"
                            Label="Podcast player"
                            IsExpanded="True"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IndexChanged="OnIndexChanged"
                            PlayingChanged="OnPlayingChanged"
                            SeekRequested="OnSeekRequested"
                            ExpandedChanged="OnExpandedChanged" />
        </Grid>
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="8" LineSpacing="8">
            <arc:Button Content="Play / pause" Variant="Secondary" Size="Small" Click="OnToggle" />
            <arc:Button Content="Next episode" Variant="Secondary" Size="Small" Click="OnNext" />
            <arc:Button Content="Jump to 10:00" Variant="Secondary" Size="Small" Click="OnJump" />
            <arc:Button Content="Open / fold" Variant="Secondary" Size="Small" Click="OnFold" />
        </WrapPanel>
        <TextBlock x:Name="Log"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Text="Play an episode, skip or scrub to see the events."
                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
    </StackPanel>
</UserControl>
