<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.VoiceOrbLevelsDemo">
    <!-- Your app owns the state and the levels: pick a state and drag the sliders (a stand-in for a microphone meter and
         a speech synthesizer's envelope). Input counts while listening, output while speaking; muted ignores the input. -->
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="32" HorizontalAlignment="Center" MaxWidth="640">
        <arc:VoiceOrb x:Name="Orb" Size="208" State="Listening" InputLevel="0.3" OutputLevel="0.3" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="16" VerticalAlignment="Center" MinWidth="240">
            <arc:SegmentedControl x:Name="State" SelectedValue="listening" SelectionChanged="OnStateChanged">
                <arc:SegmentedOption Value="idle" Label="Idle" />
                <arc:SegmentedOption Value="listening" Label="Listening" />
                <arc:SegmentedOption Value="thinking" Label="Thinking" />
                <arc:SegmentedOption Value="speaking" Label="Speaking" />
            </arc:SegmentedControl>
            <arc:Slider Label="Input level" Minimum="0" Maximum="1" SmallChange="0.05" Value="{Binding #Orb.InputLevel, Mode=TwoWay}" />
            <arc:Slider Label="Output level" Minimum="0" Maximum="1" SmallChange="0.05" Value="{Binding #Orb.OutputLevel, Mode=TwoWay}" />
            <arc:Switch Content="Microphone muted" IsChecked="{Binding #Orb.IsMuted, Mode=TwoWay}" />
        </StackPanel>
    </Grid>
</UserControl>
