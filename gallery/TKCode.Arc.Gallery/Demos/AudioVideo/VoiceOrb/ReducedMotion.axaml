<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.VoiceOrbReducedMotionDemo">
    <!-- Under reduced motion the conversation runs as usual, but the orb shows one still frame per state, words and turns
         fade in 120 ms without rising or blurring, and the call bar swaps its groups with a short fade. -->
    <StackPanel arc:ArcMotion.Level="Reduced" Spacing="14" MaxWidth="480">
        <arc:VoiceOrb x:Name="Orb" Size="200" />
        <arc:VoiceTranscript x:Name="Transcript" />
        <arc:VoiceControls x:Name="Controls" />
    </StackPanel>
</UserControl>
