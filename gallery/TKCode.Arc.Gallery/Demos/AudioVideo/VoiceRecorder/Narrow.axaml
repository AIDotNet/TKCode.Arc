<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.VoiceRecorderNarrowDemo">
    <!-- A phone-width column: Plain drops the card's border, corners and fill. The bubbles' bars narrow, the bar takes what
         the trash and the send button leave, and the review shows fewer bars rather than cutting them off. -->
    <Border Width="300"
            Height="420"
            HorizontalAlignment="Center"
            BorderBrush="{arc:ArcDesignTokenResource Border}"
            BorderThickness="1"
            CornerRadius="26"
            ClipToBounds="True">
        <arc:VoiceRecorder x:Name="Recorder"
                           Variant="Plain"
                           Label="{x:Static arc:VoiceRecorderSamples.ThreadLabel}" />
    </Border>
</UserControl>
