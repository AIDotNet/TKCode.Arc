<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.AvatarPhotosDemo">
    <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
        <arc:Avatar DisplayName="Mia Chen" Size="Large" Source="https://i.pravatar.cc/160?img=47" />
        <arc:Avatar DisplayName="Noah Park" Size="Large" Source="https://i.pravatar.cc/160?img=12" />
        <arc:Avatar DisplayName="Broken Link" Size="Large" Source="https://invalid.example/avatar.png" />
    </WrapPanel>
</UserControl>
