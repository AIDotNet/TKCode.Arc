<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.AvatarSizesDemo">
    <WrapPanel HorizontalAlignment="Center" ItemSpacing="16" LineSpacing="16">
        <arc:Avatar DisplayName="Ada Lovelace" Size="Small" Status="Online" />
        <arc:Avatar DisplayName="Grace Hopper" Size="Medium" Status="Online" />
        <arc:Avatar DisplayName="Alan Turing" Size="Large" Status="Busy" />
        <arc:Avatar DisplayName="Mary Jackson" Size="LargePlus" Status="Away" />
        <arc:Avatar DisplayName="Katherine Johnson" Size="XLarge" Status="Online" />
    </WrapPanel>
</UserControl>
