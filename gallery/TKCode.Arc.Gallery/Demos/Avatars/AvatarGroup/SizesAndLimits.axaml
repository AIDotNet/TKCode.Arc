<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             xmlns:generic="using:System.Collections.Generic"
             x:Class="TKCode.Arc.Gallery.Demos.AvatarGroupSizesAndLimitsDemo">
    <UserControl.Resources>
        <generic:List x:Key="Team" x:TypeArguments="arc:AvatarGroupMember">
            <arc:AvatarGroupMember DisplayName="Maya Chen" Status="Online" />
            <arc:AvatarGroupMember DisplayName="Noah Park" />
            <arc:AvatarGroupMember DisplayName="Leah Fox" Status="Offline" />
            <arc:AvatarGroupMember DisplayName="Omar Haddad" />
            <arc:AvatarGroupMember DisplayName="Ines Duarte" />
            <arc:AvatarGroupMember DisplayName="Kenji Sato" />
        </generic:List>
    </UserControl.Resources>
    <StackPanel Spacing="16">
        <arc:AvatarGroup ItemsSource="{StaticResource Team}" Size="Small" MaxVisibleCount="3" />
        <arc:AvatarGroup ItemsSource="{StaticResource Team}" Size="Medium" />
        <arc:AvatarGroup ItemsSource="{StaticResource Team}" Size="Large" MaxVisibleCount="5" />
    </StackPanel>
</UserControl>
