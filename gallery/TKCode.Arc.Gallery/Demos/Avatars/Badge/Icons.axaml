<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.BadgeIconsDemo">
    <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
        <arc:Badge Tone="Success" Content="Passing">
            <arc:Badge.Icon>
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Check}" Size="12" />
            </arc:Badge.Icon>
        </arc:Badge>
        <arc:Badge Tone="Info" Content="Synced">
            <arc:Badge.Icon>
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.RefreshCw}" Size="12" />
            </arc:Badge.Icon>
        </arc:Badge>
        <arc:Badge Tone="Danger" Content="Blocked">
            <arc:Badge.Icon>
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.TriangleAlert}" Size="12" />
            </arc:Badge.Icon>
        </arc:Badge>
    </WrapPanel>
</UserControl>
