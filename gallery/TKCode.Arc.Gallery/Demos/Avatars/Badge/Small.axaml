<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.BadgeSmallDemo">
    <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
        <arc:Badge Size="Small" Content="Draft" />
        <arc:Badge Size="Small" Tone="Success" Content="Live" />
        <arc:Badge Size="Small" Tone="Info" Content="Beta" />
        <arc:Badge Size="Small" Tone="Warning" Content="Degraded" />
        <arc:Badge Size="Small" Tone="Danger" Content="Failed" />
    </WrapPanel>
</UserControl>
