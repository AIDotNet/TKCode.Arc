<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.AgentBuilderWiredDemo">
    <StackPanel Margin="0,12" Spacing="12">
        <!-- Handlers stand in for a backend: the first save fails, links whose address mentions "private" fail to index. -->
        <TextBlock x:Name="Log" Opacity="0.7" TextWrapping="Wrap" Text="Change a setting, then save. The first save fails." />
        <arc:AgentBuilder x:Name="Builder" />
    </StackPanel>
</UserControl>
