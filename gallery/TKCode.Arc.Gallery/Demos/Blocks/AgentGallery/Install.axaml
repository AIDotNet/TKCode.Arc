<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.AgentGalleryInstallDemo">
    <!-- Opens on one agent. The first install fails with a message and a Retry; the next one succeeds. Prompts are reported below. -->
    <StackPanel Margin="0,12" Spacing="12">
        <arc:AgentGallery x:Name="Gallery" OpenAgentId="lit-scout" />
        <TextBlock x:Name="Log" HorizontalAlignment="Center" Opacity="0.7" Text="Install the agent or press a prompt" />
    </StackPanel>
</UserControl>
