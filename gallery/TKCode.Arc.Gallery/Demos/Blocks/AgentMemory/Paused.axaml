<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.AgentMemoryPausedDemo">
    <!-- Saved memories are off: the list is dimmed (still editable) and the captured pill gives way to a notice. -->
    <arc:AgentMemory x:Name="Memory" AssistantName="Orbit" IsSavedMemoriesEnabled="False" IsChatHistoryEnabled="False" Margin="0,12" />
</UserControl>
