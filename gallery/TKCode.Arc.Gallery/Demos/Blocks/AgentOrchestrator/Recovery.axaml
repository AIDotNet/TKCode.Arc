<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.AgentOrchestratorRecoveryDemo">
    <!-- A script in which the fact check fails and the lead gives it to another agent; played at 1.5x. -->
    <arc:AgentOrchestrator x:Name="Orchestrator" Title="Recovery run" Speed="1.5" Margin="0,12" />
</UserControl>
