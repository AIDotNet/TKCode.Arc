<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.AgentRoutinesEventsDemo">
    <StackPanel Spacing="12" Margin="0,12">
        <!-- Your backend runs the routine: this handler fails every other run to show a failed outcome. -->
        <arc:AgentRoutines x:Name="List" />
        <TextBlock x:Name="Log" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560" Opacity="0.7" />
    </StackPanel>
</UserControl>
