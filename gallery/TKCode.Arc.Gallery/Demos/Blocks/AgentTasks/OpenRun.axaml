<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.AgentTasksOpenRunDemo">
    <StackPanel Spacing="12" Margin="0,12">
        <!-- Your tasks: press a card, or Enter on it, to open its run. The chips filter by agent. -->
        <arc:AgentTasks x:Name="Board" />
        <TextBlock x:Name="Log" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560" Opacity="0.7" />
    </StackPanel>
</UserControl>
