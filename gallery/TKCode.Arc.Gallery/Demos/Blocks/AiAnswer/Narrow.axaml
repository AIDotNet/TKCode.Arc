<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.AiAnswerNarrowDemo">
    <!-- At 576 and below the source cards become one row you scroll sideways; the lit card scrolls into view. -->
    <Border Width="390" Height="640" BorderThickness="1" CornerRadius="16" ClipToBounds="True" BorderBrush="#33808080" Margin="0,12">
        <arc:AiAnswer x:Name="Answer" />
    </Border>
</UserControl>
