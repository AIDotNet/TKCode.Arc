<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.AiAnswerStaticDemo">
    <!-- No responder: only the finished answer is shown, with its sources, reasoning and cost. No box to ask another question. -->
    <Border Height="640" BorderThickness="1" CornerRadius="16" ClipToBounds="True" BorderBrush="#33808080" Margin="0,12">
        <arc:AiAnswer x:Name="Answer" Question="Which checks should block a merge during the move?" />
    </Border>
</UserControl>
