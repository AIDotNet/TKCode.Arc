<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.AiInlineEditHandlerDemo">
    <StackPanel Spacing="12" Margin="0,12">
        <!-- Your model writes the rewrite: the first request fails to show the error line, the next ones succeed. -->
        <arc:AiInlineEdit x:Name="Editor"
                          Text="Our quarterly review is scheduled for next Tuesday, and we kindly ask that every team lead prepares a short update on their goals."
                          SelectionStart="0"
                          SelectionLength="130" />
        <TextBlock x:Name="Log" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560" Opacity="0.7" />
    </StackPanel>
</UserControl>
