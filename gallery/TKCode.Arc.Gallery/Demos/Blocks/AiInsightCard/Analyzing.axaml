<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.AiInsightCardAnalyzingDemo">
    <!-- While the insight is written, a shimmering line and placeholders stand in for the text. -->
    <arc:AiInsightCard Margin="0,12" IsAnalyzing="True" />
</UserControl>
