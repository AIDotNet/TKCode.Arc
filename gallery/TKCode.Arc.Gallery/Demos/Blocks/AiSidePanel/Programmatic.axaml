<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.AiSidePanelProgrammaticDemo">
    <StackPanel Spacing="12" Margin="0,12">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <arc:Button x:Name="Shorten" Variant="Secondary" Size="Small" Content="Ask: shorten the summary" />
            <arc:Button x:Name="Toggle" Variant="Secondary" Size="Small" Content="Open / close" />
            <arc:Button x:Name="Undo" Variant="Secondary" Size="Small" Content="Undo" />
        </StackPanel>
        <Border Height="560" BorderThickness="1" CornerRadius="16" ClipToBounds="True" BorderBrush="#33808080">
            <arc:AiSidePanel x:Name="Panel" AssistantName="Helper" />
        </Border>
    </StackPanel>
</UserControl>
