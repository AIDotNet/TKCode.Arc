<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ApiKeysFailingDemo">
    <StackPanel Spacing="12" Margin="0,12">
        <arc:ApiKeys x:Name="Block"
                     Description="The first key you generate here fails, as a busy key service could; the retry goes through. Revoking Ledger sync fails too." />
        <TextBlock x:Name="Log"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="560"
                   Text="Create a key, then try again after the error." />
    </StackPanel>
</UserControl>
