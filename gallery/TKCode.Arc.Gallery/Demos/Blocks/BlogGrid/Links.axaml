<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.BlogGridLinksDemo">
    <Border BorderThickness="1"
            CornerRadius="20"
            ClipToBounds="True"
            BorderBrush="{arc:ArcDesignTokenResource Border}">
        <arc:BlogGrid x:Name="Grid" Title="Field notes" Description="Cards here open links; this demo only reports them." ShowFeatured="False" PageSize="3" />
    </Border>
</UserControl>
