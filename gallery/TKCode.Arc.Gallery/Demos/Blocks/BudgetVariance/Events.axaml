<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.BudgetVarianceEventsDemo">
    <StackPanel Spacing="12" Margin="0,12">
        <arc:BudgetVariance x:Name="Budget" SelectedPeriod="ytd" Currency="€" />
        <TextBlock x:Name="Log"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="560"
                   Text="Switch the window or open a department: the events show up here." />
    </StackPanel>
</UserControl>
