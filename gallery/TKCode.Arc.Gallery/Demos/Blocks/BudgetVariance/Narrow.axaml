<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.BudgetVarianceNarrowDemo">
    <!-- Below a 760 container each row puts its figures on top and the chart across the full width under them. -->
    <Border Width="520" Margin="0,12" HorizontalAlignment="Center">
        <arc:BudgetVariance x:Name="Budget" SelectedPeriod="month" ExpandedDepartment="sales" />
    </Border>
</UserControl>
