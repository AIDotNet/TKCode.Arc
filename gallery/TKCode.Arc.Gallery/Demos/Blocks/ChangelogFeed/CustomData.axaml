<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ChangelogFeedCustomDataDemo">
    <arc:ChangelogFeed x:Name="Feed"
                       HorizontalAlignment="Center"
                       Title="What changed"
                       Subtitle="Tidewater 2.1 shipped on March 3, 2026"
                       EndNote="That is everything since 2.0." />
</UserControl>
