<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.CohortRetentionEventsDemo">
    <!--
        The view, the segment and the cursor are two-way properties and every change is an event. Here two buttons drive
        the block from outside, and the log shows what the block reports: cursor moves, clicked cells (Enter or Space on
        the keyboard), view and segment changes.
    -->
    <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <arc:Button x:Name="Toggle" Variant="Secondary" Size="Small" Content="Switch view" />
            <arc:Button x:Name="Newest" Variant="Secondary" Size="Small" Content="Inspect the newest cohort" />
        </StackPanel>
        <arc:CohortRetention x:Name="Retention"
                             Title="Space retention"
                             Subtitle="Point at a cell, click it, or use the arrow keys."
                             FirstMetricLabel="First-month retention"
                             SecondMetricLabel="Half-year retention"
                             TotalLabel="Spaces created" />
        <TextBlock x:Name="Log"
                   TextWrapping="Wrap"
                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                   Text="Events appear here." />
    </StackPanel>
</UserControl>
