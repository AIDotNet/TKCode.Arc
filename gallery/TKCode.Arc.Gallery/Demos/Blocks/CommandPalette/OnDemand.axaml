<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.CommandPaletteOnDemandDemo">
    <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
        <arc:Button Content="Open command palette"
                    Variant="Secondary"
                    HorizontalAlignment="Center"
                    Click="OnOpenClick" />
        <TextBlock x:Name="Hint"
                   FontSize="14"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
        <TextBlock x:Name="Result"
                   Text="Nothing run yet."
                   FontSize="14"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   HorizontalAlignment="Center"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
    </StackPanel>
</UserControl>
