<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.DocumentExtractionNarrowDemo">
    <!-- In a narrow container the document sits above the form and the links are not drawn. -->
    <arc:DocumentExtraction x:Name="Extraction" Width="420" HorizontalAlignment="Left" Margin="0,12" />
</UserControl>
