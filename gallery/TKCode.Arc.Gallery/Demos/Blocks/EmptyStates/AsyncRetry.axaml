<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.EmptyStatesAsyncRetryDemo">
    <!-- One item: no tab row. The command in the code-behind retries a connection that fails the first time. -->
    <arc:EmptyStates x:Name="States" Label="Connection">
        <arc:EmptyStatesItem Scene="Offline"
                             Title="Can’t reach the server"
                             Description="Your changes are saved here and upload when the connection is back."
                             ActionLabel="Retry"
                             LoadingDescription="Connecting to api.example.com…"
                             DoneTitle="Connected"
                             DoneDescription="All changes are uploaded."
                             DoneActionLabel="Disconnect" />
    </arc:EmptyStates>
</UserControl>
