<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.EmptyStatesPreviewDemo">
    <!-- Arc's four scenes and copy (Items left empty). The code-behind plays the work each action stands for. -->
    <arc:EmptyStates x:Name="States" ActionInvoked="OnActionInvoked" />
</UserControl>
