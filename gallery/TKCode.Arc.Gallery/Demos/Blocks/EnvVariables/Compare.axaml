<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.EnvVariablesCompareDemo">
    <!-- The compare view of Staging and Production: fingerprints instead of values, and Copy to for keys one side lacks. -->
    <arc:EnvVariables x:Name="Block"
                      Margin="0,12"
                      ViewMode="Compare"
                      CompareLeft="staging"
                      CompareRight="production" />
</UserControl>
