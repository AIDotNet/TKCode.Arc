<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.EnvVariablesEventLogDemo">
    <!-- A flat block bound to its search and view, with every event it raises written below. -->
    <StackPanel Spacing="12" Margin="0,12">
        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock VerticalAlignment="Center" Text="Search (two-way):" />
            <TextBox Width="180" Text="{Binding #Block.SearchText}" />
            <TextBlock VerticalAlignment="Center" x:Name="View" />
        </StackPanel>
        <arc:EnvVariables x:Name="Block" IsFramed="False" />
        <TextBlock x:Name="Log"
                   TextWrapping="Wrap"
                   FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                   FontSize="12"
                   Text="Events appear here." />
    </StackPanel>
</UserControl>
