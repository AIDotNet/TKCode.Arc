<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.FaqSectionSearchableDemo">
    <Border CornerRadius="20" ClipToBounds="True" BorderThickness="1" BorderBrush="{arc:ArcDesignTokenResource Border}">
        <arc:FaqSection Variant="Search" Title="Questions about billing" Description="Type to filter. Matches inside a closed answer show as an excerpt." Query="refund" />
    </Border>
</UserControl>
