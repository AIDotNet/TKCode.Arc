<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.HeroSectionNarrowDemo">
    <!-- 390 wide: the block follows its own width, so the window keeps a legible size and crops evenly. -->
    <Border Width="390" HorizontalAlignment="Center" CornerRadius="20" ClipToBounds="True" BorderThickness="1" BorderBrush="{arc:ArcDesignTokenResource Border}">
        <arc:HeroSection Height="780" />
    </Border>
</UserControl>
