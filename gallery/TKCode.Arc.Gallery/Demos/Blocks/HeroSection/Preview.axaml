<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.HeroSectionPreviewDemo">
    <!-- The hero fills its frame; the switch floats over its top edge and replays the entrance. -->
    <Border CornerRadius="20" ClipToBounds="True" BorderThickness="1" BorderBrush="{arc:ArcDesignTokenResource Border}">
        <Panel>
            <arc:HeroSection x:Name="Hero" />
            <arc:SegmentedControl x:Name="Designs"
                                  AutomationProperties.Name="Hero design"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Top"
                                  Margin="0,16,0,0"
                                  SelectedValue="centered">
                <arc:SegmentedOption Value="centered" Label="Screenshot" />
                <arc:SegmentedOption Value="split" Label="Workflow" />
                <arc:SegmentedOption Value="minimal" Label="Mesh" />
            </arc:SegmentedControl>
        </Panel>
    </Border>
</UserControl>
