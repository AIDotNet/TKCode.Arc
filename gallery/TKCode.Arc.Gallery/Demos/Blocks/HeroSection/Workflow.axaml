<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.HeroSectionWorkflowDemo">
    <!-- The Split design: events run on their own while it is on screen, and Send test event runs the next one at once. -->
    <Border CornerRadius="20" ClipToBounds="True" BorderThickness="1" BorderBrush="{arc:ArcDesignTokenResource Border}">
        <arc:HeroSection Variant="Split" />
    </Border>
</UserControl>
