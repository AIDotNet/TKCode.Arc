<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.HorizonChartPreviewDemo">
    <!-- Fourteen fulfilment hubs, 119 days, against their winter forecast. Data: HorizonChartDemoData. -->
    <arc:HorizonChart x:Name="Chart"
                      Title="Orders against forecast"
                      Description="Daily orders at each fulfilment hub compared with its winter forecast, February to May 2027"
                      BaselineLabel="winter forecast" />
</UserControl>
