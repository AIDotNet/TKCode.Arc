<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.InboxSidebarRailDemo">
    <Border Height="520"
            CornerRadius="22"
            BorderThickness="1"
            ClipToBounds="True"
            BorderBrush="{arc:ArcDesignTokenResource Border}"
            Background="{arc:ArcDesignTokenResource Background}">
        <DockPanel>
            <arc:InboxSidebar DockPanel.Dock="Left" IsCollapsed="True" ResizeMode="Push" StorageTotal="0" />
            <TextBlock Margin="32" Text="Starts as the icon rail and pushes the page as it opens." TextWrapping="Wrap" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
        </DockPanel>
    </Border>
</UserControl>
