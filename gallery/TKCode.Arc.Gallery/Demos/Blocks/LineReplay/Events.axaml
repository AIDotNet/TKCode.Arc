<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.LineReplayEventsDemo">
    <!-- MomentReached fires as playback passes each moment (not when scrubbing); the buttons drive the replay from code. -->
    <StackPanel Margin="0,12" Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <arc:Button x:Name="PlayButton" Content="Replay" Variant="Secondary" Size="Small" />
            <arc:Button x:Name="NoonButton" Content="Jump to noon" Variant="Secondary" Size="Small" />
        </StackPanel>
        <TextBlock x:Name="Log" HorizontalAlignment="Center" Text="No moment reached yet" />
        <arc:LineReplay x:Name="Replay"
                        SeriesLabel="Release day"
                        BaselineLabel="Typical Wednesday"
                        ValueLabel="Active" />
    </StackPanel>
</UserControl>
