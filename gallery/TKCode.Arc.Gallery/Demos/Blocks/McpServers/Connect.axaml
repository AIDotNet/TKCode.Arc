<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.McpServersConnectDemo">
    <StackPanel Spacing="12" Margin="0,12">
        <!-- Your own connect hook: here every other attempt fails; the line below shows the last event. -->
        <arc:McpServers x:Name="Block" />
        <TextBlock x:Name="Log" Opacity="0.7" TextWrapping="Wrap" HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
