<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.MediaPlayerEventsDemo">
    <StackPanel Spacing="12" Margin="0,12" HorizontalAlignment="Center">
        <arc:MediaPlayer x:Name="Player" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <arc:Button x:Name="Previous" Variant="Secondary" Size="Small" Content="PreviousTrack()" />
            <arc:Button x:Name="Toggle" Variant="Secondary" Size="Small" Content="TogglePlay()" />
            <arc:Button x:Name="Skip" Variant="Secondary" Size="Small" Content="Seek(0:20)" />
            <arc:Button x:Name="Mute" Variant="Secondary" Size="Small" Content="ToggleMute()" />
        </StackPanel>
        <TextBlock x:Name="State" HorizontalAlignment="Center" TextAlignment="Center" />
        <TextBlock x:Name="Log" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520" />
    </StackPanel>
</UserControl>
