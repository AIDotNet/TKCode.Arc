<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.MetricExplorerEventsDemo">
    <!--
        IsOpen, SelectedMetricIndex and SelectedRangeIndex are two-way properties, and every user action is an event. The
        buttons drive the block from outside (the surface still grows out of the card); the log shows what it reports.
    -->
    <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <arc:Button x:Name="OpenTeams" Variant="Secondary" Size="Small" Content="Open weekly teams" />
            <arc:Button x:Name="Longer" Variant="Secondary" Size="Small" Content="Show 12 months" />
            <arc:Button x:Name="CloseChart" Variant="Secondary" Size="Small" Content="Close" />
        </StackPanel>
        <arc:MetricExplorer x:Name="Explorer"
                            Title="Workspace health"
                            Caption="Move over the chart, then press Escape." />
        <TextBlock x:Name="Log"
                   TextWrapping="Wrap"
                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                   Text="Events appear here." />
    </StackPanel>
</UserControl>
