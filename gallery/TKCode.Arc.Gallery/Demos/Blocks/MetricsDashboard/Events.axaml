<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.MetricsDashboardEventsDemo">
    <!-- The view state is bindable: the buttons below drive the block, and its events are logged. -->
    <StackPanel Spacing="12" Margin="0,12">
        <Border BorderThickness="1" CornerRadius="12" ClipToBounds="True"
                BorderBrush="{arc:ArcDesignTokenResource Border}">
            <arc:MetricsDashboard x:Name="Dashboard"
                                  Title="Insights"
                                  Source="northwind.dev"
                                  IsCompareEnabled="True"
                                  PrimaryListTitle="Top paths"
                                  SecondaryListTitle="Referrers"
                                  ListValueHeader="Sessions" />
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <arc:Button x:Name="NextMetric" Variant="Secondary" Size="Small" Content="Next metric" />
            <arc:Button x:Name="LongestRange" Variant="Secondary" Size="Small" Content="Longest range" />
            <arc:Button x:Name="LatestPoint" Variant="Secondary" Size="Small" Content="Inspect latest" />
            <arc:Button x:Name="ClearPoint" Variant="Ghost" Size="Small" Content="Clear" />
        </StackPanel>
        <TextBlock x:Name="Log" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560" />
    </StackPanel>
</UserControl>
