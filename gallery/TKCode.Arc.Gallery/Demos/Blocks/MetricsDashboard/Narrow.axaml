<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.MetricsDashboardNarrowDemo">
    <!-- In a 420-wide container the block picks its small layout from its own width, whatever the window's size. -->
    <Border Width="420" HorizontalAlignment="Center" BorderThickness="1" CornerRadius="12" ClipToBounds="True" Margin="0,12"
            BorderBrush="{arc:ArcDesignTokenResource Border}">
        <arc:MetricsDashboard x:Name="Dashboard"
                              Title="Insights"
                              Source="northwind.dev"
                              SelectedRange="7"
                              PrimaryListTitle="Top paths"
                              SecondaryListTitle="Referrers"
                              ListValueHeader="Sessions" />
    </Border>
</UserControl>
