<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.OtpInputNarrowDemo">
    <!-- 300 wide, as on a small phone: slots 6 apart and 44 high. Narrower still, the slots shrink to fit. -->
    <Border Width="300"
            Padding="16"
            HorizontalAlignment="Center"
            BorderThickness="1"
            CornerRadius="20"
            BorderBrush="{arc:ArcDesignTokenResource Border}"
            Background="{arc:ArcDesignTokenResource Background}">
        <arc:OtpInput Value="482" Description="Use the six digit code from your email." />
    </Border>
</UserControl>
