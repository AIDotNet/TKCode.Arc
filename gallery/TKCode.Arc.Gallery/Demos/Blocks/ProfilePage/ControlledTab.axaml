<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ProfilePageControlledTabDemo">
    <!-- The tab is bound both ways: the buttons set it, the page's own tabs and arrow keys report it. -->
    <StackPanel Spacing="12" Margin="0,12">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <arc:Button x:Name="ShowActivity" Variant="Secondary" Size="Small" Content="Show activity" />
            <arc:Button x:Name="ShowProjects" Variant="Secondary" Size="Small" Content="Show projects" />
        </StackPanel>
        <arc:ProfilePage x:Name="Page" PageHeight="620" />
        <TextBlock x:Name="Log" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560" />
    </StackPanel>
</UserControl>
