<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ProfilePageSaveErrorDemo">
    <!-- The save handler fails the first time and succeeds on the retry; the clipboard refuses the link. -->
    <StackPanel Spacing="12" Margin="0,12">
        <arc:ProfilePage x:Name="Page" PageHeight="640" />
        <TextBlock x:Name="Log" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560"
                   Text="Edit a field and save: the first try fails, the second one goes through." />
    </StackPanel>
</UserControl>
