<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.RevenueExplorerEventsDemo">
    <!--
        The range, the series, the comparison and the inspected month are two-way properties and every change is an event.
        Here three buttons drive the block from outside and the log shows what it reports.
    -->
    <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <arc:Button x:Name="Quarter" Variant="Secondary" Size="Small" Content="Show the last quarter" />
            <arc:Button x:Name="Churn" Variant="Secondary" Size="Small" Content="Toggle churn" />
            <arc:Button x:Name="Compare" Variant="Secondary" Size="Small" Content="Toggle compare" />
            <arc:Button x:Name="Inspect" Variant="Secondary" Size="Small" Content="Inspect the newest month" />
        </StackPanel>
        <arc:RevenueExplorer x:Name="Revenue" Title="Subscription revenue" />
        <TextBlock x:Name="Log"
                   TextWrapping="Wrap"
                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                   Text="Events appear here." />
    </StackPanel>
</UserControl>
