<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.RevenueGlobeSelectionDemo">
    <StackPanel Spacing="12">
        <!-- The selection is a two-way property: the app can point the camera at a city or a region, and hear about
             every change the user makes. -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <arc:Button Content="Zurich" Size="Small" Click="OnZurich" />
            <arc:Button Content="APAC" Size="Small" Click="OnApac" />
            <arc:Button Content="Reset view" Size="Small" Variant="Ghost" Click="OnReset" />
        </StackPanel>
        <arc:RevenueGlobe x:Name="Globe"
                          Title="Today's payments"
                          Description="Pick a city or a region; the card stays on the selected city."
                          DateText="Thursday, 22 October"
                          SelectionChanged="OnSelectionChanged" />
        <TextBlock x:Name="Status" Text="Nothing selected" Opacity="0.7" />
    </StackPanel>
</UserControl>
