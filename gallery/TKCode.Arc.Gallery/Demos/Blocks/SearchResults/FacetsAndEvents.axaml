<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SearchResultsFacetsAndEventsDemo">
    <StackPanel Spacing="12">
        <arc:SearchResults x:Name="Search"
                           Height="540"
                           Query="onboarding"
                           SelectedKind="Tasks"
                           Label="Search projects">
            <arc:SearchResultItem Id="plan"
                                  Title="Onboarding plan for the support team"
                                  Kind="Docs"
                                  Location="Support / Team"
                                  Meta="Updated 4d ago"
                                  Snippet="Week one covers the product tour, the ticket queue and shadowing a senior agent."
                                  Icon="{x:Static arc:ArcIcons.FileText}" />
            <arc:SearchResultItem Id="t-31"
                                  Title="Record the onboarding walkthrough"
                                  Kind="Tasks"
                                  Location="Support onboarding · Due Friday"
                                  Meta="Priya R."
                                  Snippet="A ten minute screen recording of the inbox, macros and escalation rules."
                                  Icon="{x:Static arc:ArcIcons.ListChecks}" />
            <arc:SearchResultItem Id="t-32"
                                  Title="Send laptops to the new hires"
                                  Kind="Tasks"
                                  Location="Support onboarding · Done"
                                  Meta="Jonah W."
                                  Snippet="Two laptops for the onboarding cohort starting on the 3rd."
                                  Icon="{x:Static arc:ArcIcons.ListChecks}" />
            <arc:SearchResultItem Id="t-35"
                                  Title="Review onboarding survey answers"
                                  Kind="Tasks"
                                  Location="Support onboarding · Blocked"
                                  Meta="Aiko T."
                                  Snippet="Waiting for the survey tool to export the answers."
                                  IsEnabled="False"
                                  Icon="{x:Static arc:ArcIcons.ListChecks}" />
            <arc:SearchResultItem Id="t-36"
                                  Title="Write the onboarding FAQ"
                                  Kind="Tasks"
                                  Location="Support onboarding · In progress"
                                  Meta="Samuel O."
                                  Snippet="Collect the ten questions new agents asked most in their first month."
                                  Icon="{x:Static arc:ArcIcons.ListChecks}" />
            <arc:SearchResultItem Id="chan"
                                  Title="#onboarding"
                                  Kind="Channels"
                                  Location="Chat · 14 members"
                                  Snippet="Questions from new hires and announcements for each onboarding cohort."
                                  Icon="{x:Static arc:ArcIcons.Hash}" />
        </arc:SearchResults>
        <TextBlock x:Name="Status"
                   Text="Move through the tasks with the arrow keys or the pointer, then press Enter or click."
                   FontSize="14"
                   TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
    </StackPanel>
</UserControl>
