<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SearchResultsNarrowDemo">
    <arc:SearchResults Width="380"
                       Height="520"
                       HorizontalAlignment="Center"
                       Query="invoice"
                       GroupPreviewCount="2">
        <arc:SearchResultItem Title="Invoice template"
                              Kind="Docs"
                              Location="Finance / Templates"
                              Meta="Updated 1w ago"
                              Snippet="Use this template for every customer invoice. Fill in the purchase order number before you send it."
                              Icon="{x:Static arc:ArcIcons.FileText}" />
        <arc:SearchResultItem Title="Late invoices"
                              Kind="Docs"
                              Location="Finance / Reports"
                              Meta="Updated 2d ago"
                              Snippet="Invoices more than 30 days overdue, grouped by customer and account manager."
                              Icon="{x:Static arc:ArcIcons.ChartBar}" />
        <arc:SearchResultItem Title="Invoice reminders"
                              Kind="Docs"
                              Location="Finance / Playbooks"
                              Snippet="Send the first reminder after seven days and call the customer after twenty-one."
                              Icon="{x:Static arc:ArcIcons.FileText}" />
        <arc:SearchResultItem Title="INV-1042.pdf"
                              Kind="Files"
                              Location="Customers / Brightline"
                              Meta="220 KB"
                              Icon="{x:Static arc:ArcIcons.File}" />
        <arc:SearchResultItem Title="Invoices Q2.xlsx"
                              Kind="Files"
                              Location="Finance / Exports"
                              Meta="1.1 MB"
                              Icon="{x:Static arc:ArcIcons.Table}" />
        <arc:SearchResultItem Title="Invoice totals do not match the report"
                              Kind="Issues"
                              Location="FIN-88 · Reporting"
                              Meta="Open"
                              Snippet="The monthly report rounds every invoice line, so the totals drift by a few cents."
                              Icon="{x:Static arc:ArcIcons.CircleDot}" />
        <arc:SearchResultItem Title="Automate invoice numbering"
                              Kind="Issues"
                              Location="FIN-91 · Billing"
                              Meta="Planned"
                              Icon="{x:Static arc:ArcIcons.CircleDot}" />
        <arc:SearchResultItem Title="Payroll calendar"
                              Kind="Calendars"
                              Location="Finance"
                              Icon="{x:Static arc:ArcIcons.Calendar}" />
    </arc:SearchResults>
</UserControl>
