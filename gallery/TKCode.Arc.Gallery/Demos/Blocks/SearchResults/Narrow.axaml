<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SearchResultsNarrowDemo">
    <!-- Below 560 the filters sit behind a button, in a sheet, and the results take the whole width. -->
    <arc:SearchResults Width="420"
                       Height="640"
                       HorizontalAlignment="Center"
                       Label="Search the shop"
                       Query="lamp">
        <arc:SearchResults.Filters>
            <arc:SearchValueFilter Key="kind" Title="Type">
                <arc:SearchFilterValue Value="Products" IsSelected="True" />
                <arc:SearchFilterValue Value="Guides" />
            </arc:SearchValueFilter>
            <arc:SearchValueFilter Key="room" Title="Room">
                <arc:SearchFilterValue Value="Living room" />
                <arc:SearchFilterValue Value="Office" />
                <arc:SearchFilterValue Value="Bedroom" />
            </arc:SearchValueFilter>
        </arc:SearchResults.Filters>
        <arc:SearchResultItem Title="Arc floor lamp" Kind="Products" KindLabel="Product" Location="Lighting / Floor lamps"
                              Subtitle="Brass, 160 cm"
                              Snippet="A tall lamp with a long arm that reaches over a sofa or a reading chair."
                              Caption="€189" Icon="{x:Static arc:ArcIcons.Package}" />
        <arc:SearchResultItem Title="Desk lamp, dimmable" Kind="Products" KindLabel="Product" Location="Lighting / Desk lamps"
                              Subtitle="Matt black, 45 cm"
                              Snippet="Three colour temperatures and a touch dimmer on the base."
                              Caption="€59" Icon="{x:Static arc:ArcIcons.Package}" />
        <arc:SearchResultItem Title="Table lamp with linen shade" Kind="Products" KindLabel="Product" Location="Lighting / Table lamps"
                              Subtitle="Oak, 38 cm"
                              Snippet="A soft lamp for the bedside, with a switch on the cord."
                              Caption="€79" Icon="{x:Static arc:ArcIcons.Package}" />
        <arc:SearchResultItem Title="Choosing a lamp for a small office" Kind="Guides" KindLabel="Guide" Location="Guides / Lighting"
                              Snippet="Where to put the lamp, which colour temperature to pick and how bright is bright enough."
                              Icon="{x:Static arc:ArcIcons.FileText}" />
    </arc:SearchResults>
</UserControl>
