<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SearchResultsNoResultsDemo">
    <arc:SearchResults x:Name="Search" Height="460" Label="Search the library" Query="tide">
        <arc:SearchResults.Filters>
            <arc:SearchValueFilter Key="kind" Title="Type">
                <arc:SearchFilterValue Value="Guides" IsSelected="True" />
                <arc:SearchFilterValue Value="Charts" />
            </arc:SearchValueFilter>
        </arc:SearchResults.Filters>
        <arc:SearchResultItem Title="Reading the tide table" Kind="Charts" Snippet="How to find high water for your harbour."
                              Icon="{x:Static arc:ArcIcons.File}" />
        <arc:SearchResultItem Title="Mooring in a strong tide" Kind="Charts" Snippet="Lines, fenders and the order to tie up."
                              Icon="{x:Static arc:ArcIcons.File}" />
        <arc:SearchResultItem Title="Passage planning" Kind="Guides" Snippet="Plan a day trip from start to finish."
                              Icon="{x:Static arc:ArcIcons.FileText}" />
    </arc:SearchResults>
</UserControl>
