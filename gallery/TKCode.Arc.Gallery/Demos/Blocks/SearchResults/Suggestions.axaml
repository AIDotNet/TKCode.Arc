<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SearchResultsSuggestionsDemo">
    <StackPanel Spacing="12">
        <arc:SearchResults x:Name="Search"
                           Height="560"
                           Label="Search the help center"
                           PlaceholderText="Search articles"
                           MaxRecent="4">
            <arc:SearchResultItem Title="Export your data" Kind="Articles" Location="Help center / Account"
                                  Snippet="Download every invoice, customer and payment as CSV or JSON." />
            <arc:SearchResultItem Title="Schedule a recurring export" Kind="Articles" Location="Help center / Automation"
                                  Snippet="Pick a time and a format and the export is sent to your storage bucket." />
            <arc:SearchResultItem Title="Reset your password" Kind="Articles" Location="Help center / Account"
                                  Snippet="Choose “Forgot password” on the sign-in page and follow the link in the email." />
            <arc:SearchResultItem Title="Invite a teammate" Kind="Articles" Location="Help center / Teams"
                                  Snippet="Owners and admins can invite people from the Members page." />
        </arc:SearchResults>
        <TextBlock x:Name="Status"
                   Text="The popup opens with the field. Arrow keys move through the rows, Enter or a click runs one, Escape closes it."
                   TextWrapping="Wrap"
                   FontSize="14"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
    </StackPanel>
</UserControl>
