<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SeatManagerBackendDemo">
    <!-- Handlers wired to a pretend billing service; the switch makes the next charge fail. Data: SeatManagerDemoData. -->
    <StackPanel Spacing="12" Margin="0,12">
        <arc:SeatManager x:Name="Card" />
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
            <arc:Switch x:Name="Decline" />
            <TextBlock VerticalAlignment="Center" Text="Decline the next charge" />
        </StackPanel>
        <TextBlock x:Name="Log"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="520"
                   Text="Change the seats and update. Every call to the backend is listed here." />
    </StackPanel>
</UserControl>
