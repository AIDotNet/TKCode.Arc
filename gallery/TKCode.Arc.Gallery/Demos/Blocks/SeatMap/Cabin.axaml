<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SeatMapCabinDemo">
    <!-- The same block as a cabin seen from above: rows are seat letters, numbers are cabin rows, one aisle. -->
    <arc:SeatMap x:Name="Map" MaxSelection="2" />
</UserControl>
