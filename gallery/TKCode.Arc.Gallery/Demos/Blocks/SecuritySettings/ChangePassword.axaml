<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SecuritySettingsChangePasswordDemo">
    <StackPanel Spacing="16">
        <arc:SecuritySettings x:Name="Security"
                              Sections="Password"
                              PasswordChangeRequested="OnPasswordChangeRequested" />
        <StackPanel Spacing="4">
            <TextBlock Text="The current password is &quot;correct horse&quot;. Anything else is rejected."
                       TextWrapping="Wrap"
                       FontSize="{arc:ArcDesignTokenResource TypeSM}"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
            <TextBlock x:Name="Log"
                       Text="No requests yet."
                       TextWrapping="Wrap"
                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                       Foreground="{arc:ArcDesignTokenResource TextMuted}" />
        </StackPanel>
    </StackPanel>
</UserControl>
