<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SecuritySettingsCheckupDemo">
    <!-- A new account: only a password. Each safeguard you turn on fills a segment of the meter. -->
    <arc:SecuritySettings x:Name="Security"
                          Sections="Summary, TwoStep"
                          PhoneNumber="+31 6 2045 4821"
                          AddPasskeyRequested="OnAddPasskeyRequested"
                          RecoveryCodesRequested="OnRecoveryCodesRequested" />
</UserControl>
