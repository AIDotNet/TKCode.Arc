<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SecuritySettingsOverviewDemo">
    <arc:SecuritySettings x:Name="Security"
                          IsAuthenticatorEnabled="True"
                          PhoneNumber="+31 6 2045 4821"
                          PasskeyCount="2"
                          AddPasskeyRequested="OnAddPasskeyRequested"
                          RecoveryCodesRequested="OnRecoveryCodesRequested" />
</UserControl>
