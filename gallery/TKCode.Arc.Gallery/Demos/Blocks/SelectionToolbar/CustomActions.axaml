<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SelectionToolbarCustomActionsDemo">
    <Border Height="300"
            CornerRadius="22"
            BorderThickness="1"
            ClipToBounds="True"
            BorderBrush="{arc:ArcDesignTokenResource Border}"
            Background="{arc:ArcDesignTokenResource Surface}">
        <arc:SelectionToolbar x:Name="Toolbar" TotalCount="240" ActionInvoked="OnActionInvoked">
            <arc:SelectionToolbar.Actions>
                <arc:SelectionToolbarAction Key="assign" Label="Assign" Icon="{x:Static arc:ArcIcons.User}" />
                <arc:SelectionToolbarAction Key="tag" Label="Add tag" Icon="{x:Static arc:ArcIcons.Tag}" />
                <arc:SelectionToolbarAction Key="export" Label="Export" Icon="{x:Static arc:ArcIcons.Download}" />
                <arc:SelectionToolbarAction Key="close" Label="Close tickets" Icon="{x:Static arc:ArcIcons.CircleX}" IsDestructive="True" />
            </arc:SelectionToolbar.Actions>
            <StackPanel Margin="24" Spacing="10" HorizontalAlignment="Left">
                <TextBlock Text="Set how many tickets a table has selected:" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <arc:Button Variant="Secondary" Size="Small" Content="3" Click="OnCountClick" />
                    <arc:Button Variant="Secondary" Size="Small" Content="12" Click="OnCountClick" />
                    <arc:Button Variant="Secondary" Size="Small" Content="120" Click="OnCountClick" />
                </StackPanel>
            </StackPanel>
        </arc:SelectionToolbar>
    </Border>
</UserControl>
