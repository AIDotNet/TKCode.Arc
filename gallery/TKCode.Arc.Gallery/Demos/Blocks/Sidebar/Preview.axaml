<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SidebarPreviewDemo">
    <UserControl.Styles>
        <!-- On the icon rail the header and footer keep only their leading 40px (logo, avatar); the rest fades. -->
        <Style Selector="arc|Sidebar :is(Control).rail-fade">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="arc|Sidebar:collapsed :is(Control).rail-fade">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="arc|Sidebar:motion-full :is(Control).rail-fade">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="TextBlock.stat-value">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXL}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="arc|Button.panel-toggle">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="IsPressScaleEnabled" Value="False" />
        </Style>
    </UserControl.Styles>
    <!-- The framed app window: the sidebar and the page side by side. The docs page puts it on a stage. -->
    <Border Height="580"
            CornerRadius="22"
            BorderThickness="1"
            ClipToBounds="True"
            BorderBrush="{arc:ArcDesignTokenResource Border}"
            Background="{arc:ArcDesignTokenResource Background}">
        <DockPanel>
            <arc:Sidebar x:Name="Nav"
                         DockPanel.Dock="Left"
                         IsCollapseButtonVisible="False"
                         ResizeMode="Overlay"
                         SelectedKey="home">
                <arc:Sidebar.Header>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,0,0,0">
                        <Border Width="28"
                                Height="28"
                                CornerRadius="8"
                                Background="{arc:ArcDesignTokenResource Foreground}">
                            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Sparkles}"
                                          Size="14"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{arc:ArcDesignTokenResource Background}" />
                        </Border>
                        <StackPanel Classes="rail-fade" VerticalAlignment="Center">
                            <TextBlock Text="Lumen Works"
                                       FontWeight="Medium"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
                            <TextBlock Classes="caption" Text="Brand studio" />
                        </StackPanel>
                    </StackPanel>
                </arc:Sidebar.Header>

                <arc:SidebarSection>
                    <arc:SidebarItem Key="home" Label="Home" Icon="{x:Static arc:ArcIcons.House}" />
                    <arc:SidebarItem Key="inbox" Label="Inbox" Icon="{x:Static arc:ArcIcons.Inbox}" Badge="6" />
                </arc:SidebarSection>
                <arc:SidebarSection Header="Studio">
                    <arc:SidebarItem Key="campaigns" Label="Campaigns" Icon="{x:Static arc:ArcIcons.Folder}" IsExpanded="True">
                        <arc:SidebarItem Key="campaigns/spring" Label="Spring launch" />
                        <arc:SidebarItem Key="campaigns/partner" Label="Partner kit" />
                        <arc:SidebarItem Key="campaigns/packaging" Label="Packaging 2.0" />
                    </arc:SidebarItem>
                    <arc:SidebarItem Key="calendar" Label="Calendar" Icon="{x:Static arc:ArcIcons.Calendar}" />
                    <arc:SidebarItem Key="assets" Label="Asset library" Icon="{x:Static arc:ArcIcons.Image}" />
                </arc:SidebarSection>
                <arc:SidebarSection Header="Saved">
                    <arc:SidebarItem Key="saved/brief" Label="Photo shoot brief" Icon="{x:Static arc:ArcIcons.FileText}" />
                    <arc:SidebarItem Key="saved/vendors" Label="Vendor notes" Icon="{x:Static arc:ArcIcons.MessageSquare}" />
                </arc:SidebarSection>
                <arc:SidebarSection>
                    <arc:SidebarItem Key="settings" Label="Settings" Icon="{x:Static arc:ArcIcons.Settings}" />
                </arc:SidebarSection>

                <arc:Sidebar.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,0,0,0">
                        <arc:Avatar DisplayName="Priya Nair" Size="Small" Status="Online" />
                        <StackPanel Classes="rail-fade" VerticalAlignment="Center">
                            <TextBlock Text="Priya Nair"
                                       FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
                            <TextBlock Classes="caption" Text="Art director" />
                        </StackPanel>
                    </StackPanel>
                </arc:Sidebar.Footer>
            </arc:Sidebar>

            <Grid RowDefinitions="Auto,*" RenderTransform="{Binding #Nav.PageShift}">
                <!-- The top bar: the panel toggle drives Sidebar.IsCollapsed from outside the sidebar. -->
                <Border Height="52"
                        Padding="14,0"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <arc:Button Classes="panel-toggle"
                                    Variant="Ghost"
                                    AutomationProperties.Name="Toggle sidebar"
                                    Click="OnToggleSidebar">
                            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.PanelLeft}" Size="16" StrokeThickness="1.6" />
                        </arc:Button>
                        <arc:Breadcrumb Grid.Column="1" VerticalAlignment="Center">
                            <arc:BreadcrumbItem Content="Lumen Works" />
                            <arc:BreadcrumbItem Content="Home" />
                        </arc:Breadcrumb>
                        <arc:AvatarGroup Grid.Column="2" Size="Small" Label="Collaborators">
                            <arc:AvatarGroupMember DisplayName="Priya Nair" />
                            <arc:AvatarGroupMember DisplayName="Tomas Rivera" />
                            <arc:AvatarGroupMember DisplayName="Mei Tanaka" />
                        </arc:AvatarGroup>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,28,28" Spacing="20">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding #Nav.SelectedItem.Label, FallbackValue=Home}"
                                       FontSize="{arc:ArcDesignTokenResource Type2XL}"
                                       FontWeight="Medium"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
                            <TextBlock Text="Three approvals are waiting on you before Thursday's review."
                                       TextWrapping="Wrap"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        </StackPanel>
                        <Border CornerRadius="16"
                                BorderThickness="1"
                                ClipToBounds="True"
                                BorderBrush="{arc:ArcDesignTokenResource Border}">
                            <Grid ColumnDefinitions="*,Auto,*,Auto,*">
                                <StackPanel Margin="16,14" Spacing="6">
                                    <TextBlock Classes="caption" Text="Waiting on you" />
                                    <TextBlock Classes="stat-value" Text="9" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="1" Background="{arc:ArcDesignTokenResource Border}" />
                                <StackPanel Grid.Column="2" Margin="16,14" Spacing="6">
                                    <TextBlock Classes="caption" Text="In review" />
                                    <TextBlock Classes="stat-value" Text="4" />
                                </StackPanel>
                                <Border Grid.Column="3" Width="1" Background="{arc:ArcDesignTokenResource Border}" />
                                <StackPanel Grid.Column="4" Margin="16,14" Spacing="6">
                                    <TextBlock Classes="caption" Text="Shipped this week" />
                                    <TextBlock Classes="stat-value" Text="7" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Needs your eye"
                                       FontWeight="Medium"
                                       Margin="0,0,0,10"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
                            <Border BorderThickness="0,1,0,0" BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
                                <StackPanel>
                                    <Border Padding="0,10" BorderThickness="0,0,0,1" BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
                                        <Grid ColumnDefinitions="Auto,*,Auto,72" ColumnSpacing="12">
                                            <arc:Avatar DisplayName="Tomas Rivera" Size="Small" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Retouch the hero image" Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                                <TextBlock Classes="caption" Text="Spring launch" />
                                            </StackPanel>
                                            <arc:Badge Grid.Column="2" Size="Small" Tone="Info" Content="In review" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Classes="caption" Text="Today" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border Padding="0,10" BorderThickness="0,0,0,1" BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
                                        <Grid ColumnDefinitions="Auto,*,Auto,72" ColumnSpacing="12">
                                            <arc:Avatar DisplayName="Mei Tanaka" Size="Small" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Approve the partner one-pager" Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                                <TextBlock Classes="caption" Text="Partner kit" />
                                            </StackPanel>
                                            <arc:Badge Grid.Column="2" Size="Small" Content="In progress" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Classes="caption" Text="Wed" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <Border Padding="0,10" BorderThickness="0,0,0,1" BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
                                        <Grid ColumnDefinitions="Auto,*,Auto,72" ColumnSpacing="12">
                                            <arc:Avatar DisplayName="Jonas Berg" Size="Small" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Resolve the carton print proof" Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                                <TextBlock Classes="caption" Text="Packaging 2.0" />
                                            </StackPanel>
                                            <arc:Badge Grid.Column="2" Size="Small" Tone="Warning" Content="Blocked" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Classes="caption" Text="Fri" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
