<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.TeamMembersFailuresDemo">
    <StackPanel Spacing="12" Margin="0,12">
        <arc:TeamMembers x:Name="Block" Title="Members" />
        <TextBlock x:Name="Log"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="560"
                   Text="Addresses at bounce.example fail to send, every second resend fails, Sara's invite cannot be revoked and nobody can be made an admin." />
    </StackPanel>
</UserControl>
