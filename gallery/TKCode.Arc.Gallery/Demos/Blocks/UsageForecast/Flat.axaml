<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.UsageForecastFlatDemo">
    <!-- Without a frame, in a narrow container: the block reads its own width, so the tiles stack and the chips fill their rows. -->
    <arc:UsageForecast x:Name="Forecast"
                       Width="380"
                       HorizontalAlignment="Left"
                       IsFramed="False"
                       Title="Usage outlook"
                       Subtitle="Harborline Studio · Growth plan" />
</UserControl>
