<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.UsagePricingLocalizedDemo">
    <!-- Euros with German number formats, annual billing selected, every sentence replaced (UsagePricingDemoData). -->
    <arc:UsagePricing x:Name="Pricing" Currency="EUR" BillingPeriod="Yearly" SeatIndex="4" UsageIndex="8" Margin="0,12" />
</UserControl>
