<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.WebhooksEventLogDemo">
    <StackPanel Spacing="12" Margin="0,12">
        <Border Background="{arc:ArcDesignTokenResource Surface}"
                BorderBrush="{arc:ArcDesignTokenResource Border}"
                BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
                CornerRadius="{arc:ArcDesignTokenResource RadiusStep16}"
                ClipToBounds="True">
            <arc:Webhooks x:Name="Hooks" />
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
            <arc:Button x:Name="Push" Variant="Secondary" Size="Small" Content="Push a delivery" />
            <arc:SegmentedControl x:Name="Tab" />
        </StackPanel>
        <TextBlock x:Name="Selection" HorizontalAlignment="Center" TextAlignment="Center" />
        <TextBlock x:Name="Log" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560" />
    </StackPanel>
</UserControl>
