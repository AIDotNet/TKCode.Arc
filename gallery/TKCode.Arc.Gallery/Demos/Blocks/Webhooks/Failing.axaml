<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.WebhooksFailingDemo">
    <StackPanel Spacing="12" Margin="0,12">
        <Border Background="{arc:ArcDesignTokenResource Surface}"
                BorderBrush="{arc:ArcDesignTokenResource Border}"
                BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
                CornerRadius="{arc:ArcDesignTokenResource RadiusStep16}"
                ClipToBounds="True">
            <arc:Webhooks x:Name="Hooks" />
        </Border>
        <TextBlock x:Name="Log"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   MaxWidth="560"
                   Text="The first retry times out and the next one goes through. Adding an endpoint fails once, then works." />
    </StackPanel>
</UserControl>
