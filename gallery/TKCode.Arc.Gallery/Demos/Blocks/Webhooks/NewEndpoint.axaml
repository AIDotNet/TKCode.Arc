<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.WebhooksNewEndpointDemo">
    <!-- One endpoint added a moment ago: no traffic yet. Send a test event, or add another endpoint. -->
    <Border Margin="0,12"
            Background="{arc:ArcDesignTokenResource Surface}"
            BorderBrush="{arc:ArcDesignTokenResource Border}"
            BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
            CornerRadius="{arc:ArcDesignTokenResource RadiusStep16}"
            ClipToBounds="True">
        <arc:Webhooks x:Name="Hooks" Description="Point Corvid at a URL, pick the events, then send a test to see the round trip." />
    </Border>
</UserControl>
