<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.WeekCalendarTimeZonesDemo">
    <!-- The same events, stored as instants, read in New York and in Kolkata (the corner says GMT−4 and GMT+5:30). -->
    <StackPanel Spacing="24">
        <StackPanel Spacing="10">
            <TextBlock Text="New York" FontWeight="Medium" />
            <arc:WeekCalendar x:Name="NewYork"
                              View="WorkWeek"
                              GridHeight="420"
                              IsSidebarVisible="False" />
        </StackPanel>
        <StackPanel Spacing="10">
            <TextBlock Text="Kolkata" FontWeight="Medium" />
            <arc:WeekCalendar x:Name="Kolkata"
                              View="WorkWeek"
                              GridHeight="420"
                              IsSidebarVisible="False" />
        </StackPanel>
    </StackPanel>
</UserControl>
