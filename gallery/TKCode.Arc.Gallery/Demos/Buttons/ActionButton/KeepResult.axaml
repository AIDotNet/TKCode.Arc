<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ActionButtonKeepResultDemo">
    <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
        <arc:ActionButton x:Name="Settings"
                          Label="Save settings"
                          SuccessLabel="Settings saved"
                          ResetAfter="00:00:00" />
        <arc:Button Content="Reset"
                    Variant="Ghost"
                    Size="Small"
                    Click="OnResetClick" />
    </WrapPanel>
</UserControl>
