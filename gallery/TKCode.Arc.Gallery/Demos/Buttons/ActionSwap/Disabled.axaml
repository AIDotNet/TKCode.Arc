<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ActionSwapDisabledDemo">
    <arc:ActionSwap IsEnabled="False" HorizontalAlignment="Center">
        <arc:ActionSwap.States>
            <arc:ActionSwapState Id="send" Label="Send invite" Icon="{x:Static arc:ArcIcons.Send}" />
            <arc:ActionSwapState Id="sent" Label="Sent" Icon="{x:Static arc:ArcIcons.Check}" Tone="Success" />
        </arc:ActionSwap.States>
    </arc:ActionSwap>
</UserControl>
