<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ActionSwapSpinnerDemo">
    <arc:ActionSwap x:Name="Save" HorizontalAlignment="Center">
        <arc:ActionSwap.States>
            <arc:ActionSwapState Id="idle" Label="Add to library" Icon="{x:Static arc:ArcIcons.Plus}" />
            <arc:ActionSwapState Id="added" Label="Added" Icon="{x:Static arc:ArcIcons.Check}" Tone="Success" HoldFor="0:0:2.4" />
        </arc:ActionSwap.States>
    </arc:ActionSwap>
</UserControl>
