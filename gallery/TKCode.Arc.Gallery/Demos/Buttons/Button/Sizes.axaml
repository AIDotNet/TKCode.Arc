<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ButtonSizesDemo">
    <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
        <arc:Button Content="Small" Size="Small" Variant="Secondary" />
        <arc:Button Content="Medium" Size="Medium" Variant="Secondary" />
        <arc:Button Content="Large" Size="Large" Variant="Secondary" />
    </WrapPanel>
</UserControl>
