<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ButtonGroupCollapsingLabelsDemo">
    <StackPanel Spacing="12">
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:Button Content="Narrow"
                        Variant="Secondary"
                        Size="Small"
                        Click="OnNarrowClick" />
            <arc:Button Content="Wide"
                        Variant="Secondary"
                        Size="Small"
                        Click="OnWideClick" />
        </WrapPanel>
        <Border x:Name="Frame" Width="240" HorizontalAlignment="Left">
            <arc:ButtonGroup Label="Editing">
                <arc:ButtonGroupItem Label="Undo" Icon="{x:Static arc:ArcIcons.Undo2}" />
                <arc:ButtonGroupItem Label="Redo" Icon="{x:Static arc:ArcIcons.Redo2}" />
                <arc:ButtonGroupItem Label="Download" Icon="{x:Static arc:ArcIcons.Download}" />
                <arc:ButtonGroupItem Label="Settings" Icon="{x:Static arc:ArcIcons.Settings}" />
            </arc:ButtonGroup>
        </Border>
    </StackPanel>
</UserControl>
