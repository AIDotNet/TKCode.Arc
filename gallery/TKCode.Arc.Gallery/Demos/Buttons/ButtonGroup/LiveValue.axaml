<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ButtonGroupLiveValueDemo">
    <arc:ButtonGroup Label="Zoom" Size="Small" HorizontalAlignment="Center">
        <arc:ButtonGroupItem Label="Zoom out"
                             Icon="{x:Static arc:ArcIcons.ZoomOut}"
                             IsIconOnly="True"
                             Click="OnZoomOutClick" />
        <arc:ButtonGroupItem x:Name="ZoomValue"
                             Label="Reset zoom"
                             Value="100%"
                             Click="OnZoomResetClick" />
        <arc:ButtonGroupItem Label="Zoom in"
                             Icon="{x:Static arc:ArcIcons.ZoomIn}"
                             IsIconOnly="True"
                             Click="OnZoomInClick" />
    </arc:ButtonGroup>
</UserControl>
