<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ButtonGroupVerticalDemo">
    <arc:ButtonGroup Label="Insert"
                     Orientation="Vertical"
                     MenuLabel="More blocks"
                     HorizontalAlignment="Center">
        <arc:ButtonGroupItem Label="Image" Icon="{x:Static arc:ArcIcons.Image}" />
        <arc:ButtonGroupItem Label="Table" Icon="{x:Static arc:ArcIcons.Table}" />
        <arc:ButtonGroupItem Label="Code block" Icon="{x:Static arc:ArcIcons.Code}" />
        <arc:ButtonGroup.Menu>
            <arc:MenuSurface>
                <arc:MenuEntry Header="Divider" />
                <arc:MenuEntry Header="Callout" />
            </arc:MenuSurface>
        </arc:ButtonGroup.Menu>
    </arc:ButtonGroup>
</UserControl>
