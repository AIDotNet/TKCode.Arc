             x:Class="TKCode.Arc.Gallery.Demos.ConfirmMorphDisabledDemo">
    <arc:ConfirmMorph Label="Delete project"
                      Icon="{x:Static arc:ArcIcons.Trash2}"
                      IsEnabled="False"
                      HorizontalAlignment="Center" />
</UserControl>
