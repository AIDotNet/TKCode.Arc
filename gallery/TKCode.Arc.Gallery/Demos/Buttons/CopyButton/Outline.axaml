<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.CopyButtonOutlineDemo">
    <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
        <arc:CopyButton Value="npx arc add copy-button" />
        <arc:CopyButton Value="sk_live_51H..." Label="Copy key" />
        <arc:CopyButton Value="https://uiarc.dev" IsIconOnly="True" />
    </WrapPanel>
</UserControl>
