<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.CopyButtonPlainDemo">
    <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
        <arc:CopyButton Value="#7C5CFF" Label="Copy hex" Variant="Plain" />
        <arc:CopyButton Value="rgb(124 92 255)" Variant="Plain" IsIconOnly="True" />
    </WrapPanel>
</UserControl>
