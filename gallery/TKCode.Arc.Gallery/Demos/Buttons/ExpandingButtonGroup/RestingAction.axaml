<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ExpandingButtonGroupRestingActionDemo">
    <arc:ExpandingButtonGroup Label="Card actions"
                              DefaultExpandedItem="{Binding #Comment}"
                              HorizontalAlignment="Center">
        <arc:ExpandingButtonGroupItem Label="Like"
                                      Icon="{x:Static arc:ArcIcons.Heart}"
                                      DoneLabel="Liked" />
        <arc:ExpandingButtonGroupItem x:Name="Comment"
                                      Label="Comment"
                                      Icon="{x:Static arc:ArcIcons.MessageCircle}" />
        <arc:ExpandingButtonGroupItem x:Name="Publish"
                                      Label="Publish"
                                      Icon="{x:Static arc:ArcIcons.Upload}"
                                      DoneLabel="Published" />
    </arc:ExpandingButtonGroup>
</UserControl>
