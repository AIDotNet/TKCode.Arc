<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.IconMorphChevronAndMomentsDemo">
    <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
        <StackPanel Spacing="6">
            <arc:Button Width="44"
                        Height="44"
                        Padding="0"
                        Variant="Ghost"
                        AutomationProperties.Name="Expand"
                        Tag="Collapse"
                        Click="OnToggleClick">
                <arc:IconMorph Kind="Chevron" />
            </arc:Button>
            <TextBlock Text="Chevron"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Foreground="{arc:ArcDesignTokenResource TextMuted}" />
        </StackPanel>
        <StackPanel Spacing="6">
            <arc:Button Width="44"
                        Height="44"
                        Padding="0"
                        Variant="Ghost"
                        AutomationProperties.Name="Expand"
                        Tag="Collapse"
                        Click="OnToggleClick">
                <arc:IconMorph Kind="Chevron" ChevronPointing="Right" ChevronTurn="90" />
            </arc:Button>
            <TextBlock Text="Chevron"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Foreground="{arc:ArcDesignTokenResource TextMuted}" />
        </StackPanel>
        <StackPanel Spacing="6">
            <arc:Button Width="52"
                        Height="52"
                        Padding="0"
                        Variant="Ghost"
                        AutomationProperties.Name="Like"
                        Tag="Unlike"
                        Click="OnToggleClick">
                <arc:IconMorph Kind="Heart" IconSize="32" />
            </arc:Button>
            <TextBlock Text="Heart"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Foreground="{arc:ArcDesignTokenResource TextMuted}" />
        </StackPanel>
        <StackPanel Spacing="6">
            <arc:Button Width="52"
                        Height="52"
                        Padding="0"
                        Variant="Ghost"
                        AutomationProperties.Name="Turn notifications on"
                        Tag="Turn notifications off"
                        Click="OnToggleClick">
                <arc:IconMorph Kind="Bell" IconSize="32" />
            </arc:Button>
            <TextBlock Text="Bell"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Foreground="{arc:ArcDesignTokenResource TextMuted}" />
        </StackPanel>
    </WrapPanel>
</UserControl>
