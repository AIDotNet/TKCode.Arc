<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SplitButtonDisabledDemo">
    <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
        <arc:SplitButton Label="Deploy" IsEnabled="False">
            <arc:MenuEntry Header="Deploy to staging" />
        </arc:SplitButton>
        <arc:SplitButton Label="Publish" Variant="Secondary" IsEnabled="False">
            <arc:MenuEntry Header="Publish later" />
        </arc:SplitButton>
    </WrapPanel>
</UserControl>
