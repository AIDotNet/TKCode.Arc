<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SplitButtonSecondaryDemo">
    <arc:SplitButton x:Name="Export"
                     Variant="Secondary"
                     Label="Export as CSV"
                     Icon="{x:Static arc:ArcIcons.Download}"
                     HorizontalAlignment="Center"
                     ItemClicked="OnItemClicked">
        <arc:MenuEntry Header="Export as JSON" />
        <arc:MenuEntry Header="Export as PDF" />
        <arc:MenuEntry Header="Schedule export…"
                       Icon="{x:Static arc:ArcIcons.Clock}"
                       HasSeparatorBefore="True" />
    </arc:SplitButton>
</UserControl>
