<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.EmptyStateFirstUseDemo">
    <StackPanel Spacing="12">
        <Border CornerRadius="26"
                BorderThickness="1"
                Background="{arc:ArcDesignTokenResource Surface}"
                BorderBrush="{arc:ArcDesignTokenResource Border}">
            <arc:EmptyState x:Name="Empty"
                            Label="Projects"
                            Title="No projects yet"
                            Description="Projects keep your files, people and conversations in one place.">
                <arc:EmptyState.Action>
                    <arc:Button x:Name="Create"
                                Content="New project"
                                Variant="Primary"
                                Click="OnCreateClick" />
                </arc:EmptyState.Action>
            </arc:EmptyState>
        </Border>
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:Button Content="Reset" Variant="Ghost" Click="OnResetClick" />
        </WrapPanel>
    </StackPanel>
</UserControl>
