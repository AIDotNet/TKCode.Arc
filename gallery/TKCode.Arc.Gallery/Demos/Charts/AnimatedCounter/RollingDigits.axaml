<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.AnimatedCounterRollingDigitsDemo">
    <StackPanel Spacing="20">
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:AnimatedCounter x:Name="Revenue" Label="Revenue" Value="48250" Prefix="$" />
            <arc:AnimatedCounter x:Name="Users" Label="Active users" Value="999" />
            <arc:AnimatedCounter x:Name="Rate" Label="Conversion" Value="3.42" Decimals="2" Suffix="%" />
        </WrapPanel>
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:Button Content="Increase" Variant="Secondary" Click="OnIncreaseClick" />
            <arc:Button Content="Decrease" Variant="Secondary" Click="OnDecreaseClick" />
        </WrapPanel>
    </StackPanel>
</UserControl>
