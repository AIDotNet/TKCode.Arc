<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.BarChartWeekAndMonthDemo">
    <StackPanel Spacing="16">
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:Button Content="Week" Variant="Secondary" Size="Small" Click="OnWeekClick" />
            <arc:Button Content="Month" Variant="Secondary" Size="Small" Click="OnMonthClick" />
        </WrapPanel>
        <arc:BarChart x:Name="Chart" Label="Active minutes" Unit="min" CategoryLabel="Day" />
    </StackPanel>
</UserControl>
