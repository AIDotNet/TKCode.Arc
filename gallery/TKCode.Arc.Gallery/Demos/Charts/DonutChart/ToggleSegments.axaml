<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.DonutChartToggleSegmentsDemo">
    <StackPanel Spacing="16">
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:Button Content="This month" Variant="Secondary" Size="Small" Click="OnMonthClick" />
            <arc:Button Content="This quarter" Variant="Secondary" Size="Small" Click="OnQuarterClick" />
        </WrapPanel>
        <arc:DonutChart x:Name="Chart" Label="Visits by source" Unit="visits" />
    </StackPanel>
</UserControl>
