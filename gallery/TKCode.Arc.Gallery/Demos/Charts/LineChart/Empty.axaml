<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.LineChartEmptyDemo">
    <arc:LineChart Label="Refunds" EmptyLabel="No refunds in this range" PlotHeight="160">
        <arc:LineChart.Series>
            <arc:ChartSeries Name="Refunds" />
        </arc:LineChart.Series>
    </arc:LineChart>
</UserControl>
