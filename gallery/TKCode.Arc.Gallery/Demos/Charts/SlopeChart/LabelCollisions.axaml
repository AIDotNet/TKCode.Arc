<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SlopeChartLabelCollisionsDemo">
    <arc:SlopeChart Label="Close values"
                    StartLabel="2023"
                    EndLabel="2024"
                    IsRankVisible="False"
                    MaxWidth="420"
                    HorizontalAlignment="Left">
        <arc:SlopeChart.Items>
            <arc:SlopeItem Key="a" Label="Alpha" Start="10" End="12" />
            <arc:SlopeItem Key="b" Label="Beta" Start="10.2" End="12.1" />
            <arc:SlopeItem Key="c" Label="Gamma" Start="10.4" End="8" />
            <arc:SlopeItem Key="d" Label="Delta with a long name" Start="10.5" End="12.2" />
        </arc:SlopeChart.Items>
    </arc:SlopeChart>
</UserControl>
