<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.WaffleChartEnergyMixDemo">
    <StackPanel Spacing="16">
        <arc:WaffleChart x:Name="Chart"
                         Label="Electricity generation"
                         Unit="TWh"
                         ActiveKeyChanged="OnActiveKeyChanged" />
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:Button Content="2015" Variant="Secondary" Click="On2015Click" />
            <arc:Button Content="2023" Variant="Secondary" Click="On2023Click" />
        </WrapPanel>
        <TextBlock x:Name="Pinned"
                   Text="Pinned: none"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
    </StackPanel>
</UserControl>
