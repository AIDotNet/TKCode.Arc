<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ArcWindowCaptionButtonsDemo">
    <StackPanel HorizontalAlignment="Center" Width="560" Spacing="16">
        <StackPanel Spacing="6">
            <TextBlock Text="Drawn: the bar draws minimize, maximize and close" FontSize="12" Opacity="0.7" />
            <Border BorderBrush="{arc:ArcDesignTokenResource Border}" BorderThickness="1"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}">
                <Border CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}" ClipToBounds="True">
                <arc:TitleBar Title="Drawn" CaptionButtons="Drawn" />
                </Border>
            </Border>
        </StackPanel>
        <StackPanel Spacing="6">
            <TextBlock Text="System: room for the macOS traffic lights" FontSize="12" Opacity="0.7" />
            <Border BorderBrush="{arc:ArcDesignTokenResource Border}" BorderThickness="1"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}">
                <Border CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}" ClipToBounds="True">
                <arc:TitleBar Title="System" CaptionButtons="System" />
                </Border>
            </Border>
        </StackPanel>
        <StackPanel Spacing="6">
            <TextBlock Text="None: no caption buttons" FontSize="12" Opacity="0.7" />
            <Border BorderBrush="{arc:ArcDesignTokenResource Border}" BorderThickness="1"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}">
                <Border CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}" ClipToBounds="True">
                <arc:TitleBar Title="None" CaptionButtons="None" />
                </Border>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
