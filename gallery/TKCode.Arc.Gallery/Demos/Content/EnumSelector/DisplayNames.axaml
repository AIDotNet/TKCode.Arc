<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.EnumSelectorDisplayNamesDemo">
    <StackPanel Spacing="16" Width="360" HorizontalAlignment="Center">
        <arc:Switch x:Name="Names" IsChecked="True" Content="Show descriptions" />
        <arc:EnumSelector Header="Shipping"
                          EnumType="{x:Type demos:DemoShipping}"
                          SelectedEnum="{x:Static demos:DemoShipping.Express}"
                          UseDisplayNames="{Binding #Names.IsChecked}" />
    </StackPanel>
</UserControl>
