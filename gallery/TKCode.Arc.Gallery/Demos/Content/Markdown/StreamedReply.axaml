<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.MarkdownStreamedReplyDemo">
    <StackPanel Spacing="12">
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:Button x:Name="StreamButton"
                        Content="Stream reply"
                        Variant="Primary"
                        Size="Small"
                        Click="OnStreamClick" />
            <arc:Button Content="Reset"
                        Variant="Secondary"
                        Size="Small"
                        Click="OnResetClick" />
            <TextBlock x:Name="Status"
                       Text="Idle"
                       FontSize="13"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{arc:ArcDesignTokenResource TextMuted}" />
        </WrapPanel>
        <arc:Markdown x:Name="Message" />
    </StackPanel>
</UserControl>
