<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.NumberFilterBoxActiveDemo">
    <StackPanel HorizontalAlignment="Center" Spacing="8" Grid.IsSharedSizeScope="True">
        <arc:NumberFilterBox Label="Price"
                             LabelSizeGroup="Label"
                             Operator="LessThanOrEqual"
                             Value="1000" />
        <arc:NumberFilterBox Label="Stock"
                             LabelSizeGroup="Label"
                             Description="Off: the operator and the value are kept."
                             IsActive="False"
                             NumberMode="Integer"
                             Operator="GreaterThan"
                             Value="10" />
    </StackPanel>
</UserControl>
