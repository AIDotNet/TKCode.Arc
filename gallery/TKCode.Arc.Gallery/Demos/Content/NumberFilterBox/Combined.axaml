<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.NumberFilterBoxCombinedDemo">
    <StackPanel HorizontalAlignment="Stretch" MaxWidth="560" Spacing="8" Grid.IsSharedSizeScope="True">
        <arc:NumberFilterBox x:Name="PriceFilter"
                             Label="Price"
                             LabelSizeGroup="Label"
                             Operator="LessThanOrEqual"
                             Value="1000" />
        <arc:TextFilterBox x:Name="NameFilter"
                           Label="Name"
                           LabelSizeGroup="Label"
                           Placeholder="Type a product name"
                           Text="Pro" />
        <arc:NumberFilterBox x:Name="StockFilter"
                             Label="Stock"
                             LabelSizeGroup="Label"
                             IsActive="False"
                             NumberMode="Integer"
                             Operator="GreaterThan"
                             Value="10" />
        <TextBlock x:Name="Count" Margin="0,8,0,0" FontWeight="SemiBold" />
        <ItemsControl x:Name="Results">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" Margin="0,2" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
