<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.TextFilterBoxExtraContentDemo">
    <StackPanel HorizontalAlignment="Stretch" MaxWidth="600" Spacing="8">
        <arc:TextFilterBox x:Name="FileFilter"
                           Label="File name"
                           Operator="EndsWith"
                           Text=".axaml">
            <arc:TextFilterBox.ExtraContent>
                <arc:Checkbox x:Name="MatchCase" Content="Match case" />
            </arc:TextFilterBox.ExtraContent>
        </arc:TextFilterBox>
        <TextBlock x:Name="Summary" FontSize="12" Opacity="0.7" />
    </StackPanel>
</UserControl>
