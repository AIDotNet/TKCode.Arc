<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.TextFilterBoxRegexDemo">
    <StackPanel HorizontalAlignment="Stretch" MaxWidth="520" Spacing="8" Grid.IsSharedSizeScope="True">
        <arc:TextFilterBox Label="Valid"
                           LabelSizeGroup="Label"
                           Operator="Regex"
                           IsCaseSensitive="True"
                           Text="^[A-Z]\w+$" />
        <arc:TextFilterBox Label="Invalid"
                           LabelSizeGroup="Label"
                           Operator="Regex"
                           Text="([a-z" />
    </StackPanel>
</UserControl>
