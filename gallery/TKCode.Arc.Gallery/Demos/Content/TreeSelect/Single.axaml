<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.TreeSelectSingleDemo">
    <StackPanel HorizontalAlignment="Center" Width="340" Spacing="8">
        <arc:TreeSelect x:Name="Destination"
                        Label="Move to"
                        Placeholder="Select a folder"
                        ShowFullPath="True" />
        <TextBlock x:Name="Result" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
