<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.GravityWellPreviewDemo">
    <!-- A moodboard of 42 photos in 7 columns. Move over it, click to send a shockwave, or Tab in and use the arrows. -->
    <Border MaxWidth="600"
            Padding="20"
            BorderThickness="1"
            ClipToBounds="True"
            Background="{arc:ArcDesignTokenResource Surface}"
            BorderBrush="{arc:ArcDesignTokenResource Border}"
            CornerRadius="{arc:ArcDesignTokenResource RadiusSurface}">
        <arc:GravityWell Label="Studio moodboard"
                         Columns="7"
                         Cursor="Cross"
                         ItemsSource="{x:Static demos:GravityWellDemoData.Photos}">
            <arc:GravityWell.ItemTemplate>
                <DataTemplate x:DataType="arc:ImageSource">
                    <arc:ArcImage Source="{Binding}" Stretch="UniformToFill" />
                </DataTemplate>
            </arc:GravityWell.ItemTemplate>
        </arc:GravityWell>
    </Border>
</UserControl>
