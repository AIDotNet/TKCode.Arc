<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.InkFluidPreviewDemo">
    <!-- Stir the ink with the pointer; leave it alone and a slow stir takes over after a moment. -->
    <arc:InkFluid MinHeight="440"
                  MaxWidth="760"
                  BorderThickness="1"
                  Background="{arc:ArcDesignTokenResource Surface}"
                  BorderBrush="{arc:ArcDesignTokenResource Border}"
                  CornerRadius="{arc:ArcDesignTokenResource RadiusSurface}">
        <StackPanel Spacing="12" MaxWidth="460" Margin="24,48" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Calm until you move"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       FontFamily="{arc:ArcDesignTokenResource DisplayFontFamily}"
                       FontSize="{arc:ArcDesignTokenResource Type4XL}"
                       FontWeight="Medium"
                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
            <TextBlock Text="Every stroke leaves a trail of ink that drifts, curls and settles back to quiet."
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,12,0,0">
                <arc:Button Content="Start building" />
                <arc:Button Content="See examples" Variant="Ghost" />
            </StackPanel>
        </StackPanel>
    </arc:InkFluid>
</UserControl>
