<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SplitBarCompactDemo">
    <!-- No heading, no sum: a slim bar with its legend, colors set per part. -->
    <arc:SplitBar IsSumVisible="False" ShowsPercent="True" MaxWidth="420">
        <arc:SplitBarSegment Label="Passed" Value="412" Brush="{arc:ArcDesignTokenResource Success}" />
        <arc:SplitBarSegment Label="Skipped" Value="23" Brush="{arc:ArcDesignTokenResource Warning}" />
        <arc:SplitBarSegment Label="Failed" Value="9" Brush="{arc:ArcDesignTokenResource Danger}" />
    </arc:SplitBar>
</UserControl>
