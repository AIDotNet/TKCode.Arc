<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SplitBarLiveSharesDemo">
    <StackPanel Spacing="16" MaxWidth="560">
        <arc:SplitBar x:Name="Bar" Title="Monthly budget" ValuePrefix="$" SegmentInvoked="OnSegmentInvoked" />
        <WrapPanel ItemSpacing="12" LineSpacing="12">
            <arc:Button Content="Shuffle amounts" Variant="Secondary" Size="Small" Click="OnShuffle" />
            <arc:Button x:Name="ToggleButton" Content="Add travel" Variant="Secondary" Size="Small" Click="OnToggle" />
        </WrapPanel>
        <TextBlock x:Name="Log"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Text="Click a part, or focus the bar and press Enter."
                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
    </StackPanel>
</UserControl>
