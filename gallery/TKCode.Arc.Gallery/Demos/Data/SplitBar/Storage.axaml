<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SplitBarStorageDemo">
    <arc:SplitBar Title="Storage" Total="256" ValueDecimals="1" ValueSuffix=" GB" RemainderLabel="Free" MaxWidth="560">
        <arc:SplitBarSegment Label="Photos" Value="82.4" />
        <arc:SplitBarSegment Label="Apps" Value="46.1" />
        <arc:SplitBarSegment Label="Documents" Value="21.7" />
        <arc:SplitBarSegment Label="System" Value="18.3" />
    </arc:SplitBar>
</UserControl>
