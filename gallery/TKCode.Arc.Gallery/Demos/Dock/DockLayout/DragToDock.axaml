<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.DockLayoutDragToDockDemo">
    <!-- Drag a tab along its strip to reorder it, or away from the strip to dock it: the compass shows over the group under
         the pointer, the edge buttons dock along the whole layout, and the preview shows where the pane will land. Drag the
         empty part of a strip to move the whole group. Escape cancels; Reset layout puts everything back. -->
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                       Text="Drag a tab onto the compass, an edge button or another tab strip. Press Escape to cancel." />
            <arc:Button x:Name="ResetButton" Grid.Column="1" Margin="12,0,0,0" Content="Reset layout" Variant="Secondary" Size="Small" />
        </Grid>
        <arc:DockLayout x:Name="Layout" Height="400" CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}">
            <arc:DockSplit Orientation="Horizontal">
                <arc:DockGroup Size="24">
                    <arc:DockPane Id="explorer" Title="Explorer" Icon="{x:Static arc:ArcIcons.Folder}" PreferredSide="Left">
                        <TextBlock Margin="14,6" Text="4 folders" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                    </arc:DockPane>
                    <arc:DockPane Id="outline" Title="Outline" Icon="{x:Static arc:ArcIcons.List}" PreferredSide="Left">
                        <TextBlock Margin="14,6" Text="No symbols" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                    </arc:DockPane>
                </arc:DockGroup>
                <arc:DockSplit Orientation="Vertical" Size="76">
                    <arc:DockDocumentArea Size="66">
                        <arc:DockGroup>
                            <arc:DockPane Id="doc:main" Title="Main.cs" Icon="{x:Static arc:ArcIcons.FileCode}">
                                <TextBlock Margin="16,8" Text="static void Main() { }" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" />
                            </arc:DockPane>
                            <arc:DockPane Id="doc:notes" Title="Notes.md" Icon="{x:Static arc:ArcIcons.FileText}">
                                <TextBlock Margin="16,8" Text="Ship the dock package" />
                            </arc:DockPane>
                            <arc:DockPane Id="doc:todo" Title="Todo.md" Icon="{x:Static arc:ArcIcons.ListTodo}">
                                <TextBlock Margin="16,8" Text="Drag me next to Main.cs" />
                            </arc:DockPane>
                        </arc:DockGroup>
                    </arc:DockDocumentArea>
                    <arc:DockGroup Size="34">
                        <arc:DockPane Id="terminal" Title="Terminal" Icon="{x:Static arc:ArcIcons.Terminal}" PreferredSide="Bottom">
                            <TextBlock Margin="16,4" Text="$ dotnet watch" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" />
                        </arc:DockPane>
                        <arc:DockPane Id="output" Title="Output" Icon="{x:Static arc:ArcIcons.ScanText}" PreferredSide="Bottom">
                            <TextBlock Margin="16,4" Text="Build succeeded" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        </arc:DockPane>
                    </arc:DockGroup>
                </arc:DockSplit>
            </arc:DockSplit>
        </arc:DockLayout>
    </DockPanel>
</UserControl>
