<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.FileDropzoneAppDrivenDemo">
    <arc:FileDropzone x:Name="Zone"
                      Label="Queue files"
                      Description="The app uploads them in its own queue"
                      MaxWidth="560"
                      FilesChanged="OnFilesChanged" />
</UserControl>
