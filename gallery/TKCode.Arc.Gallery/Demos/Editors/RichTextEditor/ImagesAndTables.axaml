<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.RichTextEditorImagesAndTablesDemo">
    <StackPanel Spacing="12" MaxWidth="680">
        <Border Padding="24,20"
                CornerRadius="26"
                BorderThickness="1"
                Background="{arc:ArcDesignTokenResource Surface}"
                BorderBrush="{arc:ArcDesignTokenResource Border}">
            <arc:RichTextEditor x:Name="Editor"
                                Profile="Docs"
                                ImageSourceRequested="OnImageSourceRequested" />
        </Border>
        <TextBlock x:Name="Log"
                   TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                   Text="Type / and choose Image or Table, paste a screenshot, or drop an image file." />
    </StackPanel>
</UserControl>
