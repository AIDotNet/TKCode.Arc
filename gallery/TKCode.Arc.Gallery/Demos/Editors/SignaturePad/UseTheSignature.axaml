<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SignaturePadUseTheSignatureDemo">
    <StackPanel Spacing="16" MaxWidth="560">
        <arc:SignaturePad x:Name="Pad"
                          Signer="Signed in the gallery"
                          FileName="gallery-signature"
                          StrokesChanged="OnStrokesChanged" />
        <TextBlock x:Name="Status"
                   Text="Draw to see the exported image."
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
        <Image x:Name="Preview"
               Height="64"
               Stretch="Uniform"
               HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
