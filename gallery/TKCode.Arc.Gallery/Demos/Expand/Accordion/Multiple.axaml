<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.AccordionMultipleDemo">
    <arc:Accordion ExpandMode="Multiple">
        <arc:AccordionItem Header="What is included in the free plan?"
                           Content="Unlimited projects, three collaborators and a week of version history. Upgrade any time to add more people and keep history for a year." />
        <arc:AccordionItem Header="Can I change plans later?"
                           Content="Yes. Plan changes apply immediately and the difference is prorated on your next invoice." />
        <arc:AccordionItem Header="How do refunds work?"
                           Content="Annual plans can be refunded within 30 days. Monthly plans can be cancelled at any time and stay active until the end of the period." />
    </arc:Accordion>
</UserControl>
