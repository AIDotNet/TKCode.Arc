<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ExpandableCardOpenByDefaultDemo">
    <arc:ExpandableCard Header="Deploy failed"
                        Description="api-gateway · 2 minutes ago"
                        IsExpanded="True">
        <TextBlock Text="Health check on /ready timed out after 30s. The previous release is still serving traffic; no action is needed until the next deploy."
                   FontSize="14"
                   TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
    </arc:ExpandableCard>
</UserControl>
