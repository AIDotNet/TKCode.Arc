<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ResizablePanelsDefaultDemo">
    <StackPanel Spacing="12">
        <Border Height="320"
                Padding="1"
                BorderThickness="1"
                CornerRadius="26"
                ClipToBounds="True"
                BorderBrush="{arc:ArcDesignTokenResource Border}">
            <arc:ResizablePanels Label="Mail layout" LayoutChanged="OnLayoutChanged">
                <arc:ResizablePanel Id="folders"
                                    Label="Folders"
                                    DefaultSize="22"
                                    MinSize="140"
                                    IsCollapsible="True">
                    <Border Padding="16" Background="{arc:ArcDesignTokenResource SurfaceMuted}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Folders"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
                            <TextBlock Text="Inbox, Drafts, Sent, Archive"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        </StackPanel>
                    </Border>
                </arc:ResizablePanel>
                <arc:ResizablePanel Id="messages"
                                    Label="Messages"
                                    DefaultSize="33"
                                    MinSize="200">
                    <Border Padding="16" Background="{arc:ArcDesignTokenResource Surface}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Messages"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
                            <TextBlock Text="42 conversations"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        </StackPanel>
                    </Border>
                </arc:ResizablePanel>
                <arc:ResizablePanel Id="reading"
                                    Label="Reading pane"
                                    DefaultSize="45"
                                    MinSize="220"
                                    IsCollapsible="True">
                    <Border Padding="16" Background="{arc:ArcDesignTokenResource Surface}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Quarterly review"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
                            <TextBlock Text="Hi team, the numbers are in and they look good. Let's walk through them on Thursday."
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        </StackPanel>
                    </Border>
                </arc:ResizablePanel>
            </arc:ResizablePanels>
        </Border>
        <TextBlock x:Name="Status"
                   Text="Drag a divider"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
    </StackPanel>
</UserControl>
