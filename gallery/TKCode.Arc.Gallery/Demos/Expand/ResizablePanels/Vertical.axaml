<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ResizablePanelsVerticalDemo">
    <Panel Height="360">
        <Border Padding="2"
                CornerRadius="26"
                ClipToBounds="True">
            <arc:ResizablePanels Label="Editor and terminal" Orientation="Vertical">
                <arc:ResizablePanel Id="editor"
                                    Label="Editor"
                                    DefaultSize="65"
                                    MinSize="120">
                    <Border Padding="16" Background="{arc:ArcDesignTokenResource Surface}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="invoice-service.ts"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
                            <TextBlock Text="export async function sendReminder(invoice: Invoice) { ... }"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        </StackPanel>
                    </Border>
                </arc:ResizablePanel>
                <arc:ResizablePanel Id="terminal"
                                    Label="Terminal"
                                    DefaultSize="35"
                                    MinSize="80"
                                    IsCollapsible="True">
                    <Border Padding="16" Background="{arc:ArcDesignTokenResource SurfaceMuted}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Terminal"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
                            <TextBlock Text="12 tests passed in 1.4 s"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        </StackPanel>
                    </Border>
                </arc:ResizablePanel>
            </arc:ResizablePanels>
        </Border>
        <!-- The outline sits over the clipped panes so their backgrounds never cover its rounded corners. -->
        <Border IsHitTestVisible="False"
                BorderThickness="1"
                CornerRadius="26"
                BorderBrush="{arc:ArcDesignTokenResource Border}" />
    </Panel>
</UserControl>
