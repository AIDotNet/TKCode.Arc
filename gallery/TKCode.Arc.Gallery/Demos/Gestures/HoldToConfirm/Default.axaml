<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.HoldToConfirmDefaultDemo">
    <StackPanel Spacing="12">
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:HoldToConfirm x:Name="Project"
                               Label="Hold to delete project"
                               ConfirmedLabel="Deleted"
                               HoldingChanged="OnHoldingChanged" />
            <arc:Button Content="Reset"
                        Variant="Ghost"
                        Size="Small"
                        Click="OnResetClick" />
        </WrapPanel>
        <TextBlock x:Name="Hint"
                   Text="Press and hold, or focus it and hold Space or Enter."
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
    </StackPanel>
</UserControl>
