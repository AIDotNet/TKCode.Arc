<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.SwipeActionsInboxDemo">
    <UserControl.Styles>
        <Style Selector="TextBlock.sender">
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="TextBlock.sender.unread">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>
    <StackPanel Width="400" HorizontalAlignment="Center" Spacing="12">
        <Grid ColumnDefinitions="*,Auto" Margin="2,0">
            <TextBlock Text="Inbox"
                       FontSize="15"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
            <TextBlock x:Name="Remaining"
                       Grid.Column="1"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{arc:ArcDesignTokenResource TextMuted}" />
        </Grid>
        <arc:SwipeActions x:Name="Inbox"
                          Label="Inbox"
                          ActionInvoked="OnActionInvoked">
            <arc:SwipeActions.LeadingActions>
                <arc:SwipeAction Label="Unread"
                                 Icon="{x:Static arc:ArcIcons.Mail}"
                                 Tone="Accent"
                                 KeepsRow="True" />
            </arc:SwipeActions.LeadingActions>
            <arc:SwipeActions.TrailingActions>
                <arc:SwipeAction Label="Archive" Icon="{x:Static arc:ArcIcons.Archive}" />
                <arc:SwipeAction Label="Delete" Icon="{x:Static arc:ArcIcons.Trash2}" Tone="Danger" />
            </arc:SwipeActions.TrailingActions>
            <arc:SwipeActions.ItemTemplate>
                <DataTemplate x:DataType="demos:SwipeActionsInboxDemo+Message">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <arc:Avatar DisplayName="{Binding Sender}"
                                    Source="{Binding Photo}"
                                    Size="Medium"
                                    VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Classes="sender"
                                           Classes.unread="{Binding IsUnread}"
                                           Text="{Binding Sender}"
                                           FontSize="13"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Time}"
                                           FontSize="12"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                            </Grid>
                            <TextBlock Text="{Binding Subject}"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
                            <TextBlock Text="{Binding Preview}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </arc:SwipeActions.ItemTemplate>
        </arc:SwipeActions>
        <TextBlock x:Name="Status"
                   Text="Swipe a message, or use its menu."
                   Margin="2,0"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
        <WrapPanel x:Name="Recovery" ItemSpacing="8" IsVisible="False">
            <arc:Button x:Name="Undo"
                        Content="Undo"
                        Variant="Ghost"
                        Size="Small"
                        IsVisible="False"
                        Click="OnUndoClick" />
            <arc:Button Content="Reset inbox"
                        Variant="Secondary"
                        Size="Small"
                        Click="OnResetClick" />
        </WrapPanel>
    </StackPanel>
</UserControl>
