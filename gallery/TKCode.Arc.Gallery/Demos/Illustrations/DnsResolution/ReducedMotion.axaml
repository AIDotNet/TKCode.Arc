<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.DnsResolutionReducedMotionDemo">
    <!-- Under reduced motion the card opens on its end; Play again and Next step still work, in place. -->
    <arc:DnsResolution arc:ArcMotion.Level="Reduced" />
</UserControl>
