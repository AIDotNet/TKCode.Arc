<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.DnsResolutionStepLogDemo">
    <StackPanel Spacing="16">
        <arc:DnsResolution x:Name="Card" AutoPlay="False" StepChanged="OnStepChanged" />
        <TextBlock x:Name="Log"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Text="Press Next step: each chapter the story enters is logged here."
                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
    </StackPanel>
</UserControl>
