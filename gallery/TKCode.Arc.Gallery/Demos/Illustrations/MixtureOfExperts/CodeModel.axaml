<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.MixtureOfExpertsCodeModelDemo">
    <!--
        Five experts of an invented code model. The first tokens bring their own gate scores; "return" and "total"
        have none, so the card derives stable example scores from their text. A capacity factor of 1.25 gives each
        expert room for three tokens at top 1.
    -->
    <arc:MixtureOfExperts MaxWidth="760"
                          TopK="1"
                          Parameters="96, 4, 7.5"
                          CapacityFactor="1.25"
                          Title="Routing in a code model">
        <arc:MixtureOfExperts.Experts>
            <arc:MixtureOfExpertsExpert Name="Keywords" Handles="Reserved words such as if, for and return." Icon="{x:Static arc:ArcIcons.Code}" />
            <arc:MixtureOfExpertsExpert Name="Names" Handles="Variables, functions and types." Icon="{x:Static arc:ArcIcons.Hash}" />
            <arc:MixtureOfExpertsExpert Name="Literals" Handles="Numbers and quoted strings." Icon="{x:Static arc:ArcIcons.Quote}" />
            <arc:MixtureOfExpertsExpert Name="Operators" Handles="Arithmetic, comparison and assignment." Icon="{x:Static arc:ArcIcons.Equal}" />
            <arc:MixtureOfExpertsExpert Name="Punctuation" Handles="Brackets, commas and semicolons." Icon="{x:Static arc:ArcIcons.Terminal}" />
        </arc:MixtureOfExperts.Experts>
        <arc:MixtureOfExpertsTokenItem Text="for" Scores="62, 12, 3, 4, 6" />
        <arc:MixtureOfExpertsTokenItem Text="(" Scores="5, 3, 2, 9, 70" />
        <arc:MixtureOfExpertsTokenItem Text="item" Scores="8, 66, 4, 3, 2" />
        <arc:MixtureOfExpertsTokenItem Text=" in" Scores="48, 21, 2, 9, 3" />
        <arc:MixtureOfExpertsTokenItem Text=" cart" Scores="4, 71, 6, 2, 3" />
        <arc:MixtureOfExpertsTokenItem Text=")" Scores="3, 2, 2, 8, 74" />
        <arc:MixtureOfExpertsTokenItem Text=" total" />
        <arc:MixtureOfExpertsTokenItem Text=" +=" Scores="3, 5, 2, 68, 9" />
        <arc:MixtureOfExpertsTokenItem Text=" 0.5" Scores="2, 6, 59, 12, 3" />
        <arc:MixtureOfExpertsTokenItem Text=";" Scores="2, 2, 3, 6, 77" />
        <arc:MixtureOfExpertsTokenItem Text=" return" />
    </arc:MixtureOfExperts>
</UserControl>
