<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.MultiRegionFailoverAutomaticFailoverDemo">
    <StackPanel Spacing="12">
        <arc:MultiRegionFailover x:Name="Failover" />
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:Button Content="0.5×" Variant="Secondary" Size="Small" Click="OnHalfSpeedClick" />
            <arc:Button Content="1×" Variant="Secondary" Size="Small" Click="OnNormalSpeedClick" />
            <arc:Button Content="2×" Variant="Secondary" Size="Small" Click="OnDoubleSpeedClick" />
            <arc:Button Content="Start over" Variant="Ghost" Size="Small" Click="OnRestartClick" />
        </WrapPanel>
    </StackPanel>
</UserControl>
