<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.PromptCacheReducedMotionDemo">
    <!-- Reduced motion opens on a finished round; play and step still work, and every change applies at once. -->
    <arc:PromptCache MaxWidth="744" arc:ArcMotion.Level="Reduced" />
</UserControl>
