<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ReasoningTreeNarrowColumnDemo">
    <!-- Under 620px of stage the tree becomes an outline; under 520px of card the header and footer tighten. -->
    <arc:ReasoningTree Width="360" HorizontalAlignment="Center" VerticalAlignment="Top" />
</UserControl>
