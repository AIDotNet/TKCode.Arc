<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SpeculativeDecodingReducedMotionDemo">
    <!-- Reduced motion: the card waits for Play; tokens then appear in place and the sweep steps a cell at a time. -->
    <arc:SpeculativeDecoding MaxWidth="720" arc:ArcMotion.Level="Reduced" />
</UserControl>
