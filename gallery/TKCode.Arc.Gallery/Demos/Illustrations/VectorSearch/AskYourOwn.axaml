<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.VectorSearchAskYourOwnDemo">
    <StackPanel Spacing="12">
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:SearchField x:Name="Question"
                             Placeholder="Ask the help centre"
                             Width="360"
                             SearchSubmitted="OnSearchSubmitted" />
            <arc:Button Content="Search"
                        Variant="Primary"
                        Size="Small"
                        Click="OnSearchClick" />
        </WrapPanel>
        <arc:VectorSearch x:Name="Search" ResultsChanged="OnResultsChanged" />
        <TextBlock x:Name="Answers"
                   Text="Try “change my password” or “invoice for last month”."
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
    </StackPanel>
</UserControl>
