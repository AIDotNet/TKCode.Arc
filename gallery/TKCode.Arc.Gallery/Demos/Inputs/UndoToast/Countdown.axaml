<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.UndoToastCountdownDemo">
    <!-- A longer window with the ring, and a quieter toast without it. Each close reports its reason. -->
    <StackPanel Spacing="16" HorizontalAlignment="Center" Margin="0,24">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <arc:Button Variant="Secondary" Size="Small" Content="Move 3 files" Click="OnMove" />
            <arc:Button Variant="Secondary" Size="Small" Content="Mark as read" Click="OnRead" />
        </StackPanel>
        <arc:UndoToast x:Name="Long" Duration="0:0:8" Closed="OnClosed" HorizontalAlignment="Center" />
        <arc:UndoToast x:Name="Quiet" IsCountdownVisible="False" Closed="OnClosed" HorizontalAlignment="Center" />
        <TextBlock x:Name="Log" HorizontalAlignment="Center" Text="Closes are listed here."
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
    </StackPanel>
</UserControl>
