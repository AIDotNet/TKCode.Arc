<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.BackToTopAttachedDemo">
    <Border MaxWidth="560"
            Padding="16,12,16,4"
            CornerRadius="26"
            BorderThickness="1"
            Background="{arc:ArcDesignTokenResource Surface}"
            BorderBrush="{arc:ArcDesignTokenResource Border}">
        <!-- Timeline is an ItemsControl whose template holds the ScrollViewer: the attached button finds it. -->
        <arc:Timeline x:Name="Feed"
                      Label="Audit log"
                      Height="340"
                      arc:BackToTop.IsAttached="True" />
    </Border>
</UserControl>
