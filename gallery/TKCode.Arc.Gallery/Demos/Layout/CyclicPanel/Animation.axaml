<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.CyclicPanelAnimationDemo">
    <UserControl.Styles>
        <Style Selector="arc|CyclicPanel > Border">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep12}" />
        </Style>
        <Style Selector="arc|CyclicPanel > Border > TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="12" MaxWidth="520">
        <arc:Switch x:Name="Animated" Content="IsAnimationEnabled" HorizontalAlignment="Center" IsChecked="True" />
        <arc:CyclicPanel x:Name="Strip"
                         Orientation="Horizontal"
                         VisibleItemCount="3"
                         Spacing="8"
                         Height="88"
                         AnimationDuration="0:0:0.6"
                         AnimationEasing="CubicEaseInOut"
                         IsAnimationEnabled="{Binding #Animated.IsChecked}">
            <Border><TextBlock Text="A" /></Border>
            <Border><TextBlock Text="B" /></Border>
            <Border><TextBlock Text="C" /></Border>
            <Border><TextBlock Text="D" /></Border>
            <Border><TextBlock Text="E" /></Border>
        </arc:CyclicPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <arc:Button x:Name="Back" Content="Back 3" Variant="Secondary" Size="Small" />
            <arc:Button x:Name="Forward" Content="Forward 1" Variant="Secondary" Size="Small" />
        </StackPanel>
    </StackPanel>
</UserControl>
