<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.CyclicPanelItemsControlDemo">
    <StackPanel Spacing="12" Width="300">
        <ItemsControl x:Name="Items" Height="240">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <arc:CyclicPanel VisibleItemCount="4" Spacing="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Border Background="{arc:ArcDesignTokenResource Surface}"
                            BorderBrush="{arc:ArcDesignTokenResource Border}"
                            BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep12}"
                            Padding="16,0">
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <arc:Button x:Name="Add" Content="Add" Variant="Secondary" Size="Small" />
            <arc:Button x:Name="Remove" Content="Remove" Variant="Secondary" Size="Small" />
        </StackPanel>
        <TextBlock x:Name="Status"
                   HorizontalAlignment="Center"
                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
    </StackPanel>
</UserControl>
