<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.CyclicPanelPreviewDemo">
    <UserControl.Styles>
        <Style Selector="arc|CyclicPanel > Border">
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep12}" />
        </Style>
        <Style Selector="arc|CyclicPanel > Border > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="12" Width="280">
        <arc:CyclicPanel x:Name="Wheel" Height="280" VisibleItemCount="5" Spacing="6">
            <Border><TextBlock Text="Item 0" /></Border>
            <Border><TextBlock Text="Item 1" /></Border>
            <Border><TextBlock Text="Item 2" /></Border>
            <Border><TextBlock Text="Item 3" /></Border>
            <Border><TextBlock Text="Item 4" /></Border>
            <Border><TextBlock Text="Item 5" /></Border>
            <Border><TextBlock Text="Item 6" /></Border>
            <Border><TextBlock Text="Item 7" /></Border>
            <Border><TextBlock Text="Item 8" /></Border>
            <Border><TextBlock Text="Item 9" /></Border>
        </arc:CyclicPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <arc:Button x:Name="Previous" Content="Previous" Variant="Secondary" Size="Small" />
            <arc:Button x:Name="Next" Content="Next" Variant="Secondary" Size="Small" />
        </StackPanel>
        <TextBlock x:Name="Indices"
                   HorizontalAlignment="Center"
                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
    </StackPanel>
</UserControl>
