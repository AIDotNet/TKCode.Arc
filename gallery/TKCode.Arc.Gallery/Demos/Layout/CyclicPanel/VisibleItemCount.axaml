<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.CyclicPanelVisibleItemCountDemo">
    <UserControl.Styles>
        <Style Selector="arc|CyclicPanel > Border">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep8}" />
        </Style>
        <Style Selector="arc|CyclicPanel > Border > TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
    </UserControl.Styles>
    <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center">
        <StackPanel Spacing="8">
            <TextBlock Text="VisibleItemCount 3" HorizontalAlignment="Center" FontSize="{arc:ArcDesignTokenResource TypeXS}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
            <arc:CyclicPanel VisibleItemCount="3" Spacing="4" Width="140" Height="240">
                <Border><TextBlock Text="00" /></Border>
                <Border><TextBlock Text="15" /></Border>
                <Border><TextBlock Text="30" /></Border>
                <Border><TextBlock Text="45" /></Border>
            </arc:CyclicPanel>
        </StackPanel>
        <StackPanel Spacing="8">
            <TextBlock Text="VisibleItemCount 7" HorizontalAlignment="Center" FontSize="{arc:ArcDesignTokenResource TypeXS}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
            <arc:CyclicPanel VisibleItemCount="7" Spacing="4" Width="140" Height="240">
                <Border><TextBlock Text="1" /></Border>
                <Border><TextBlock Text="2" /></Border>
                <Border><TextBlock Text="3" /></Border>
                <Border><TextBlock Text="4" /></Border>
                <Border><TextBlock Text="5" /></Border>
                <Border><TextBlock Text="6" /></Border>
                <Border><TextBlock Text="7" /></Border>
                <Border><TextBlock Text="8" /></Border>
                <Border><TextBlock Text="9" /></Border>
                <Border><TextBlock Text="10" /></Border>
                <Border><TextBlock Text="11" /></Border>
                <Border><TextBlock Text="12" /></Border>
            </arc:CyclicPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
