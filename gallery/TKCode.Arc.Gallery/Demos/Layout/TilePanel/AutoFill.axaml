<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.TilePanelAutoFillDemo">
    <UserControl.Styles>
        <Style Selector="arc|TilePanel > Border">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep12}" />
        </Style>
        <Style Selector="arc|TilePanel > Border > TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="16" MaxWidth="480">
        <arc:Switch x:Name="Fill" Content="IsAutoFill" HorizontalAlignment="Center" IsChecked="True" />
        <arc:TilePanel Columns="4" Rows="3" Height="260" MaxRowSpan="2" MaxColumnSpan="3"
                       IsAutoFill="{Binding #Fill.IsChecked}">
            <Border arc:TilePanel.ColumnSpan="2"><TextBlock Text="A" /></Border>
            <Border><TextBlock Text="B" /></Border>
            <Border arc:TilePanel.RowSpan="2"><TextBlock Text="C" /></Border>
            <Border><TextBlock Text="D" /></Border>
            <Border><TextBlock Text="E" /></Border>
        </arc:TilePanel>
    </StackPanel>
</UserControl>
