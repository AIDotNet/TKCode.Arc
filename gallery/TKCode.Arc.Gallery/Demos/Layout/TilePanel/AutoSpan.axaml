<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.TilePanelAutoSpanDemo">
    <UserControl.Styles>
        <!-- The items set no spans: IsAutoSpan sizes them. Colors rotate with the item's position. -->
        <Style Selector="ItemsControl > ContentPresenter:nth-child(4n+1) Border.tile">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Series1}" />
        </Style>
        <Style Selector="ItemsControl > ContentPresenter:nth-child(4n+2) Border.tile">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Series2}" />
        </Style>
        <Style Selector="ItemsControl > ContentPresenter:nth-child(4n+3) Border.tile">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Series3}" />
        </Style>
        <Style Selector="ItemsControl > ContentPresenter:nth-child(4n+4) Border.tile">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Series4}" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="12" MaxWidth="560">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <arc:Button x:Name="Shuffle" Content="New seed" Variant="Secondary" Size="Small" />
            <arc:Button x:Name="Add" Content="Add" Variant="Secondary" Size="Small" />
            <arc:Button x:Name="Remove" Content="Remove" Variant="Secondary" Size="Small" />
            <arc:Switch x:Name="Fill" Content="IsAutoFill" IsChecked="True" VerticalAlignment="Center" />
        </StackPanel>
        <ItemsControl x:Name="Tiles" Height="300">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <arc:TilePanel Columns="5" Rows="4" Spacing="8" IsAutoSpan="True" IsAutoFill="True" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="demos:AppTile">
                    <Border Classes="tile" CornerRadius="{arc:ArcDesignTokenResource RadiusStep12}" Padding="8">
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Padding="8,2"
                                CornerRadius="{arc:ArcDesignTokenResource RadiusStep8}"
                                Background="{arc:ArcDesignTokenResource Surface}">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
                        </Border>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="SeedLabel"
                   HorizontalAlignment="Center"
                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
    </StackPanel>
</UserControl>
