<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.TilePanelFixedGridDemo">
    <UserControl.Styles>
        <Style Selector="arc|TilePanel > Border">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep12}" />
        </Style>
    </UserControl.Styles>
    <!-- Four columns share the width and three rows share the 240 px height: cells are not square. -->
    <arc:TilePanel Columns="4" Rows="3" Height="240" MaxWidth="560" Spacing="6">
        <Border arc:TilePanel.ColumnSpan="2" />
        <Border arc:TilePanel.RowSpan="3" />
        <Border />
        <Border arc:TilePanel.RowSpan="2" arc:TilePanel.ColumnSpan="2" />
        <Border />
        <Border arc:TilePanel.ColumnSpan="3" />
    </arc:TilePanel>
</UserControl>
