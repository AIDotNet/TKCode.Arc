<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.TilePanelPreviewDemo">
    <UserControl.Styles>
        <Style Selector="arc|TilePanel > Border">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep12}" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="arc|TilePanel > Border > TextBlock">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        </Style>
        <Style Selector="arc|TilePanel > Border.accent">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
        </Style>
    </UserControl.Styles>
    <arc:TilePanel Columns="6" MaxWidth="560">
        <Border Classes="accent" arc:TilePanel.RowSpan="2" arc:TilePanel.ColumnSpan="2"><TextBlock Text="Revenue · 2×2" /></Border>
        <Border><TextBlock Text="1×1" /></Border>
        <Border><TextBlock Text="1×1" /></Border>
        <Border arc:TilePanel.RowSpan="2" arc:TilePanel.ColumnSpan="2"><TextBlock Text="Map · 2×2" /></Border>
        <Border arc:TilePanel.ColumnSpan="2"><TextBlock Text="Orders · 1×2" /></Border>
        <Border><TextBlock Text="1×1" /></Border>
        <Border arc:TilePanel.RowSpan="2"><TextBlock Text="2×1" /></Border>
        <Border arc:TilePanel.ColumnSpan="3"><TextBlock Text="Activity · 1×3" /></Border>
        <Border><TextBlock Text="1×1" /></Border>
        <Border arc:TilePanel.ColumnSpan="2"><TextBlock Text="1×2" /></Border>
    </arc:TilePanel>
</UserControl>
