<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.TilePanelSpanLimitsDemo">
    <UserControl.Styles>
        <Style Selector="arc|TilePanel > Border">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep12}" />
        </Style>
        <Style Selector="arc|TilePanel > Border > TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        </Style>
    </UserControl.Styles>
    <!-- Every tile asks for 3×4; MaxRowSpan and MaxColumnSpan cut that to 2×2. -->
    <arc:TilePanel Columns="5" MaxRowSpan="2" MaxColumnSpan="2" MaxWidth="480">
        <Border arc:TilePanel.RowSpan="3" arc:TilePanel.ColumnSpan="4"><TextBlock Text="asks 3×4, gets 2×2" /></Border>
        <Border arc:TilePanel.RowSpan="3" arc:TilePanel.ColumnSpan="4"><TextBlock Text="asks 3×4, gets 2×2" /></Border>
        <Border><TextBlock Text="1×1" /></Border>
        <Border><TextBlock Text="1×1" /></Border>
    </arc:TilePanel>
</UserControl>
