<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.WaterfallPanelItemSizeDemo">
    <UserControl.Styles>
        <Style Selector="arc|WaterfallPanel > Border">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep12}" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="arc|WaterfallPanel > Border > TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        </Style>
    </UserControl.Styles>
    <arc:WaterfallPanel Columns="3" MinItemSize="64" MaxItemSize="140" MaxWidth="560">
        <Border><TextBlock Text="Short note." /></Border>
        <Border><TextBlock Text="A longer card whose text wraps over several lines, so its height comes from the content and the column width." /></Border>
        <Border><TextBlock Text="Tiny." /></Border>
        <Border><TextBlock Text="This one is long enough to reach the maximum item size of 140 px. Anything past that is clipped by the card, because MaxItemSize caps the height the panel gives it and measures the content within it." /></Border>
        <Border><TextBlock Text="Medium length text that needs two or three lines." /></Border>
        <Border><TextBlock Text="OK" /></Border>
    </arc:WaterfallPanel>
</UserControl>
