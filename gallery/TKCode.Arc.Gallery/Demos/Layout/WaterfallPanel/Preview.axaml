<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.WaterfallPanelPreviewDemo">
    <UserControl.Styles>
        <!-- The cards set no height: ItemSizing="Varied" gives each one a height between MinItemSize and MaxItemSize. -->
        <Style Selector="arc|WaterfallPanel > Border">
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep12}" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style Selector="arc|WaterfallPanel > Border:nth-child(4n+1)">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Series1}" />
        </Style>
        <Style Selector="arc|WaterfallPanel > Border:nth-child(4n+2)">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Series2}" />
        </Style>
        <Style Selector="arc|WaterfallPanel > Border:nth-child(4n+3)">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Series3}" />
        </Style>
        <Style Selector="arc|WaterfallPanel > Border:nth-child(4n+4)">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Series4}" />
        </Style>
        <Style Selector="arc|WaterfallPanel > Border > Border">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep8}" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        </Style>
        <Style Selector="arc|WaterfallPanel > Border > Border > TextBlock">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer MaxHeight="380" MaxWidth="560">
        <arc:WaterfallPanel Columns="3" Spacing="10" ItemSizing="Varied" MinItemSize="80" MaxItemSize="200">
            <Border><Border><TextBlock Text="1" /></Border></Border>
            <Border><Border><TextBlock Text="2" /></Border></Border>
            <Border><Border><TextBlock Text="3" /></Border></Border>
            <Border><Border><TextBlock Text="4" /></Border></Border>
            <Border><Border><TextBlock Text="5" /></Border></Border>
            <Border><Border><TextBlock Text="6" /></Border></Border>
            <Border><Border><TextBlock Text="7" /></Border></Border>
            <Border><Border><TextBlock Text="8" /></Border></Border>
            <Border><Border><TextBlock Text="9" /></Border></Border>
            <Border><Border><TextBlock Text="10" /></Border></Border>
            <Border><Border><TextBlock Text="11" /></Border></Border>
            <Border><Border><TextBlock Text="12" /></Border></Border>
        </arc:WaterfallPanel>
    </ScrollViewer>
</UserControl>
