<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.WaterfallPanelVariedSizesDemo">
    <UserControl.Styles>
        <!-- One template for every item; the panel varies the heights. Colors rotate with the item's position. -->
        <Style Selector="ItemsControl > ContentPresenter:nth-child(4n+1) Border.swatch">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Series1}" />
        </Style>
        <Style Selector="ItemsControl > ContentPresenter:nth-child(4n+2) Border.swatch">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Series2}" />
        </Style>
        <Style Selector="ItemsControl > ContentPresenter:nth-child(4n+3) Border.swatch">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Series3}" />
        </Style>
        <Style Selector="ItemsControl > ContentPresenter:nth-child(4n+4) Border.swatch">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Series4}" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="12" MaxWidth="560">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <arc:Button x:Name="Shuffle" Content="New seed" Variant="Secondary" Size="Small" />
            <arc:Button x:Name="Add" Content="Add photo" Variant="Secondary" Size="Small" />
            <TextBlock x:Name="SeedLabel"
                       VerticalAlignment="Center"
                       FontSize="{arc:ArcDesignTokenResource TypeSM}"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
        </StackPanel>
        <ScrollViewer MaxHeight="380">
            <ItemsControl x:Name="Photos">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <arc:WaterfallPanel Columns="0" MinLaneSize="140" Spacing="10"
                                            ItemSizing="Varied" MinItemSize="120" MaxItemSize="240" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="demos:WaterfallPhoto">
                        <Border CornerRadius="{arc:ArcDesignTokenResource RadiusStep12}"
                                BorderBrush="{arc:ArcDesignTokenResource Border}"
                                BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
                                Background="{arc:ArcDesignTokenResource Surface}"
                                ClipToBounds="True">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Margin="10,8" Spacing="2">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                               FontWeight="SemiBold"
                                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                    <TextBlock Text="{Binding Place}"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                </StackPanel>
                                <Border Classes="swatch" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</UserControl>
