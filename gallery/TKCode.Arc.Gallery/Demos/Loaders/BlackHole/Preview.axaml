<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.BlackHolePreviewDemo">
    <!--
        A mailbox: select conversations (click, Space or Enter), then Delete, or press Delete / Backspace on a row.
        The rows spiral into the hole while the rest of the list bends around it; Undo spins them back out.
        BlackHoleMailbox.cs holds the card; DeleteAsync and UndoAsync show the SwallowAsync / ReleaseAsync calls.
    -->
    <demos:BlackHoleMailbox Margin="0,24" />
</UserControl>
