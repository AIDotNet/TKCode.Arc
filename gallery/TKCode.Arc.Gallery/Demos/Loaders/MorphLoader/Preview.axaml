<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.MorphLoaderPreviewDemo">
    <UserControl.Styles>
        <!-- The shape picker: a 36px track with a gliding white pill under the chosen option. -->
        <Style Selector="arc|Button.shape-option">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="arc|Button.shape-option:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="arc|Button.shape-option.chosen">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <!-- The result buttons: 36px capsules; while a result shows they fade to 45% and keep their colors. -->
        <Style Selector="arc|Button.preview-action">
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style Selector="arc|Button.preview-action:disabled">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        </Style>
    </UserControl.Styles>

    <!-- A 220px stage above one row of controls (two rows when narrow), at most 480 wide. Resolve and Reject set the
         loader's Status; after 1.7 seconds the demo sets it back to Loading and the strokes gather into the shape again.
         The shape can change at any time, also while a result shows. -->
    <Grid RowDefinitions="220,20,Auto" MaxWidth="480" Margin="0,40" VerticalAlignment="Center">
        <arc:MorphLoader x:Name="Loader"
                         Size="72"
                         Foreground="{arc:ArcDesignTokenResource Accent}">
            <arc:MorphLoader.Labels>
                <arc:MorphLoaderLabels Loading="Saving" Success="Saved" Error="Couldn't save" />
            </arc:MorphLoader.Labels>
        </arc:MorphLoader>
        <WrapPanel Grid.Row="2" ItemsAlignment="Center" ItemSpacing="10" LineSpacing="10" HorizontalAlignment="Center">
            <Border x:Name="Picker"
                    Padding="2"
                    Height="36"
                    BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
                    BorderBrush="{arc:ArcDesignTokenResource Border}"
                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                    AutomationProperties.Name="Shape">
                <Panel>
                    <arc:GlidingIndicator x:Name="Pill"
                                          Fill="{arc:ArcDesignTokenResource Surface}"
                                          Stroke="{arc:ArcDesignTokenResource Border}"
                                          StrokeThickness="1"
                                          BoxShadow="{arc:ArcDesignTokenResource ShadowResting}"
                                          CornerRadius="15" />
                    <StackPanel x:Name="Options" Orientation="Horizontal">
                        <arc:Button Classes="shape-option chosen" Variant="Ghost" Content="Dots" Tag="{x:Static arc:MorphLoaderVariant.Dots}" Click="OnShape" />
                        <arc:Button Classes="shape-option" Variant="Ghost" Content="Bars" Tag="{x:Static arc:MorphLoaderVariant.Bars}" Click="OnShape" />
                        <arc:Button Classes="shape-option" Variant="Ghost" Content="Ring" Tag="{x:Static arc:MorphLoaderVariant.Ring}" Click="OnShape" />
                        <arc:Button Classes="shape-option" Variant="Ghost" Content="Square" Tag="{x:Static arc:MorphLoaderVariant.Square}" Click="OnShape" />
                    </StackPanel>
                </Panel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <arc:Button x:Name="Resolve" Classes="preview-action" Variant="Secondary" Size="Small" Content="Resolve" Click="OnResolve" />
                <arc:Button x:Name="Reject" Classes="preview-action" Variant="Secondary" Size="Small" Content="Reject" Click="OnReject" />
            </StackPanel>
        </WrapPanel>
    </Grid>
</UserControl>
