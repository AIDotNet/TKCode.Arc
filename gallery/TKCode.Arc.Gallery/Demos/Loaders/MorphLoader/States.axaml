<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.MorphLoaderStatesDemo">
    <UserControl.Styles>
        <Style Selector="TextBlock.caption">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
    </UserControl.Styles>
    <!-- Every shape and both results at 32px. The second row turns Tone off: the check and the cross keep the text color. -->
    <Grid ColumnDefinitions="*,*,*,*,*,*" RowDefinitions="Auto,Auto,Auto" Margin="0,24" MaxWidth="560">
        <arc:MorphLoader Grid.Column="0" Size="32" Variant="Dots" />
        <arc:MorphLoader Grid.Column="1" Size="32" Variant="Bars" />
        <arc:MorphLoader Grid.Column="2" Size="32" Variant="Ring" />
        <arc:MorphLoader Grid.Column="3" Size="32" Variant="Square" />
        <arc:MorphLoader Grid.Column="4" Size="32" Status="Success" />
        <arc:MorphLoader Grid.Column="5" Size="32" Status="Error" />
        <TextBlock Grid.Row="1" Grid.Column="0" Classes="caption" Text="Dots" Margin="0,10,0,20" />
        <TextBlock Grid.Row="1" Grid.Column="1" Classes="caption" Text="Bars" Margin="0,10,0,20" />
        <TextBlock Grid.Row="1" Grid.Column="2" Classes="caption" Text="Ring" Margin="0,10,0,20" />
        <TextBlock Grid.Row="1" Grid.Column="3" Classes="caption" Text="Square" Margin="0,10,0,20" />
        <TextBlock Grid.Row="1" Grid.Column="4" Classes="caption" Text="Success" Margin="0,10,0,20" />
        <TextBlock Grid.Row="1" Grid.Column="5" Classes="caption" Text="Error" Margin="0,10,0,20" />
        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Classes="caption" VerticalAlignment="Center" Text="Tone off" />
        <arc:MorphLoader Grid.Row="2" Grid.Column="4" Size="32" Status="Success" Tone="False" />
        <arc:MorphLoader Grid.Row="2" Grid.Column="5" Size="32" Status="Error" Tone="False" />
    </Grid>
</UserControl>
