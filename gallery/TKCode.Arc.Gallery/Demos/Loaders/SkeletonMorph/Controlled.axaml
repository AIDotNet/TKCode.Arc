<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SkeletonMorphControlledDemo">
    <!-- IsLoading is two-way: the switch drives the card; Resolved reports when the last block has settled. -->
    <StackPanel Margin="16,32" Spacing="16" Width="340" HorizontalAlignment="Center">
        <arc:Switch Content="Loading" IsChecked="{Binding #Order.IsLoading, Mode=TwoWay}" />
        <arc:SkeletonMorph x:Name="Order" Classes="card" IsLoading="True" LoadingLabel="Loading order"
                           Resolved="OnResolved">
            <StackPanel Spacing="12">
                <arc:MorphBlock SkeletonWidth="120" Lines="1" LineHeight="20">
                    <TextBlock Text="Order 4127" FontSize="16" FontWeight="Medium" LineHeight="20" />
                </arc:MorphBlock>
                <arc:MorphBlock Lines="2" LineHeight="20">
                    <TextBlock FontSize="14" LineHeight="20" TextWrapping="Wrap"
                               Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                               Text="Two stoneware mugs and a linen towel, packed together. Leaves the studio on Friday." />
                </arc:MorphBlock>
                <arc:MorphBlock SkeletonWidth="112" SkeletonHeight="36" SkeletonRadius="18">
                    <arc:Button Content="Track parcel" Size="Small" Variant="Secondary" />
                </arc:MorphBlock>
            </StackPanel>
        </arc:SkeletonMorph>
        <TextBlock x:Name="Log" Text="Turn Loading off to resolve the card." TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
    </StackPanel>
</UserControl>
