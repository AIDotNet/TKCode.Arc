<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SkeletonMorphReducedMotionDemo">
    <!-- Reduced motion: the skeletons keep their opacity pulse but nothing stretches or blurs, and every block
         crossfades to its content in 120 ms at once. -->
    <StackPanel Margin="16,32" Spacing="16" Width="320" HorizontalAlignment="Center" arc:ArcMotion.Level="Reduced">
        <arc:Switch Content="Loading" IsChecked="{Binding #Weather.IsLoading, Mode=TwoWay}" />
        <arc:SkeletonMorph x:Name="Weather" Classes="card" IsLoading="True" LoadingLabel="Loading forecast">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <arc:MorphBlock IsCircle="True" SkeletonWidth="44" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="22" Background="{arc:ArcDesignTokenResource SurfaceMuted}">
                        <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Sun}" Size="22" StrokeThickness="1.75"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </arc:MorphBlock>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <arc:MorphBlock SkeletonWidth="96" Lines="1" LineHeight="24">
                        <TextBlock Text="17° Breezy" FontSize="18" FontWeight="Medium" LineHeight="24" />
                    </arc:MorphBlock>
                    <arc:MorphBlock SkeletonWidth="150" Lines="1" LineHeight="18">
                        <TextBlock Text="Harbor district, until 6 pm" FontSize="13" LineHeight="18"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                    </arc:MorphBlock>
                </StackPanel>
            </Grid>
        </arc:SkeletonMorph>
    </StackPanel>
</UserControl>
