<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.StretchRefreshErrorsDemo">
    <!-- Every other refresh fails here: the handler throws, and the line gives way to a cross and the error label.
         Labels are reworded through StretchRefreshLabels; a refresh that returns nothing shows the done label. -->
    <arc:StretchRefresh x:Name="Feed"
                        Title="Inbox"
                        Subtitle="Last checked 3 min ago"
                        Width="340"
                        Height="320"
                        Margin="0,12"
                        HorizontalAlignment="Center" />
</UserControl>
