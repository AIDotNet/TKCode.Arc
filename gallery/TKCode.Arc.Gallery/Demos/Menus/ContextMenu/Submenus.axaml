<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ContextMenuSubmenusDemo">
    <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
        <Border Width="260"
                Height="110"
                CornerRadius="18"
                BorderThickness="1"
                Background="{arc:ArcDesignTokenResource Surface}"
                BorderBrush="{arc:ArcDesignTokenResource Border}">
            <arc:ContextMenu.Menu>
                <arc:MenuSurface>
                    <arc:MenuEntry Header="New" Icon="{x:Static arc:ArcIcons.FilePlus}">
                        <arc:MenuEntry Header="Folder" Icon="{x:Static arc:ArcIcons.Folder}" />
                        <arc:MenuEntry Header="Document" Icon="{x:Static arc:ArcIcons.FileText}" />
                        <arc:MenuEntry Header="Spreadsheet" Icon="{x:Static arc:ArcIcons.Table}" />
                    </arc:MenuEntry>
                    <arc:MenuEntry Header="Sort by" Icon="{x:Static arc:ArcIcons.ArrowUpDown}">
                        <arc:MenuEntry Header="Name" ToggleType="Radio" GroupName="sort" IsChecked="True" />
                        <arc:MenuEntry Header="Date modified" ToggleType="Radio" GroupName="sort" />
                        <arc:MenuEntry Header="Size" ToggleType="Radio" GroupName="sort" />
                    </arc:MenuEntry>
                    <arc:MenuEntry Header="Refresh"
                                   Icon="{x:Static arc:ArcIcons.RefreshCw}"
                                   HasSeparatorBefore="True" />
                </arc:MenuSurface>
            </arc:ContextMenu.Menu>
            <TextBlock Text="Right-click for New and Sort by"
                       FontSize="14"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
        </Border>
    </WrapPanel>
</UserControl>
