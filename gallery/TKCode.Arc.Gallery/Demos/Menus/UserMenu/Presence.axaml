<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.UserMenuPresenceDemo">
    <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
        <arc:UserMenu DisplayName="Grace Hopper"
                      Email="grace@compiler.dev"
                      Plan="Admin"
                      IsStatusVisible="True"
                      Status="Busy"
                      IsThemeSwitchVisible="False"
                      PanelAlignment="Start">
            <arc:MenuEntry Header="Profile" Icon="{x:Static arc:ArcIcons.User}" />
            <arc:MenuEntry Header="Settings"
                           Icon="{x:Static arc:ArcIcons.Settings}"
                           InputGestureText="⌘ ," />
            <arc:MenuEntry Header="Billing" Icon="{x:Static arc:ArcIcons.CreditCard}" />
        </arc:UserMenu>
    </WrapPanel>
</UserControl>
