<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.AlertDismissDemo">
    <StackPanel Spacing="12">
        <arc:Alert x:Name="Maintenance"
                   Tone="Warning"
                   Title="Scheduled maintenance on Sunday"
                   Content="The dashboard is read-only from 02:00 to 03:00 UTC."
                   IsDismissible="True" />
        <TextBlock Text="Content below closes the gap when the alert collapses."
                   FontSize="14"
                   TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:Button Content="Show again" Variant="Ghost" Click="OnShowAgainClick" />
        </WrapPanel>
    </StackPanel>
</UserControl>
