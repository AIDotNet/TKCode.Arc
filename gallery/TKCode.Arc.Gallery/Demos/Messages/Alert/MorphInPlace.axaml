<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.AlertMorphInPlaceDemo">
    <StackPanel Spacing="16">
        <arc:Alert x:Name="Status"
                   Title="Ready to sync"
                   Content="Changes are saved on this device." />
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:Button Content="Save" Variant="Secondary" Click="OnSaveClick" />
            <arc:Button Content="Fail" Variant="Secondary" Click="OnFailClick" />
        </WrapPanel>
    </StackPanel>
</UserControl>
