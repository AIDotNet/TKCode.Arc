<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.CookieConsentConsentBarDemo">
    <StackPanel Spacing="12">
        <Border Height="520"
                CornerRadius="26"
                BorderThickness="1"
                ClipToBounds="True"
                Background="{arc:ArcDesignTokenResource Background}"
                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
            <Grid>
                <StackPanel Margin="24" Spacing="8">
                    <TextBlock Text="Acme Store"
                               FontSize="22"
                               FontWeight="Medium"
                               TextWrapping="Wrap"
                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                    <TextBlock Text="The layer lets clicks through everywhere except on the consent surface."
                               FontSize="14"
                               TextWrapping="Wrap"
                               Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                </StackPanel>
                <arc:CookieConsent x:Name="Consent"
                                   StorageKey="demo-consent"
                                   ConsentChanged="OnConsentChanged">
                    <arc:CookieConsent.Storage>
                        <arc:InMemoryMessageStorage />
                    </arc:CookieConsent.Storage>
                    <arc:CookieConsent.Policy>
                        <arc:CookieConsentPolicy Label="Cookie policy" />
                    </arc:CookieConsent.Policy>
                </arc:CookieConsent>
            </Grid>
        </Border>
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:Button Content="Cookie settings" Size="Small" Variant="Secondary" Click="OnSettingsClick" />
            <arc:Button Content="Reset" Size="Small" Variant="Secondary" Click="OnResetClick" />
            <arc:Button Content="Bottom" Size="Small" Variant="Secondary" Click="OnBottomClick" />
            <arc:Button Content="Bottom left" Size="Small" Variant="Secondary" Click="OnBottomLeftClick" />
            <arc:Button Content="Bottom right" Size="Small" Variant="Secondary" Click="OnBottomRightClick" />
        </WrapPanel>
        <TextBlock x:Name="State"
                   Text="Not decided yet."
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
    </StackPanel>
</UserControl>
