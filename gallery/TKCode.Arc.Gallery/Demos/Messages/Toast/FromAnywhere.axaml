<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ToastFromAnywhereDemo">
    <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
        <arc:Button Content="Success" Variant="Secondary" Click="OnSuccessClick" />
        <arc:Button Content="Info" Variant="Secondary" Click="OnInfoClick" />
        <arc:Button Content="Error" Variant="Secondary" Click="OnErrorClick" />
    </WrapPanel>
</UserControl>
