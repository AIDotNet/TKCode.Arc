<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:arcm="https://github.com/AIDotNet/TKCode.Arc.Mobile"
             x:Class="TKCode.Arc.Gallery.Demos.MobileNavbarLargeTitleDemo">
    <arcm:Page IsScrollable="True">
        <arcm:Page.Header>
            <arcm:Navbar Title="Photos" LargeTitle="True" />
        </arcm:Page.Header>
        <StackPanel Margin="16" Spacing="12">
            <TextBlock Text="Scroll the page: the large title collapses into the bar."
                       TextWrapping="Wrap"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
            <Border Height="120" CornerRadius="12" Background="{arc:ArcDesignTokenResource Surface}" />
            <Border Height="120" CornerRadius="12" Background="{arc:ArcDesignTokenResource Surface}" />
            <Border Height="120" CornerRadius="12" Background="{arc:ArcDesignTokenResource Surface}" />
            <Border Height="120" CornerRadius="12" Background="{arc:ArcDesignTokenResource Surface}" />
            <Border Height="120" CornerRadius="12" Background="{arc:ArcDesignTokenResource Surface}" />
            <Border Height="120" CornerRadius="12" Background="{arc:ArcDesignTokenResource Surface}" />
        </StackPanel>
    </arcm:Page>
</UserControl>
