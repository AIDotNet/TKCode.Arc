<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:arcm="https://github.com/AIDotNet/TKCode.Arc.Mobile"
             x:Class="TKCode.Arc.Gallery.Demos.MobilePageKeyboardDemo">
    <arcm:Page IsScrollable="True">
        <arcm:Page.Header>
            <arcm:Navbar Title="New contact" />
        </arcm:Page.Header>
        <StackPanel Margin="16" Spacing="12">
            <TextBlock Text="Turn on Keyboard above the phone, then tap a field."
                       TextWrapping="Wrap"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
            <arcm:TextField Watermark="First name" />
            <arcm:TextField Watermark="Last name" />
            <arcm:TextField Watermark="Company" />
            <arcm:TextField Watermark="Phone" />
            <arcm:TextField Watermark="Email" />
            <arcm:TextField Watermark="Address" />
            <arcm:TextField Watermark="Notes" />
            <arcm:Button Content="Save" />
        </StackPanel>
        <arcm:Page.Footer>
            <arcm:Tabbar SelectedIndex="0">
                <arcm:TabbarItem Content="Contacts" Icon="{x:Static arc:ArcIcons.User}" />
                <arcm:TabbarItem Content="Search" Icon="{x:Static arc:ArcIcons.Search}" />
            </arcm:Tabbar>
        </arcm:Page.Footer>
    </arcm:Page>
</UserControl>
