<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ActionMorphPreviewDemo">
    <!--
        A weekly plan with the morph in its corner. Pick an action (or press its letter), write a line and submit: the
        surface folds back into the button with a check and the entry joins the list. "Fails" makes saving throw, so the
        form stays open with the draft and an error.
    -->
    <StackPanel Spacing="16" HorizontalAlignment="Center" Width="540">
        <Border Height="440"
                Background="{arc:ArcDesignTokenResource Surface}"
                BorderBrush="{arc:ArcDesignTokenResource Border}"
                BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
                CornerRadius="{arc:ArcDesignTokenResource RadiusSurface}">
            <Panel>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="24,24,24,12" ColumnDefinitions="*,Auto">
                        <TextBlock Text="This week"
                                   FontSize="{arc:ArcDesignTokenResource Type2XL}"
                                   FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="Summary"
                                   Grid.Column="1"
                                   Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel x:Name="Entries" Margin="12,0,12,96" />
                </DockPanel>
                <arc:ActionMorph x:Name="Morph"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Margin="16">
                    <arc:ActionMorphAction Id="todo"
                                           Label="To-do"
                                           Description="Something to finish"
                                           Glyph="{x:Static arc:ArcIcons.ListTodo}"
                                           Shortcut="d"
                                           Title="New to-do"
                                           Placeholder="What needs to get done?"
                                           ChoicesLabel="When"
                                           SubmitLabel="Add to-do"
                                           SuccessLabel="To-do added"
                                           EmptyHint="Name the to-do first">
                        <arc:ActionMorphAction.Choices>
                            <x:String>Today</x:String>
                            <x:String>This week</x:String>
                            <x:String>Someday</x:String>
                        </arc:ActionMorphAction.Choices>
                    </arc:ActionMorphAction>
                    <arc:ActionMorphAction Id="note"
                                           Label="Note"
                                           Description="Only you can see it"
                                           Glyph="{x:Static arc:ArcIcons.FileText}"
                                           Shortcut="n"
                                           Title="New note"
                                           Placeholder="Jot it down"
                                           IsMultiline="True"
                                           SubmitLabel="Save note"
                                           SuccessLabel="Note saved"
                                           EmptyHint="Nothing to save yet" />
                    <arc:ActionMorphAction Id="event"
                                           Label="Event"
                                           Description="Put it on the calendar"
                                           Glyph="{x:Static arc:ArcIcons.Calendar}"
                                           Shortcut="e"
                                           Title="New event"
                                           Placeholder="What's happening?"
                                           ChoicesLabel="Starts"
                                           DefaultChoice="Noon"
                                           SubmitLabel="Add event"
                                           SuccessLabel="Event added"
                                           EmptyHint="Give the event a name">
                        <arc:ActionMorphAction.Choices>
                            <x:String>9:00 AM</x:String>
                            <x:String>Noon</x:String>
                            <x:String>6:30 PM</x:String>
                        </arc:ActionMorphAction.Choices>
                    </arc:ActionMorphAction>
                </arc:ActionMorph>
            </Panel>
        </Border>
        <arc:SegmentedControl x:Name="Outcome" SelectedValue="saves" HorizontalAlignment="Center">
            <arc:SegmentedOption Value="saves" Label="Saves" />
            <arc:SegmentedOption Value="fails" Label="Fails" />
        </arc:SegmentedControl>
    </StackPanel>
</UserControl>
