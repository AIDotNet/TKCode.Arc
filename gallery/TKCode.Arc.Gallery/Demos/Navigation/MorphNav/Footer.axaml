<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.MorphNavFooterDemo">
    <!-- Aligned left, the panel grows to the right. LinkInvoked reports the choice; Footer holds a button under the links. -->
    <Panel Height="380" MaxWidth="560">
        <TextBlock x:Name="Status" Text="Choose a link" Margin="24,96,24,0"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
        <arc:MorphNav x:Name="Nav" Title="Cinder Studio" HorizontalAlignment="Left" PanelWidth="440"
                      Margin="16,16,0,0" LinkInvoked="OnLinkInvoked">
            <arc:MorphNavSection Header="Work">
                <arc:MorphNavLink Text="Projects" />
                <arc:MorphNavLink Text="Clients" />
                <arc:MorphNavLink Text="Invoices" />
            </arc:MorphNavSection>
            <arc:MorphNavSection Header="Studio">
                <arc:MorphNavLink Text="About" />
                <arc:MorphNavLink Text="Journal" />
            </arc:MorphNavSection>
            <arc:MorphNav.Footer>
                <arc:Button Content="Book a call" Variant="Primary" HorizontalAlignment="Stretch" Click="OnBook" />
            </arc:MorphNav.Footer>
        </arc:MorphNav>
    </Panel>
</UserControl>
