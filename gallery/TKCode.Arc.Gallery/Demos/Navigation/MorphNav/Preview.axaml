<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.MorphNavPreviewDemo">
    <!-- Hover a section: the surface grows into its panel and follows you to the next one. Press search, or switch to compact. -->
    <Panel Height="560">
        <StackPanel Spacing="12" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8">
            <TextBlock x:Name="Status" Text="Point at a section, or open search from the bar" HorizontalAlignment="Center"
                       Foreground="{arc:ArcDesignTokenResource TextMuted}" />
            <arc:SegmentedControl x:Name="BarSize" HorizontalAlignment="Center" SelectedValue="full"
                                  AutomationProperties.Name="Bar height">
                <arc:SegmentedOption Value="full" Label="Full" />
                <arc:SegmentedOption Value="compact" Label="Compact" />
            </arc:SegmentedControl>
        </StackPanel>
        <arc:MorphNav x:Name="Nav" BrandName="Lantern" ActionLabel="Get started" SearchPlaceholder="Search Lantern"
                      Label="Lantern" Margin="14,14,14,0">
            <arc:MorphNav.BrandMark>
                <Border Width="26" Height="26" CornerRadius="{arc:ArcDesignTokenResource RadiusStep8}"
                        Background="{arc:ArcDesignTokenResource Foreground}">
                    <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Sparkles}" Size="15"
                                  Foreground="{arc:ArcDesignTokenResource Background}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </arc:MorphNav.BrandMark>
            <arc:MorphNavItem Value="platform" Label="Platform">
                <arc:MorphNavLink Label="Notebooks" Description="Notes, sketches and photos in one place" Icon="{x:Static arc:ArcIcons.FileText}" />
                <arc:MorphNavLink Label="Maps" Description="Pin every note to where you took it" Icon="{x:Static arc:ArcIcons.Globe}" />
                <arc:MorphNavLink Label="Timeline" Description="Walk back through trips and seasons" Icon="{x:Static arc:ArcIcons.Clock}" />
                <arc:MorphNavLink Label="Sync" Description="Works offline and catches up later" Icon="{x:Static arc:ArcIcons.RefreshCw}" />
                <arc:MorphNavLink Label="Sharing" Description="Send a trail to friends or a class" Icon="{x:Static arc:ArcIcons.Share2}" />
                <arc:MorphNavLink Label="Exports" Description="PDF, CSV and GPX in one step" Icon="{x:Static arc:ArcIcons.Download}" />
                <arc:MorphNavItem.Feature>
                    <arc:MorphNavStory Title="Lantern 3 brings tide tables" Description="Plan your walks around the water, hour by hour" />
                </arc:MorphNavItem.Feature>
                <arc:MorphNavItem.Footer>
                    <arc:MorphNavLink Label="Exports now keep your photo captions" />
                </arc:MorphNavItem.Footer>
            </arc:MorphNavItem>
            <arc:MorphNavItem Value="teams" Label="Teams">
                <arc:MorphNavLink Label="Classrooms" Description="Shared notebooks for a whole class" Icon="{x:Static arc:ArcIcons.Users}" />
                <arc:MorphNavLink Label="Birding clubs" Description="Species lists that fill in as you walk" Icon="{x:Static arc:ArcIcons.Eye}" />
                <arc:MorphNavLink Label="Research" Description="Tag, filter and cite every sighting" Icon="{x:Static arc:ArcIcons.Database}" />
                <arc:MorphNavLink Label="Hiking groups" Description="One shared map for every trip" Icon="{x:Static arc:ArcIcons.Flag}" />
                <arc:MorphNavItem.Feature>
                    <arc:MorphNavStory Title="How a river trust logged four thousand sightings" Description="Case study · 6 min read" />
                </arc:MorphNavItem.Feature>
            </arc:MorphNavItem>
            <arc:MorphNavItem Value="learn" Label="Learn">
                <arc:MorphNavLink Label="Guides" Description="Start with the basics" Icon="{x:Static arc:ArcIcons.BookOpen}" />
                <arc:MorphNavLink Label="Changelog" Description="What changed this month" Icon="{x:Static arc:ArcIcons.Sparkles}" />
                <arc:MorphNavLink Label="Community" Description="Ask other walkers" Icon="{x:Static arc:ArcIcons.MessageCircle}" />
                <arc:MorphNavLink Label="Help" Description="Talk to a person" Icon="{x:Static arc:ArcIcons.CircleHelp}" />
                <arc:MorphNavItem.Feature>
                    <arc:MorphNavStory Title="A beginner's field kit" Description="Guide · 9 min read" />
                </arc:MorphNavItem.Feature>
            </arc:MorphNavItem>
            <arc:MorphNavItem Value="pricing" Label="Pricing" />
            <arc:MorphNav.SearchEntries>
                <arc:MorphNavSearchEntry Label="Notebooks" Description="Notes, sketches and photos in one place" Group="Platform" Icon="{x:Static arc:ArcIcons.FileText}" />
                <arc:MorphNavSearchEntry Label="Maps" Description="Pin every note to where you took it" Group="Platform" Icon="{x:Static arc:ArcIcons.Globe}" />
                <arc:MorphNavSearchEntry Label="Pricing" Description="Free, Plus and Team plans" Group="Company" Icon="{x:Static arc:ArcIcons.Tag}" Keywords="plans cost billing" />
                <arc:MorphNavSearchEntry Label="Guides" Description="Start with the basics" Group="Learn" Icon="{x:Static arc:ArcIcons.BookOpen}" />
                <arc:MorphNavSearchEntry Label="Changelog" Description="What changed this month" Group="Learn" Icon="{x:Static arc:ArcIcons.Sparkles}" Keywords="release news" />
                <arc:MorphNavSearchEntry Label="Sync" Description="Works offline and catches up later" Group="Platform" Icon="{x:Static arc:ArcIcons.RefreshCw}" />
                <arc:MorphNavSearchEntry Label="Exports" Description="PDF, CSV and GPX in one step" Group="Platform" Icon="{x:Static arc:ArcIcons.Download}" />
                <arc:MorphNavSearchEntry Label="Classrooms" Description="Shared notebooks for a whole class" Group="Teams" Icon="{x:Static arc:ArcIcons.Users}" Keywords="school students" />
                <arc:MorphNavSearchEntry Label="Help" Description="Talk to a person" Group="Learn" Icon="{x:Static arc:ArcIcons.CircleHelp}" Keywords="support contact" />
                <arc:MorphNavSearchEntry Label="About Lantern" Description="The small team behind the app" Group="Company" Icon="{x:Static arc:ArcIcons.Heart}" />
            </arc:MorphNav.SearchEntries>
        </arc:MorphNav>
    </Panel>
</UserControl>
