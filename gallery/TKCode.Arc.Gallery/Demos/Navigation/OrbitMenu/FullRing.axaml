<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.OrbitMenuFullRingDemo">
    <!-- A sweep of 360 spreads the actions round a full ring; StartAngle -90 puts the first one at the top. -->
    <Panel Height="260">
        <arc:OrbitMenu Label="Reactions" Glyph="{x:Static arc:ArcIcons.SmilePlus}" StartAngle="-90" SweepAngle="360" Radius="80">
            <arc:OrbitMenuAction Glyph="{x:Static arc:ArcIcons.Heart}" Label="Love" />
            <arc:OrbitMenuAction Glyph="{x:Static arc:ArcIcons.ThumbsUp}" Label="Agree" />
            <arc:OrbitMenuAction Glyph="{x:Static arc:ArcIcons.Star}" Label="Favorite" />
            <arc:OrbitMenuAction Glyph="{x:Static arc:ArcIcons.Lightbulb}" Label="Insightful" />
            <arc:OrbitMenuAction Glyph="{x:Static arc:ArcIcons.Zap}" Label="Exciting" />
            <arc:OrbitMenuAction Glyph="{x:Static arc:ArcIcons.Flag}" Label="Report" />
        </arc:OrbitMenu>
    </Panel>
</UserControl>
