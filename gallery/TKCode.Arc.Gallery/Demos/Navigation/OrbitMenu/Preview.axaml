<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.OrbitMenuPreviewDemo">
    <!--
        A photo card with its actions behind one button. Press the button and drag toward an action, then let go to fire
        it; or click it to keep the actions open. Each action leaves a chip on the card; Start over clears them.
    -->
    <UserControl.Styles>
        <Style Selector="Panel.card-host">
            <Setter Property="arc:ArcMotion.Tracks" Value="True" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="Panel.card-host.dim">
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        <Style Selector="Panel.card-host:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                    <arc:SpringTransformOperationsTransition Property="RenderTransform" Spring="Smooth" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.chip TextBlock">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.chip arc|ArcGlyph">
            <Setter Property="Size" Value="13" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="14" MaxWidth="640">
        <Border Height="440"
                Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                BorderBrush="{arc:ArcDesignTokenResource Border}"
                BorderThickness="1"
                CornerRadius="{arc:ArcDesignTokenResource RadiusSurface}">
            <StackPanel Margin="16,24,16,0" Spacing="22" HorizontalAlignment="Center">
                <Panel x:Name="CardHost" Classes="card-host">
                    <Border x:Name="Card"
                            Width="360"
                            Background="{arc:ArcDesignTokenResource Surface}"
                            BorderBrush="{arc:ArcDesignTokenResource Border}"
                            BorderThickness="1"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                            BoxShadow="{arc:ArcDesignTokenResource ShadowRaised}"
                            ClipToBounds="True">
                        <StackPanel>
                            <Image x:Name="Photo" Height="200" Stretch="UniformToFill" />
                            <StackPanel Margin="16,14,16,16" Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Ellipse Width="28" Height="28" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                <GradientStop Color="#F6B26B" Offset="0" />
                                                <GradientStop Color="#E0567A" Offset="1" />
                                            </LinearGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="Fire lookout above Alder Lake"
                                                   FontFamily="{arc:ArcDesignTokenResource DisplayFontFamily}"
                                                   FontSize="{arc:ArcDesignTokenResource TypeBase}"
                                                   FontWeight="Medium"
                                                   Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                        <TextBlock Text="Mira Okafor, Cedar Range"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                    </StackPanel>
                                </StackPanel>
                                <WrapPanel x:Name="Chips" ItemSpacing="8" LineSpacing="8" IsVisible="False" />
                                <TextBlock x:Name="Placeholder"
                                           Text="Shot at first light · nothing done with it yet"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Panel x:Name="Deleted" Width="360" Height="200" IsVisible="False">
                        <Rectangle RadiusX="26" RadiusY="26"
                                   Stroke="{arc:ArcDesignTokenResource BorderStrong}"
                                   StrokeThickness="1"
                                   StrokeDashArray="4,3" />
                        <StackPanel Spacing="8" VerticalAlignment="Center" Margin="24,0">
                            <TextBlock Text="Photo deleted" HorizontalAlignment="Center"
                                       FontSize="{arc:ArcDesignTokenResource TypeBase}" FontWeight="Medium"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
                            <TextBlock Text="Fire lookout above Alder Lake waits in Trash for 30 days."
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                            <arc:Button x:Name="Restore" Variant="Secondary" Size="Small" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <arc:ArcGlyph Data="{x:Static arc:ArcIcons.RotateCcw}" Size="15" VerticalAlignment="Center" />
                                    <TextBlock Text="Restore photo" VerticalAlignment="Center" />
                                </StackPanel>
                            </arc:Button>
                        </StackPanel>
                    </Panel>
                </Panel>
                <arc:OrbitMenu x:Name="Menu" Label="Photo actions">
                    <arc:OrbitMenuAction x:Name="LikeAction" Glyph="{x:Static arc:ArcIcons.Heart}" Label="Like" DoneText="Liked" />
                    <arc:OrbitMenuAction x:Name="AlbumAction" Glyph="{x:Static arc:ArcIcons.Folder}" Label="Add to album" DoneText="Added to Weekend hikes" />
                    <arc:OrbitMenuAction x:Name="SendAction" Glyph="{x:Static arc:ArcIcons.Send}" Label="Send to Theo" DoneText="Sent" />
                    <arc:OrbitMenuAction x:Name="SaveAction" Glyph="{x:Static arc:ArcIcons.Download}" Label="Download" DoneText="Saved" />
                    <arc:OrbitMenuAction x:Name="DeleteAction" Glyph="{x:Static arc:ArcIcons.Trash2}" Label="Delete" DoneText="Deleted" Tone="Danger" />
                </arc:OrbitMenu>
            </StackPanel>
        </Border>
        <arc:Button x:Name="Reset" Variant="Secondary" Size="Small" HorizontalAlignment="Left" IsEnabled="False">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.RotateCcw}" Size="15" VerticalAlignment="Center" />
                <TextBlock Text="Start over" VerticalAlignment="Center" />
            </StackPanel>
        </arc:Button>
    </StackPanel>
</UserControl>
