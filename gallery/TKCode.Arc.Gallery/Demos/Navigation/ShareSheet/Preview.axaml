<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ShareSheetPreviewDemo">
    <!--
        The button opens into the panel around its center. Pick a few people and send; the switch below decides whether
        the pretend server accepts the send or fails it (the panel then stays open with an error).
    -->
    <Grid RowDefinitions="*,Auto" MinHeight="560">
        <arc:ShareSheet x:Name="Sheet"
                        Title="Spring offsite plan"
                        Link="https://harbor.example/doc/spring-offsite"
                        Access="workspace"
                        Align="Center"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
            <arc:ShareSheet.AccessLevels>
                <arc:ShareSheetAccess Value="private" Label="Private" Description="Only the people you add"
                                      Glyph="{x:Static arc:ArcIcons.Lock}" />
                <arc:ShareSheetAccess Value="workspace" Label="Harbor Studio" Description="Everyone in the workspace can comment"
                                      Glyph="{x:Static arc:ArcIcons.Users}" />
                <arc:ShareSheetAccess Value="public" Label="Public link" Description="Anyone with the link can view"
                                      Glyph="{x:Static arc:ArcIcons.Globe}" />
            </arc:ShareSheet.AccessLevels>
            <arc:ShareSheet.Channels>
                <arc:ShareSheetChannel Id="email" Label="Email" DoneLabel="Sent" Glyph="{x:Static arc:ArcIcons.Mail}" />
                <arc:ShareSheetChannel Id="chat" Label="Chat" DoneLabel="Posted" Glyph="{x:Static arc:ArcIcons.MessageCircle}" />
                <arc:ShareSheetChannel Id="feed" Label="Feed" DoneLabel="Shared" Glyph="{x:Static arc:ArcIcons.Send}" />
            </arc:ShareSheet.Channels>
            <arc:ShareSheet.People>
                <arc:ShareSheetPerson Id="lena" Name="Lena Okoro" />
                <arc:ShareSheetPerson Id="tobias" Name="Tobias Hahn" />
                <arc:ShareSheetPerson Id="priya" Name="Priya Raman" />
                <arc:ShareSheetPerson Id="mateo" Name="Mateo Silva" />
                <arc:ShareSheetPerson Id="yuki" Name="Yuki Tanaka" />
            </arc:ShareSheet.People>
        </arc:ShareSheet>
        <arc:SegmentedControl x:Name="Outcome"
                              Grid.Row="1"
                              HorizontalAlignment="Center"
                              SelectedValue="works">
            <arc:SegmentedOption Value="works" Label="Server up" />
            <arc:SegmentedOption Value="fails" Label="Server down" />
        </arc:SegmentedControl>
    </Grid>
</UserControl>
