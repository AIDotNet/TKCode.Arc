<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ShareSheetSheetDemo">
    <!-- Presentation="Sheet" always rises from the bottom, even on a wide window. Drag it down or press Escape to close it. -->
    <arc:ShareSheet Presentation="Sheet" Title="Send invite" Subtitle="Book club, Thursday 7 pm"
                    Link="https://example.com/i/book-club" HorizontalAlignment="Center">
        <arc:Button Content="Send invite" Variant="Primary" />
        <arc:ShareSheet.People>
            <arc:ShareSheetTarget Name="Iris Novak" />
            <arc:ShareSheetTarget Name="Leo Brandt" />
            <arc:ShareSheetTarget Name="Sana Iqbal" />
        </arc:ShareSheet.People>
        <arc:ShareSheet.Destinations>
            <arc:ShareSheetTarget Name="Email" Glyph="{x:Static arc:ArcIcons.Mail}" />
            <arc:ShareSheetTarget Name="Calendar" Glyph="{x:Static arc:ArcIcons.Calendar}" />
        </arc:ShareSheet.Destinations>
    </arc:ShareSheet>
</UserControl>
