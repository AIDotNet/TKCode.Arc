<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:generic="using:System.Collections.Generic"
             x:Class="TKCode.Arc.Gallery.Demos.TabsOverflowDemo">
    <StackPanel Spacing="12">
        <arc:Tabs x:Name="Folders"
                  MaxWidth="460"
                  HorizontalAlignment="Left">
            <arc:Tabs.ItemsSource>
                <generic:List x:TypeArguments="x:String">
                    <x:String>Inbox</x:String>
                    <x:String>Drafts</x:String>
                    <x:String>Sent</x:String>
                    <x:String>Scheduled</x:String>
                    <x:String>Spam</x:String>
                    <x:String>Trash</x:String>
                    <x:String>Archive</x:String>
                    <x:String>Templates</x:String>
                    <x:String>Snoozed</x:String>
                    <x:String>Important</x:String>
                </generic:List>
            </arc:Tabs.ItemsSource>
            <arc:Tabs.ContentTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding StringFormat='{}{0}: nothing new since this morning.'}"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                </DataTemplate>
            </arc:Tabs.ContentTemplate>
        </arc:Tabs>
        <TextBlock Text="{Binding #Folders.SelectedItem, StringFormat='Selected: {0}'}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
    </StackPanel>
</UserControl>
