<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             xmlns:atom="https://atomui.net"
             x:Class="TKCode.Arc.Gallery.Demos.DialogShortFormDemo">
    <StackPanel Spacing="12">
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:Button Content="Rename project"
                        Variant="Secondary"
                        Command="{Binding #RenameDialog.OpenCommand}" />
            <arc:Dialog x:Name="RenameDialog"
                        Title="Rename project"
                        Description="Choose a short name your team will recognize."
                        Closed="OnClosed">
                <atom:TextBox x:Name="ProjectName" Text="Atlas redesign" />
                <arc:Dialog.Actions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <arc:Button Content="Cancel" Variant="Secondary" arc:Dialog.Result="{x:False}" />
                        <arc:Button Content="Save" arc:Dialog.Result="{x:True}" />
                    </StackPanel>
                </arc:Dialog.Actions>
            </arc:Dialog>
        </WrapPanel>
        <TextBlock x:Name="Status"
                   Text="Project: Atlas redesign"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
    </StackPanel>
</UserControl>
