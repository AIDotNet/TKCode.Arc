<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.DialogStepsDemo">
    <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
        <arc:Button Content="Invite people"
                    Variant="Secondary"
                    Command="{Binding #InviteDialog.OpenCommand}" />
        <arc:Dialog x:Name="InviteDialog"
                    Title="Invite your team"
                    Description="Add people by email."
                    Opened="OnOpened">
            <TextBlock x:Name="Step"
                       Text="Step 1 of 3"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Foreground="{arc:ArcDesignTokenResource TextMuted}" />
            <arc:Dialog.Actions>
                <arc:Button x:Name="Next" Content="Next" Click="OnNextClick" />
            </arc:Dialog.Actions>
        </arc:Dialog>
    </WrapPanel>
</UserControl>
