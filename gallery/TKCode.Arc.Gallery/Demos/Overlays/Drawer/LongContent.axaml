<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.DrawerLongContentDemo">
    <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
        <arc:Button Content="Open record"
                    Variant="Secondary"
                    Command="{Binding #RecordDrawer.OpenCommand}" />
        <arc:Drawer x:Name="RecordDrawer"
                    Title="INV-2041"
                    Description="Paid on 12 March by Ada Lovelace.">
            <StackPanel x:Name="Lines" Spacing="10">
                <StackPanel.Styles>
                    <Style Selector="TextBlock">
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
                    </Style>
                    <Style Selector="TextBlock.muted">
                        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
                    </Style>
                </StackPanel.Styles>
            </StackPanel>
        </arc:Drawer>
    </WrapPanel>
</UserControl>
