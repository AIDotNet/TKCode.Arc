<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.PopoverFromCodeDemo">
    <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
        <arc:Button Content="Show at the box" Variant="Secondary" Click="OnShowClick" />
        <Border x:Name="Anchor"
                Width="120"
                Height="36"
                CornerRadius="18"
                BorderThickness="1"
                BorderBrush="{arc:ArcDesignTokenResource BorderStrong}" />
    </WrapPanel>
</UserControl>
