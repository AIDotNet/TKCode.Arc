<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.PopoverSmallFormDemo">
    <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
        <arc:Popover>
            <arc:Popover.Trigger>
                <arc:Button Content="Filter" Variant="Ghost" />
            </arc:Popover.Trigger>
            <StackPanel Spacing="12">
                <TextBlock Text="Status"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                <arc:Input Placeholder="Any" />
                <arc:Button Content="Apply" />
            </StackPanel>
        </arc:Popover>
    </WrapPanel>
</UserControl>
