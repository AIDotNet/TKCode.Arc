<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.PdfViewerLockedDemo">
    <StackPanel Spacing="12">
        <TextBlock Text="The password of this sample is arc-sample." />
        <arc:PdfViewer Height="440"
                       Source="{x:Static demos:PdfDemoMedia.Locked}"
                       Document="{x:Static demos:PdfDemoMedia.Simulated}" />
    </StackPanel>
</UserControl>
