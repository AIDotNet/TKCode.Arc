<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.PdfViewerSidebarDemo">
    <arc:PdfViewer Height="480"
                   Source="{x:Static demos:PdfDemoMedia.Sample}"
                   Document="{x:Static demos:PdfDemoMedia.Simulated}"
                   IsSidebarOpen="True"
                   SidebarMode="Outline" />
</UserControl>
