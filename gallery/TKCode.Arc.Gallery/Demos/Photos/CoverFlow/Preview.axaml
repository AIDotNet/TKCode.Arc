<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.CoverFlowPreviewDemo">
    <!-- Drag or flick the row, use the arrow keys, or click a cover to bring it to the centre. -->
    <arc:CoverFlow Label="Albums"
                   SelectedIndex="4"
                   ItemsSource="{x:Static demos:PhotosDemoData.Albums}" />
</UserControl>
