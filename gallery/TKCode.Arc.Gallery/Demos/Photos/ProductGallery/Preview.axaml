<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.ProductGalleryPreviewDemo">
    <!-- Hover the picture with a mouse to zoom toward the pointer; on a touch screen, swipe it. -->
    <arc:ProductGallery MaxWidth="440"
                        HorizontalAlignment="Center"
                        Label="Speckled stoneware mug"
                        ItemsSource="{x:Static demos:PhotosDemoData.OatMug}" />
</UserControl>
