<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.DatePickerDateFieldDemo">
    <StackPanel Spacing="12">
        <arc:DatePicker x:Name="Start"
                        Label="Start date"
                        Description="Type a date or press Alt+Down to open the calendar."
                        Culture="en-US"
                        Width="280"
                        HorizontalAlignment="Left"
                        SelectedDateChanged="OnSelectedDateChanged" />
        <TextBlock x:Name="Picked"
                   FontSize="13"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
    </StackPanel>
</UserControl>
