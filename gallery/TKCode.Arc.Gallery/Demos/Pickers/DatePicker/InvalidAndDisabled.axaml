<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.DatePickerInvalidAndDisabledDemo">
    <StackPanel x:Name="Fields" Spacing="16">
        <arc:DatePicker Label="Invoice date"
                        ErrorMessage="Pick a date before the due date."
                        Width="280"
                        HorizontalAlignment="Left" />
        <arc:DatePicker Label="Locked"
                        IsEnabled="False"
                        Width="280"
                        HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
