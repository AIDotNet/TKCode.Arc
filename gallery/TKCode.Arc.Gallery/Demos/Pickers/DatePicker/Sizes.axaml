<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.DatePickerSizesDemo">
    <StackPanel x:Name="Fields" Spacing="16">
        <arc:DatePicker Label="Small" Size="Small" Width="260" HorizontalAlignment="Left" />
        <arc:DatePicker Label="Medium" Width="260" HorizontalAlignment="Left" />
        <arc:DatePicker Label="Large" Size="Large" Width="260" HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
