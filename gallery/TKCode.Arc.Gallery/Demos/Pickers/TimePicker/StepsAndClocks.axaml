<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.TimePickerStepsAndClocksDemo">
    <StackPanel Spacing="16">
        <arc:TimePicker Label="Every 5 minutes"
                        MinuteStep="5"
                        Width="240"
                        HorizontalAlignment="Left" />
        <arc:TimePicker Label="Every 30 minutes, 24-hour"
                        MinuteStep="30"
                        ClockFormat="TwentyFourHour"
                        SelectedTime="18:30"
                        Width="240"
                        HorizontalAlignment="Left" />
        <arc:TimePicker Label="Reminder"
                        SelectedTime="{x:Null}"
                        Width="240"
                        HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
