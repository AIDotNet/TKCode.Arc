<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SandTextCodeDemo">
    <!-- With Trigger None only code moves the text: here a slow, far drift and the two events. -->
    <StackPanel Spacing="18" HorizontalAlignment="Center">
        <arc:SandText x:Name="Sand"
                      Text="Draft deleted"
                      Trigger="None"
                      Duration="0:0:2.4"
                      Distance="180"
                      FontSize="36"
                      HorizontalAlignment="Center"
                      Dissolved="OnDissolved"
                      Gathered="OnGathered" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <arc:Button Content="Scatter" Variant="Secondary" Click="OnScatter" />
            <arc:Button Content="Gather" Variant="Ghost" Click="OnGather" />
            <TextBlock x:Name="Status"
                       Text="Standing"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
        </StackPanel>
    </StackPanel>
</UserControl>
