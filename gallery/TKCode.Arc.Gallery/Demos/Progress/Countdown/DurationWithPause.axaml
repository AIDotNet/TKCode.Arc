<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.CountdownDurationWithPauseDemo">
    <StackPanel Spacing="16">
        <arc:Countdown x:Name="Timer"
                       Duration="0:0:12"
                       Units="Minutes, Seconds"
                       Completed="OnCompleted" />
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:Button x:Name="PauseButton"
                        Content="Pause"
                        Variant="Secondary"
                        Click="OnPauseClick" />
            <arc:Button Content="Restart" Variant="Ghost" Click="OnRestartClick" />
        </WrapPanel>
        <TextBlock x:Name="Status"
                   Text="Counting down 12 seconds."
                   TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
    </StackPanel>
</UserControl>
