<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ProgressChangingLabelDemo">
    <StackPanel Spacing="16">
        <arc:Progress x:Name="Export" Label="Preparing export" Value="20" />
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:Button Content="Next phase" Variant="Secondary" Click="OnNextPhaseClick" />
        </WrapPanel>
    </StackPanel>
</UserControl>
