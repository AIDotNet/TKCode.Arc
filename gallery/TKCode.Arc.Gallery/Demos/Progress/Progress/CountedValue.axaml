<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ProgressCountedValueDemo">
    <StackPanel Spacing="16">
        <arc:Progress x:Name="Upload"
                      Label="Uploading 4 files"
                      IsValueVisible="True"
                      Value="35" />
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:Button Content="Advance" Variant="Secondary" Click="OnAdvanceClick" />
            <arc:Button Content="Complete" Variant="Secondary" Click="OnCompleteClick" />
            <arc:Button Content="Reset" Variant="Ghost" Click="OnResetClick" />
        </WrapPanel>
    </StackPanel>
</UserControl>
