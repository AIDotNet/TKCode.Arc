<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SkeletonIntoContentDemo">
    <StackPanel Spacing="16">
        <arc:Skeleton x:Name="Post" IsAvatarVisible="True" Lines="2">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <arc:Avatar DisplayName="Maya Chen" Size="Medium" />
                    <TextBlock Text="Maya Chen"
                               FontSize="16"
                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                </StackPanel>
                <TextBlock Text="Shipped the new billing page. The usage meter now explains what fills the plan."
                           TextWrapping="Wrap"
                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
            </StackPanel>
        </arc:Skeleton>
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:Button x:Name="Toggle"
                        Content="Finish loading"
                        Variant="Secondary"
                        Click="OnToggleClick" />
        </WrapPanel>
    </StackPanel>
</UserControl>
