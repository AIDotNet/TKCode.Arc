<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.StepperCurrentDetailsDemo">
    <arc:Stepper CurrentIndex="1" Details="Current">
        <arc:StepperStep Id="account" Label="Account" Description="Create your login" />
        <arc:StepperStep Id="shipping" Label="Shipping" Description="Where should we send it" />
        <arc:StepperStep Id="payment" Label="Payment" Description="Card or invoice" />
        <arc:StepperStep Id="review" Label="Review" Description="Check and confirm" />
    </arc:Stepper>
</UserControl>
