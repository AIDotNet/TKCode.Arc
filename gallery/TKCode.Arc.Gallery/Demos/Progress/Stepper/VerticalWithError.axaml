<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.StepperVerticalWithErrorDemo">
    <StackPanel Spacing="16">
        <arc:Stepper x:Name="Setup"
                     CurrentIndex="2"
                     Orientation="Vertical"
                     Width="320"
                     HorizontalAlignment="Left">
            <arc:StepperStep Id="account" Label="Account" Description="Create your login" />
            <arc:StepperStep Id="shipping" Label="Shipping" Description="Where should we send it" />
            <arc:StepperStep Id="payment" Label="Payment" Description="Card or invoice" />
            <arc:StepperStep Id="review" Label="Review" Description="Check and confirm" />
        </arc:Stepper>
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:Button Content="Toggle error" Variant="Danger" Click="OnToggleErrorClick" />
        </WrapPanel>
    </StackPanel>
</UserControl>
