<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.UsageMeterAlmostFullDemo">
    <arc:UsageMeter Label="API calls this month" Limit="100" Unit="K">
        <arc:UsageSegment Id="prod" Label="Production" Value="61.5" />
        <arc:UsageSegment Id="staging" Label="Staging" Value="29.8" />
    </arc:UsageMeter>
</UserControl>
