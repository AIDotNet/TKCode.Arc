<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.TocProgressEntriesDemo">
    <!-- Sections listed by hand: titles that differ from the headings, and an entry per heading element. -->
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="32" Height="360" MaxWidth="820">
        <ScrollViewer x:Name="Notes" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Margin="0,0,16,120">
                <TextBlock x:Name="Goals" Text="1. Goals for the quarter" FontSize="20" FontWeight="SemiBold" />
                <TextBlock TextWrapping="Wrap" LineHeight="24" Text="Ship the offline mode, halve the time to first sync and keep the app under forty megabytes on every platform." />
                <TextBlock TextWrapping="Wrap" LineHeight="24" Text="Each goal has one owner and a weekly check-in on Thursday." />
                <TextBlock x:Name="Risks" Text="2. Known risks" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,0" />
                <TextBlock TextWrapping="Wrap" LineHeight="24" Text="The storage layer still writes on the main thread on older phones, and two of the larger customers depend on the export format we want to change." />
                <TextBlock TextWrapping="Wrap" LineHeight="24" Text="Both get a spike in the first two weeks so the plan can move if they turn out larger than they look." />
                <TextBlock x:Name="Timeline" Text="3. Timeline" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,0" />
                <TextBlock TextWrapping="Wrap" LineHeight="24" Text="Weeks one to four for the spikes and the sync work, five to nine for offline mode, and the rest for polish, the beta and the release notes." />
                <TextBlock TextWrapping="Wrap" LineHeight="24" Text="The beta opens to the waiting list in week ten." />
            </StackPanel>
        </ScrollViewer>
        <arc:TocProgress Grid.Column="1" Width="200" VerticalAlignment="Top" Target="{Binding #Notes}">
            <arc:TocProgressEntry Title="Goals" Target="{Binding #Goals}" />
            <arc:TocProgressEntry Title="Risks" Target="{Binding #Risks}" />
            <arc:TocProgressEntry Title="Timeline" Target="{Binding #Timeline}" />
        </arc:TocProgress>
    </Grid>
</UserControl>
