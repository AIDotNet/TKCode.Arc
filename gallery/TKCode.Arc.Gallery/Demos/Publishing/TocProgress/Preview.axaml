<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.TocProgressPreviewDemo">
    <!-- An invented article about keeping a sourdough starter. Scroll it, or pick a section on the right. -->
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="32" Height="420" MaxWidth="820">
        <ScrollViewer x:Name="Article" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Margin="0,0,16,160">
                <TextBlock Text="Before you start" arc:TocProgress.Heading="Before you start" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,0" />
                <TextBlock Text="Pick a quiet weekend and a container with a loose lid. A clean glass jar works well because you can watch the bubbles rise along the sides." TextWrapping="Wrap" LineHeight="24" />
                <TextBlock Text="Flour and water are all you need. Whole grain flour wakes the culture faster; plain flour keeps it calm once it is going." TextWrapping="Wrap" LineHeight="24" />
                <TextBlock Text="Day one: the first mix" arc:TocProgress.Heading="Day one: the first mix" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,0" />
                <TextBlock Text="Stir equal weights of flour and water into a thick paste, scrape the sides down and mark the level with a rubber band." TextWrapping="Wrap" LineHeight="24" />
                <TextBlock Text="Leave it somewhere warm, away from direct sun. Nothing much will happen today, and that is fine." TextWrapping="Wrap" LineHeight="24" />
                <TextBlock Text="What the smell means" arc:TocProgress.Heading="What the smell means" arc:TocProgress.Level="2" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="A sharp, fruity smell on day two is normal. It fades as the right microbes take over from the early ones." TextWrapping="Wrap" LineHeight="24" />
                <TextBlock Text="A grey liquid on top only means the culture is hungry. Pour it off or stir it back in." TextWrapping="Wrap" LineHeight="24" />
                <TextBlock Text="Feeding every day" arc:TocProgress.Heading="Feeding every day" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,0" />
                <TextBlock Text="Each morning, keep a spoonful, discard the rest and feed it fresh flour and water. The routine matters more than the exact amounts." TextWrapping="Wrap" LineHeight="24" />
                <TextBlock Text="After about a week the starter should double within a few hours of a feeding." TextWrapping="Wrap" LineHeight="24" />
                <TextBlock Text="Keeping it in the fridge" arc:TocProgress.Heading="Keeping it in the fridge" arc:TocProgress.Level="2" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="If you bake once a week, the starter can live in the fridge and be fed the day before you bake." TextWrapping="Wrap" LineHeight="24" />
                <TextBlock Text="Give it two warm feedings before a big bake so it is lively again." TextWrapping="Wrap" LineHeight="24" />
                <TextBlock Text="Your first loaf" arc:TocProgress.Heading="Your first loaf" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,0" />
                <TextBlock Text="Use the starter at its peak, when it has domed and just begins to fall. A spoonful should float in water." TextWrapping="Wrap" LineHeight="24" />
                <TextBlock Text="Mix, rest, fold a few times over the afternoon, shape, and let the cold of the fridge do the rest overnight." TextWrapping="Wrap" LineHeight="24" />
                <TextBlock Text="When things go wrong" arc:TocProgress.Heading="When things go wrong" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,0" />
                <TextBlock Text="Pink or orange streaks mean it is time to start over. Everything else can usually be fixed with a few regular feedings." TextWrapping="Wrap" LineHeight="24" />
                <TextBlock Text="Write down what you did each day; patterns show up quickly." TextWrapping="Wrap" LineHeight="24" />
            </StackPanel>
        </ScrollViewer>
        <arc:TocProgress Grid.Column="1" Width="240" VerticalAlignment="Top" Target="{Binding #Article}" />
    </Grid>
</UserControl>
