<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ChipGroupFilterChipsDemo">
    <StackPanel Spacing="12">
        <arc:ChipGroup x:Name="Topics"
                       Label="Topics"
                       MaxWidth="560"
                       HorizontalAlignment="Left"
                       SelectionChanged="OnSelectionChanged">
            <arc:SelectItem Content="Design" />
            <arc:SelectItem Content="Engineering" />
            <arc:SelectItem Content="Research" />
            <arc:SelectItem Content="Marketing" />
            <arc:SelectItem Content="Sales" />
            <arc:SelectItem Content="Support" />
            <arc:SelectItem Content="Finance" />
            <arc:SelectItem Content="Legal" />
            <arc:SelectItem Content="Operations" />
            <arc:SelectItem Content="People" />
        </arc:ChipGroup>
        <TextBlock x:Name="Chosen"
                   Text="Values: none"
                   FontSize="13"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
    </StackPanel>
</UserControl>
