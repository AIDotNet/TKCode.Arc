<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ComboboxSearchableDemo">
    <StackPanel Spacing="12">
        <arc:Combobox x:Name="Zone"
                      Label="Time zone"
                      HorizontalAlignment="Left"
                      Description="Search by city, zone name or offset."
                      Width="320" />
        <TextBlock FontSize="13"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                   Text="{Binding #Zone.SelectedValue, StringFormat='Value: {0}', TargetNullValue='Value: none'}" />
    </StackPanel>
</UserControl>
