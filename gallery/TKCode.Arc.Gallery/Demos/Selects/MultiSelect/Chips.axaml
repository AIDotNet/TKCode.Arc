<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.MultiSelectChipsDemo">
    <StackPanel Spacing="12">
        <arc:MultiSelect x:Name="Labels"
                         Label="Labels"
                         HorizontalAlignment="Left"
                         Description="Shown on the issue card."
                         Width="320"
                         SelectionChanged="OnSelectionChanged">
            <arc:SelectItem Content="Bug" Value="bug" />
            <arc:SelectItem Content="Feature" Value="feature" />
            <arc:SelectItem Content="Documentation" Value="docs" />
            <arc:SelectItem Content="Performance" Value="perf" />
            <arc:SelectItem Content="Design" Value="design" />
            <arc:SelectItem Content="Accessibility" Value="a11y" />
            <arc:SelectItem Content="Infrastructure" Value="infra" IsEnabled="False" />
        </arc:MultiSelect>
        <TextBlock x:Name="Chosen"
                   Text="Values: none"
                   FontSize="13"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
    </StackPanel>
</UserControl>
