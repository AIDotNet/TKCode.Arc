<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.MultiSelectOneVisibleChipDemo">
    <arc:MultiSelect x:Name="Owners"
                     Label="Owners"
                     HorizontalAlignment="Center"
                     MaxVisibleChips="1"
                     Width="280">
        <arc:SelectItem Content="Ada" />
        <arc:SelectItem Content="Grace" />
        <arc:SelectItem Content="Linus" />
        <arc:SelectItem Content="Margaret" />
        <arc:SelectItem Content="Ken" />
    </arc:MultiSelect>
</UserControl>
