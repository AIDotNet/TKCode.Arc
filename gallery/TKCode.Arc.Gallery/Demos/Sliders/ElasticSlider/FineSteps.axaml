<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ElasticSliderFineStepsDemo">
    <arc:ElasticSlider x:Name="Zoom"
                       Label="Zoom"
                       Minimum="0.5"
                       Maximum="3"
                       SmallChange="0.1"
                       Value="1"
                       Width="360"
                       HorizontalAlignment="Center">
        <arc:ElasticSlider.StartIcon>
            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ZoomOut}"
                          Size="16"
                          Foreground="{arc:ArcDesignTokenResource TextMuted}"
                          VerticalAlignment="Center" />
        </arc:ElasticSlider.StartIcon>
        <arc:ElasticSlider.EndIcon>
            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ZoomIn}"
                          Size="16"
                          Foreground="{arc:ArcDesignTokenResource TextMuted}"
                          VerticalAlignment="Center" />
        </arc:ElasticSlider.EndIcon>
        <arc:ElasticSlider.Marks>
            <arc:SliderMark Value="1" />
            <arc:SliderMark Value="2" />
        </arc:ElasticSlider.Marks>
    </arc:ElasticSlider>
</UserControl>
