<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SliderRangeDemo">
    <StackPanel Spacing="16">
        <arc:Slider x:Name="Price"
                    Label="Price"
                    IsRange="True"
                    Minimum="0"
                    Maximum="1000"
                    SmallChange="10"
                    LowerValue="200"
                    UpperValue="800"
                    MinStepsBetweenThumbs="5"
                    LowerThumbName="Minimum price"
                    UpperThumbName="Maximum price"
                    Width="360"
                    HorizontalAlignment="Center"
                    ValueCommitted="OnValueCommitted" />
        <TextBlock x:Name="Committed"
                   Text="Committed: $200 – $800"
                   HorizontalAlignment="Center"
                   FontSize="12"
                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
    </StackPanel>
</UserControl>
