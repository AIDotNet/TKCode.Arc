<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SliderStepsAndMarksDemo">
    <arc:Slider x:Name="Speed"
                Label="Playback speed"
                Minimum="0.5"
                Maximum="2"
                SmallChange="0.25"
                Value="1"
                Width="360"
                HorizontalAlignment="Center">
        <arc:Slider.Marks>
            <arc:SliderMark Value="0.5" Label="0.5×" />
            <arc:SliderMark Value="0.75" />
            <arc:SliderMark Value="1" Label="1×" />
            <arc:SliderMark Value="1.25" />
            <arc:SliderMark Value="1.5" Label="1.5×" />
            <arc:SliderMark Value="1.75" />
            <arc:SliderMark Value="2" Label="2×" />
        </arc:Slider.Marks>
    </arc:Slider>
</UserControl>
