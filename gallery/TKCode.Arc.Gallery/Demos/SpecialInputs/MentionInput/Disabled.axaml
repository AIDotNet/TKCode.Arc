<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.MentionInputDisabledDemo">
    <arc:MentionInput x:Name="Input"
                      Label="Locked comment"
                      IsEnabled="False"
                      People="{x:Static demos:MentionDemoData.People}"
                      Channels="{x:Static demos:MentionDemoData.Channels}"
                      Width="440"
                      HorizontalAlignment="Center" />
</UserControl>
