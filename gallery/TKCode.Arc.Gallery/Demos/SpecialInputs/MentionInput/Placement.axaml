<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.MentionInputPlacementDemo">
    <arc:MentionInput Label="Reply"
                      Placeholder="Suggestions open above. Try @ or #"
                      SuggestionPlacement="Top"
                      People="{x:Static demos:MentionDemoData.People}"
                      Channels="{x:Static demos:MentionDemoData.Channels}"
                      Width="440"
                      HorizontalAlignment="Center" />
</UserControl>
