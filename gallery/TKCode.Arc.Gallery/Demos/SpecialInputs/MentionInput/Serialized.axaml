<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.MentionInputSerializedDemo">
    <StackPanel Spacing="14">
        <arc:MentionInput x:Name="Input"
                          Label="Announcement"
                          Placeholder="Type a message with a few mentions"
                          People="{x:Static demos:MentionDemoData.People}"
                          Channels="{x:Static demos:MentionDemoData.Channels}"
                          Width="440"
                          HorizontalAlignment="Center" />
        <TextBlock x:Name="Output"
                   Width="440"
                   HorizontalAlignment="Center"
                   FontSize="13"
                   FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                   TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
    </StackPanel>
</UserControl>
