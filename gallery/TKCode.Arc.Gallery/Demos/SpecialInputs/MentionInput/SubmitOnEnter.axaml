<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.MentionInputSubmitOnEnterDemo">
    <UserControl.Styles>
        <Style Selector="TextBlock.sent">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="14">
        <arc:MentionInput x:Name="Input"
                          Label="Message"
                          Placeholder="Message #design"
                          IsSubmitOnEnter="True"
                          People="{x:Static demos:MentionDemoData.People}"
                          Channels="{x:Static demos:MentionDemoData.Channels}"
                          Width="440"
                          HorizontalAlignment="Center"
                          Submitted="OnSubmitted" />
        <StackPanel x:Name="Log" Spacing="6" Width="440" HorizontalAlignment="Center">
            <TextBlock x:Name="Empty"
                       Text="Sent messages show up here."
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{arc:ArcDesignTokenResource TextMuted}" />
        </StackPanel>
    </StackPanel>
</UserControl>
