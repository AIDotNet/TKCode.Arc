<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.MoneyInputBindingAndEventsDemo">
    <StackPanel Spacing="14">
        <arc:MoneyInput x:Name="Amount"
                        Label="Amount"
                        Maximum="5000"
                        Width="380"
                        HorizontalAlignment="Left"
                        ValueChanged="OnValueChanged" />
        <TextBlock x:Name="Readout"
                   FontSize="13"
                   FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
        <TextBlock x:Name="EventLine"
                   Text="ValueChanged: (none yet)"
                   FontSize="13"
                   FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <arc:Button Content="Set Value = 99.99" Variant="Secondary" Size="Small" Click="OnSetClick" />
            <arc:Button Content="Clear" Variant="Ghost" Size="Small" Click="OnClearClick" />
        </StackPanel>
    </StackPanel>
</UserControl>
