<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:generic="clr-namespace:System.Collections.Generic;assembly=System.Collections"
             x:Class="TKCode.Arc.Gallery.Demos.MoneyInputHiddenLabelDemo">
    <arc:MoneyInput Label="Donation"
                    IsLabelVisible="False"
                    Width="380"
                    HorizontalAlignment="Left">
        <arc:MoneyInput.QuickAddAmounts>
            <generic:List x:TypeArguments="x:Decimal">
                <x:Decimal>5</x:Decimal>
                <x:Decimal>20</x:Decimal>
                <x:Decimal>50</x:Decimal>
            </generic:List>
        </arc:MoneyInput.QuickAddAmounts>
    </arc:MoneyInput>
</UserControl>
