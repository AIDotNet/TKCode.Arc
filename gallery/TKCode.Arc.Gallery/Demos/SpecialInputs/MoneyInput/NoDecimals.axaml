<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             xmlns:generic="clr-namespace:System.Collections.Generic;assembly=System.Collections"
             x:Class="TKCode.Arc.Gallery.Demos.MoneyInputNoDecimalsDemo">
    <arc:MoneyInput Label="Price"
                    Currency="JPY"
                    Value="12000"
                    Width="380"
                    HorizontalAlignment="Left">
        <arc:MoneyInput.QuickAddAmounts>
            <generic:List x:TypeArguments="x:Decimal">
                <x:Decimal>1000</x:Decimal>
                <x:Decimal>5000</x:Decimal>
                <x:Decimal>10000</x:Decimal>
            </generic:List>
        </arc:MoneyInput.QuickAddAmounts>
    </arc:MoneyInput>
</UserControl>
