<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.NumberFieldBindingAndEventsDemo">
    <StackPanel Spacing="16">
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:NumberField x:Name="Bound"
                             Label="Bound"
                             Maximum="50"
                             Value="7"
                             ValueChanged="OnValueChanged" />
            <arc:NumberField Label="Mirror"
                             Maximum="50"
                             Value="{Binding #Bound.Value, Mode=TwoWay}" />
        </WrapPanel>
        <TextBlock x:Name="Readout"
                   Text="Value 7"
                   HorizontalAlignment="Center"
                   FontSize="13"
                   FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
    </StackPanel>
</UserControl>
