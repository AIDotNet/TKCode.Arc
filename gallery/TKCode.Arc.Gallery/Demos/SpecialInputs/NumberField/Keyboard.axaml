<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.NumberFieldKeyboardDemo">
    <StackPanel Spacing="12">
        <arc:NumberField Label="Items" Maximum="1000" Value="120" LargeStep="50" HorizontalAlignment="Center" />
        <TextBlock Text="ArrowUp / ArrowDown step (hold to repeat), Shift or PageUp / PageDown take the large step, Home / End jump to the limits, Enter commits a draft or selects the number, Escape restores it. The wheel steps while the field is focused."
                   HorizontalAlignment="Center"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
    </StackPanel>
</UserControl>
