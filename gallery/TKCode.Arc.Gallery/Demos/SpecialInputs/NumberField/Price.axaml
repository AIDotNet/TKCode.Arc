<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.NumberFieldPriceDemo">
    <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
        <arc:NumberField Label="Price" Prefix="$" Step="0.5" Maximum="999" Value="24.5" />
        <arc:NumberField Label="Unit cost" Prefix="$" Step="0.01" Maximum="100" Value="4.99" />
    </WrapPanel>
</UserControl>
