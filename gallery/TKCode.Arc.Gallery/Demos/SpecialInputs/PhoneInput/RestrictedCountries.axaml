<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:generic="clr-namespace:System.Collections.Generic;assembly=System.Collections"
             x:Class="TKCode.Arc.Gallery.Demos.PhoneInputRestrictedCountriesDemo">
    <arc:PhoneInput Label="Phone number"
                    Country="GB"
                    Width="360"
                    HorizontalAlignment="Left">
        <arc:PhoneInput.Countries>
            <generic:List x:TypeArguments="x:String">
                <x:String>GB</x:String>
                <x:String>IE</x:String>
                <x:String>FR</x:String>
                <x:String>DE</x:String>
                <x:String>ES</x:String>
                <x:String>IT</x:String>
                <x:String>NL</x:String>
                <x:String>PT</x:String>
            </generic:List>
        </arc:PhoneInput.Countries>
        <arc:PhoneInput.PreferredCountries>
            <generic:List x:TypeArguments="x:String">
                <x:String>GB</x:String>
                <x:String>IE</x:String>
            </generic:List>
        </arc:PhoneInput.PreferredCountries>
    </arc:PhoneInput>
</UserControl>
