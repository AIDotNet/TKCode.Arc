<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.PhoneInputValueChangedDemo">
    <StackPanel Spacing="12">
        <arc:PhoneInput Label="Phone number"
                        Width="360"
                        HorizontalAlignment="Left"
                        ValueChanged="OnValueChanged" />
        <StackPanel Spacing="4">
            <TextBlock x:Name="E164"
                       Text="E.164: —"
                       FontSize="13"
                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
            <TextBlock x:Name="Formatted"
                       Text="Formatted: —"
                       FontSize="13"
                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
            <TextBlock x:Name="Status"
                       Text="Status: Empty"
                       FontSize="13"
                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
        </StackPanel>
        <TextBlock Text="Try +14155550132, or pick Canada with a number typed."
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
    </StackPanel>
</UserControl>
