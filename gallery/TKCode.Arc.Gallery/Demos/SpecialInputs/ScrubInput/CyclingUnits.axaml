<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             xmlns:generic="clr-namespace:System.Collections.Generic;assembly=System.Collections"
             x:Class="TKCode.Arc.Gallery.Demos.ScrubInputCyclingUnitsDemo">
    <Border Width="320"
            HorizontalAlignment="Center"
            Padding="16,26,16,16"
            CornerRadius="18"
            BorderThickness="1"
            Background="{arc:ArcDesignTokenResource Surface}"
            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
        <StackPanel Spacing="8">
            <arc:ScrubInput x:Name="WidthInput" Label="Width" Value="240" Minimum="0">
                <arc:ScrubInput.Units>
                    <generic:List x:TypeArguments="x:String">
                        <x:String>px</x:String>
                        <x:String>%</x:String>
                        <x:String>em</x:String>
                    </generic:List>
                </arc:ScrubInput.Units>
            </arc:ScrubInput>
            <arc:ScrubInput Label="Gap" Value="1.5" Step="0.1" Minimum="0">
                <arc:ScrubInput.Units>
                    <generic:List x:TypeArguments="x:String">
                        <x:String>em</x:String>
                        <x:String>px</x:String>
                    </generic:List>
                </arc:ScrubInput.Units>
            </arc:ScrubInput>
            <TextBlock x:Name="UnitLog"
                       Text="Unit: px"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{arc:ArcDesignTokenResource TextMuted}" />
        </StackPanel>
    </Border>
</UserControl>
