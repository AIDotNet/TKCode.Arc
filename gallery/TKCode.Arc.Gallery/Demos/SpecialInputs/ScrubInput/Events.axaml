<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ScrubInputEventsDemo">
    <Border Width="320"
            HorizontalAlignment="Center"
            Padding="16,26,16,16"
            CornerRadius="18"
            BorderThickness="1"
            Background="{arc:ArcDesignTokenResource Surface}"
            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
        <StackPanel Spacing="12">
            <arc:ScrubInput x:Name="Amount"
                            Label="Amount"
                            Value="10"
                            Minimum="0"
                            Maximum="50"
                            Step="1"
                            ResetValue="10"
                            ValueChanged="OnValueChanged"
                            ValueCommitted="OnValueCommitted" />
            <arc:Button Content="Set 25 from code"
                        Variant="Secondary"
                        HorizontalAlignment="Left"
                        Click="OnSetFromCodeClick" />
            <TextBlock x:Name="Log"
                       FontSize="12"
                       LineSpacing="2"
                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
        </StackPanel>
    </Border>
</UserControl>
