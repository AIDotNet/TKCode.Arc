<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ShortcutRecorderNoModifierDemo">
    <arc:ShortcutRecorder Label="Next conversation"
                          Value="J"
                          ResetValue="J"
                          IsModifierRequired="False"
                          Description="Single keys are allowed here; Escape still cancels."
                          Width="320"
                          HorizontalAlignment="Center" />
</UserControl>
