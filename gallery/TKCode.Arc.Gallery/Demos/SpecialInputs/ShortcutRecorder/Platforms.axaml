<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ShortcutRecorderPlatformsDemo">
    <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
        <arc:ShortcutRecorder Label="Mac"
                              Platform="Mac"
                              Value="Cmd+Shift+K"
                              ResetValue="Cmd+Shift+K"
                              Width="320" />
        <arc:ShortcutRecorder Label="Windows and Linux"
                              Platform="Other"
                              Value="Ctrl+Shift+K"
                              ResetValue="Ctrl+Shift+K"
                              Width="320" />
    </WrapPanel>
</UserControl>
