<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ShortcutRecorderReservedDemo">
    <StackPanel Spacing="24" HorizontalAlignment="Center">
        <arc:ShortcutRecorder x:Name="Sidebar"
                              Label="Toggle sidebar"
                              Width="320" />
        <arc:ShortcutRecorder x:Name="Duplicate"
                              Label="Duplicate line"
                              IsReservedWarningEnabled="False"
                              Description="IsReservedWarningEnabled = false: reserved combinations record directly."
                              Width="320" />
    </StackPanel>
</UserControl>
