<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             xmlns:generic="using:System.Collections.Generic"
             x:Class="TKCode.Arc.Gallery.Demos.TagInputTwoWayValueDemo">
    <StackPanel Spacing="16">
        <arc:TagInput x:Name="Labels"
                      Label="Labels"
                      Width="420"
                      HorizontalAlignment="Left">
            <arc:TagInput.Value>
                <generic:List x:TypeArguments="x:String">
                    <x:String>bug</x:String>
                    <x:String>ui</x:String>
                </generic:List>
            </arc:TagInput.Value>
        </arc:TagInput>
        <arc:TagInput Label="Bound copy"
                      Description="Bound two-way to the field above."
                      Value="{Binding #Labels.Value, Mode=TwoWay}"
                      Width="420"
                      HorizontalAlignment="Left" />
        <TextBlock x:Name="ValueText"
                   Text="Value: bug, ui"
                   FontSize="13"
                   FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
        <TextBlock x:Name="LastEvent"
                   Text="Last event: none"
                   FontSize="13"
                   FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
        <arc:Button Content="Reset in code"
                    Variant="Ghost"
                    Size="Small"
                    HorizontalAlignment="Left"
                    Click="OnResetClick" />
    </StackPanel>
</UserControl>
