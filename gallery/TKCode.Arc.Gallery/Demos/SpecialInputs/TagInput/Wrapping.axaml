<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             xmlns:generic="using:System.Collections.Generic"
             x:Class="TKCode.Arc.Gallery.Demos.TagInputWrappingDemo">
    <arc:TagInput Label="Recipients" Width="420" HorizontalAlignment="Left">
        <arc:TagInput.Value>
            <generic:List x:TypeArguments="x:String">
                <x:String>ada@example.com</x:String>
                <x:String>grace@example.com</x:String>
                <x:String>linus@example.com</x:String>
                <x:String>margaret@example.com</x:String>
                <x:String>ken@example.com</x:String>
                <x:String>barbara@example.com</x:String>
                <x:String>dennis@example.com</x:String>
            </generic:List>
        </arc:TagInput.Value>
    </arc:TagInput>
</UserControl>
