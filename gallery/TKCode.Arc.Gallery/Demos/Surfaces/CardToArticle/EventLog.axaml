<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.CardToArticleEventLogDemo">
    <!-- Six stories bound to OpenItemId. The buttons open and close from code; the log shows every change and its cause. -->
    <StackPanel Spacing="16">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <arc:Button Content="Open the meteor story" Variant="Secondary" Click="OnOpenMeteors" />
            <arc:Button Content="Close" Variant="Ghost" Click="OnClose" />
        </StackPanel>
        <arc:CardToArticle x:Name="Stories" OpenItemChanged="OnOpenItemChanged" />
        <TextBlock x:Name="Log"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="Open a story to see its events here."
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
    </StackPanel>
</UserControl>
