<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ControlCenterNarrowDemo">
    <!-- In a 300px slot the panel follows its container, tightens its spacing and uses the 150px dial. In a window 455px
         wide or less it also drops its border, radius, shadow and fill; the detail keeps its own surface. -->
    <Grid Height="460">
        <Border Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">
            <arc:ControlCenter x:Name="Center" />
        </Border>
    </Grid>
</UserControl>
