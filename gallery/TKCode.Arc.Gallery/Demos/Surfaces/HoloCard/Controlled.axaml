<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.HoloCardControlledDemo">
    <!-- IsFlipped is two-way: the switch turns the card, and turning the card moves the switch. -->
    <WrapPanel HorizontalAlignment="Center" Margin="16,32">
        <arc:HoloCard x:Name="Card" Width="240" Margin="0,0,40,24"
                      FlippedChanged="OnFlippedChanged"
                      Label="Spring summit pass, Ada Brennan">
            <arc:HoloCard.Front>
                <Grid Background="#0D1936" RowDefinitions="*,Auto">
                    <Panel>
                        <Panel.Background>
                            <RadialGradientBrush Center="30%,25%" GradientOrigin="30%,25%" RadiusX="90%" RadiusY="70%">
                                <GradientStop Color="#2C807C" Offset="0" />
                                <GradientStop Color="#172A5A" Offset="0.6" />
                                <GradientStop Color="#0D1936" Offset="1" />
                            </RadialGradientBrush>
                        </Panel.Background>
                        <Ellipse Width="96" Height="96" Fill="#70C1A5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="AB" FontSize="36" FontWeight="SemiBold" Foreground="#0D1936"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                    <StackPanel Grid.Row="1" Margin="18" Spacing="2">
                        <TextBlock Text="Ada Brennan" FontSize="22" FontWeight="Medium" Foreground="#F5F5F5" />
                        <TextBlock Text="Speaker · Spring summit" FontSize="13" Foreground="#AEBEDF" />
                    </StackPanel>
                </Grid>
            </arc:HoloCard.Front>
            <arc:HoloCard.Back>
                <Grid Background="#0D1936">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                        <TextBlock Text="Hall C" HorizontalAlignment="Center" FontSize="26" FontWeight="Medium" Foreground="#F5F5F5" />
                        <TextBlock Text="Thursday, 10:30" HorizontalAlignment="Center" FontSize="14" Foreground="#AEBEDF" />
                    </StackPanel>
                </Grid>
            </arc:HoloCard.Back>
        </arc:HoloCard>
        <StackPanel Width="240" Spacing="12" VerticalAlignment="Center">
            <arc:Switch Content="Show the back" IsChecked="{Binding #Card.IsFlipped, Mode=TwoWay}" />
            <TextBlock Text="Events" FontWeight="Medium" />
            <TextBlock x:Name="Log" Text="Click either half of the card." TextWrapping="Wrap"
                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
        </StackPanel>
    </WrapPanel>
</UserControl>
