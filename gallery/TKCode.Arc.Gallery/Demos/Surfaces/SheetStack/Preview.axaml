<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SheetStackPreviewDemo">
    <!-- The account settings of an invented notes app: open them, step into the profile, then pick an avatar. The mode
         switch, Reset and the status line belong to this demo; the stack itself only knows its sheets. -->
    <UserControl.Resources>
        <!-- The profile row: a bordered card button that opens the next level. -->
        <ControlTheme x:Key="SheetStackDemoRowTheme" TargetType="Button">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="arc:ArcMotion.Tracks" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate TargetType="Button">
                    <Panel>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalContentAlignment="Stretch" />
                        </Border>
                        <Border Name="FocusRing"
                                IsVisible="False"
                                Margin="-4"
                                BorderThickness="2"
                                CornerRadius="30"
                                BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            </Style>
            <Style Selector="^:focus-visible">
                <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            </Style>
            <Style Selector="^:focus-visible /template/ Border#FocusRing">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^:motion-full">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                    </Transitions>
                </Setter>
            </Style>
        </ControlTheme>

        <!-- An avatar choice: a 2px accent ring around the selected picture, which settles slightly smaller. -->
        <ControlTheme x:Key="SheetStackDemoChoiceTheme" TargetType="RadioButton">
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="arc:ArcMotion.Tracks" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate TargetType="RadioButton">
                    <Panel Background="Transparent">
                        <Ellipse Name="Ring" IsVisible="False" StrokeThickness="2" Stroke="{arc:ArcDesignTokenResource Accent}" />
                        <ContentPresenter Name="Face"
                                          Margin="5"
                                          Content="{TemplateBinding Content}"
                                          RenderTransformOrigin="50%,50%"
                                          RenderTransform="scale(1)" />
                        <Ellipse Name="Focus" IsVisible="False" Margin="-4" StrokeThickness="2" Stroke="{arc:ArcDesignTokenResource FocusRing}" />
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:checked /template/ Ellipse#Ring">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^:checked /template/ ContentPresenter#Face">
                <Setter Property="RenderTransform" Value="scale(0.94)" />
            </Style>
            <Style Selector="^:focus-visible /template/ Ellipse#Focus">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^:motion-full /template/ ContentPresenter#Face">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcTransformOperationsTransition Property="RenderTransform" Tween="Spring" />
                    </Transitions>
                </Setter>
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <StackPanel Spacing="12" MaxWidth="744">
        <Border Height="580"
                Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                BorderBrush="{arc:ArcDesignTokenResource Border}"
                BorderThickness="1"
                CornerRadius="{arc:ArcDesignTokenResource RadiusSurface}">
            <arc:SheetStack x:Name="Stack"
                            IsContained="True"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusSurface}"
                            StackChanged="OnStackChanged">
                <arc:SheetStack.Sheets>
                    <arc:SheetStackSheet Id="account" Title="Account">
                        <StackPanel Spacing="14">
                            <Button x:Name="ProfileRow"
                                    Theme="{StaticResource SheetStackDemoRowTheme}"
                                    arc:SheetStack.OpenSheet="profile">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <ContentControl x:Name="RowAvatar" Width="44" Height="44" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="RowName" FontSize="{arc:ArcDesignTokenResource TypeSM}" FontWeight="Medium" />
                                        <TextBlock x:Name="RowRole"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                    </StackPanel>
                                    <arc:ArcGlyph Grid.Column="2"
                                                  Data="{x:Static arc:ArcIcons.ChevronRight}"
                                                  Size="18"
                                                  Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                  VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Border BorderBrush="{arc:ArcDesignTokenResource Border}"
                                    BorderThickness="1"
                                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="14,12">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Offline copies" FontSize="{arc:ArcDesignTokenResource TypeSM}" FontWeight="Medium" />
                                            <TextBlock Text="Keep recent notes on this device"
                                                       TextWrapping="Wrap"
                                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                        </StackPanel>
                                        <arc:Switch x:Name="OfflineSwitch"
                                                    Grid.Column="1"
                                                    IsChecked="True"
                                                    AutomationProperties.Name="Offline copies"
                                                    IsCheckedChanged="OnOfflineChanged" />
                                    </Grid>
                                    <Border Height="1" Background="{arc:ArcDesignTokenResource BorderSubtle}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="14,12">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Spell check" FontSize="{arc:ArcDesignTokenResource TypeSM}" FontWeight="Medium" />
                                            <TextBlock Text="Underline unknown words while typing"
                                                       TextWrapping="Wrap"
                                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                        </StackPanel>
                                        <arc:Switch x:Name="SpellSwitch"
                                                    Grid.Column="1"
                                                    AutomationProperties.Name="Spell check"
                                                    IsCheckedChanged="OnSpellChanged" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </arc:SheetStackSheet>

                    <arc:SheetStackSheet Id="profile" Title="Your profile" BackLabel="Details">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="6" Margin="0,4,0,2" HorizontalAlignment="Center">
                                <arc:ArcContentSwap x:Name="ProfileAvatar" Mode="BlurSwap" Width="76" Height="76" HorizontalAlignment="Center" />
                                <arc:Button x:Name="PickButton"
                                            Variant="Ghost"
                                            Size="Small"
                                            Content="Pick avatar"
                                            Foreground="{arc:ArcDesignTokenResource AccentStrong}"
                                            HorizontalAlignment="Center"
                                            arc:SheetStack.OpenSheet="avatar" />
                            </StackPanel>
                            <arc:Input x:Name="NameInput" Label="Name" TextChanged="OnDraftChanged" />
                            <arc:Input x:Name="RoleInput" Label="Title" TextChanged="OnDraftChanged" />
                        </StackPanel>
                        <arc:SheetStackSheet.Footer>
                            <arc:Button x:Name="SaveButton" Content="Save changes" IsEnabled="False" Click="OnSave" />
                        </arc:SheetStackSheet.Footer>
                    </arc:SheetStackSheet>

                    <arc:SheetStackSheet Id="avatar" Title="Pick avatar">
                        <UniformGrid x:Name="Choices"
                                     Columns="3"
                                     ColumnSpacing="12"
                                     RowSpacing="12"
                                     Margin="4,4,4,8"
                                     AutomationProperties.Name="Avatar style"
                                     SizeChanged="OnChoicesSizeChanged" />
                        <arc:SheetStackSheet.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <arc:Button Variant="Ghost" Content="Remove photo" Click="OnRemovePhoto" />
                                <arc:Button Content="Use photo" Click="OnUsePhoto" />
                            </StackPanel>
                        </arc:SheetStackSheet.Footer>
                    </arc:SheetStackSheet>
                </arc:SheetStack.Sheets>

                <!-- The page under the stack: the person and the button that opens the first level. -->
                <StackPanel Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <ContentControl x:Name="StageAvatar" Width="72" Height="72" HorizontalAlignment="Center" />
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="StageName"
                                   HorizontalAlignment="Center"
                                   FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                   FontWeight="Medium" />
                        <TextBlock x:Name="StageRole"
                                   HorizontalAlignment="Center"
                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                    </StackPanel>
                    <arc:Button x:Name="OpenButton"
                                Content="Open settings"
                                HorizontalAlignment="Center"
                                arc:SheetStack.OpenSheet="account" />
                </StackPanel>
            </arc:SheetStack>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <arc:SegmentedControl x:Name="ModeSwitch" SelectedValue="Auto" SelectionChanged="OnModeChanged" AutomationProperties.Name="Layout">
                <arc:SegmentedOption Value="Auto" Label="Auto" />
                <arc:SegmentedOption Value="Sheet" Label="Sheets" />
                <arc:SegmentedOption Value="Dialog" Label="Dialogs" />
            </arc:SegmentedControl>
            <arc:Button Variant="Secondary" Click="OnReset" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <arc:ArcGlyph Data="{x:Static arc:ArcIcons.RotateCcw}" Size="16" />
                    <TextBlock Text="Reset" />
                </StackPanel>
            </arc:Button>
            <TextBlock x:Name="Status"
                       Width="1"
                       Height="1"
                       Opacity="0"
                       IsHitTestVisible="False"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </StackPanel>
</UserControl>
