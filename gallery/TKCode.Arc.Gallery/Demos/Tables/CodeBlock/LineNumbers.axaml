<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.CodeBlockLineNumbersDemo">
    <StackPanel Spacing="12">
        <arc:CodeBlock x:Name="CartView"
                       FileName="CartView.cs"
                       Language="cs"
                       ShowLineNumbers="True" />
        <arc:CodeBlock x:Name="Usage" FileName="Usage.axaml" Language="axaml" />
    </StackPanel>
</UserControl>
