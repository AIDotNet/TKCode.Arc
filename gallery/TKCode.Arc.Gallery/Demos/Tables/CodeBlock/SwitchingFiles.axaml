<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.CodeBlockSwitchingFilesDemo">
    <StackPanel Spacing="12">
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:Button Content="greeting.tsx" Variant="Secondary" Size="Small" Click="OnFileClick" />
            <arc:Button Content="card.module.css" Variant="Secondary" Size="Small" Click="OnFileClick" />
            <arc:Button Content="package.json" Variant="Secondary" Size="Small" Click="OnFileClick" />
        </WrapPanel>
        <arc:CodeBlock x:Name="Viewer" FileName="greeting.tsx" />
    </StackPanel>
</UserControl>
