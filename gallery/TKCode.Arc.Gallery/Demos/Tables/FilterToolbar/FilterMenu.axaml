<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             xmlns:generic="using:System.Collections.Generic"
             x:Class="TKCode.Arc.Gallery.Demos.FilterToolbarFilterMenuDemo">
    <StackPanel Spacing="14">
        <arc:FilterMenu HorizontalAlignment="Left"
                        Alignment="Start"
                        FilterSelected="OnFilterSelected">
            <arc:FilterMenu.Fields>
                <generic:List x:TypeArguments="arc:FilterField">
                    <arc:FilterField Id="status" Label="Status" Icon="{x:Static arc:ArcIcons.CircleDot}">
                        <arc:FilterOption Value="Open" Hint="4" />
                        <arc:FilterOption Value="In progress" Hint="2" />
                        <arc:FilterOption Value="Closed" Hint="2" />
                    </arc:FilterField>
                    <arc:FilterField Id="owner" Label="Owner" Icon="{x:Static arc:ArcIcons.User}">
                        <arc:FilterOption Value="Mina" />
                        <arc:FilterOption Value="Theo" />
                        <arc:FilterOption Value="Ana" />
                        <arc:FilterOption Value="Kai" />
                    </arc:FilterField>
                    <arc:FilterField Id="priority" Label="Priority" Icon="{x:Static arc:ArcIcons.Flag}">
                        <arc:FilterOption Value="Urgent" />
                        <arc:FilterOption Value="High" />
                        <arc:FilterOption Value="Medium" />
                        <arc:FilterOption Value="Low" />
                    </arc:FilterField>
                </generic:List>
            </arc:FilterMenu.Fields>
        </arc:FilterMenu>
        <TextBlock x:Name="Picked"
                   Text="Nothing picked yet"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
    </StackPanel>
</UserControl>
