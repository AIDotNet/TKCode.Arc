<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.FilterToolbarSearchAndTableDemo">
    <StackPanel Spacing="14">
        <arc:FilterToolbar x:Name="Toolbar"
                           IsSearchVisible="True"
                           SearchPlaceholder="Search issues"
                           FiltersChanged="OnFiltersChanged">
            <arc:FilterField Id="status" Label="Status" Icon="{x:Static arc:ArcIcons.CircleDot}">
                <arc:FilterOption Value="Open" Hint="4" />
                <arc:FilterOption Value="In progress" Hint="2" />
                <arc:FilterOption Value="Closed" Hint="2" />
            </arc:FilterField>
            <arc:FilterField Id="owner" Label="Owner" Icon="{x:Static arc:ArcIcons.User}">
                <arc:FilterOption Value="Mina" />
                <arc:FilterOption Value="Theo" />
                <arc:FilterOption Value="Ana" />
                <arc:FilterOption Value="Kai" />
            </arc:FilterField>
            <arc:FilterField Id="priority" Label="Priority" Icon="{x:Static arc:ArcIcons.Flag}">
                <arc:FilterOption Value="Urgent" />
                <arc:FilterOption Value="High" />
                <arc:FilterOption Value="Medium" />
                <arc:FilterOption Value="Low" />
            </arc:FilterField>
        </arc:FilterToolbar>
        <arc:SortableDataTable x:Name="Table"
                               ItemNameOne="issue"
                               ItemNameOther="issues"
                               EmptyMessage="No issues match these filters"
                               MaxHeight="360" />
    </StackPanel>
</UserControl>
