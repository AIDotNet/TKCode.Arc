<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.JsonViewerWebhookPayloadDemo">
    <StackPanel Spacing="12">
        <arc:JsonViewer x:Name="Viewer"
                        ExpandDepth="2"
                        Copied="OnCopied"
                        CurrentRowChanged="OnCurrentRowChanged" />
        <TextBlock x:Name="Current"
                   Text="Current: root"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
        <TextBlock x:Name="Status"
                   Text="Hover a row and use its copy actions, or press Ctrl/Cmd+C on the current row."
                   FontSize="14"
                   TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
    </StackPanel>
</UserControl>
