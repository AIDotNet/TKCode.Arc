<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:local="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.ReorderableListCustomItemTemplateDemo">
    <arc:ReorderableList x:Name="Colors" Width="520" HorizontalAlignment="Left">
        <arc:ReorderableList.ItemTemplate>
            <DataTemplate x:DataType="x:String">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Width="14"
                            Height="14"
                            CornerRadius="7"
                            VerticalAlignment="Center"
                            Background="{Binding Converter={x:Static local:ReorderableListCustomItemTemplateDemo.SwatchBrush}}" />
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
        </arc:ReorderableList.ItemTemplate>
    </arc:ReorderableList>
</UserControl>
