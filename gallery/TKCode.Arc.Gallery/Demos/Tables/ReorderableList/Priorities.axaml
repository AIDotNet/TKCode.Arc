<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ReorderableListPrioritiesDemo">
    <StackPanel Spacing="14">
        <arc:ReorderableList x:Name="Priorities"
                             Width="520"
                             HorizontalAlignment="Left"
                             Reordered="OnReordered">
            <arc:ReorderableListEntry Id="pricing" Title="Ship pricing page" Detail="Marketing · due Friday" />
            <arc:ReorderableListEntry Id="onboarding" Title="Review onboarding flow" Detail="Design · 3 open comments" />
            <arc:ReorderableListEntry Id="billing" Title="Migrate billing webhooks" Detail="Platform" />
            <arc:ReorderableListEntry Id="notes" Title="Write launch notes" Detail="Docs · draft ready" />
        </arc:ReorderableList>
        <TextBlock x:Name="Status"
                   Text="Drag a grip, or focus one and press ↑ / ↓. Space picks a row up, arrows move it, Space drops, Escape cancels."
                   FontSize="14"
                   TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
    </StackPanel>
</UserControl>
