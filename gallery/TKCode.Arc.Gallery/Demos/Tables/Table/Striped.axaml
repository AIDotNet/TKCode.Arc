<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.TableStripedDemo">
    <StackPanel Spacing="12">
        <arc:Switch x:Name="StripedSwitch" Content="Striped rows" IsChecked="True" />
        <arc:Table x:Name="Table"
                   IsStriped="{Binding #StripedSwitch.IsChecked}"
                   IsSelectable="True"
                   Caption="Projects" />
    </StackPanel>
</UserControl>
