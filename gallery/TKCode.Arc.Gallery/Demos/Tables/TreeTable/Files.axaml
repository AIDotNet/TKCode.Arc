<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.TreeTableFilesDemo">
    <StackPanel Spacing="12" MaxWidth="720">
        <arc:TreeTable x:Name="Table"
                       Caption="Files"
                       MaxHeight="300"
                       RowActivated="OnRowActivated" />
        <TextBlock x:Name="Status"
                   Text="Click a file, or press Enter on one. Narrow the window to hide the Modified column."
                   FontSize="14"
                   TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
    </StackPanel>
</UserControl>
