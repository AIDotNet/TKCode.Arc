<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.TreeViewDataWithChildrenSelectorDemo">
    <StackPanel Spacing="12">
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:Button Content="Expand all" Variant="Secondary" Size="Small" Click="OnExpandAllClick" />
            <arc:Button Content="Collapse all" Variant="Secondary" Size="Small" Click="OnCollapseAllClick" />
            <arc:Button Content="Select globals.css" Variant="Ghost" Size="Small" Click="OnRevealClick" />
        </WrapPanel>
        <arc:TreeView x:Name="Tree"
                      HorizontalAlignment="Left"
                      Width="300"
                      SelectionChanged="OnSelectionChanged" />
        <TextBlock x:Name="Selected"
                   Text="SelectedItem: (none)"
                   FontSize="14"
                   TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
    </StackPanel>
</UserControl>
