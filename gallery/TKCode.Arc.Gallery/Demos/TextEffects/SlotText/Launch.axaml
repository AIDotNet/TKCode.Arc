<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SlotTextLaunchDemo">
    <StackPanel Spacing="16" HorizontalAlignment="Center">
        <arc:SlotText x:Name="Word" Value="Ready" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <arc:Button Content="Next word" Variant="Secondary" HorizontalAlignment="Center" Click="OnNext" />
    </StackPanel>
</UserControl>
