<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.TextMorphPrefixAndSuffixDemo">
    <StackPanel Spacing="16">
        <arc:TextMorph x:Name="Price"
                       Text="$12 / month"
                       FontSize="20"
                       Matching="PrefixSuffix" />
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:Button Content="Change plan" Variant="Secondary" Click="OnChangePlanClick" />
        </WrapPanel>
    </StackPanel>
</UserControl>
