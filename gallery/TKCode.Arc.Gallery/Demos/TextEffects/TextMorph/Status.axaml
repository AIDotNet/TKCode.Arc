<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.TextMorphStatusDemo">
    <StackPanel Spacing="16">
        <arc:TextMorph x:Name="Status" Text="Deploy" FontSize="28" />
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:Button Content="Next status" Variant="Secondary" Click="OnNextClick" />
        </WrapPanel>
    </StackPanel>
</UserControl>
