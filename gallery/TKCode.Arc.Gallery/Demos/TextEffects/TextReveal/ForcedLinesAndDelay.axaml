<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.TextRevealForcedLinesAndDelayDemo">
    <StackPanel Spacing="16">
        <arc:TextReveal x:Name="Lines"
                        Text="Ship the quiet details.&#10;Keep the motion honest."
                        Level="H2"
                        Delay="0:0:0.2" />
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:Button Content="Replay" Variant="Secondary" Click="OnReplayClick" />
        </WrapPanel>
    </StackPanel>
</UserControl>
