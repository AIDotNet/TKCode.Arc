<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.TextRevealHeroDemo">
    <StackPanel Spacing="16">
        <arc:TextReveal x:Name="Hero"
                        Text="Interfaces that feel considered from the first frame"
                        Level="H1" />
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
            <arc:Button Content="Replay" Variant="Secondary" Click="OnReplayClick" />
        </WrapPanel>
    </StackPanel>
</UserControl>
