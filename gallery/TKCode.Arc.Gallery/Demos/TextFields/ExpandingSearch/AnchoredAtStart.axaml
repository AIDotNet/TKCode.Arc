<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             xmlns:generic="using:System.Collections.Generic"
             x:Class="TKCode.Arc.Gallery.Demos.ExpandingSearchAnchoredAtStartDemo">
    <Border Width="420" HorizontalAlignment="Left">
        <arc:ExpandingSearch Label="Find a dashboard"
                             Anchor="Start"
                             ExpandedWidth="300">
            <arc:ExpandingSearch.ItemsSource>
                <generic:List x:TypeArguments="arc:ExpandingSearchItem">
                    <arc:ExpandingSearchItem Id="revenue"
                                             Title="Revenue dashboard"
                                             Meta="Dashboard · Updated daily"
                                             Group="Dashboards"
                                             Icon="{x:Static arc:ArcIcons.ChartBar}" />
                    <arc:ExpandingSearchItem Id="growth"
                                             Title="Growth funnel"
                                             Meta="Dashboard · Weekly"
                                             Group="Dashboards"
                                             Icon="{x:Static arc:ArcIcons.ChartBar}" />
                </generic:List>
            </arc:ExpandingSearch.ItemsSource>
        </arc:ExpandingSearch>
    </Border>
</UserControl>
