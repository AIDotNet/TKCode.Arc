<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.InlineEditRenameDemo">
    <StackPanel Spacing="16">
        <arc:InlineEdit x:Name="ProjectName"
                        Label="Project name"
                        Value="Atlas redesign"
                        HeadingLevel="2"
                        TextCommitted="OnTextCommitted"
                        Saved="OnSaved"
                        SaveFailed="OnSaveFailed" />
        <arc:Switch x:Name="FailNext" Content="Fail the next save" />
        <TextBlock x:Name="Log"
                   Text="Click the title to rename it."
                   FontSize="14"
                   TextWrapping="Wrap"
                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
    </StackPanel>
</UserControl>
