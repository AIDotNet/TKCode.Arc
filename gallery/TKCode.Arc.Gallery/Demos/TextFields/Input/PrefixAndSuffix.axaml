<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.InputPrefixAndSuffixDemo">
    <StackPanel Spacing="16">
        <arc:Input Label="Site"
                   Placeholder="example.com"
                   Width="360"
                   HorizontalAlignment="Left">
            <arc:Input.Prefix>
                <TextBlock Text="https://"
                           FontSize="14"
                           Foreground="{arc:ArcDesignTokenResource TextMuted}" />
            </arc:Input.Prefix>
        </arc:Input>
        <arc:Input Label="Price"
                   Text="49"
                   Width="360"
                   HorizontalAlignment="Left">
            <arc:Input.Prefix>
                <TextBlock Text="$"
                           FontSize="14"
                           Foreground="{arc:ArcDesignTokenResource TextMuted}" />
            </arc:Input.Prefix>
            <arc:Input.Suffix>
                <TextBlock Text="USD"
                           FontSize="14"
                           Foreground="{arc:ArcDesignTokenResource TextMuted}" />
            </arc:Input.Suffix>
        </arc:Input>
    </StackPanel>
</UserControl>
