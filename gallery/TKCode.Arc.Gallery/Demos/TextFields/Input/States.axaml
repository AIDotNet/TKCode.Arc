<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.InputStatesDemo">
    <StackPanel Spacing="16">
        <arc:Input Label="Disabled"
                   Text="Not editable right now"
                   IsEnabled="False"
                   Width="360"
                   HorizontalAlignment="Left" />
        <arc:Input Label="Read-only"
                   Text="ws_7f3a9c"
                   IsReadOnly="True"
                   Description="Copy it, but it cannot change."
                   Width="360"
                   HorizontalAlignment="Left" />
        <arc:Input Label="Website"
                   Text="example"
                   ErrorMessage="Enter a full address, like https://example.com."
                   Width="360"
                   HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
