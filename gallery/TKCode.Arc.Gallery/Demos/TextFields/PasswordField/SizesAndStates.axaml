<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.PasswordFieldSizesAndStatesDemo">
    <StackPanel Spacing="16">
        <arc:PasswordField Label="Small"
                           Size="Small"
                           Text="secret"
                           Width="360"
                           HorizontalAlignment="Left" />
        <arc:PasswordField Label="Disabled"
                           Text="secret"
                           IsEnabled="False"
                           Width="360"
                           HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
