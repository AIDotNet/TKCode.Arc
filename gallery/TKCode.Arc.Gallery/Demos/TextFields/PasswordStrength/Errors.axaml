<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.PasswordStrengthErrorsDemo">
    <StackPanel Spacing="16">
        <arc:PasswordStrength x:Name="Password"
                              Label="Password"
                              Text="password"
                              Width="400"
                              HorizontalAlignment="Left" />
        <arc:Button Content="Submit"
                    Variant="Secondary"
                    HorizontalAlignment="Left"
                    Click="OnSubmitClick" />
    </StackPanel>
</UserControl>
