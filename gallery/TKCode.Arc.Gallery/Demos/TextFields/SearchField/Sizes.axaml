<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SearchFieldSizesDemo">
    <StackPanel Spacing="16">
        <arc:SearchField Label="Small"
                         Size="Small"
                         Placeholder="Search"
                         Width="360"
                         HorizontalAlignment="Left" />
        <arc:SearchField Label="Large"
                         Size="Large"
                         Text="Roadmap"
                         Width="360"
                         HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
