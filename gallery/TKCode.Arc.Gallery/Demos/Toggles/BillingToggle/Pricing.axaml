<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.BillingTogglePricingDemo">
    <StackPanel Spacing="28">
        <arc:BillingToggle x:Name="Toggle"
                           Value="yearly"
                           HorizontalAlignment="Center"
                           ValueChanged="OnValueChanged" />
        <WrapPanel HorizontalAlignment="Center" ItemSpacing="32" LineSpacing="16">
            <StackPanel Spacing="6">
                <TextBlock Text="Starter" FontSize="14" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                <arc:BillingPrice x:Name="StarterPrice" />
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Text="Pro" FontSize="14" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                <arc:BillingPrice x:Name="ProPrice" />
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Text="Team" FontSize="14" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                <arc:BillingPrice x:Name="TeamPrice" />
            </StackPanel>
        </WrapPanel>
    </StackPanel>
</UserControl>
