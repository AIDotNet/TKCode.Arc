<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.CheckboxIndeterminateParentDemo">
    <StackPanel HorizontalAlignment="Center">
        <arc:Checkbox x:Name="All" Content="All channels" CheckedStateChanged="OnAllChanged" />
        <arc:Checkbox x:Name="Email"
                      Content="Email"
                      Margin="28,0,0,0"
                      CheckedStateChanged="OnChildChanged" />
        <arc:Checkbox x:Name="Push"
                      Content="Push notifications"
                      Margin="28,0,0,0"
                      CheckedStateChanged="OnChildChanged" />
        <arc:Checkbox x:Name="Sms"
                      Content="SMS"
                      Margin="28,0,0,0"
                      CheckedStateChanged="OnChildChanged" />
    </StackPanel>
</UserControl>
