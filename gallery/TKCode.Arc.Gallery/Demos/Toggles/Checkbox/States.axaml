<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.CheckboxStatesDemo">
    <WrapPanel HorizontalAlignment="Center" ItemSpacing="12" LineSpacing="12">
        <arc:Checkbox Content="Disabled" IsEnabled="False" />
        <arc:Checkbox Content="Disabled checked" IsChecked="True" IsEnabled="False" />
        <arc:Checkbox Content="Required"
                      Description="Check this box to continue."
                      IsInvalid="True"
                      IsRequired="True" />
        <arc:Checkbox />
    </WrapPanel>
</UserControl>
