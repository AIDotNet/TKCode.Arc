<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.RadioGroupPlansDemo">
    <StackPanel Spacing="12" HorizontalAlignment="Center">
        <arc:RadioGroup x:Name="Plans" Header="Plan" Width="420" SelectedValue="pro">
            <arc:RadioOption Value="hobby" Label="Hobby" Description="For side projects and experiments." />
            <arc:RadioOption Value="pro" Label="Pro" Description="For professionals who ship every week." />
            <arc:RadioOption Value="team"
                             Label="Team"
                             Description="Shared workspaces, roles and audit logs for growing teams." />
        </arc:RadioGroup>
        <TextBlock FontSize="12"
                   Foreground="{arc:ArcDesignTokenResource TextMuted}"
                   Text="{Binding #Plans.SelectedValue, StringFormat='Selected: {0}'}" />
    </StackPanel>
</UserControl>
