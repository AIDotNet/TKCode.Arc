<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SegmentedControlViewSwitcherDemo">
    <arc:SegmentedControl AutomationProperties.Name="Range"
                          HorizontalAlignment="Center"
                          SelectedValue="week">
        <arc:SegmentedOption Value="day" Label="Day" />
        <arc:SegmentedOption Value="week" Label="Week" />
        <arc:SegmentedOption Value="month" Label="Month" />
    </arc:SegmentedControl>
</UserControl>
