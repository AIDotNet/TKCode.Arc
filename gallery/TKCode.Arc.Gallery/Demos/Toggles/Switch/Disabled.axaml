<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.SwitchDisabledDemo">
    <WrapPanel HorizontalAlignment="Center" ItemSpacing="16" LineSpacing="12">
        <arc:Switch Content="Off and disabled" IsEnabled="False" />
        <arc:Switch Content="On and disabled" IsChecked="True" IsEnabled="False" />
    </WrapPanel>
</UserControl>
