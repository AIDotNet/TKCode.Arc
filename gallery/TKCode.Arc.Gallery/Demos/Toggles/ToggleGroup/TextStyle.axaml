<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.ToggleGroupTextStyleDemo">
    <arc:ToggleGroup Label="Text style"
                     Mode="Multiple"
                     SelectedValues="bold,italic"
                     HorizontalAlignment="Center">
        <arc:ToggleGroupOption Value="bold" Label="Bold" Icon="{x:Static arc:ArcIcons.Bold}" />
        <arc:ToggleGroupOption Value="italic" Label="Italic" Icon="{x:Static arc:ArcIcons.Italic}" />
        <arc:ToggleGroupOption Value="underline" Label="Underline" Icon="{x:Static arc:ArcIcons.Underline}" />
    </arc:ToggleGroup>
</UserControl>
