<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:demos="using:TKCode.Arc.Gallery.Demos"
             x:Class="TKCode.Arc.Gallery.Demos.VideoPlayerPlaybackDemo">
    <!-- Which playback backend this app uses, what it can play, and how frames reach the screen. Without a platform
         backend the player shows a generated test picture and keeps time silently. -->
    <StackPanel Spacing="12" MaxWidth="720">
        <arc:VideoPlayer x:Name="Player"
                         Title="Aurora"
                         AspectRatio="1.7778"
                         Source="{x:Static demos:VideoDemoMedia.Aurora}"
                         Poster="{x:Static demos:VideoDemoMedia.AuroraPoster}" />
        <!-- In a browser: draw frames in the canvas (Canvas) or show the browser's own video element (Native). -->
        <arc:Switch x:Name="NativeSwitch" Content="Native presentation (browser)" IsVisible="False" />
        <SelectableTextBlock x:Name="Info" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
