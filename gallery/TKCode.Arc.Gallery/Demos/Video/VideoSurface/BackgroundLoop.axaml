<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.VideoSurfaceBackgroundLoopDemo">
    <!-- A muted, looping picture behind a card: VideoSurface clips to its corners and other controls draw over it.
         With reduced motion the clip does not start; the first frame stays. -->
    <Grid MaxWidth="720" Height="320">
        <arc:VideoSurface x:Name="Surface" Stretch="UniformToFill" CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}" />
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="24" Padding="20,16" MaxWidth="320"
                Background="{arc:ArcDesignTokenResource Surface}"
                CornerRadius="{arc:ArcDesignTokenResource RadiusStep12}"
                BoxShadow="{arc:ArcDesignTokenResource ShadowRaised}">
            <StackPanel Spacing="6">
                <TextBlock FontSize="{arc:ArcDesignTokenResource TypeLG}" FontWeight="SemiBold" Text="Aurora" />
                <TextBlock TextWrapping="Wrap" Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                           Text="Three chapters of light, drawn as video under ordinary controls." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
