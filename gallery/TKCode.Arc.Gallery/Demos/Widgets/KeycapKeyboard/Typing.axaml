<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.KeycapKeyboardTypingDemo">
    <!-- Tracking="Window" mirrors every key pressed in the window, here while typing in the field. Presses are watched, never taken. -->
    <StackPanel Spacing="14" MaxWidth="560" HorizontalAlignment="Center">
        <arc:Input Placeholder="Type here and watch the keys" />
        <arc:KeycapKeyboard Tracking="Window" IsClickable="False" KeySize="34" Label="Keys being pressed" />
    </StackPanel>
</UserControl>
