<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="TKCode.Arc.Gallery.Demos.WorkflowCanvasPanZoomDemo">
    <!-- A larger workflow in a fixed-height canvas: drag to pan, scroll to pan, Ctrl + scroll or pinch to zoom.
         The zoom bar sits over the bottom-left corner. -->
    <Panel Height="420">
        <arc:WorkflowCanvas x:Name="Canvas"
                            AutoFit="Fit"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                            BorderThickness="1" />
        <arc:WorkflowZoomControls Target="{Binding #Canvas}"
                                  Margin="12"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Bottom" />
    </Panel>
</UserControl>
