<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(ArcTargetFrameworks)</TargetFrameworks>
        <RootNamespace>TKCode.Arc.Gallery</RootNamespace>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);CS0436</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="AtomUI.Desktop.Controls" />
        <ProjectReference Include="../../src/TKCode.Arc/TKCode.Arc.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.Blocks/TKCode.Arc.Blocks.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.Mobile/TKCode.Arc.Mobile.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.Special/TKCode.Arc.Special.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.AdvancedCharts/TKCode.Arc.AdvancedCharts.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.Workflow/TKCode.Arc.Workflow.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.Themes.Corners/TKCode.Arc.Themes.Corners.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.Themes.Pixel/TKCode.Arc.Themes.Pixel.csproj" />
        <ProjectReference Include="../TKCode.Arc.Gallery.Shots/TKCode.Arc.Gallery.Shots.csproj" />
        <ProjectReference Include="../TKCode.Arc.Gallery.Content/TKCode.Arc.Gallery.Content.csproj" />
        <ProjectReference Include="../TKCode.Arc.Gallery.Generators/TKCode.Arc.Gallery.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
    </ItemGroup>

    <!-- The brand logo (Shell/GalleryBrand.cs). -->
    <ItemGroup>
        <AvaloniaResource Include="Assets/*.png" />
    </ItemGroup>


    <!-- Docs screenshots (GalleryShotView): Docs/<Category>/<Component>/images/<Name>.png and <Name>.dark.png, captured
         by tools/docshots from the XAML block under each ![caption](images/<Name>.png) line. They are resources of
         TKCode.Arc.Gallery.Shots (GalleryDocs.ScreenshotUri), which reads them from this folder. -->

    <!-- The Docs section of the sidebar (GalleryGuides) and the docs pages' Markdown are read at run time (Docs/GalleryTexts) from
         TKCode.Arc.Gallery.Content, which holds them as resources; the generator below still reads the docs pages to check them. -->

    <!-- Docs pages (design/decisions/0012-gallery-docs.md): pages and API translations go to GalleryDocsGenerator, which
         also collects the Demos/**/*.axaml views that <Demo name="..." /> lines show (Avalonia passes them in).
         The API translations stay out of Localization/ folders, which AtomUI's language build owns. -->
    <ItemGroup>
        <AdditionalFiles Include="Docs/**/*.md" GalleryDocKind="Page" />
        <AdditionalFiles Include="Docs/Api/*.xlf" GalleryDocKind="ApiTranslation" />
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="GalleryDocKind" />
        <!-- Demos are found under, and shown relative to, this project's folder. -->
        <CompilerVisibleProperty Include="ProjectDir" />
    </ItemGroup>

    <!-- A demo without a code-behind gets its view class from GalleryDocsGenerator. Avalonia's name generator cannot see
         that class and would warn (AXN0001) that the x:Class does not exist, so those files are retagged after Avalonia
         adds them as additional files (_InjectAvaloniaAdditionalFiles, Avalonia 12.1): it reads only SourceItemGroup=AvaloniaXaml.
         The XAML compiler still compiles them; it reads @(AvaloniaXaml). -->
    <Target Name="HideGeneratedDemoViewsFromAvaloniaNameGenerator" AfterTargets="_InjectAvaloniaAdditionalFiles">
        <PropertyGroup>
            <_GalleryDemosFolder>$([System.String]::Copy('$(MSBuildProjectDirectory)/Demos/').Replace('\', '/'))</_GalleryDemosFolder>
        </PropertyGroup>
        <ItemGroup>
            <AdditionalFiles Condition="'%(AdditionalFiles.SourceItemGroup)' == 'AvaloniaXaml' And $([System.String]::Copy('%(AdditionalFiles.FullPath)').Replace('\', '/').StartsWith('$(_GalleryDemosFolder)')) And !Exists('%(AdditionalFiles.FullPath).cs')">
                <SourceItemGroup>GalleryDemo</SourceItemGroup>
            </AdditionalFiles>
        </ItemGroup>
    </Target>

    <!-- The compiler does not load the XML documentation of references, so the documentation files of every referenced
         TKCode.Arc assembly (TKCode.Arc, .Core, .Illustrations, .Blocks, …) are passed to the generator as additional files. -->
    <Target Name="AddArcDocumentationToGalleryDocs" AfterTargets="ResolveAssemblyReferences" BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun;CoreCompile">
        <ItemGroup>
            <_GalleryArcReference Include="@(ReferencePath)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('TKCode.Arc'))" />
            <_GalleryArcDocumentation Include="@(_GalleryArcReference->'%(RootDir)%(Directory)%(Filename).xml')" />
            <AdditionalFiles Include="@(_GalleryArcDocumentation)" Condition="Exists('%(FullPath)')" GalleryDocKind="XmlDoc" />
        </ItemGroup>
    </Target>
</Project>
