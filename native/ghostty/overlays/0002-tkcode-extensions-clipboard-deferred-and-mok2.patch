diff --git a/src/terminal/c/terminal.zig b/src/terminal/c/terminal.zig
index 06cab9b..45d3cda 100644
--- a/src/terminal/c/terminal.zig
+++ b/src/terminal/c/terminal.zig
@@ -7415,3 +7415,28 @@ test "get mouse_shape" {
     try testing.expectEqual(Result.success, get(t, .mouse_shape, @ptrCast(&shape)));
     try testing.expectEqual(mouse.Shape.wait, shape);
 }
+
+// ---------------------------------------------------------------------------
+// TKCode overlays O3 / O4. Exported with a `tkcode_ghostty_` prefix so they never
+// collide with upstream symbols. See TKCode docs/terminal/02-core-ghostty.md §2.4.
+
+/// O3: enable or disable deferred OSC 52 clipboard read replies.
+pub fn tkcode_set_clipboard_read_deferred(terminal_: Terminal, deferred: bool) callconv(lib.calling_conv) void {
+    const wrapper = terminal_ orelse return;
+    wrapper.stream.handler.clipboard_read_deferred = deferred;
+}
+
+/// O3: terminator of the most recent clipboard read request: 0 = ST, 1 = BEL.
+pub fn tkcode_clipboard_read_terminator(terminal_: Terminal) callconv(lib.calling_conv) u8 {
+    const wrapper = terminal_ orelse return 0;
+    return switch (wrapper.stream.handler.clipboard_read_terminator) {
+        .st => 0,
+        .bel => 1,
+    };
+}
+
+/// O4: whether xterm modifyOtherKeys level 2 is active (CSI > 4 ; 2 m).
+pub fn tkcode_modify_other_keys_2(terminal_: Terminal) callconv(lib.calling_conv) bool {
+    const wrapper = terminal_ orelse return false;
+    return wrapper.terminal.flags.modify_other_keys_2;
+}
