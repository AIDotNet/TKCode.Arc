+/// TKCode overlay O5: mark the row above the cursor dirty (its last cell was
+/// changed, e.g. a stale spacer_head cleared when overwriting a wrapped wide char).
+pub fn cursorPrevRowMarkDirty(self: *Screen) void {
+    assert(self.cursor.y > 0);
+    const page_pin = self.cursor.page_pin.up(1).?;
+    page_pin.rowAndCell().row.dirty = true;
+}
