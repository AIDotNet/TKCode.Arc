<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.AgentTasksTheme">

    <!--
        The board: Surface, 1px Border, RadiusPanel. The head holds the title, the running / waiting summary and the agent
        chips; under it four columns on SurfaceMuted with their cards. At 720 wide or less (:compact) the columns stack.
    -->
    <ControlTheme x:Key="{x:Type arc:AgentTasks}" TargetType="arc:AgentTasks">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="CompactWidth" Value="{arc:AgentTasksTokenResource CompactWidth}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
        <Setter Property="Padding" Value="{arc:AgentTasksTokenResource BoardPadding}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AgentTasks">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        TextElement.FontSize="{TemplateBinding FontSize}"
                        TextElement.Foreground="{TemplateBinding Foreground}">
                    <Panel>
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="2">
                                    <TextBlock Name="PART_Title"
                                               FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                               FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                               AutomationProperties.HeadingLevel="2" />
                                    <TextBlock Name="PART_Summary"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                               FontFeatures="tnum"
                                               Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                </StackPanel>
                                <WrapPanel Name="PART_Filters" ItemSpacing="6" LineSpacing="6" />
                            </StackPanel>
                            <Grid Name="PART_Board" Margin="-6,0" />
                        </StackPanel>
                        <arc:AiAnnouncer Name="PART_Announcer" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- A column: title with its count, then the cards, on SurfaceMuted. -->
    <ControlTheme x:Key="{x:Type arc:AgentTasksColumn}" TargetType="arc:AgentTasksColumn">
        <Setter Property="Margin" Value="{arc:AgentTasksTokenResource ColumnMargin}" />
        <Setter Property="Padding" Value="{arc:AgentTasksTokenResource ColumnPadding}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep20}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AgentTasksColumn">
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <StackPanel Spacing="{arc:AgentTasksTokenResource CardGap}">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,2,4,0">
                            <TextBlock Text="{TemplateBinding Title}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                       AutomationProperties.HeadingLevel="3" />
                            <TextBlock Text="{TemplateBinding CountText}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       FontFeatures="tnum"
                                       Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                        </StackPanel>
                        <StackPanel Name="PART_Cards" Spacing="{arc:AgentTasksTokenResource CardGap}" />
                        <TextBlock Name="PART_Empty"
                                   Text="{TemplateBinding EmptyText}"
                                   IsVisible="False"
                                   Margin="4,0,4,6"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:empty /template/ TextBlock#PART_Empty">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>

    <!-- A card: title, note, progress (running), agent and time. -->
    <ControlTheme x:Key="{x:Type arc:AgentTasksCard}" TargetType="arc:AgentTasksCard">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        <Setter Property="Padding" Value="{arc:AgentTasksTokenResource CardPadding}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep14}" />
        <Setter Property="RingRadius" Value="RadiusStep17" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AgentTasksCard">
                <Panel Name="PART_RingHost">
                    <Border Name="PART_Face"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{TemplateBinding Title}"
                                       FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                       FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}"
                                       LineHeight="19"
                                       MaxLines="2"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Name="PART_Note"
                                       Text="{TemplateBinding Note}"
                                       IsVisible="{TemplateBinding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       LineHeight="16"
                                       MaxLines="2"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" />
                            <Grid Name="PART_ProgressRow" ColumnDefinitions="*,Auto" IsVisible="False">
                                <arc:AiAgentMeter Height="{arc:AgentTasksTokenResource ProgressHeight}"
                                                  Value="{TemplateBinding Progress}"
                                                  Fill="{arc:ArcDesignTokenResource Accent}"
                                                  Track="{arc:ArcDesignTokenResource BorderSubtle}"
                                                  VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           Text="{TemplateBinding ProgressText}"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           FontFeatures="tnum"
                                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <arc:Avatar DisplayName="{TemplateBinding Agent}" Size="Small" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Margin="6,0,0,0"
                                           Text="{TemplateBinding Agent}"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                                    <Border Name="PART_Status"
                                            Padding="6,1"
                                            CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                                            IsVisible="False"
                                            VerticalAlignment="Center">
                                        <TextBlock Name="PART_StatusText"
                                                   Text="{TemplateBinding StatusText}"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                                    </Border>
                                    <TextBlock Text="{TemplateBinding UpdatedText}"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ TextBlock#PART_Note">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="^:running /template/ Grid#PART_ProgressRow">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:needs-input /template/ Border#PART_Status">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource WarningSubtle}" />
        </Style>
        <Style Selector="^:needs-input /template/ TextBlock#PART_StatusText">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Warning}" />
        </Style>
        <Style Selector="^:failed /template/ Border#PART_Status">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource DangerSubtle}" />
        </Style>
        <Style Selector="^:failed /template/ TextBlock#PART_StatusText">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
        </Style>
        <Style Selector="^:failed /template/ TextBlock#PART_Note">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
        </Style>
        <Style Selector="^:done">
            <Setter Property="Opacity" Value="0.75" />
        </Style>
        <Style Selector="^:hover">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#PART_Face">
            <Setter Property="RenderTransform" Value="scale(0.99)" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="BorderBrush" Tween="Fast" />
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Standard" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-full /template/ Border#PART_Face">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:SpringTransformOperationsTransition Property="RenderTransform" Spring="Snappy" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="BorderBrush" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- An agent filter chip: a pill; the selected one in the foreground color. -->
    <ControlTheme x:Key="{x:Type arc:AgentTasksChip}" TargetType="arc:AgentTasksChip">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="Padding" Value="{arc:AgentTasksTokenResource ChipPadding}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="RingRadius" Value="RadiusPill" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AgentTasksChip">
                <Panel Name="PART_RingHost">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:hover">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Surface}" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                    <arc:ArcBrushTransition Property="Foreground" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
