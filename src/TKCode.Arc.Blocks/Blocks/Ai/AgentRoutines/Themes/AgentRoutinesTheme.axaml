<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.AgentRoutinesTheme">

    <!--
        The list: Surface, 1px Border, RadiusPanel; the head (title and active count), then one row per routine split
        by 1px lines: switch, header (name, agent, schedule and next run), history strip, Run now; the detail opens under.
    -->
    <ControlTheme x:Key="{x:Type arc:AgentRoutines}" TargetType="arc:AgentRoutines">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="MaxWidth" Value="{arc:AgentRoutinesTokenResource MaxWidth}" />
        <Setter Property="CompactWidth" Value="{arc:AgentRoutinesTokenResource CompactWidth}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AgentRoutines">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        TextElement.FontSize="{TemplateBinding FontSize}"
                        TextElement.Foreground="{TemplateBinding Foreground}">
                    <Panel>
                        <StackPanel>
                            <StackPanel Spacing="2" Margin="{arc:AgentRoutinesTokenResource RowPadding}">
                                <TextBlock Name="PART_Title"
                                           FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                           FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                           AutomationProperties.HeadingLevel="2" />
                                <TextBlock Name="PART_Summary"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           FontFeatures="tnum"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                            </StackPanel>
                            <StackPanel Name="PART_List" />
                        </StackPanel>
                        <arc:AiAnnouncer Name="PART_Announcer" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- A routine row. -->
    <ControlTheme x:Key="{x:Type arc:AgentRoutinesItem}" TargetType="arc:AgentRoutinesItem">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Padding" Value="{arc:AgentRoutinesTokenResource RowPadding}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AgentRoutinesItem">
                <Border BorderThickness="{arc:ArcDesignTokenResource EdgeThicknessTop}"
                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                        Padding="{TemplateBinding Padding}">
                    <StackPanel>
                        <Grid Name="PART_Row" ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
                            <arc:Switch Name="PART_Switch" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <arc:AgentRoutinesHeader Name="PART_Header" Grid.Column="1" />
                            <arc:AgentRoutinesHistory Name="PART_History"
                                                      Height="{arc:AgentRoutinesTokenResource HistoryHeight}"
                                                      VerticalAlignment="Center"
                                                      Margin="12,0"
                                                      SuccessBrush="{arc:ArcDesignTokenResource Success}"
                                                      FailureBrush="{arc:ArcDesignTokenResource Danger}"
                                                      SkipBrush="{arc:ArcDesignTokenResource BorderStrong}" />
                            <arc:Button Name="PART_Run" Size="Small" Variant="Secondary" VerticalAlignment="Center" />
                        </Grid>
                        <arc:AiCollapsible Name="PART_Detail" CrossClipOverflow="4" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ arc|AgentRoutinesHistory#PART_History">
            <Setter Property="Grid.Column" Value="2" />
        </Style>
        <Style Selector="^ /template/ arc|Button#PART_Run">
            <Setter Property="Grid.Column" Value="3" />
        </Style>
        <Style Selector="^ /template/ arc|AiCollapsible#PART_Detail">
            <Setter Property="ContentMargin" Value="56,6,0,0" />
        </Style>
        <Style Selector="^:paused /template/ arc|AgentRoutinesHeader#PART_Header">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="^:compact /template/ arc|AgentRoutinesHistory#PART_History">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="8,8,0,0" />
        </Style>
        <Style Selector="^:compact /template/ arc|Button#PART_Run">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style Selector="^:compact /template/ arc|AiCollapsible#PART_Detail">
            <Setter Property="ContentMargin" Value="0,6,0,0" />
        </Style>
    </ControlTheme>

    <!-- A routine's header: name and agent over schedule · next run, and a chevron. -->
    <ControlTheme x:Key="{x:Type arc:AgentRoutinesHeader}" TargetType="arc:AgentRoutinesHeader">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep12}" />
        <Setter Property="RingRadius" Value="RadiusStep15" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AgentRoutinesHeader">
                <Panel Name="PART_RingHost">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <arc:ArcShrinkRow Spacing="8">
                                    <TextBlock Text="{TemplateBinding Title}"
                                               FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                               TextTrimming="CharacterEllipsis"
                                               arc:ArcShrinkRow.IsShrinkable="True" />
                                    <TextBlock Text="{TemplateBinding Agent}"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                               VerticalAlignment="Center" />
                                </arc:ArcShrinkRow>
                                <arc:ArcShrinkRow Spacing="6">
                                    <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Clock}" Size="12" VerticalAlignment="Center"
                                                  Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                    <TextBlock Text="{TemplateBinding ScheduleText}"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis"
                                               arc:ArcShrinkRow.IsShrinkable="True" />
                                    <TextBlock Text="·" FontSize="{arc:ArcDesignTokenResource TypeXS}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                    <TextBlock Text="{TemplateBinding StatusText}"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                               Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                </arc:ArcShrinkRow>
                            </StackPanel>
                            <arc:ArcGlyph Name="PART_Chevron"
                                          Grid.Column="1"
                                          Data="{x:Static arc:ArcIcons.ChevronDown}"
                                          Size="14"
                                          Margin="8,0,0,0"
                                          Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                          RenderTransform="rotate(0deg)"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:hover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:expanded /template/ arc|ArcGlyph#PART_Chevron">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Standard" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-full /template/ arc|ArcGlyph#PART_Chevron">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:SpringTransformOperationsTransition Property="RenderTransform" Spring="Snappy" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
