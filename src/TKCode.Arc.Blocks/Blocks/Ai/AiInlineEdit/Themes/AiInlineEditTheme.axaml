<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.AiInlineEditTheme">

    <!--
        The editor: Surface, 1px Border, RadiusPanel. The paragraph on top (selectable while idle; with the selection
        tinted, or the changes and their buttons, while editing), and one bar under it whose content follows the phase:
        the hint and Edit with AI; the instruction field with the quick instructions; or the review line with Accept all
        and Reject all.
    -->
    <ControlTheme x:Key="{x:Type arc:AiInlineEdit}" TargetType="arc:AiInlineEdit">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="MaxWidth" Value="{arc:AiInlineEditTokenResource MaxWidth}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeBase}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AiInlineEdit">
                <Border Name="PART_Card"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Panel>
                        <StackPanel>
                            <Panel Margin="{arc:AiInlineEditTokenResource DocumentPadding}">
                                <SelectableTextBlock Name="PART_Source"
                                                     Text="{TemplateBinding Text}"
                                                     FontSize="{TemplateBinding FontSize}"
                                                     Foreground="{TemplateBinding Foreground}"
                                                     LineHeight="{arc:AiInlineEditTokenResource LineHeight}"
                                                     SelectionBrush="{arc:ArcDesignTokenResource AccentSubtle}"
                                                     TextWrapping="Wrap" />
                                <TextBlock Name="PART_Document"
                                           IsVisible="False"
                                           FontSize="{TemplateBinding FontSize}"
                                           Foreground="{TemplateBinding Foreground}"
                                           LineHeight="{arc:AiInlineEditTokenResource LineHeight}"
                                           TextWrapping="Wrap" />
                            </Panel>
                            <Border Name="PART_Bar"
                                    Padding="{arc:AiInlineEditTokenResource BarPadding}"
                                    BorderThickness="{arc:ArcDesignTokenResource EdgeThicknessTop}"
                                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                    CornerRadius="{arc:ArcDesignTokenResource RadiusStep25Bottom}">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Name="PART_StatusRow">
                                        <arc:ArcGlyph Name="PART_Spark"
                                                      Data="{x:Static arc:ArcIcons.Sparkles}"
                                                      Size="14"
                                                      Margin="0,0,8,0"
                                                      Foreground="{arc:ArcDesignTokenResource Accent}"
                                                      VerticalAlignment="Center" />
                                        <TextBlock Name="PART_Status"
                                                   Grid.Column="1"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   AutomationProperties.LiveSetting="Off" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                                            <arc:Button Name="PART_Edit" Size="Small" Variant="Primary" />
                                            <arc:Button Name="PART_RejectAll" Size="Small" Variant="Ghost" />
                                            <arc:Button Name="PART_AcceptAll" Size="Small" Variant="Primary" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Name="PART_Ask" Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <arc:Input Name="PART_Instruction" />
                                            <arc:Button Name="PART_Send" Grid.Column="1" Size="Medium" Variant="Primary" Margin="8,0,0,0" />
                                            <arc:Button Name="PART_Cancel" Grid.Column="2" Size="Medium" Variant="Ghost" Margin="4,0,0,0" />
                                        </Grid>
                                        <WrapPanel Name="PART_Suggestions" ItemSpacing="6" LineSpacing="6" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <arc:AiAnnouncer Name="PART_Announcer" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
        <!-- Idle: the selectable paragraph, the hint and Edit with AI. -->
        <Style Selector="^ /template/ StackPanel#PART_Ask">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^ /template/ arc|Button#PART_AcceptAll">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^ /template/ arc|Button#PART_RejectAll">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:not(:idle) /template/ SelectableTextBlock#PART_Source">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:not(:idle) /template/ TextBlock#PART_Document">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:not(:idle) /template/ arc|Button#PART_Edit">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:instructing /template/ StackPanel#PART_Ask">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:thinking /template/ StackPanel#PART_Ask">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:thinking /template/ WrapPanel#PART_Suggestions">
            <Setter Property="IsEnabled" Value="False" />
        </Style>
        <Style Selector="^:reviewing /template/ arc|Button#PART_AcceptAll">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:reviewing /template/ arc|Button#PART_RejectAll">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:error /template/ TextBlock#PART_Status">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
        </Style>
    </ControlTheme>

    <!-- A change's accept (check) or reject (cross) button: a 20px circle, tinted on hover. -->
    <ControlTheme x:Key="{x:Type arc:AiInlineEditChangeButton}" TargetType="arc:AiInlineEditChangeButton">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Width" Value="{arc:AiInlineEditTokenResource ChangeButtonSize}" />
        <Setter Property="Height" Value="{arc:AiInlineEditTokenResource ChangeButtonSize}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="RingRadius" Value="RadiusStep14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AiInlineEditChangeButton">
                <Panel Name="PART_RingHost">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <arc:ArcGlyph Data="{TemplateBinding Glyph}"
                                      Size="{arc:AiInlineEditTokenResource ChangeGlyphSize}"
                                      StrokeThickness="2"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:accept">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Success}" />
        </Style>
        <Style Selector="^:hover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource DangerSubtle}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
        </Style>
        <Style Selector="^:accept:hover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SuccessSubtle}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Success}" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
