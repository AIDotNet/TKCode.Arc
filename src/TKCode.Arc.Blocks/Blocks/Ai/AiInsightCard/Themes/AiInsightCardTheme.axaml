<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.AiInsightCardTheme">

    <!--
        The insight card (an original TKCode design): a Surface card at most 640 wide with a 1px Border, the panel radius
        and the resting shadow. From the top: the eyebrow and the feedback thumbs, the metric (name, value, change pill,
        period), the readout and the chart, then the summary, the causes, the suggestion and the footnote. While
        :analyzing a shimmering line and placeholder lines stand in for the text. At 420 wide or less (:compact) the
        paddings tighten from 20 to 16.
    -->
    <ControlTheme x:Key="{x:Type arc:AiInsightCard}" TargetType="arc:AiInsightCard">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
        <Setter Property="Padding" Value="{arc:AiInsightCardTokenResource CardPadding}" />
        <Setter Property="CompactWidth" Value="{arc:AiInsightCardTokenResource CompactWidth}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AiInsightCard">
                <Border Name="PART_Card"
                        MaxWidth="{arc:AiInsightCardTokenResource CardMaxWidth}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{arc:ArcDesignTokenResource ShadowResting}"
                        Padding="{TemplateBinding Padding}">
                    <StackPanel Spacing="{arc:AiInsightCardTokenResource SectionGap}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Border Name="PART_Eyebrow"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Padding="{arc:AiInsightCardTokenResource EyebrowPadding}"
                                    CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                                    Background="{arc:ArcDesignTokenResource AccentSubtle}">
                                <StackPanel Orientation="Horizontal" Spacing="{arc:AiInsightCardTokenResource EyebrowGap}">
                                    <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Sparkles}"
                                                  Size="{arc:AiInsightCardTokenResource EyebrowGlyphSize}"
                                                  Foreground="{arc:ArcDesignTokenResource AccentStrong}"
                                                  VerticalAlignment="Center" />
                                    <TextBlock Name="PART_EyebrowText"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                               FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                               Foreground="{arc:ArcDesignTokenResource AccentStrong}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <StackPanel Name="PART_FeedbackBar"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="2"
                                        VerticalAlignment="Center"
                                        IsVisible="{TemplateBinding IsFeedbackVisible}">
                                <arc:Button Name="PART_Helpful" Classes="insight-icon" Variant="Ghost" Size="Small">
                                    <arc:ArcGlyph Name="PART_HelpfulGlyph" Data="{x:Static arc:ArcIcons.ThumbsUp}"
                                                  Size="{arc:AiInsightCardTokenResource GlyphSize}" />
                                </arc:Button>
                                <arc:Button Name="PART_NotHelpful" Classes="insight-icon" Variant="Ghost" Size="Small">
                                    <arc:ArcGlyph Name="PART_NotHelpfulGlyph" Data="{x:Static arc:ArcIcons.ThumbsDown}"
                                                  Size="{arc:AiInsightCardTokenResource GlyphSize}" />
                                </arc:Button>
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Name="PART_Title"
                                       Text="{TemplateBinding Title}"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                       FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                       TextTrimming="CharacterEllipsis"
                                       AutomationProperties.HeadingLevel="2" />
                            <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="4">
                                <TextBlock Name="PART_Value"
                                           Text="{TemplateBinding Value}"
                                           FontFamily="{arc:ArcDesignTokenResource DisplayFontFamily}"
                                           FontSize="{arc:ArcDesignTokenResource Type2XL}"
                                           FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                           FontFeatures="tnum"
                                           VerticalAlignment="Center" />
                                <Border Name="PART_ChangePill"
                                        VerticalAlignment="Center"
                                        Padding="{arc:AiInsightCardTokenResource ChangePadding}"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                                        IsVisible="{TemplateBinding ChangeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <arc:ArcGlyph Name="PART_ChangeGlyph"
                                                      Data="{TemplateBinding ChangeGlyph}"
                                                      Size="14"
                                                      VerticalAlignment="Center" />
                                        <TextBlock Name="PART_ChangeText"
                                                   Text="{TemplateBinding ChangeText}"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                   FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                                   FontFeatures="tnum"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Name="PART_Period"
                                           Text="{TemplateBinding PeriodText}"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                           VerticalAlignment="Center" />
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Name="PART_Readout"
                                       Text="{TemplateBinding Readout}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       FontFeatures="tnum"
                                       Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                       TextTrimming="CharacterEllipsis" />
                            <arc:AiInsightCardChart Name="PART_Chart"
                                                    Height="{arc:AiInsightCardTokenResource ChartHeight}"
                                                    LineThickness="{arc:AiInsightCardTokenResource LineThickness}"
                                                    DotRadius="{arc:AiInsightCardTokenResource DotRadius}"
                                                    AreaOpacity="{arc:AiInsightCardTokenResource AreaOpacity}"
                                                    LineBrush="{arc:ArcDesignTokenResource Accent}"
                                                    AreaBrush="{arc:ArcDesignTokenResource AccentSubtle}"
                                                    ComparisonBrush="{arc:ArcDesignTokenResource BorderStrong}"
                                                    GridBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                    BandBrush="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                    DotBrush="{arc:ArcDesignTokenResource Surface}"
                                                    FocusBrush="{arc:ArcDesignTokenResource FocusRing}" />
                        </StackPanel>

                        <StackPanel Name="PART_Analyzing" Spacing="10">
                            <arc:TextShimmer Name="PART_AnalyzingText"
                                             FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                             FontWeight="{arc:ArcDesignTokenResource WeightMedium}" />
                            <arc:Skeleton Lines="3" />
                        </StackPanel>

                        <StackPanel Name="PART_Body" Spacing="{arc:AiInsightCardTokenResource SectionGap}">
                            <StackPanel Spacing="{arc:AiInsightCardTokenResource HeadingGap}">
                                <TextBlock Name="PART_SummaryHeading" Classes="insight-heading" AutomationProperties.HeadingLevel="3" />
                                <TextBlock Name="PART_Summary"
                                           Text="{TemplateBinding Summary}"
                                           LineHeight="{arc:AiInsightCardTokenResource BodyLineHeight}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Name="PART_CausesSection" Spacing="{arc:AiInsightCardTokenResource HeadingGap}">
                                <TextBlock Name="PART_CausesHeading" Classes="insight-heading" AutomationProperties.HeadingLevel="3" />
                                <StackPanel Name="PART_Causes" Spacing="{arc:AiInsightCardTokenResource RowGap}" />
                            </StackPanel>
                            <Border Name="PART_NextStep"
                                    Padding="{arc:AiInsightCardTokenResource NextStepPadding}"
                                    CornerRadius="{arc:ArcDesignTokenResource RadiusStep14}"
                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}">
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                    <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Lightbulb}"
                                                  Size="{arc:AiInsightCardTokenResource GlyphSize}"
                                                  Foreground="{arc:ArcDesignTokenResource Accent}"
                                                  Margin="0,2,10,0"
                                                  VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Name="PART_NextStepHeading" Classes="insight-heading" AutomationProperties.HeadingLevel="3" />
                                        <TextBlock Name="PART_NextStepText"
                                                   Text="{TemplateBinding NextStep}"
                                                   LineHeight="{arc:AiInsightCardTokenResource BodyLineHeight}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <arc:Button Name="PART_Action"
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="0,12,0,0"
                                                HorizontalAlignment="Left"
                                                Variant="Primary"
                                                Size="Small"
                                                IsVisible="{TemplateBinding IsActionVisible}" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <TextBlock Name="PART_Footnote"
                                   Text="{TemplateBinding Footnote}"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   LineHeight="{arc:AiInsightCardTokenResource SmallLineHeight}"
                                   Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                   TextWrapping="Wrap"
                                   IsVisible="{TemplateBinding Footnote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <arc:AiAnnouncer Name="PART_Announcer" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:compact">
            <Setter Property="Padding" Value="{arc:AiInsightCardTokenResource CompactCardPadding}" />
        </Style>

        <Style Selector="^ /template/ TextBlock.insight-heading">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
            <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="^ /template/ arc|Button.insight-icon">
            <Setter Property="Width" Value="{arc:AiInsightCardTokenResource IconButtonSize}" />
            <Setter Property="Height" Value="{arc:AiInsightCardTokenResource IconButtonSize}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="^ /template/ arc|ArcGlyph#PART_HelpfulGlyph, ^ /template/ arc|ArcGlyph#PART_NotHelpfulGlyph">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="^:helpful /template/ arc|ArcGlyph#PART_HelpfulGlyph, ^:not-helpful /template/ arc|ArcGlyph#PART_NotHelpfulGlyph">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
        </Style>

        <!-- The change pill and the line inside the band take the change's tone. -->
        <Style Selector="^ /template/ Border#PART_ChangePill">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^ /template/ TextBlock#PART_ChangeText">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="^ /template/ arc|ArcGlyph#PART_ChangeGlyph">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="^ /template/ arc|AiInsightCardChart#PART_Chart">
            <Setter Property="ChangeBrush" Value="{arc:ArcDesignTokenResource AccentStrong}" />
        </Style>
        <Style Selector="^:good">
            <Style Selector="^ /template/ Border#PART_ChangePill">
                <Setter Property="Background" Value="{arc:ArcDesignTokenResource SuccessSubtle}" />
            </Style>
            <Style Selector="^ /template/ TextBlock#PART_ChangeText">
                <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Success}" />
            </Style>
            <Style Selector="^ /template/ arc|ArcGlyph#PART_ChangeGlyph">
                <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Success}" />
            </Style>
            <Style Selector="^ /template/ arc|AiInsightCardChart#PART_Chart">
                <Setter Property="ChangeBrush" Value="{arc:ArcDesignTokenResource Success}" />
            </Style>
        </Style>
        <Style Selector="^:bad">
            <Style Selector="^ /template/ Border#PART_ChangePill">
                <Setter Property="Background" Value="{arc:ArcDesignTokenResource DangerSubtle}" />
            </Style>
            <Style Selector="^ /template/ TextBlock#PART_ChangeText">
                <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
            </Style>
            <Style Selector="^ /template/ arc|ArcGlyph#PART_ChangeGlyph">
                <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
            </Style>
            <Style Selector="^ /template/ arc|AiInsightCardChart#PART_Chart">
                <Setter Property="ChangeBrush" Value="{arc:ArcDesignTokenResource Danger}" />
            </Style>
        </Style>

        <Style Selector="^ /template/ StackPanel#PART_Analyzing">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:analyzing">
            <Style Selector="^ /template/ StackPanel#PART_Analyzing">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^ /template/ StackPanel#PART_Body">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>
        <Style Selector="^ /template/ StackPanel#PART_CausesSection">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:has-causes /template/ StackPanel#PART_CausesSection">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^ /template/ Border#PART_NextStep">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:has-next-step /template/ Border#PART_NextStep">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^:motion-full">
            <Style Selector="^ /template/ arc|ArcGlyph#PART_HelpfulGlyph, ^ /template/ arc|ArcGlyph#PART_NotHelpfulGlyph">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcBrushTransition Property="Foreground" Tween="Fast" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ Border#PART_ChangePill">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcBrushTransition Property="Background" Tween="Standard" />
                    </Transitions>
                </Setter>
            </Style>
        </Style>
    </ControlTheme>

    <!--
        A cause row: a toggle with 12 / 10 padding and the RadiusStep14 corner. The title (14, medium) and the share
        (12, tabular) share the first line, the evidence (12 / 16.8, TextMuted) wraps under it and the 72 × 4 share bar
        sits at the end of the first line. Hover tints it SurfaceMuted; checked, it takes the soft accent.
    -->
    <ControlTheme x:Key="{x:Type arc:AiInsightCardCauseRow}" TargetType="arc:AiInsightCardCauseRow">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="{arc:AiInsightCardTokenResource RowPadding}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AiInsightCardCauseRow">
                <Panel Name="PART_Root">
                    <Border Name="PART_Face"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep14}"
                            Padding="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <TextBlock Text="{TemplateBinding Title}"
                                       FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                                <arc:AiInsightCardShareBar Width="{arc:AiInsightCardTokenResource ShareBarWidth}"
                                                           Height="{arc:AiInsightCardTokenResource ShareBarHeight}"
                                                           VerticalAlignment="Center"
                                                           Value="{TemplateBinding Share}"
                                                           TrackBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                           FillBrush="{arc:ArcDesignTokenResource Accent}" />
                                <TextBlock Text="{TemplateBinding ShareText}"
                                           MinWidth="32"
                                           TextAlignment="Right"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           FontFeatures="tnum"
                                           Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Margin="0,2,0,0"
                                       Text="{TemplateBinding Detail}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       LineHeight="{arc:AiInsightCardTokenResource SmallLineHeight}"
                                       Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                       TextWrapping="Wrap"
                                       IsVisible="{TemplateBinding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </Grid>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:checked">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
