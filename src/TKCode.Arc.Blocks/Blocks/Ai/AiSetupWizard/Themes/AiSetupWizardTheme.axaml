<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.AiSetupWizardTheme">

    <!--
        The setup wizard (an original TKCode design): a Surface card at most 860 wide with a 1px Border, the panel radius
        and the resting shadow. The title on top; a vertical stepper (220 wide) on the left of the page, which slides
        between steps; Back and Continue in a footer under a line. At 640 wide or less (:compact) the stepper turns
        horizontal above the page and the paddings tighten from 24 to 16.
    -->
    <ControlTheme x:Key="{x:Type arc:AiSetupWizard}" TargetType="arc:AiSetupWizard">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
        <Setter Property="Padding" Value="{arc:AiSetupWizardTokenResource CardPadding}" />
        <Setter Property="CompactWidth" Value="{arc:AiSetupWizardTokenResource CompactWidth}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AiSetupWizard">
                <Border Name="PART_Card"
                        MaxWidth="{arc:AiSetupWizardTokenResource WizardMaxWidth}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{arc:ArcDesignTokenResource ShadowResting}"
                        Padding="{TemplateBinding Padding}">
                    <StackPanel Spacing="{arc:AiSetupWizardTokenResource SectionGap}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="32"
                                    Height="32"
                                    CornerRadius="{arc:ArcDesignTokenResource RadiusStep10}"
                                    Background="{arc:ArcDesignTokenResource AccentSubtle}">
                                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Sparkles}"
                                              Size="18"
                                              Foreground="{arc:ArcDesignTokenResource AccentStrong}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Name="PART_Title"
                                       FontFamily="{arc:ArcDesignTokenResource DisplayFontFamily}"
                                       FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                       FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       AutomationProperties.HeadingLevel="2" />
                        </StackPanel>
                        <DockPanel>
                            <arc:Stepper Name="PART_Stepper"
                                         Orientation="Vertical"
                                         IsNavigable="True"
                                         VerticalAlignment="Top" />
                            <arc:ArcContentSwap Name="PART_Page"
                                                MinHeight="{arc:AiSetupWizardTokenResource PageMinHeight}"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Top"
                                                MeasuresExiting="True" />
                        </DockPanel>
                        <Border BorderThickness="{arc:ArcDesignTokenResource EdgeThicknessTop}"
                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                Padding="0,16,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <arc:Button Name="PART_Back" Variant="Ghost" />
                                <arc:Button Name="PART_Next" Grid.Column="2" Variant="Primary" />
                            </Grid>
                        </Border>
                        <arc:AiAnnouncer Name="PART_Announcer" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ arc|Stepper#PART_Stepper">
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="Width" Value="{arc:AiSetupWizardTokenResource StepperWidth}" />
            <Setter Property="Margin" Value="0,0,32,0" />
        </Style>
        <Style Selector="^:compact">
            <Setter Property="Padding" Value="{arc:AiSetupWizardTokenResource CompactCardPadding}" />
            <Style Selector="^ /template/ arc|Stepper#PART_Stepper">
                <Setter Property="DockPanel.Dock" Value="Top" />
                <Setter Property="Width" Value="NaN" />
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>
        </Style>
        <Style Selector="^:first /template/ arc|Button#PART_Back">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:completed /template/ arc|Button#PART_Back, ^:completed /template/ arc|Button#PART_Next">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ControlTheme>

    <!-- A test check: an 18px status glyph (muted circle, spinner, green check, red cross) and its name. -->
    <ControlTheme x:Key="{x:Type arc:AiSetupWizardCheckRow}" TargetType="arc:AiSetupWizardCheckRow">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AiSetupWizardCheckRow">
                <Grid ColumnDefinitions="Auto,*">
                    <Panel Width="{arc:AiSetupWizardTokenResource CheckGlyphSize}"
                           Height="{arc:AiSetupWizardTokenResource CheckGlyphSize}"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center">
                        <arc:ArcGlyph Name="PART_Pending" Data="{x:Static arc:ArcIcons.Circle}"
                                      Size="{arc:AiSetupWizardTokenResource CheckGlyphSize}"
                                      Foreground="{arc:ArcDesignTokenResource BorderStrong}" />
                        <arc:ArcSpinner Name="PART_Running" Foreground="{arc:ArcDesignTokenResource Accent}" />
                        <arc:ArcGlyph Name="PART_Passed" Data="{x:Static arc:ArcIcons.CircleCheck}"
                                      Size="{arc:AiSetupWizardTokenResource CheckGlyphSize}"
                                      Foreground="{arc:ArcDesignTokenResource Success}" />
                        <arc:ArcGlyph Name="PART_Failed" Data="{x:Static arc:ArcIcons.CircleX}"
                                      Size="{arc:AiSetupWizardTokenResource CheckGlyphSize}"
                                      Foreground="{arc:ArcDesignTokenResource Danger}" />
                    </Panel>
                    <TextBlock Name="PART_Text"
                               Grid.Column="1"
                               Text="{TemplateBinding Text}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </Grid>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ arc|ArcGlyph#PART_Pending, ^ /template/ arc|ArcSpinner#PART_Running, ^ /template/ arc|ArcGlyph#PART_Passed, ^ /template/ arc|ArcGlyph#PART_Failed">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:pending /template/ arc|ArcGlyph#PART_Pending">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:pending /template/ TextBlock#PART_Text">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="^:running /template/ arc|ArcSpinner#PART_Running">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:passed /template/ arc|ArcGlyph#PART_Passed">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:failed /template/ arc|ArcGlyph#PART_Failed">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
