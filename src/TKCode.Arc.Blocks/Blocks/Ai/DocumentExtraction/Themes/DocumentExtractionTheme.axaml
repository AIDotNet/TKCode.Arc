<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.DocumentExtractionTheme">

    <!--
        One tab of the form pane (spec 3.4): 30 high, 0 12 inside, radius 15 (the gliding block draws the selected look),
        12 / 16.8 medium; TextMuted, Foreground under the pointer, AccentStrong when selected (160ms; Reduced 120ms). The
        keyboard ring is 2px of FocusRing 2px outside (radius 17).
    -->
    <ControlTheme x:Key="{x:Type arc:ExtractionTabButton}" TargetType="arc:ExtractionTabButton">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:ExtractionTabButton">
                <Panel Background="{TemplateBinding Background}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Margin="{TemplateBinding Padding}"
                                      Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      TextBlock.LineHeight="16.8" />
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            Margin="-2"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep17}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentStrong}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!--
        The form pane's tab list (spec 3.4): a 38px shell, 1px Border, radius 18, SurfaceMuted, 3 inside; the tabs 2 apart over
        the gliding Surface block (1px Border, the resting shadow, radius 15; its outline is drawn half a pixel in).
    -->
    <ControlTheme x:Key="{x:Type arc:ExtractionTabStrip}" TargetType="arc:ExtractionTabStrip">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep18}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:ExtractionTabStrip">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Panel>
                        <arc:GlidingIndicator Name="PART_Highlight"
                                              Fill="{arc:ArcDesignTokenResource Surface}"
                                              Stroke="{arc:ArcDesignTokenResource Border}"
                                              StrokeThickness="1"
                                              BoxShadow="{arc:ArcDesignTokenResource ShadowResting}"
                                              CornerRadius="{arc:ArcDesignTokenResource RadiusStep14p5}"
                                              Spring="Morph" />
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <arc:ExtractionTabButton Name="PART_Fields" />
                            <arc:ExtractionTabButton Name="PART_Json" />
                            <arc:ExtractionTabButton Name="PART_Schema" />
                        </StackPanel>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--
        The block (spec 3.1, 3.2): at most 1080 wide, radius 26, a 1px Border, Surface, clipped. The body holds the viewer and
        the form pane side by side (600 high; the pane min(436, 45%) wide with a BorderSubtle line on its left) or stacked
        below 760 (379 + 478), with the link overlay over both. The form pane: a 48px head (0 8 0 10, BorderSubtle under it)
        with the tabs and the action button, then the panels, each its own scroll area (0 12 20 14 inside). The Fields panel
        starts with the sticky status line (pulled out to the pane's sides). The footer: 60 high (16 left, 10 elsewhere), a
        BorderSubtle line above, the bars and the summary, the run's meta and Accept all. Two hidden polite live regions.
    -->
    <ControlTheme x:Key="{x:Type arc:DocumentExtraction}" TargetType="arc:DocumentExtraction">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="MaxWidth" Value="{arc:DocumentExtractionTokenResource MaxWidth}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightRegular}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
        <Setter Property="StackBreakpoint" Value="{arc:DocumentExtractionTokenResource StackBreakpoint}" />
        <Setter Property="FooterWrapBreakpoint" Value="{arc:DocumentExtractionTokenResource FooterWrapBreakpoint}" />
        <Setter Property="NarrowBreakpoint" Value="{arc:DocumentExtractionTokenResource NarrowBreakpoint}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:DocumentExtraction">
                <Border Name="PART_Card"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <Panel>
                        <DockPanel>
                            <Border Name="PART_FooterFrame"
                                    DockPanel.Dock="Bottom"
                                    MinHeight="{arc:DocumentExtractionTokenResource FooterHeight}"
                                    Padding="{arc:DocumentExtractionTokenResource FooterPadding}"
                                    BorderThickness="{arc:ArcDesignTokenResource EdgeThicknessTop}"
                                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
                                <arc:ExtractionFooter Name="PART_Footer" VerticalAlignment="Center">
                                    <StackPanel Name="PART_Summary"
                                                Orientation="Horizontal"
                                                Spacing="12"
                                                VerticalAlignment="Center"
                                                ClipToBounds="True">
                                        <arc:ConfidenceBars Name="PART_Bars" />
                                        <TextBlock Name="PART_SummaryNote"
                                                   Classes="summary"
                                                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                        <StackPanel Name="PART_AverageGroup" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Name="PART_Average"
                                                       Classes="summary"
                                                       FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                                       FontFeatures="tnum" />
                                            <TextBlock Name="PART_AverageWord"
                                                       Classes="summary"
                                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                        </StackPanel>
                                        <StackPanel Name="PART_Flag" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <arc:ArcGlyph Name="PART_FlagIcon" Size="14" StrokeThickness="1.75" VerticalAlignment="Center" />
                                            <TextBlock Name="PART_FlagText" Classes="summary" />
                                        </StackPanel>
                                    </StackPanel>
                                    <arc:AiRunMeta Name="PART_Meta" />
                                    <arc:Button Name="PART_AcceptAll" Variant="Primary" Size="Small" />
                                </arc:ExtractionFooter>
                            </Border>
                            <arc:ExtractionBody Name="PART_Body"
                                                BodyHeight="{arc:DocumentExtractionTokenResource BodyHeight}"
                                                FormPaneWidth="{arc:DocumentExtractionTokenResource FormPaneWidth}"
                                                FormPaneShare="{arc:DocumentExtractionTokenResource FormPaneShare}"
                                                StackedViewerHeight="{arc:DocumentExtractionTokenResource StackedViewerHeight}"
                                                StackedFormHeight="{arc:DocumentExtractionTokenResource StackedFormHeight}">
                                <arc:DocumentViewer Name="PART_Viewer"
                                                    Zoom="{TemplateBinding Zoom, Mode=TwoWay}"
                                                    IsFitWidth="{TemplateBinding IsFitWidth, Mode=TwoWay}"
                                                    ZoomSteps="{TemplateBinding ZoomSteps}"
                                                    Labels="{TemplateBinding Labels}" />
                                <Border Name="PART_FormPane"
                                        Background="{arc:ArcDesignTokenResource Surface}"
                                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
                                    <DockPanel>
                                        <Border Name="PART_FormHead"
                                                DockPanel.Dock="Top"
                                                Height="{arc:DocumentExtractionTokenResource BarHeight}"
                                                Padding="10,0,8,0"
                                                BorderThickness="{arc:ArcDesignTokenResource EdgeThicknessBottom}"
                                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
                                            <!-- The tabs come first in the Tab order, then the button (spec 6.1). -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <arc:ExtractionTabStrip Name="PART_Tabs"
                                                                        SelectedTab="{TemplateBinding SelectedTab, Mode=TwoWay}" />
                                                <arc:Button Name="PART_Action"
                                                            Grid.Column="1"
                                                            Size="Small"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <Panel Name="PART_Panels">
                                            <ScrollViewer Name="PART_FieldsScroll" Classes="panel">
                                                <StackPanel Name="PART_FieldsContent" Margin="14,0,12,20">
                                                    <arc:AiRunStatusLine Name="PART_Status" Margin="-14,0,-12,2" ZIndex="1" />
                                                    <StackPanel Name="PART_Form" />
                                                </StackPanel>
                                            </ScrollViewer>
                                            <ScrollViewer Name="PART_JsonScroll" Classes="panel" IsVisible="False">
                                                <StackPanel Margin="14,0,12,20">
                                                    <DockPanel Classes="note">
                                                        <arc:CopyButton Name="PART_JsonCopy" DockPanel.Dock="Right" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <arc:ArcGlyph Name="PART_JsonNoteIcon" Size="16" StrokeThickness="1.75" VerticalAlignment="Top" />
                                                            <TextBlock Name="PART_JsonNote" Classes="note" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <arc:ExtractionJsonView Name="PART_Json" />
                                                </StackPanel>
                                            </ScrollViewer>
                                            <ScrollViewer Name="PART_SchemaScroll" Classes="panel" IsVisible="False">
                                                <StackPanel Margin="14,0,12,20">
                                                    <DockPanel Classes="note">
                                                        <arc:CopyButton Name="PART_SchemaCopy" DockPanel.Dock="Right" />
                                                        <TextBlock Name="PART_SchemaNote" Classes="note" />
                                                    </DockPanel>
                                                    <arc:ExtractionJsonView Name="PART_Schema" />
                                                </StackPanel>
                                            </ScrollViewer>
                                            <Border Name="PART_PanelRing"
                                                    IsVisible="False"
                                                    IsHitTestVisible="False"
                                                    Margin="3"
                                                    BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                                                    CornerRadius="{arc:ArcDesignTokenResource RadiusStep12}"
                                                    BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                                        </Panel>
                                    </DockPanel>
                                </Border>
                                <arc:SourceLinkOverlay Name="PART_Links" />
                            </arc:ExtractionBody>
                        </DockPanel>
                        <arc:AiAnnouncer Name="PART_RunAnnouncer" />
                        <arc:AiAnnouncer Name="PART_ReviewAnnouncer" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ TextBlock.summary">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
            <Setter Property="LineHeight" Value="19.6" />
            <Setter Property="LetterSpacing" Value="-0.14" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="^ /template/ TextBlock.note">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
            <Setter Property="LineHeight" Value="16.8" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="^ /template/ DockPanel.note">
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>
        <Style Selector="^ /template/ arc|CopyButton">
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="^ /template/ ScrollViewer.panel">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <!-- The form pane's line on its left side by side; stacked, the viewer's toolbar line is the only one. -->
        <Style Selector="^ /template/ Border#PART_FormPane">
            <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThicknessLeft}" />
        </Style>
        <Style Selector="^:stacked /template/ Border#PART_FormPane">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="^:stacked /template/ arc|SourceLinkOverlay#PART_Links">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
