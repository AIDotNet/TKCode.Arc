<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.McpServersTheme">

    <!--
        The card: at most 720 wide and centered, 1px Border, RadiusPanel, Surface. From the top: the header (title,
        subtitle, summary, Add server), the Add server form (its height springs open), the list of servers (rows built
        in code) or the empty state, and the hidden live region. At 520 wide or less (:compact) the paddings tighten.
    -->
    <ControlTheme x:Key="{x:Type arc:McpServers}" TargetType="arc:McpServers">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightRegular}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
        <Setter Property="CompactWidth" Value="{arc:McpServersTokenResource CompactWidth}" />
        <Setter Property="BodyPadding" Value="{arc:McpServersTokenResource BodyPadding}" />
        <Setter Property="FormPadding" Value="{arc:McpServersTokenResource FormPadding}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:McpServers">
                <Border Name="PART_Card"
                        MaxWidth="{arc:McpServersTokenResource CardMaxWidth}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="False"
                        TextElement.FontFamily="{TemplateBinding FontFamily}"
                        TextElement.FontSize="{TemplateBinding FontSize}"
                        TextElement.Foreground="{TemplateBinding Foreground}"
                        AutomationProperties.LandmarkType="Region">
                    <StackPanel>
                        <Grid Name="PART_Header" ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Name="PART_Title"
                                           FontFamily="{arc:ArcDesignTokenResource DisplayFontFamily}"
                                           FontSize="{arc:ArcDesignTokenResource TypeBase}"
                                           FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                           LineHeight="22"
                                           LetterSpacing="-0.176"
                                           TextWrapping="Wrap"
                                           AutomationProperties.HeadingLevel="2" />
                                <TextBlock Name="PART_Subtitle"
                                           LineHeight="20"
                                           LetterSpacing="-0.14"
                                           TextWrapping="Wrap"
                                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                <TextBlock Name="PART_Summary"
                                           Margin="0,6,0,0"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           LineHeight="16.8"
                                           TextWrapping="Wrap"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                            </StackPanel>
                            <arc:Button Name="PART_Add"
                                        Grid.Column="1"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Top"
                                        Size="Small"
                                        Variant="Secondary" />
                        </Grid>
                        <arc:SpringSizeDecorator Name="PART_FormHost" Axis="Height" Spring="Smooth" IsExpanded="False" />
                        <Border Name="PART_ListBox"
                                BorderThickness="{arc:ArcDesignTokenResource EdgeThicknessTop}"
                                BorderBrush="{arc:ArcDesignTokenResource Border}">
                            <StackPanel>
                                <StackPanel Name="PART_List" Spacing="2" AutomationProperties.Name="Servers" />
                                <StackPanel Name="PART_Empty" Spacing="6" Margin="16,28,16,24" HorizontalAlignment="Center">
                                    <arc:ArcGlyph Data="{x:Static arc:McpServersGlyphs.Plug}"
                                                  Size="22"
                                                  HorizontalAlignment="Center"
                                                  Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                    <TextBlock Name="PART_EmptyTitle"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                               LineHeight="19.6" />
                                    <TextBlock Name="PART_EmptyBody"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="360"
                                               LineHeight="19.6"
                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <arc:AiAnnouncer Name="PART_Announcer" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- Values that change with :compact or :empty are styles, not template values (those would win). -->
        <Style Selector="^ /template/ Grid#PART_Header">
            <Setter Property="Margin" Value="{arc:McpServersTokenResource HeaderPadding}" />
        </Style>
        <Style Selector="^ /template/ Border#PART_ListBox">
            <Setter Property="Padding" Value="{arc:McpServersTokenResource ListPadding}" />
        </Style>
        <Style Selector="^ /template/ StackPanel#PART_List">
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style Selector="^ /template/ StackPanel#PART_Empty">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:empty /template/ StackPanel#PART_Empty">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:compact">
            <Setter Property="BodyPadding" Value="{arc:McpServersTokenResource CompactBodyPadding}" />
            <Setter Property="FormPadding" Value="{arc:McpServersTokenResource CompactFormPadding}" />
        </Style>
        <Style Selector="^:compact /template/ Grid#PART_Header">
            <Setter Property="Margin" Value="{arc:McpServersTokenResource CompactHeaderPadding}" />
        </Style>
        <Style Selector="^:compact /template/ Border#PART_ListBox">
            <Setter Property="Padding" Value="{arc:McpServersTokenResource CompactListPadding}" />
        </Style>
    </ControlTheme>

    <!-- One server: clear at rest, tinted on hover, a quieter tint while open; the tint changes in 120 / 160 ms. -->
    <ControlTheme x:Key="{x:Type arc:McpServerRow}" TargetType="arc:McpServerRow">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep18}" />
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{arc:McpServersTokenResource RowHoverBackground}" />
        </Style>
        <Style Selector="^:open">
            <Setter Property="Background" Value="{arc:McpServersTokenResource RowOpenBackground}" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- A server's header button: its content (mark, name, status line) and a chevron that turns on a spring when open. -->
    <ControlTheme x:Key="{x:Type arc:McpServerRowHeader}" TargetType="arc:McpServerRowHeader">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{arc:McpServersTokenResource RowHeaderPadding}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:McpServerRowHeader">
                <Panel Name="PART_RingHost">
                    <Border Name="PART_Back"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep18}"
                            Padding="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="*,Auto">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalAlignment="Center" />
                            <arc:ArcGlyph Name="PART_Chevron"
                                          Grid.Column="1"
                                          Data="{x:Static arc:ArcIcons.ChevronDown}"
                                          Size="16"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          RenderTransformOrigin="50%,50%"
                                          Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                        </Grid>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ arc|ArcGlyph#PART_Chevron">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>
        <Style Selector="^:expanded /template/ arc|ArcGlyph#PART_Chevron">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <Style Selector="^:motion-full /template/ arc|ArcGlyph#PART_Chevron">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcTransformOperationsTransition Property="RenderTransform" Tween="Spring" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
