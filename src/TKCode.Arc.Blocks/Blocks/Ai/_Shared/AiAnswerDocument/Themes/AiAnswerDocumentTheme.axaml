<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal">

    <!--
        The answer body: blocks 16 apart (headings and figures add their own margins in code). The brushes below are the
        theme's raw colors; the document derives what Arc mixes from them (the 12% sentence light, the hairline of the
        theme's kind, the code fill of 55% SurfaceMuted over the page) and hands them to its texts, tables and code.
    -->
    <ControlTheme x:Key="{x:Type arc:AiAnswerDocument}" TargetType="arc:AiAnswerDocument">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="LightBrush" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="PageBrush" Value="{arc:ArcDesignTokenResource Background}" />
        <Setter Property="MutedBrush" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="SubtleBorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="CursorBrush" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AiAnswerDocument">
                <StackPanel Name="PART_Body" Spacing="16" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--
        A text of the answer. Paragraphs and list items 16 / 25.6 in Foreground; headings in the display font 18 / 19.8 at
        500 with -0.012em tracking; table cells 14 / 20.3 with tabular digits, the header at 500 and the first column in
        TextSecondary.
    -->
    <ControlTheme x:Key="{x:Type arc:AiAnswerText}" TargetType="arc:AiAnswerText">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeBase}" />
        <Setter Property="LineHeight" Value="25.6" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="SelectionBrush" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
        <Setter Property="SelectionForegroundBrush" Value="{x:Null}" />

        <Style Selector="^.heading">
            <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource DisplayFontFamily}" />
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeLG}" />
            <Setter Property="LineHeight" Value="19.8" />
            <Setter Property="LetterSpacing" Value="-0.216" />
            <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        </Style>
        <Style Selector="^.header, ^.rowheader, ^.cell">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
            <Setter Property="LineHeight" Value="20.3" />
            <Setter Property="FontFeatures" Value="tnum" />
        </Style>
        <Style Selector="^.header">
            <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="^.rowheader">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
    </ControlTheme>

    <!--
        Inline code: the monospace family at 0.85em of its text (set in code), Foreground on SurfaceMuted, radius 6,
        padding 0.12em 0.38em; the 1px border is the document's hairline (BorderSubtle light, Border dark).
    -->
    <ControlTheme x:Key="{x:Type arc:AiAnswerCodeChip}" TargetType="arc:AiAnswerCodeChip">
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
    </ControlTheme>

    <!-- A list marker: "n." right-aligned in the first 18px, TextMuted, tabular digits, on the item's first line. -->
    <ControlTheme x:Key="{x:Type arc:AiAnswerListMarker}" TargetType="arc:AiAnswerListMarker">
        <Setter Property="Width" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeBase}" />
        <Setter Property="LineHeight" Value="25.6" />
        <Setter Property="FontFeatures" Value="tnum" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
    </ControlTheme>
</ResourceDictionary>
