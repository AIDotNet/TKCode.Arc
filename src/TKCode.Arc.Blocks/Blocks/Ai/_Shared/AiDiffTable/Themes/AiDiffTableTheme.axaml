<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal">

    <!--
        A table change in the side panel's change card: the new table redrawn small (Inter 12 / 16.8, tabular figures),
        headers TextMuted, cells TextSecondary, inserted cells Foreground on Accent at 13% (computed in code, radius 4,
        2px padding) like the card's inserted words. Cells are padded 3 8 3 0 with no row lines (AiDiffTableGrid).
    -->
    <ControlTheme x:Key="{x:Type arc:AiDiffTable}" TargetType="arc:AiDiffTable">
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="LineHeight" Value="16.8" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="HeaderForeground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="InsertForeground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="InsertTint" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="InsertTintOpacity" Value="0.13" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AiDiffTable">
                <arc:AiDiffTableGrid Name="PART_Grid" Margin="{TemplateBinding Padding}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
