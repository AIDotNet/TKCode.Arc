<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.AiModelLineTheme">

    <!--
        "[mark 14] Lumen Pro 4 · 812 tokens · 18.6s": 12 / 16.8, the parts 8px apart and wrapping 4px apart; the name in
        TextSecondary (an ellipsis when it alone is too wide), the figures in TextMuted with tabular figures, each led by a
        3px TextMuted dot at 70%.
    -->
    <ControlTheme x:Key="{x:Type arc:AiModelLine}" TargetType="arc:AiModelLine">
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AiModelLine">
                <WrapPanel Name="PART_Line"
                           ItemSpacing="8"
                           LineSpacing="4"
                           AutomationProperties.AccessibilityView="Raw">
                    <DockPanel Name="PART_Model" IsVisible="{TemplateBinding HasModel}" VerticalAlignment="Center">
                        <arc:ModelMark Name="PART_Mark"
                                       DockPanel.Dock="Left"
                                       Mark="{TemplateBinding Mark}"
                                       MarkColor="{TemplateBinding MarkColor}"
                                       IsVisible="{TemplateBinding Mark, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Size="14"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center" />
                        <TextBlock Name="PART_Name"
                                   Text="{TemplateBinding ModelName}"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                   LineHeight="16.8"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Name="PART_Tokens"
                                Orientation="Horizontal"
                                Spacing="8"
                                IsVisible="{TemplateBinding ShowsTokens}"
                                VerticalAlignment="Center">
                        <Ellipse Name="PART_TokensDot"
                                 Width="3"
                                 Height="3"
                                 Opacity="0.7"
                                 IsVisible="{TemplateBinding TokensDot}"
                                 Fill="{arc:ArcDesignTokenResource TextMuted}"
                                 VerticalAlignment="Center" />
                        <TextBlock Name="PART_TokensText"
                                   Text="{TemplateBinding TokensText}"
                                   FontFeatures="tnum"
                                   LineHeight="16.8"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Name="PART_Duration"
                                Orientation="Horizontal"
                                Spacing="8"
                                IsVisible="{TemplateBinding ShowsDuration}"
                                VerticalAlignment="Center">
                        <Ellipse Name="PART_DurationDot"
                                 Width="3"
                                 Height="3"
                                 Opacity="0.7"
                                 IsVisible="{TemplateBinding DurationDot}"
                                 Fill="{arc:ArcDesignTokenResource TextMuted}"
                                 VerticalAlignment="Center" />
                        <TextBlock Name="PART_DurationText"
                                   Text="{TemplateBinding DurationText}"
                                   FontFeatures="tnum"
                                   LineHeight="16.8"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </WrapPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
