<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.AiRegenerateMenuTheme">

    <!--
        A surface of the answer-again menu (and of its list of models): at least 216 wide, 1px Border, radius 26 on the
        raised surface (the floating shadow comes from the popup), the rows 5px in. Text 14 / 18.2 in the text color.
    -->
    <ControlTheme x:Key="{x:Type arc:AiRegenerateMenuPanel}" TargetType="arc:AiRegenerateMenuPanel">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="MinWidth" Value="216" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceRaised}" />
        <Setter Property="arc:ArcSurface.Elevation" Value="Raised" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightRegular}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AiRegenerateMenuPanel">
                <Border Name="PART_Frame"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_List" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--
        A row: 36px, padding 0 12 0 10, radius 20: [glyph 16 in TextSecondary, or a model's mark 15 in a 16px cell] 10px
        [text, one line] [ChevronRight 16 on "Switch model"]. The highlight is SurfaceMuted, fading in 120ms.
    -->
    <ControlTheme x:Key="{x:Type arc:AiRegenerateMenuRow}" TargetType="arc:AiRegenerateMenuRow">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="10,0,12,0" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep20}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AiRegenerateMenuRow">
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <DockPanel>
                        <Panel Name="PART_Lead"
                               DockPanel.Dock="Left"
                               Width="16"
                               Height="16"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center">
                            <arc:ArcGlyph Name="PART_Icon"
                                          Data="{TemplateBinding Icon}"
                                          IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"
                                          Size="16"
                                          StrokeThickness="1.75"
                                          Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                            <arc:ModelMark Name="PART_Mark"
                                           Mark="{TemplateBinding Mark}"
                                           MarkColor="{TemplateBinding MarkColor}"
                                           IsVisible="{TemplateBinding Mark, Converter={x:Static ObjectConverters.IsNotNull}}"
                                           Size="15" />
                        </Panel>
                        <arc:ArcGlyph Name="PART_Chevron"
                                      DockPanel.Dock="Right"
                                      IsVisible="False"
                                      Data="{x:Static arc:ArcIcons.ChevronRight}"
                                      Size="16"
                                      StrokeThickness="1.75"
                                      Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                      Margin="10,0,0,0"
                                      VerticalAlignment="Center" />
                        <TextBlock Name="PART_Text"
                                   Text="{TemplateBinding Text}"
                                   LineHeight="18.2"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:submenu /template/ arc|ArcGlyph#PART_Chevron">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:highlighted">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:motion-full, ^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- The heading of the list of models: 12 / 16.8 in TextMuted, padding 6 10 4. -->
    <ControlTheme x:Key="{x:Type arc:AiRegenerateMenuHeading}" TargetType="arc:AiRegenerateMenuHeading">
        <Setter Property="Padding" Value="10,6,10,4" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AiRegenerateMenuHeading">
                <TextBlock Text="{TemplateBinding Text}"
                           Margin="{TemplateBinding Padding}"
                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                           LineHeight="16.8"
                           Foreground="{arc:ArcDesignTokenResource TextMuted}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
