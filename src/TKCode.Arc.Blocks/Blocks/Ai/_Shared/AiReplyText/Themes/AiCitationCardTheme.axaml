<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal">

    <!--
        The source preview above a citation: 288 wide, padding 14 16, 1px Border, radius 26 (RadiusPanel) on
        SurfaceRaised; the popup adds ShadowFloating. Rows 6 apart: the site's 14px mark (or its initial), the domain
        12 TextSecondary and the number 12 TextMuted on the right, 8 apart; the title 14/19.6 at 500; the excerpt 14/21
        TextSecondary.
    -->
    <ControlTheme x:Key="{x:Type arc:AiCitationCard}" TargetType="arc:AiCitationCard">
        <Setter Property="Width" Value="288" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AiCitationCard">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <StackPanel Spacing="6">
                        <DockPanel>
                            <Panel DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                <arc:ModelMark Name="PART_Mark"
                                               Size="14"
                                               Mark="{TemplateBinding Mark}"
                                               MarkColor="{TemplateBinding MarkBrush}"
                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                               IsVisible="{TemplateBinding HasMark}" />
                                <Border Name="PART_Initial"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusStep4}"
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        IsVisible="{TemplateBinding HasMark, Converter={x:Static BoolConverters.Not}}">
                                    <TextBlock Text="{TemplateBinding Initial}"
                                               FontSize="9"
                                               FontWeight="Medium"
                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Panel>
                            <TextBlock Name="PART_Number"
                                       DockPanel.Dock="Right"
                                       Margin="8,0,0,0"
                                       Text="{TemplateBinding Number}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       LineHeight="16.8"
                                       Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                       VerticalAlignment="Center" />
                            <TextBlock Name="PART_Domain"
                                       Text="{TemplateBinding Domain}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       LineHeight="16.8"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Name="PART_Title"
                                   Text="{TemplateBinding Title}"
                                   LineHeight="19.6"
                                   FontWeight="Medium"
                                   TextWrapping="Wrap" />
                        <TextBlock Name="PART_Snippet"
                                   Text="{TemplateBinding Snippet}"
                                   LineHeight="21"
                                   TextWrapping="Wrap"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                   IsVisible="{TemplateBinding Snippet, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <!-- The answer's meta row: "domain · date", 12 / 16.8 muted, 2px further down; the dot is the model line's. -->
                        <StackPanel Name="PART_Meta"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    Margin="0,2,0,0"
                                    IsVisible="{TemplateBinding HasMeta}">
                            <TextBlock Name="PART_MetaDomain"
                                       Text="{TemplateBinding Domain}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       LineHeight="16.8"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                       VerticalAlignment="Center"
                                       IsVisible="{TemplateBinding Domain, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <Ellipse Name="PART_MetaDot"
                                     Width="3"
                                     Height="3"
                                     Opacity="0.7"
                                     Fill="{arc:ArcDesignTokenResource TextMuted}"
                                     VerticalAlignment="Center"
                                     IsVisible="{TemplateBinding HasMetaDot}" />
                            <TextBlock Name="PART_MetaDate"
                                       Text="{TemplateBinding Date}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       LineHeight="16.8"
                                       FontFeatures="tnum"
                                       Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
