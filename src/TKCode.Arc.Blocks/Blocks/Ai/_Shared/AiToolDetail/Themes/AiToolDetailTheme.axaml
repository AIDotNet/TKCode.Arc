<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.AiToolDetailTheme">

    <!--
        A tool's detail: 8px under the chips (a gap that comes and goes with the panel, not animated), 1px BorderSubtle,
        radius 16, padding 12 / 14, parts 10px apart, text 14 / 19.6. Search terms: a 13px Search glyph (TextMuted) and the
        term (TextSecondary), 8px apart, rows 4px apart. Sources: link rows reaching 8px past the text on both sides. Query:
        the statement in 12 / 19.2 monospace Foreground that scrolls sideways under Arc's overlay scrollbars (they take no
        room, as the browser's do), then "Result" (12, TextMuted) and the value
        (12 monospace, tabular figures, Foreground) 10px apart.
    -->
    <ControlTheme x:Key="{x:Type arc:AiToolDetail}" TargetType="arc:AiToolDetail">
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AiToolDetail">
                <arc:AiCollapsible Name="PART_Body" ContentMargin="0,8,0,0">
                    <Border Name="PART_Panel"
                            Padding="14,12"
                            BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
                            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep16}">
                        <StackPanel Spacing="10">
                            <ItemsControl Name="PART_Queries" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Search}"
                                                          Size="13"
                                                          StrokeThickness="1.75"
                                                          Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                          VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding}"
                                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                       LineHeight="19.6"
                                                       LetterSpacing="-0.14"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Name="PART_Sources" Focusable="False" Margin="-8,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="arc:AiSource">
                                        <arc:AiToolSourceRow Source="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <arc:ScrollArea Name="PART_InputScroll"
                                            Orientation="Horizontal"
                                            FadeLength="0">
                                <SelectableTextBlock Name="PART_Input"
                                                     FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                     FontSize="12"
                                                     LineHeight="19.2"
                                                     TextWrapping="NoWrap"
                                                     Foreground="{arc:ArcDesignTokenResource Foreground}" />
                            </arc:ScrollArea>
                            <StackPanel Name="PART_ResultRow" Orientation="Horizontal" Spacing="10">
                                <TextBlock Name="PART_ResultLabel"
                                           Text="{TemplateBinding ResultLabel}"
                                           FontSize="12"
                                           LineHeight="19.2"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                           VerticalAlignment="Center" />
                                <SelectableTextBlock Name="PART_Output"
                                                     FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                     FontSize="12"
                                                     LineHeight="19.2"
                                                     FontFeatures="tnum"
                                                     TextWrapping="Wrap"
                                                     Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                     VerticalAlignment="Center" />
                            </StackPanel>
                            <ContentPresenter Name="PART_Custom" IsVisible="False" />
                        </StackPanel>
                    </Border>
                </arc:AiCollapsible>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--
        A source row: 32px, 8px sides, radius 10, the 14px mark, 10px, the title (14, Foreground, trimmed) and the domain
        (12, TextMuted) at the right; hover SurfaceMuted (160ms). A narrow panel hides the domain.
    -->
    <ControlTheme x:Key="{x:Type arc:AiToolSourceRow}" TargetType="arc:AiToolSourceRow">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep10}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AiToolSourceRow">
                <Panel>
                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                    <DockPanel Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                        <arc:AiToolSourceMark Name="PART_Mark"
                                              DockPanel.Dock="Left"
                                              Source="{TemplateBinding Source}"
                                              Size="14"
                                              Margin="0,0,10,0" />
                        <TextBlock Name="PART_Domain"
                                   DockPanel.Dock="Right"
                                   Margin="10,0,0,0"
                                   Text="{Binding Source.Domain, RelativeSource={RelativeSource TemplatedParent}}"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                   TextWrapping="NoWrap"
                                   VerticalAlignment="Center" />
                        <TextBlock Name="PART_Title"
                                   Text="{Binding Source.Title, RelativeSource={RelativeSource TemplatedParent}}"
                                   LineHeight="19.6"
                                   LetterSpacing="-0.14"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            Margin="-4"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep14}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:hover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:narrow /template/ TextBlock#PART_Domain">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
