<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.AiUndoPillTheme">

    <!--
        The undo pill: 32 high, padding 0 12, a pill with a 1px Border on SurfaceRaised and ShadowRaised. Parts 6px apart:
        the label (12 / 16.8, TextMuted), a 1 × 14 Border line with 2px more on each side, RotateCcw 13 (Foreground) and the
        action (12 / 16.8, weight 500, Foreground). Hover (mouse and pen): SurfaceMuted in 160ms (standard). Keyboard focus:
        the 2px ring, 2px out.
    -->
    <ControlTheme x:Key="{x:Type arc:AiUndoPill}" TargetType="arc:AiUndoPill">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AiUndoPill">
                <Panel>
                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            BoxShadow="{arc:ArcDesignTokenResource ShadowRaised}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Name="PART_Label"
                                       Text="{TemplateBinding ShownText}"
                                       LineHeight="16.8"
                                       LetterSpacing="-0.14"
                                       FontWeight="{arc:ArcDesignTokenResource WeightRegular}"
                                       Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                       VerticalAlignment="Center" />
                            <Border Name="PART_Separator"
                                    Width="1"
                                    Height="14"
                                    Margin="2,0"
                                    VerticalAlignment="Center"
                                    Background="{arc:ArcDesignTokenResource Border}" />
                            <arc:ArcGlyph Name="PART_Icon"
                                          Data="{x:Static arc:ArcIcons.RotateCcw}"
                                          Size="13"
                                          StrokeThickness="2"
                                          VerticalAlignment="Center"
                                          Foreground="{arc:ArcDesignTokenResource Foreground}" />
                            <TextBlock Name="PART_Undo"
                                       Text="{TemplateBinding UndoText}"
                                       LineHeight="16.8"
                                       LetterSpacing="-0.14"
                                       FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            Margin="-4"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:hover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
