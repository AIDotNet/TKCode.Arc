<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal">

    <!--
        A field row (spec 3.4): radius 12, padding 2 4 2 8; the label (88, narrow 76; 12 / 16.8 TextSecondary, ellipsis),
        the value box and the confidence column (60, narrow 54), 8 apart, all centered on the 32px box. Under the box (from
        the box's column to the end): the error (12 / 16.8 Danger, padding 4 0 6 8) and the reason (padding 6 0 6 8; the
        text 12 / 16.8 TextSecondary wrapping, the pill 10 to its right and 3 up; narrow: the pill 10 under the text, left).
        A lit row's fill is set by the row (its group color at 8%); the theme fades it in 160ms.
    -->
    <ControlTheme x:Key="{x:Type arc:ExtractionFieldRow}" TargetType="arc:ExtractionFieldRow">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep12}" />
        <Setter Property="Padding" Value="8,2,4,2" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:ExtractionFieldRow">
                <Border Name="PART_Row"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Grid Name="PART_Grid" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Name="PART_Label"
                                   Grid.Column="0"
                                   Width="88"
                                   Text="{TemplateBinding Label}"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   LineHeight="16.8"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Background="Transparent"
                                   AutomationProperties.AccessibilityView="Raw" />
                        <arc:ExtractionInput Name="PART_Input"
                                             Grid.Column="1"
                                             Value="{TemplateBinding Value}" />
                        <arc:ConfidenceIndicator Name="PART_Confidence"
                                                 Grid.Column="2"
                                                 Width="60"
                                                 Value="{TemplateBinding Value}"
                                                 TypeName="{TemplateBinding TypeName}"
                                                 EditedText="{TemplateBinding EditedText}"
                                                 AutomationText="{TemplateBinding ConfidenceAutomationText}"
                                                 IsAccepted="{TemplateBinding IsAccepted}" />
                        <TextBlock Name="PART_Error"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="2"
                                   Margin="8,4,0,6"
                                   Text="{TemplateBinding ErrorText}"
                                   IsVisible="{TemplateBinding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Foreground="{arc:ArcDesignTokenResource Danger}"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   LineHeight="16.8"
                                   TextWrapping="Wrap"
                                   AutomationProperties.AccessibilityView="Raw" />
                        <arc:ExtractionReveal Name="PART_Reason"
                                              Grid.Row="2"
                                              Grid.Column="1"
                                              Grid.ColumnSpan="2">
                            <Grid Name="PART_ReasonBody" Margin="8,6,0,6" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <TextBlock Name="PART_ReasonText"
                                           Text="{TemplateBinding ReasonText}"
                                           Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           LineHeight="16.8"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Top"
                                           AutomationProperties.AccessibilityView="Raw" />
                                <arc:ExtractionPillButton Name="PART_LooksRight"
                                                          Grid.Column="1"
                                                          Margin="10,-3,0,0"
                                                          VerticalAlignment="Top"
                                                          HorizontalAlignment="Right"
                                                          Text="{TemplateBinding LooksRightText}" />
                            </Grid>
                        </arc:ExtractionReveal>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:narrow">
            <Style Selector="^ /template/ TextBlock#PART_Label">
                <Setter Property="Width" Value="76" />
            </Style>
            <Style Selector="^ /template/ arc|ConfidenceIndicator#PART_Confidence">
                <Setter Property="Width" Value="54" />
            </Style>
            <Style Selector="^ /template/ arc|ExtractionPillButton#PART_LooksRight">
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Margin" Value="0,10,0,0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
        </Style>

        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!--
        "Looks right" (spec 3.4): 26 high, padding 0 10 0 8, a 13px check 5 before the text (12 / 16.8, weight 500,
        Foreground), a pill with a 1px Border on Surface; hover SurfaceMuted with BorderStrong in 160ms; the keyboard ring
        2px out.
    -->
    <ControlTheme x:Key="{x:Type arc:ExtractionPillButton}" TargetType="arc:ExtractionPillButton">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="8,0,10,0" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:ExtractionPillButton">
                <Panel>
                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Check}"
                                          Size="13"
                                          StrokeThickness="2"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}" />
                            <TextBlock Text="{TemplateBinding Text}"
                                       LineHeight="16.8"
                                       TextWrapping="NoWrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            Margin="-4"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:hover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                    <arc:ArcBrushTransition Property="BorderBrush" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                    <arc:ArcBrushTransition Property="BorderBrush" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
