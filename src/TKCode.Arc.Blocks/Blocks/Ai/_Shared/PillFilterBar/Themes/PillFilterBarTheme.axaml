<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal">

    <!--
        The bar: 32px pills 2px apart in a 34px row that scrolls sideways without a scrollbar. One SurfaceMuted pill
        glides under the selected label; the edges fade (20 at the start, 28 at the end) only while the row can scroll
        that way (mask set in code). Concealed: the row fades out in 160ms and takes no input.
    -->
    <ControlTheme x:Key="{x:Type arc:PillFilterBar}" TargetType="arc:PillFilterBar">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="StartFade" Value="20" />
        <Setter Property="EndFade" Value="28" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PillFilterBar">
                <ScrollViewer Name="PART_ScrollViewer"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              BringIntoViewOnFocusChange="False">
                    <arc:PillFilterTrack Name="PART_Track" Spacing="2" Margin="0,1">
                        <arc:GlidingIndicator Name="PART_Selection"
                                              Fill="{arc:ArcDesignTokenResource SurfaceMuted}"
                                              CornerRadius="{arc:ArcDesignTokenResource RadiusPill}" />
                    </arc:PillFilterTrack>
                </ScrollViewer>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:concealed">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!--
        A pill: 32 high, 0 12 padding, Inter 14 / 19.6 regular in TextSecondary; hover (mouse and pen), press and the
        selected pill turn Foreground in 160ms. No background of its own and the same weight when selected, so widths
        never change. Keyboard focus draws a 2px ring inside the pill's edge.
    -->
    <ControlTheme x:Key="{x:Type arc:PillFilterButton}" TargetType="arc:PillFilterButton">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightRegular}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PillFilterButton">
                <Panel Background="{TemplateBinding Background}">
                    <TextBlock Name="PART_Label"
                               Text="{TemplateBinding Label}"
                               Margin="{TemplateBinding Padding}"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               LineHeight="19.6"
                               LetterSpacing="-0.14" />
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            BorderThickness="2"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:hover, ^:pressed, ^:selected">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <!-- Keyboard focus only: a pointer press focuses the pill without a ring. -->
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
