<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal">

    <!--
        A model row: 38px, padding 0 10, radius 16; columns 16 | 1fr | auto | 14, 10px apart: mark, name (14 / 19.6,
        Foreground, ellipsis), prices (12 / 16.8 tabular, TextMuted), Check 14 (stroke 2, Foreground; shows on the selected
        row in 160ms). The tint is one SurfaceMuted layer: 60% under the pointer, full when selected (120ms). The keyboard
        ring is 2px inside the edge.
    -->
    <ControlTheme x:Key="{x:Type arc:PromptModelRow}" TargetType="arc:PromptModelRow">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep16}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PromptModelRow">
                <Panel>
                    <Border Name="PART_Tint"
                            Opacity="0"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{arc:ArcDesignTokenResource SurfaceMuted}" />
                    <Grid ColumnDefinitions="16,*,Auto,14" Margin="{TemplateBinding Padding}">
                        <arc:ModelMark Name="PART_Mark"
                                       Size="16"
                                       Mark="{TemplateBinding Mark}"
                                       MarkColor="{TemplateBinding MarkColor}"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
                        <TextBlock Name="PART_Text"
                                   Grid.Column="1"
                                   Margin="10,0"
                                   Text="{TemplateBinding Text}"
                                   VerticalAlignment="Center"
                                   LineHeight="19.6"
                                   LetterSpacing="-0.14"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{arc:ArcDesignTokenResource Foreground}" />
                        <TextBlock Name="PART_Price"
                                   Grid.Column="2"
                                   Margin="0,0,10,0"
                                   Text="{TemplateBinding Price}"
                                   VerticalAlignment="Center"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   LineHeight="16.8"
                                   TextWrapping="NoWrap"
                                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                        <arc:ArcGlyph Name="PART_Check"
                                      Grid.Column="3"
                                      Data="{x:Static arc:ArcIcons.Check}"
                                      Size="14"
                                      StrokeThickness="2"
                                      Opacity="0"
                                      VerticalAlignment="Center"
                                      Foreground="{arc:ArcDesignTokenResource Foreground}" />
                    </Grid>
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Tint">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="^:checked /template/ Border#PART_Tint">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:checked /template/ arc|ArcGlyph#PART_Check">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:motion-full">
            <Style Selector="^ /template/ Border#PART_Tint">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcDoubleTransition Property="Opacity" Tween="Instant" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ arc|ArcGlyph#PART_Check">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                    </Transitions>
                </Setter>
            </Style>
        </Style>
        <Style Selector="^:motion-reduced">
            <Style Selector="^ /template/ Border#PART_Tint">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcDoubleTransition Property="Opacity" Tween="Instant" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ arc|ArcGlyph#PART_Check">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcDoubleTransition Property="Opacity" Tween="Instant" />
                    </Transitions>
                </Setter>
            </Style>
        </Style>
    </ControlTheme>

    <!--
        The effort row: 36px track, 1px Border, pill radius, padding 2; equal cells 2px apart (30px); the highlight
        (SurfaceMuted, radius 15) glides under the selected cell on the quick spring.
    -->
    <ControlTheme x:Key="{x:Type arc:PromptEffortStrip}" TargetType="arc:PromptEffortStrip">
        <Setter Property="Height" Value="36" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PromptEffortStrip">
                <Border Name="PART_Track"
                        BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
                        BorderBrush="{arc:ArcDesignTokenResource Border}"
                        CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                        Padding="2">
                    <Panel>
                        <arc:GlidingIndicator Name="PART_Thumb"
                                              CornerRadius="{arc:ArcDesignTokenResource RadiusStep15}"
                                              Spring="Quick"
                                              Fill="{arc:ArcDesignTokenResource SurfaceMuted}" />
                        <arc:PromptEffortColumns Name="PART_Cells" Spacing="2" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--
        An effort cell: 30px, the word centered (14 / 19.6), TextMuted; the text color when selected or under
        the pointer (160ms). The keyboard ring is 2px inside the cell.
    -->
    <ControlTheme x:Key="{x:Type arc:PromptEffortCell}" TargetType="arc:PromptEffortCell">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PromptEffortCell">
                <Panel Background="{TemplateBinding Background}">
                    <!-- Centered without the padding: the equal columns set the width (a word wider than its
                         padding allows, such as "XHigh", still fits, as Arc's flex cells grow into their padding). -->
                    <TextBlock Name="PART_Text"
                               Text="{TemplateBinding Text}"
                               Foreground="{TemplateBinding Foreground}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               LineHeight="19.6"
                               LetterSpacing="-0.14"
                               TextWrapping="NoWrap" />
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep15}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover, ^:checked">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
