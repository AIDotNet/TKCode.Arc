<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.PromptRunButtonTheme">

    <!--
        Run: 36 high, padding 0 14 0 13, a pill in Accent with AccentForeground 14 / 500; 8px between the 13px glyph slot,
        the label slot (as wide as the wider of Run and Stop) and the muted key cap. Hover and press: AccentStrong (160ms);
        press scales to 0.97 (120ms) at full motion only. Keyboard focus: a 2px ring 2px outside.
    -->
    <ControlTheme x:Key="{x:Type arc:PromptRunButton}" TargetType="arc:PromptRunButton">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="13,0,14,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentForeground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PromptRunButton">
                <Panel>
                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center">
                            <arc:ArcContentSwap Name="PART_Icon"
                                                Mode="Label"
                                                EnterOffset="0"
                                                Width="13"
                                                Height="13"
                                                VerticalAlignment="Center" />
                            <arc:SpringSizeDecorator Name="PART_LabelSize"
                                                     Axis="Width"
                                                     Spring="Quick"
                                                     VerticalAlignment="Center">
                                <Grid Name="PART_LabelSlot" HorizontalAlignment="Left">
                                    <!-- The slot is as wide as the wider label, so Run and Stop share one width. -->
                                    <TextBlock Name="PART_RunReserve"
                                               Text="{TemplateBinding RunText}"
                                               Opacity="0"
                                               LineHeight="19.6"
                                               TextWrapping="NoWrap" />
                                    <TextBlock Name="PART_StopReserve"
                                               Text="{TemplateBinding StopText}"
                                               Opacity="0"
                                               LineHeight="19.6"
                                               TextWrapping="NoWrap" />
                                    <arc:ArcContentSwap Name="PART_Label"
                                                        Mode="Label"
                                                        EnterOffset="0"
                                                        HorizontalContentAlignment="Left"
                                                        VerticalContentAlignment="Center" />
                                </Grid>
                            </arc:SpringSizeDecorator>
                            <arc:PromptKbd Name="PART_Shortcut"
                                           IsMuted="True"
                                           Text="{TemplateBinding EffectiveShortcutText}"
                                           Foreground="{TemplateBinding Foreground}"
                                           IsVisible="{TemplateBinding EffectiveShortcutText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Border>
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            Margin="-4"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover, ^:pressed">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentStrong}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.52" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^:motion-full">
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                    <arc:ArcTransformOperationsTransition Property="RenderTransform" Tween="Instant" />
                </Transitions>
            </Setter>
            <Style Selector="^:pressed">
                <Setter Property="RenderTransform" Value="scale(0.97)" />
            </Style>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
