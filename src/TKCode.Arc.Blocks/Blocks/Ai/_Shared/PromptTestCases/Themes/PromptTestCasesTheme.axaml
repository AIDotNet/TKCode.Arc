<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal">

    <!--
        The cases: a 36px pill frame (1px Border, Surface-transparent, 2px padding) around 30px options 2px apart. One
        SurfaceMuted pill glides under the selected option (code: quick spring).
    -->
    <ControlTheme x:Key="{x:Type arc:PromptTestCases}" TargetType="arc:PromptTestCases">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PromptTestCases">
                <Border Name="PART_Frame"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <arc:PromptTestCaseTrack Name="PART_Track" Spacing="2">
                        <arc:GlidingIndicator Name="PART_Selection"
                                              Fill="{arc:ArcDesignTokenResource SurfaceMuted}"
                                              CornerRadius="{arc:ArcDesignTokenResource RadiusPill}" />
                    </arc:PromptTestCaseTrack>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--
        An option: 30 high, 0 12 padding, Inter 14 / 19.6 in TextMuted; hover (mouse and pen), press and the selected
        option turn Foreground in 160ms. Same weight when selected, so widths never change. Keyboard focus draws a 2px
        ring inside the option's edge (Arc's outline offset -2).
    -->
    <ControlTheme x:Key="{x:Type arc:PromptTestCaseOption}" TargetType="arc:PromptTestCaseOption">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightRegular}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PromptTestCaseOption">
                <Panel Background="{TemplateBinding Background}">
                    <TextBlock Name="PART_Label"
                               Text="{TemplateBinding Label}"
                               Margin="{TemplateBinding Padding}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               LineHeight="19.6"
                               LetterSpacing="-0.14" />
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            BorderThickness="2"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:hover, ^:pressed, ^:selected">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <!-- Keyboard focus only: a pointer press focuses the option without a ring. -->
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
