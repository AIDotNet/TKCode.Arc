<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.PromptVersionMenuTheme">

    <!--
        A version row: 62.4px (padding 8 10), radius 18. Avatar 28 (2px down), 10px gap, then the message (16 / 22.4,
        Foreground, ellipsis) and 2px under it the 22px meta line (12 / 16.8, TextMuted, centered; ellipsis; the production
        row keeps room for the marker at its end). The tint is one SurfaceMuted layer: 60% under the pointer, full when
        checked (120ms). The keyboard ring is 2px inside the edge.
    -->
    <ControlTheme x:Key="{x:Type arc:PromptVersionRow}" TargetType="arc:PromptVersionRow">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusControl}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PromptVersionRow">
                <Panel>
                    <Border Name="PART_Tint"
                            Opacity="0"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{arc:ArcDesignTokenResource SurfaceMuted}" />
                    <Grid ColumnDefinitions="28,*" Margin="{TemplateBinding Padding}">
                        <arc:PromptVersionAvatar Name="PART_Avatar"
                                                 VerticalAlignment="Top"
                                                 Margin="0,2,0,0"
                                                 AuthorName="{TemplateBinding AuthorName}"
                                                 Image="{TemplateBinding AuthorImage}" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                            <TextBlock Name="PART_Message"
                                       Text="{TemplateBinding Message}"
                                       FontSize="{arc:ArcDesignTokenResource TypeBase}"
                                       LineHeight="22.4"
                                       LetterSpacing="-0.16"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
                            <Panel Name="PART_MetaLine" Height="22">
                                <TextBlock Name="PART_Meta"
                                           VerticalAlignment="Center"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           LineHeight="16.8"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                            </Panel>
                        </StackPanel>
                    </Grid>
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Tint">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="^:checked /template/ Border#PART_Tint">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:motion-full /template/ Border#PART_Tint, ^:motion-reduced /template/ Border#PART_Tint">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- The author's avatar: Arc's small avatar (28, 1px Border, SurfaceMuted, initials) with the picture as a 26px circle. -->
    <ControlTheme x:Key="{x:Type arc:PromptVersionAvatar}" TargetType="arc:PromptVersionAvatar">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PromptVersionAvatar">
                <Panel>
                    <arc:Avatar Name="PART_Avatar"
                                Size="Small"
                                DisplayName="{TemplateBinding AuthorName}" />
                    <Border Name="PART_Picture"
                            Width="26"
                            Height="26"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep13}"
                            ClipToBounds="True"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{TemplateBinding Image, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Image Source="{TemplateBinding Image}" Stretch="UniformToFill" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--
        An action: 36px, padding 0 10, radius 16; icon 16 (stroke 1.75, TextSecondary), 10px, text (14 / 19.6, Foreground).
        Hover: SurfaceMuted (120ms); disabled: icon and text TextMuted, arrow cursor. Keyboard ring 2px inside the edge.
    -->
    <ControlTheme x:Key="{x:Type arc:PromptMenuAction}" TargetType="arc:PromptMenuAction">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep16}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PromptMenuAction">
                <Panel>
                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <arc:ArcGlyph Name="PART_Icon"
                                          Data="{TemplateBinding Icon}"
                                          Size="16"
                                          StrokeThickness="1.75"
                                          VerticalAlignment="Center" />
                            <TextBlock Name="PART_Text"
                                       Text="{TemplateBinding Text}"
                                       Foreground="{TemplateBinding Foreground}"
                                       LineHeight="19.6"
                                       LetterSpacing="-0.14"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ arc|ArcGlyph#PART_Icon">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="^:disabled /template/ arc|ArcGlyph#PART_Icon">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:motion-full, ^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- The last line: 12 / 16.8 TextMuted words; Undo (small ghost button, padding 0 12) at the end. -->
    <ControlTheme x:Key="{x:Type arc:PromptVersionStatus}" TargetType="arc:PromptVersionStatus">
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PromptVersionStatus">
                <DockPanel>
                    <arc:Button Name="PART_Undo"
                                DockPanel.Dock="Right"
                                Variant="Ghost"
                                Size="Small"
                                Padding="12,0"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding UndoText}"
                                IsVisible="{TemplateBinding ShowsUndo}" />
                    <TextBlock Name="PART_Text"
                               Text="{TemplateBinding Text}"
                               VerticalAlignment="Center"
                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                               LineHeight="16.8"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
