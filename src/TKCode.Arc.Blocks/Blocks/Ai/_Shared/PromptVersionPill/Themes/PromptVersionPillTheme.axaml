<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal">

    <!--
        The version pill: 32px, pill radius, 1px Border on the Surface, padding 0 9 0 11. The label ("v4", medium) and the
        state (dot + "Production", or "Latest") sit in one width spring (quick); the label is 8px from the state (Arc's 2px
        margin and 6px gap), the chevron (ChevronDown 14 at 1.75 in TextMuted, never turning) 6px after it. Hover and the
        open popover: SurfaceMuted with the strong border.
    -->
    <ControlTheme x:Key="{x:Type arc:PromptVersionPill}" TargetType="arc:PromptVersionPill">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="11,0,9,0" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PromptVersionPill">
                <Panel>
                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <DockPanel VerticalAlignment="Center">
                            <arc:ArcGlyph Name="PART_Chevron"
                                          DockPanel.Dock="Right"
                                          Data="{x:Static arc:ArcIcons.ChevronDown}"
                                          Size="14"
                                          StrokeThickness="1.75"
                                          Margin="6,0,0,0"
                                          Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                          VerticalAlignment="Center" />
                            <!-- Clips at its (springing) width: the new text is revealed as the pill grows. -->
                            <arc:SpringSizeDecorator Name="PART_TextSize"
                                                     Axis="Width"
                                                     Spring="Quick"
                                                     ClipOverflow="0"
                                                     ClipToBounds="True"
                                                     HorizontalAlignment="Left"
                                                     VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <arc:ArcContentSwap Name="PART_Label"
                                                        Mode="Label"
                                                        HorizontalContentAlignment="Left"
                                                        VerticalContentAlignment="Center" />
                                    <arc:ArcContentSwap Name="PART_State"
                                                        Mode="Label"
                                                        HorizontalContentAlignment="Left"
                                                        VerticalContentAlignment="Center" />
                                </StackPanel>
                            </arc:SpringSizeDecorator>
                        </DockPanel>
                    </Border>
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            Margin="-4"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:hover, ^:open">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        </Style>
        <!-- Keyboard focus only: a press focuses the pill without a ring. -->
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <!-- Background 120ms, border 160ms (standard). -->
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                    <arc:ArcBrushTransition Property="BorderBrush" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                    <arc:ArcBrushTransition Property="BorderBrush" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- The state layer: [6px Success dot, 6px] word in TextSecondary (14 on a 19.6 line, regular). -->
    <ControlTheme x:Key="{x:Type arc:PromptVersionPillState}" TargetType="arc:PromptVersionPillState">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PromptVersionPillState">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Name="PART_Dot"
                             Width="6"
                             Height="6"
                             VerticalAlignment="Center"
                             IsVisible="{TemplateBinding ShowsDot}"
                             Fill="{arc:ArcDesignTokenResource Success}" />
                    <TextBlock Name="PART_Text"
                               Text="{TemplateBinding Text}"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"
                               LineHeight="19.6"
                               LetterSpacing="-0.14"
                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                               FontWeight="{arc:ArcDesignTokenResource WeightRegular}"
                               Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
