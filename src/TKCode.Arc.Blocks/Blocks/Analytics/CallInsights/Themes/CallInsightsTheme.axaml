<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.CallInsightsTheme">

    <!--
        Call insights. Framed: a card with a 1px Border, radius 20, Surface and no shadow; flat: no frame. The body (header,
        player, timeline, transcript and the side column) is built in code; padding 24, 16 at the compact width.
    -->
    <ControlTheme x:Key="{x:Type arc:CallInsights}" TargetType="arc:CallInsights">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep20}" />
        <Setter Property="Padding" Value="{arc:CallInsightsTokenResource Padding}" />
        <Setter Property="CompactWidth" Value="{arc:CallInsightsTokenResource CompactWidth}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:CallInsights">
                <Border Name="PART_Shell"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Panel>
                        <Decorator Name="PART_Body" />
                        <arc:AnalyticsAnnouncer Name="PART_Announcer" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:not(:framed)">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="^:framed:compact">
            <Setter Property="Padding" Value="{arc:CallInsightsTokenResource CompactPadding}" />
        </Style>
    </ControlTheme>

    <!--
        A pressable row: no chrome, radius 12, padding from the token; tints on hover (160ms), the current line keeps an
        accent-subtle tint. Chips (topics) are pills with a 1px Border edge; a chosen chip is AccentSubtle with an Accent edge.
    -->
    <ControlTheme x:Key="{x:Type arc:CallInsightsPressable}" TargetType="arc:CallInsightsPressable">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep12}" />
        <Setter Property="Padding" Value="{arc:CallInsightsTokenResource LinePadding}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:CallInsightsPressable">
                <Panel Name="PART_RingHost">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{arc:CallInsightsTokenResource RowHoverBackground}" />
        </Style>
        <Style Selector="^:current">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
        </Style>
        <Style Selector="^.chip">
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        </Style>
        <Style Selector="^.chip:current">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                    <arc:ArcBrushTransition Property="BorderBrush" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
