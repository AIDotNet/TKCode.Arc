<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.InboxSidebarTheme">
    <!--
        Inbox sidebar: a Sidebar with the rail toggle, the mailbox name and Compose in its header, the folders, the labels
        under a heading that folds, and the storage meter and account in its footer. On the icon rail the texts fade and
        only the leading icons stay.
    -->
    <ControlTheme x:Key="{x:Type arc:InboxSidebar}" TargetType="arc:InboxSidebar">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:InboxSidebar">
                <arc:Sidebar Name="PART_Sidebar"
                             IsCollapseButtonVisible="False"
                             IsCollapsed="{TemplateBinding IsCollapsed, Mode=TwoWay}"
                             ResizeMode="{TemplateBinding ResizeMode}">
                    <arc:Sidebar.Header>
                        <StackPanel Spacing="{arc:InboxSidebarTokenResource HeaderGap}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <arc:Button Name="PART_ToggleButton"
                                            Variant="Ghost"
                                            Size="Small"
                                            IsPressScaleEnabled="False"
                                            Width="{arc:InboxSidebarTokenResource ToggleSize}"
                                            Height="{arc:InboxSidebarTokenResource ToggleSize}"
                                            MinHeight="0"
                                            Padding="0"
                                            Margin="4,0,0,0">
                                    <arc:ArcGlyph Data="{x:Static arc:ArcIcons.PanelLeft}" Size="16" />
                                </arc:Button>
                                <TextBlock Name="PART_MailboxName"
                                           Grid.Column="1"
                                           Classes="ibs-rail-fade"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                           Foreground="{arc:ArcDesignTokenResource Foreground}" />
                            </Grid>
                            <arc:Button Name="PART_ComposeButton"
                                        Variant="Primary"
                                        Size="Small"
                                        IsPressScaleEnabled="False"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Padding="{arc:InboxSidebarTokenResource ComposePadding}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <arc:ArcGlyph Data="{x:Static arc:ArcIcons.SquarePen}" Size="16" StrokeThickness="1.8" />
                                    <TextBlock Name="PART_ComposeText" Classes="ibs-rail-fade" VerticalAlignment="Center" />
                                </StackPanel>
                            </arc:Button>
                        </StackPanel>
                    </arc:Sidebar.Header>
                    <arc:Sidebar.Footer>
                        <StackPanel Spacing="12">
                            <StackPanel Name="PART_Storage" Classes="ibs-rail-fade" Spacing="6" Margin="6,0,6,0">
                                <TextBlock Name="PART_StorageText"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                <arc:Progress Name="PART_StorageMeter" IsValueVisible="False" />
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="4,0,0,0">
                                <arc:Avatar Name="PART_Avatar" Size="Small" />
                                <StackPanel Grid.Column="1" Classes="ibs-rail-fade" VerticalAlignment="Center">
                                    <TextBlock Name="PART_AccountName"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                    <TextBlock Name="PART_AccountEmail"
                                               TextTrimming="CharacterEllipsis"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                               Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </arc:Sidebar.Footer>
                </arc:Sidebar>
            </ControlTemplate>
        </Setter>
        <Setter Property="HorizontalAlignment" Value="Left" />

        <Style Selector="^ /template/ :is(Control).ibs-rail-fade">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:collapsed /template/ :is(Control).ibs-rail-fade">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:motion-full /template/ :is(Control).ibs-rail-fade">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced /template/ :is(Control).ibs-rail-fade">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
