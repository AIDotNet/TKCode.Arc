<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
                    x:ClassModifier="internal">
    <!-- The Sidebar block (original TKCode design): pane, header row, filter, scrolling list with the gliding marker, footer. -->
    <ControlTheme x:Key="{x:Type arc:Sidebar}" TargetType="arc:Sidebar">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:Sidebar">
                <Panel>
                    <!-- The edge line is drawn over the pane, so it takes no width: rows are exactly 236 open and 40 on the rail. -->
                    <Border Name="PART_Pane"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="{arc:SidebarTokenResource PanePadding}">
                            <Grid Name="PART_HeaderRow"
                                  ColumnDefinitions="*,Auto"
                                  Margin="{arc:SidebarTokenResource HeaderMargin}">
                                <arc:SidebarOpenWidthHost Name="PART_HeaderHost" ClipsWhenNarrow="True" VerticalAlignment="Center">
                                    <ContentPresenter Name="PART_HeaderPresenter"
                                                      Content="{TemplateBinding Header}"
                                                      HorizontalContentAlignment="Stretch"
                                                      VerticalContentAlignment="Center" />
                                </arc:SidebarOpenWidthHost>
                                <arc:SidebarIconButton Name="PART_CollapseButton"
                                                       Grid.Column="1"
                                                       Glyph="{x:Static arc:ArcIcons.PanelLeft}"
                                                       IsVisible="{TemplateBinding IsCollapseButtonVisible}" />
                            </Grid>
                            <Panel Name="PART_FilterRow"
                                   Grid.Row="1"
                                   Margin="{arc:SidebarTokenResource FilterMargin}"
                                   IsVisible="{TemplateBinding IsFilterVisible}">
                                <arc:SidebarOpenWidthHost>
                                    <arc:SearchField Name="PART_Filter"
                                                     Size="Small"
                                                     IsLabelVisible="False"
                                                     Label="{TemplateBinding FilterPlaceholder}"
                                                     PlaceholderText="{TemplateBinding FilterPlaceholder}"
                                                     Text="{TemplateBinding FilterText, Mode=TwoWay}" />
                                </arc:SidebarOpenWidthHost>
                                <arc:SidebarIconButton Name="PART_FilterButton"
                                                       Glyph="{x:Static arc:ArcIcons.Search}"
                                                       HorizontalAlignment="Left" />
                            </Panel>
                            <ScrollViewer Name="PART_ScrollViewer"
                                          Grid.Row="2"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          AllowAutoHide="True"
                                          BringIntoViewOnFocusChange="False">
                                <arc:SidebarListPanel Name="PART_List"
                                                      Margin="{arc:SidebarTokenResource ListMargin}"
                                                      RowGap="{arc:SidebarTokenResource RowGap}"
                                                      ChildrenMargin="{arc:SidebarTokenResource ChildrenMargin}"
                                                      GuideMargin="{arc:SidebarTokenResource GuideMargin}"
                                                      GuideBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                      MarkerBarWidth="{arc:SidebarTokenResource MarkerBarWidth}"
                                                      MarkerBarHeight="{arc:SidebarTokenResource MarkerBarHeight}"
                                                      MarkerBarInset="{arc:SidebarTokenResource MarkerBarInset}">
                                    <arc:GlidingIndicator Name="PART_MarkerBlock"
                                                          Fill="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                          CornerRadius="{arc:SidebarTokenResource RowRadius}"
                                                          Spring="Snappy" />
                                    <arc:GlidingIndicator Name="PART_MarkerBar"
                                                          Fill="{arc:ArcDesignTokenResource Accent}"
                                                          CornerRadius="{arc:SidebarTokenResource MarkerBarRadius}"
                                                          Spring="Snappy" />
                                    <StackPanel Name="PART_Content" />
                                    <TextBlock Name="PART_NoMatches"
                                               IsVisible="False"
                                               VerticalAlignment="Top"
                                               Margin="{arc:SidebarTokenResource RowInlinePadding}"
                                               Text="{TemplateBinding NoMatchesText}"
                                               TextWrapping="Wrap"
                                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                               Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                </arc:SidebarListPanel>
                            </ScrollViewer>
                            <arc:SidebarOpenWidthHost Name="PART_FooterHost"
                                                      Grid.Row="3"
                                                      ClipsWhenNarrow="True"
                                                      Margin="{arc:SidebarTokenResource FooterMargin}"
                                                      IsVisible="{TemplateBinding Footer, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <ContentPresenter Name="PART_FooterPresenter"
                                                  Content="{TemplateBinding Footer}"
                                                  HorizontalContentAlignment="Stretch"
                                                  VerticalContentAlignment="Center" />
                            </arc:SidebarOpenWidthHost>
                        </Grid>
                    </Border>
                    <Border Name="PART_Edge"
                            IsHitTestVisible="False"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Setter Property="OpenWidth" Value="{arc:SidebarTokenResource ExpandedWidth}" />
        <Setter Property="Width" Value="{arc:SidebarTokenResource ExpandedWidth}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />

        <Style Selector="^:collapsed">
            <Setter Property="Width" Value="{arc:SidebarTokenResource RailWidth}" />
        </Style>

        <!-- On the rail the collapse button takes the header's place; without the button the header stays, clipped to the rail. -->
        <Style Selector="^ /template/ arc|SidebarOpenWidthHost#PART_HeaderHost">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:collapsed[IsCollapseButtonVisible=True] /template/ arc|SidebarOpenWidthHost#PART_HeaderHost">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="^ /template/ arc|SearchField#PART_Filter">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^ /template/ arc|SidebarIconButton#PART_FilterButton">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="^:collapsed /template/ arc|SidebarIconButton#PART_FilterButton">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <!-- The rail has no room for a scroll bar; the wheel and the keyboard still scroll it. -->
        <Style Selector="^:collapsed /template/ ScrollViewer#PART_ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
        </Style>
        <Style Selector="^:collapsed /template/ arc|SearchField#PART_Filter">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- The width springs (smooth) between the open sidebar and the rail; reduced motion changes it at once. -->
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:SpringDoubleTransition Property="Width" Spring="Smooth" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-full /template/ arc|SidebarOpenWidthHost#PART_HeaderHost">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced /template/ arc|SidebarOpenWidthHost#PART_HeaderHost">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-full /template/ arc|SidebarIconButton#PART_FilterButton">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced /template/ arc|SidebarIconButton#PART_FilterButton">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-full /template/ arc|SearchField#PART_Filter">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced /template/ arc|SearchField#PART_Filter">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- The sidebar's icon buttons (collapse / expand, rail search): ghost squares that line up with the page rows on the rail. -->
    <ControlTheme x:Key="{x:Type arc:SidebarIconButton}" TargetType="arc:SidebarIconButton">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:SidebarIconButton">
                <Panel>
                    <Border Name="PART_Fill"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{arc:SidebarTokenResource RowRadius}" />
                    <arc:ArcGlyph Data="{TemplateBinding Glyph}"
                                  Size="{arc:SidebarTokenResource RowGlyphSize}"
                                  StrokeThickness="{arc:SidebarTokenResource RowGlyphStroke}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            Margin="{arc:SidebarTokenResource FocusRingMargin}"
                            BorderThickness="2"
                            CornerRadius="{arc:SidebarTokenResource FocusRingRadius}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Setter Property="Width" Value="{arc:SidebarTokenResource IconButtonWidth}" />
        <Setter Property="Height" Value="{arc:SidebarTokenResource RowHeight}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ClipToBounds" Value="False" />
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{arc:SidebarTokenResource RowHoverFill}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                    <arc:ArcBrushTransition Property="Foreground" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- One page row: icon, label, count, chevron; the selection block underneath is the sidebar's gliding marker. -->
    <ControlTheme x:Key="{x:Type arc:SidebarRow}" TargetType="arc:SidebarRow">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:SidebarRow">
                <Panel>
                    <Border Name="PART_Fill"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{arc:SidebarTokenResource RowRadius}" />
                    <arc:SidebarOpenWidthHost Name="PART_Layout" Margin="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Panel Name="PART_IconSlot"
                                   Width="{arc:SidebarTokenResource RowGlyphSize}"
                                   Height="{arc:SidebarTokenResource RowGlyphSize}"
                                   Margin="{arc:SidebarTokenResource RowGlyphMargin}"
                                   VerticalAlignment="Center">
                                <arc:ArcGlyph Name="PART_Glyph"
                                              Data="{TemplateBinding Glyph}"
                                              Size="{arc:SidebarTokenResource RowGlyphSize}"
                                              StrokeThickness="{arc:SidebarTokenResource RowGlyphStroke}" />
                                <ContentPresenter Name="PART_IconPresenter"
                                                  Content="{TemplateBinding IconContent}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                <TextBlock Name="PART_Monogram"
                                           IsVisible="False"
                                           Text="{TemplateBinding Monogram}"
                                           FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                           FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Panel>
                            <TextBlock Name="PART_Label"
                                       Grid.Column="1"
                                       Text="{TemplateBinding Label}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <TextBlock Name="PART_Badge"
                                       Grid.Column="2"
                                       Text="{TemplateBinding Badge}"
                                       Margin="{arc:SidebarTokenResource BadgeMargin}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                       VerticalAlignment="Center" />
                            <arc:ArcGlyph Name="PART_Chevron"
                                          Grid.Column="3"
                                          Data="{x:Static arc:ArcIcons.ChevronRight}"
                                          Size="{arc:SidebarTokenResource ChevronSize}"
                                          StrokeThickness="{arc:SidebarTokenResource ChevronStroke}"
                                          Margin="{arc:SidebarTokenResource ChevronMargin}"
                                          IsVisible="{TemplateBinding IsParent}"
                                          VerticalAlignment="Center"
                                          RenderTransformOrigin="50%,50%" />
                        </Grid>
                    </arc:SidebarOpenWidthHost>
                    <Ellipse Name="PART_Dot"
                             IsHitTestVisible="False"
                             Width="{arc:SidebarTokenResource BadgeDotSize}"
                             Height="{arc:SidebarTokenResource BadgeDotSize}"
                             Margin="{arc:SidebarTokenResource BadgeDotMargin}"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Fill="{arc:ArcDesignTokenResource Accent}" />
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            Margin="{arc:SidebarTokenResource FocusRingMargin}"
                            BorderThickness="2"
                            CornerRadius="{arc:SidebarTokenResource FocusRingRadius}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Setter Property="Height" Value="{arc:SidebarTokenResource RowHeight}" />
        <Setter Property="Padding" Value="{arc:SidebarTokenResource RowInlinePadding}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ClipToBounds" Value="False" />

        <!-- Part defaults live in styles so the state styles below can change them. -->
        <Style Selector="^ /template/ TextBlock#PART_Label">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^ /template/ TextBlock#PART_Badge">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^ /template/ arc|ArcGlyph#PART_Chevron">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>
        <Style Selector="^ /template/ Ellipse#PART_Dot">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:not(:has-badge) /template/ TextBlock#PART_Badge">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:not(:has-icon) /template/ Panel#PART_IconSlot">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:hovered">
            <Setter Property="Background" Value="{arc:SidebarTokenResource RowHoverFill}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^:current">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^:expanded /template/ arc|ArcGlyph#PART_Chevron">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
        <Style Selector="^:hovered /template/ arc|ArcGlyph#PART_Chevron">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="{arc:SidebarTokenResource DisabledOpacity}" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- The icon rail: the text fades (fast) and the count becomes a dot; a page without an icon shows its initial. -->
        <Style Selector="^:rail /template/ TextBlock#PART_Label">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:rail /template/ TextBlock#PART_Badge">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:rail /template/ arc|ArcGlyph#PART_Chevron">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:rail:has-badge:not(:nested) /template/ Ellipse#PART_Dot">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:rail:not(:has-icon):not(:nested) /template/ Panel#PART_IconSlot">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:rail:not(:has-icon):not(:nested) /template/ TextBlock#PART_Monogram">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" Tween="Fast" />
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-full /template/ TextBlock#PART_Label">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-full /template/ TextBlock#PART_Badge">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-full /template/ Ellipse#PART_Dot">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-full /template/ arc|ArcGlyph#PART_Chevron">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                    <arc:ArcBrushTransition Property="Foreground" Tween="Fast" />
                    <arc:SpringTransformOperationsTransition Property="RenderTransform" Spring="Snappy" />
                </Transitions>
            </Setter>
        </Style>
        <!-- Reduced motion: the text only fades; the chevron turns at once. -->
        <Style Selector="^:motion-reduced /template/ TextBlock#PART_Label">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced /template/ TextBlock#PART_Badge">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced /template/ Ellipse#PART_Dot">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced /template/ arc|ArcGlyph#PART_Chevron">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- A section heading and the gap above it; on the rail a 1px line marks the section break instead. -->
    <ControlTheme x:Key="{x:Type arc:SidebarSectionHeader}" TargetType="arc:SidebarSectionHeader">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:SidebarSectionHeader">
                <Panel>
                    <Border Name="PART_Separator"
                            IsHitTestVisible="False"
                            Height="1"
                            VerticalAlignment="Center"
                            Margin="{arc:SidebarTokenResource SeparatorMargin}"
                            Background="{arc:ArcDesignTokenResource BorderSubtle}" />
                    <Panel Name="PART_TitleRow"
                           Height="{arc:SidebarTokenResource SectionHeaderHeight}"
                           VerticalAlignment="Bottom">
                        <Border Name="PART_Fill"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{arc:SidebarTokenResource RowRadius}" />
                        <arc:SidebarOpenWidthHost Margin="{arc:SidebarTokenResource RowInlinePadding}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Name="PART_Title"
                                           Text="{TemplateBinding Title}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <arc:ArcGlyph Name="PART_Chevron"
                                              Data="{x:Static arc:ArcIcons.ChevronDown}"
                                              Size="{arc:SidebarTokenResource SectionChevronSize}"
                                              StrokeThickness="{arc:SidebarTokenResource ChevronStroke}"
                                              IsVisible="{TemplateBinding IsCollapsible}"
                                              VerticalAlignment="Center"
                                              RenderTransformOrigin="50%,50%" />
                            </StackPanel>
                        </arc:SidebarOpenWidthHost>
                        <Border Name="PART_FocusRing"
                                IsVisible="False"
                                IsHitTestVisible="False"
                                Margin="{arc:SidebarTokenResource FocusRingMargin}"
                                BorderThickness="2"
                                CornerRadius="{arc:SidebarTokenResource FocusRingRadius}"
                                BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                    </Panel>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="ClipToBounds" Value="False" />

        <Style Selector="^ /template/ Panel#PART_TitleRow">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:titled /template/ Panel#PART_TitleRow">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:gap /template/ Panel#PART_TitleRow">
            <Setter Property="Margin" Value="{arc:SidebarTokenResource SectionTitleMargin}" />
        </Style>
        <Style Selector="^:gap:not(:titled)">
            <Setter Property="MinHeight" Value="{arc:SidebarTokenResource SectionGap}" />
        </Style>
        <Style Selector="^ /template/ Border#PART_Separator">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^ /template/ arc|ArcGlyph#PART_Chevron">
            <Setter Property="RenderTransform" Value="rotate(-90deg)" />
        </Style>
        <Style Selector="^:expanded /template/ arc|ArcGlyph#PART_Chevron">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>
        <Style Selector="^:hovered">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:rail /template/ Panel#PART_TitleRow">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="^:rail:gap /template/ Border#PART_Separator">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-full /template/ Panel#PART_TitleRow">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-full /template/ Border#PART_Separator">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-full /template/ arc|ArcGlyph#PART_Chevron">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:SpringTransformOperationsTransition Property="RenderTransform" Spring="Snappy" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced /template/ Panel#PART_TitleRow">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced /template/ Border#PART_Separator">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
