<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal">
    <!--
        LoginSplit: the form column (header 46 high with 24 32 0 padding; the steps centered in the middle with 40 20 padding;
        the footer with 0 32 24 padding) beside the picture column (muted surface under the picture, 1px border on its left).
        The control sets the columns from its own width (5:6 from 1100, 1:1 from 760, the form alone below) and the
        :compact padding below 480. Framed: 1px border, 26px corners, at least 640 high; :fullscreen: square, no border.
        The steps are built in code (LoginSplit.Flow.cs, LoginSplitViews.cs) and shown in PART_Viewport.
    -->
    <ControlTheme x:Key="{x:Type arc:LoginSplit}" TargetType="arc:LoginSplit">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Background}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
        <Setter Property="MinHeight" Value="{arc:LoginSplitTokenResource FramedMinHeight}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeBase}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:LoginSplit">
                <Border Name="PART_Frame"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <Grid Name="PART_Layout" ColumnDefinitions="5*,6*">
                        <Grid Name="PART_FormSide" RowDefinitions="Auto,*,Auto">
                            <!-- Header: the brand, then "No account? Sign up". -->
                            <DockPanel Name="PART_Header">
                                <StackPanel Name="PART_SignUpLine"
                                            DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Name="PART_NoAccount"
                                               VerticalAlignment="Center"
                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                               LineHeight="19.6"
                                               LetterSpacing="{arc:LoginSplitTokenResource BodyLetterSpacing}" />
                                    <arc:LoginSplitTextButton Name="PART_SignUp" Classes="link" Margin="4,0,0,0" />
                                </StackPanel>
                                <StackPanel Name="PART_Brand"
                                            Orientation="Horizontal"
                                            Spacing="{arc:LoginSplitTokenResource BrandGap}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left">
                                    <arc:AuthBrandMark Name="PART_BrandMark"
                                                             DefaultData="{x:Static arc:AuthBrandMarks.Notebook24}"
                                                             Width="{arc:LoginSplitTokenResource BrandMarkSize}"
                                                             Height="{arc:LoginSplitTokenResource BrandMarkSize}"
                                                             Data="{TemplateBinding BrandMark}"
                                                             Foreground="{arc:ArcDesignTokenResource Accent}" />
                                    <TextBlock Name="PART_BrandName"
                                               Text="{TemplateBinding BrandName}"
                                               VerticalAlignment="Center"
                                               FontSize="{arc:ArcDesignTokenResource TypeBase}"
                                               FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                               LineHeight="16"
                                               LetterSpacing="{arc:LoginSplitTokenResource BrandLetterSpacing}"
                                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                </StackPanel>
                            </DockPanel>

                            <!-- The steps, centered; the viewport hangs 12 outside the 360 form on each side. -->
                            <Border Name="PART_Main" Grid.Row="1" Padding="{arc:LoginSplitTokenResource MainInset}">
                                <arc:LoginSplitViewport Name="PART_Viewport"
                                                        Margin="{arc:LoginSplitTokenResource ViewportOutset}"
                                                        MaxWidth="{arc:LoginSplitTokenResource ViewportMaxWidth}"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Center" />
                            </Border>

                            <!-- Footer: the visible status line (screen readers hear PART_Announcer), then the legal links. -->
                            <arc:LoginSplitFooterPanel Name="PART_Footer"
                                                       Grid.Row="2"
                                                       RowGap="{arc:LoginSplitTokenResource FooterRowGap}"
                                                       ColumnGap="{arc:LoginSplitTokenResource FooterColumnGap}">
                                <arc:SiteSwap Name="PART_Status" AutomationProperties.AccessibilityView="Raw" />
                                <StackPanel Name="PART_Legal"
                                            Orientation="Horizontal"
                                            Spacing="{arc:LoginSplitTokenResource LegalGap}">
                                    <arc:LoginSplitTextButton Name="PART_Terms" Classes="legal" />
                                    <arc:LoginSplitTextButton Name="PART_Privacy" Classes="legal" />
                                </StackPanel>
                            </arc:LoginSplitFooterPanel>
                        </Grid>

                        <!-- The picture column: muted surface while the picture loads, a 1px border on its left. -->
                        <Border Name="PART_PhotoSide"
                                Grid.Column="1"
                                Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                BorderBrush="{arc:ArcDesignTokenResource Border}"
                                BorderThickness="{arc:ArcDesignTokenResource EdgeThicknessLeft}"
                                AutomationProperties.AccessibilityView="Raw">
                            <arc:LoginSplitBackdrop Name="PART_Backdrop"
                                                    Image="{TemplateBinding Photo}"
                                                    Alignment="{TemplateBinding PhotoAlignment}" />
                        </Border>

                        <arc:SiteAnnouncer Name="PART_Announcer" Grid.ColumnSpan="2" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:fullscreen">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="^ /template/ DockPanel#PART_Header">
            <Setter Property="Margin" Value="{arc:LoginSplitTokenResource HeaderInset}" />
        </Style>
        <Style Selector="^ /template/ arc|LoginSplitFooterPanel#PART_Footer">
            <Setter Property="Margin" Value="{arc:LoginSplitTokenResource FooterInset}" />
        </Style>
        <Style Selector="^:compact /template/ DockPanel#PART_Header">
            <Setter Property="Margin" Value="{arc:LoginSplitTokenResource CompactHeaderInset}" />
        </Style>
        <Style Selector="^:compact /template/ arc|LoginSplitFooterPanel#PART_Footer">
            <Setter Property="Margin" Value="{arc:LoginSplitTokenResource CompactFooterInset}" />
        </Style>
    </ControlTheme>

    <!--
        Text buttons. link: "Sign up" (14 / 500, foreground; an underline fades in on hover). legal: Terms and Privacy
        (12, muted; hover foreground). forgot: "Forgot password?" (14 / 400, secondary; padding 6 4, radius 8; hover
        foreground). resend: the resend button (12; muted and regular while it counts down, foreground and medium when ready).
        :inert keeps focus but shows no hover. Keyboard focus draws a 2px ring 2px outside.
    -->
    <ControlTheme x:Key="{x:Type arc:LoginSplitTextButton}" TargetType="arc:LoginSplitTextButton">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep4}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:LoginSplitTextButton">
                <Panel>
                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Panel>
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <Border Name="PART_Underline"
                                    IsVisible="False"
                                    Opacity="0"
                                    Height="1"
                                    Margin="0,0,0,3"
                                    VerticalAlignment="Bottom"
                                    IsHitTestVisible="False"
                                    Background="{TemplateBinding Foreground}" />
                        </Panel>
                    </Border>
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            Margin="-4"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^.link /template/ Border#PART_Underline">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^.link:pointerover /template/ Border#PART_Underline">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^.legal">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
            <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightRegular}" />
        </Style>
        <Style Selector="^.legal:pointerover">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>

        <Style Selector="^.forgot">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
            <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightRegular}" />
            <Setter Property="Padding" Value="{arc:LoginSplitTokenResource ForgotInset}" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep8}" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style Selector="^ /template/ Border#PART_FocusRing">
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep8}" />
        </Style>
        <Style Selector="^.forgot /template/ Border#PART_FocusRing">
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep12}" />
        </Style>
        <Style Selector="^.forgot:pointerover:not(:inert)">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^.forgot:pressed:not(:inert)">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>

        <Style Selector="^.resend">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        </Style>
        <Style Selector="^.resend:inert">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
            <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightRegular}" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <Style Selector="^:inert">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" />
                </Transitions>
            </Setter>
            <Style Selector="^ /template/ Border#PART_Underline">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcDoubleTransition Property="Opacity" />
                    </Transitions>
                </Setter>
            </Style>
        </Style>
    </ControlTheme>

    <!--
        The account chip: 36 high, padding 3 12 3 3, 8 between the 28px avatar, the email (ellipsis when long) and a 16px
        chevron; surface fill with a 1px border, pill corners. Hover: muted surface and the strong border; press: .97 on
        Arc's CSS spring. Keyboard focus draws a pill ring 2px outside.
    -->
    <ControlTheme x:Key="{x:Type arc:LoginSplitChip}" TargetType="arc:LoginSplitChip">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="{arc:LoginSplitTokenResource ChipHeight}" />
        <Setter Property="Padding" Value="{arc:LoginSplitTokenResource ChipInset}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightRegular}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:LoginSplitChip">
                <Panel>
                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <arc:Avatar Name="PART_Avatar"
                                        DockPanel.Dock="Left"
                                        Size="Small"
                                        DisplayName="{TemplateBinding DisplayName}"
                                        Source="{TemplateBinding Picture}"
                                        AutomationProperties.AccessibilityView="Raw" />
                            <arc:ArcGlyph Name="PART_Chevron"
                                          DockPanel.Dock="Right"
                                          Margin="8,0,0,0"
                                          Data="{x:Static arc:ArcIcons.ChevronDown}"
                                          Size="16"
                                          StrokeThickness="1.75"
                                          VerticalAlignment="Center"
                                          Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                            <TextBlock Name="PART_Email"
                                       Margin="8,0,0,0"
                                       Text="{TemplateBinding Email}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       LineHeight="19.6"
                                       LetterSpacing="{arc:LoginSplitTokenResource BodyLetterSpacing}" />
                        </DockPanel>
                    </Border>
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            Margin="-4"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^:motion-full">
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" />
                    <arc:ArcBrushTransition Property="BorderBrush" />
                    <arc:ArcTransformOperationsTransition Property="RenderTransform" Tween="Spring" />
                </Transitions>
            </Setter>
            <Style Selector="^:pressed">
                <Setter Property="RenderTransform" Value="scale(0.97)" />
            </Style>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                    <arc:ArcBrushTransition Property="BorderBrush" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
