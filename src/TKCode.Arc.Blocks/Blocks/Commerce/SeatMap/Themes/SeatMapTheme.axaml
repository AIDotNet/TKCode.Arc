<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.SeatMapTheme">
    <!-- Seat map: title and legend, the drawn map, and the summary of the chosen seats beside it (under it when narrow). -->
    <ControlTheme x:Key="{x:Type arc:SeatMap}" TargetType="arc:SeatMap">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
        <Setter Property="Padding" Value="{arc:SeatMapTokenResource BlockPadding}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="CompactThreshold" Value="{arc:SeatMapTokenResource CompactThreshold}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:SeatMap">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Panel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,16">
                                <TextBlock Name="PART_Title"
                                           TextWrapping="Wrap"
                                           FontFamily="{arc:ArcDesignTokenResource DisplayFontFamily}"
                                           FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                           FontWeight="{arc:ArcDesignTokenResource WeightMedium}" />
                                <WrapPanel Name="PART_Legend" ItemSpacing="16" LineSpacing="6" />
                            </StackPanel>
                            <StackPanel Name="PART_Summary" DockPanel.Dock="Right" Spacing="12" />
                            <arc:SeatMapCanvas Name="PART_Canvas" VerticalAlignment="Top" />
                        </DockPanel>
                        <arc:FinanceAnnouncer Name="PART_Announcer" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ StackPanel#PART_Summary">
            <Setter Property="Width" Value="{arc:SeatMapTokenResource SummaryWidth}" />
            <Setter Property="Margin" Value="{arc:SeatMapTokenResource SummaryMargin}" />
        </Style>
        <Style Selector="^:compact /template/ StackPanel#PART_Summary">
            <Setter Property="DockPanel.Dock" Value="Bottom" />
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Margin" Value="{arc:SeatMapTokenResource SummaryStackedMargin}" />
        </Style>
        <Style Selector="^ /template/ arc|SeatMapCanvas#PART_Canvas">
            <Setter Property="Tier1Brush" Value="{arc:ArcDesignTokenResource Series1}" />
            <Setter Property="Tier2Brush" Value="{arc:ArcDesignTokenResource Series2}" />
            <Setter Property="Tier3Brush" Value="{arc:ArcDesignTokenResource Series3}" />
            <Setter Property="Tier4Brush" Value="{arc:ArcDesignTokenResource Series4}" />
            <Setter Property="TakenBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
            <Setter Property="ChosenBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Setter Property="ChosenForeground" Value="{arc:ArcDesignTokenResource Background}" />
            <Setter Property="StageBrush" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="TextBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Setter Property="MutedBrush" Value="{arc:ArcDesignTokenResource TextMuted}" />
            <Setter Property="FocusBrush" Value="{arc:ArcDesignTokenResource FocusRing}" />
            <Setter Property="ReadoutBrush" Value="{arc:ArcDesignTokenResource SurfaceRaised}" />
            <Setter Property="ReadoutBorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep10}" />
            <Setter Property="LabelFontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
            <Setter Property="LabelFontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
    </ControlTheme>

    <!-- A legend dot (classes s1–s4, taken, chosen). -->
    <ControlTheme x:Key="{x:Type arc:SeatMapLegendDot}" TargetType="arc:SeatMapLegendDot">
        <Setter Property="Width" Value="{arc:SeatMapTokenResource LegendDot}" />
        <Setter Property="Height" Value="{arc:SeatMapTokenResource LegendDot}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Series1}" />
        <Style Selector="^.s2">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Series2}" />
        </Style>
        <Style Selector="^.s3">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Series3}" />
        </Style>
        <Style Selector="^.s4">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Series4}" />
        </Style>
        <Style Selector="^.taken">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
            <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        </Style>
        <Style Selector="^.chosen">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
