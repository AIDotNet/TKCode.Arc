<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.WalletCardTheme">
    <!--
        Wallet card: the face column (the drawn card, its frost layer, the freeze and details buttons, the copy button) and
        the balance column (balance, the monthly limit meter, the frozen note and the recent activity rows built in code).
        Narrow blocks stack the columns.
    -->
    <ControlTheme x:Key="{x:Type arc:WalletCard}" TargetType="arc:WalletCard">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
        <Setter Property="Padding" Value="{arc:WalletCardTokenResource BlockPadding}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="CompactThreshold" Value="{arc:WalletCardTokenResource CompactThreshold}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:WalletCard">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Panel>
                        <DockPanel>
                            <StackPanel Name="PART_FaceColumn"
                                        DockPanel.Dock="Left"
                                        Spacing="14"
>
                                <arc:WalletCardFacePanel Name="PART_Face"
                                                         MaxFaceWidth="{arc:WalletCardTokenResource FaceMaxWidth}"
                                                         HorizontalAlignment="Left"
                                                         Focusable="False">
                                    <arc:WalletCardArt Name="PART_Art" />
                                    <Grid Margin="{arc:WalletCardTokenResource FacePadding}"
                                          RowDefinitions="Auto,*,Auto,Auto"
                                          ColumnDefinitions="*,Auto">
                                        <TextBlock Name="PART_Issuer"
                                                   FontFamily="{arc:ArcDesignTokenResource DisplayFontFamily}"
                                                   FontSize="{arc:ArcDesignTokenResource TypeBase}"
                                                   FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                                   Foreground="{arc:WalletCardTokenResource FaceTextColor}" />
                                        <TextBlock Name="PART_Network"
                                                   Grid.Column="1"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                   Foreground="{arc:WalletCardTokenResource FaceMutedTextColor}" />
                                        <Panel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,10">
                                            <TextBlock Name="PART_Masked"
                                                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                       FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                                       Foreground="{arc:WalletCardTokenResource FaceTextColor}" />
                                            <TextBlock Name="PART_Full"
                                                       Classes="details"
                                                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                       FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                                       Foreground="{arc:WalletCardTokenResource FaceTextColor}" />
                                        </Panel>
                                        <arc:ArcShrinkRow Grid.Row="3" Grid.ColumnSpan="2" Spacing="18">
                                            <TextBlock Name="PART_Holder"
                                                       arc:ArcShrinkRow.IsShrinkable="True"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Bottom"
                                                       FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                       Foreground="{arc:WalletCardTokenResource FaceTextColor}" />
                                            <StackPanel Spacing="1">
                                                <TextBlock Name="PART_ExpiryLabel"
                                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                           Foreground="{arc:WalletCardTokenResource FaceMutedTextColor}" />
                                                <TextBlock Name="PART_Expiry"
                                                           FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                           FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                           Foreground="{arc:WalletCardTokenResource FaceTextColor}" />
                                            </StackPanel>
                                            <StackPanel Name="PART_Cvc" Classes="details" Spacing="1">
                                                <TextBlock Name="PART_CvcLabel"
                                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                           Foreground="{arc:WalletCardTokenResource FaceMutedTextColor}" />
                                                <TextBlock Name="PART_CvcValue"
                                                           FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                           FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                           Foreground="{arc:WalletCardTokenResource FaceTextColor}" />
                                            </StackPanel>
                                        </arc:ArcShrinkRow>
                                    </Grid>
                                    <Border Name="PART_Frost"
                                            Background="{arc:WalletCardTokenResource FrostColor}"
                                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep16}"
                                            IsHitTestVisible="False">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                            <arc:ArcGlyph Name="PART_FrostGlyph"
                                                          Size="28"
                                                          HorizontalAlignment="Center"
                                                          Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                            <Border Background="{arc:ArcDesignTokenResource Surface}"
                                                    CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                                                    Padding="10,3">
                                                <TextBlock Name="PART_FrostLabel"
                                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                           FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                                           Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </arc:WalletCardFacePanel>
                                <WrapPanel Name="PART_Actions" Orientation="Horizontal">
                                    <arc:Button Name="PART_Freeze" Variant="Secondary" Size="Small" Margin="0,0,8,8" />
                                    <arc:Button Name="PART_Details" Variant="Ghost" Size="Small" Margin="0,0,8,8" />
                                    <arc:CopyButton Name="PART_Copy" Margin="0,0,0,8" />
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Name="PART_Side" Spacing="16">
                                <StackPanel Spacing="4">
                                    <TextBlock Name="PART_BalanceLabel"
                                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                               Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                    <TextBlock Name="PART_Balance"
                                               FontFamily="{arc:ArcDesignTokenResource DisplayFontFamily}"
                                               FontSize="{arc:ArcDesignTokenResource Type3XL}"
                                               FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                               FontFeatures="+tnum"
                                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <arc:WalletCardMeter Name="PART_Meter" Height="{arc:WalletCardTokenResource MeterHeight}" />
                                    <TextBlock Name="PART_LimitLine"
                                               TextWrapping="Wrap"
                                               FontFeatures="+tnum"
                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                </StackPanel>
                                <Border Name="PART_FrozenNote"
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusStep14}"
                                        Padding="12,10">
                                    <TextBlock Name="PART_FrozenNoteText"
                                               TextWrapping="Wrap"
                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                </Border>
                                <StackPanel Spacing="4">
                                    <TextBlock Name="PART_ActivityTitle"
                                               Margin="0,4,0,4"
                                               FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                    <StackPanel Name="PART_Rows" />
                                    <TextBlock Name="PART_Empty"
                                               Margin="0,8"
                                               Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                        <arc:FinanceAnnouncer Name="PART_Announcer" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ arc|WalletCardArt#PART_Art">
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep16}" />
            <Setter Property="AccentBrush" Value="{arc:ArcDesignTokenResource Accent}" />
            <Setter Property="AccentStrongBrush" Value="{arc:ArcDesignTokenResource AccentStrong}" />
        </Style>
        <Style Selector="^ /template/ arc|WalletCardMeter#PART_Meter">
            <Setter Property="TrackBrush" Value="{arc:ArcDesignTokenResource ControlTrack}" />
            <Setter Property="FillBrush" Value="{arc:ArcDesignTokenResource Accent}" />
            <Setter Property="OverBrush" Value="{arc:ArcDesignTokenResource Danger}" />
        </Style>
        <!-- Details: the full number and the CVC replace the masked number; the frost covers a frozen face. -->
        <Style Selector="^ /template/ StackPanel#PART_Cvc, ^ /template/ TextBlock#PART_Full">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:details /template/ StackPanel#PART_Cvc, ^:details /template/ TextBlock#PART_Full">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:details /template/ TextBlock#PART_Masked">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^ /template/ Border#PART_Frost">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:frozen /template/ Border#PART_Frost">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^ /template/ StackPanel#PART_FaceColumn">
            <Setter Property="Width" Value="{arc:WalletCardTokenResource FaceMaxWidth}" />
            <Setter Property="Margin" Value="{arc:WalletCardTokenResource FaceColumnMargin}" />
        </Style>
        <Style Selector="^:compact /template/ StackPanel#PART_FaceColumn">
            <Setter Property="DockPanel.Dock" Value="Top" />
            <Setter Property="Width" Value="NaN" />
            <Setter Property="Margin" Value="{arc:WalletCardTokenResource FaceColumnStackedMargin}" />
        </Style>
        <Style Selector="^:motion-full">
            <Style Selector="^ /template/ StackPanel#PART_Cvc, ^ /template/ TextBlock#PART_Full">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcDoubleTransition Property="Opacity" Tween="Standard" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ TextBlock#PART_Masked">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ Border#PART_Frost">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcDoubleTransition Property="Opacity" Tween="Considered" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ arc|WalletCardMeter#PART_Meter">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:SpringDoubleTransition Property="Fraction" Spring="Smooth" />
                    </Transitions>
                </Setter>
            </Style>
        </Style>
        <Style Selector="^:motion-reduced">
            <Style Selector="^ /template/ StackPanel#PART_Cvc, ^ /template/ TextBlock#PART_Full">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcDoubleTransition Property="Opacity" Tween="Instant" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ Border#PART_Frost">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcDoubleTransition Property="Opacity" Tween="Instant" />
                    </Transitions>
                </Setter>
            </Style>
        </Style>
    </ControlTheme>

    <!-- An activity row: a quiet button, filled on hover and keyboard focus, with Arc's focus ring. -->
    <ControlTheme x:Key="{x:Type arc:WalletCardRow}" TargetType="arc:WalletCardRow">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Padding" Value="{arc:WalletCardTokenResource RowPadding}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep14}" />
        <Setter Property="MinHeight" Value="{arc:WalletCardTokenResource RowHeight}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:WalletCardRow">
                <Panel>
                    <Border Name="PART_FocusRing"
                            Margin="-2"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep16}"
                            Opacity="0"
                            IsHitTestVisible="False" />
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:focus-visible">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Style Selector="^ /template/ Border#PART_FocusRing">
                <Setter Property="Opacity" Value="1" />
            </Style>
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- A merchant's disc: the muted surface with the initials in one of the four series colors. -->
    <ControlTheme x:Key="{x:Type arc:WalletCardMerchantDisc}" TargetType="arc:WalletCardMerchantDisc">
        <Setter Property="Width" Value="{arc:WalletCardTokenResource MerchantDiameter}" />
        <Setter Property="Height" Value="{arc:WalletCardTokenResource MerchantDiameter}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="TextElement.Foreground" Value="{arc:ArcDesignTokenResource Series1}" />
        <Setter Property="TextElement.FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="TextElement.FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Style Selector="^.s2">
            <Setter Property="TextElement.Foreground" Value="{arc:ArcDesignTokenResource Series2}" />
        </Style>
        <Style Selector="^.s3">
            <Setter Property="TextElement.Foreground" Value="{arc:ArcDesignTokenResource Series3}" />
        </Style>
        <Style Selector="^.s4">
            <Setter Property="TextElement.Foreground" Value="{arc:ArcDesignTokenResource Series4}" />
        </Style>
        <Style Selector="^.credit">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SuccessSubtle}" />
            <Setter Property="TextElement.Foreground" Value="{arc:ArcDesignTokenResource Success}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
