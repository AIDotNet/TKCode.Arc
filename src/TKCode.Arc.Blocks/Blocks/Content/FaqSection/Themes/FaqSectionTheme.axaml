<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.FaqSectionTheme">
    <!-- Ported from Arc's free faq-section block (MIT, Copyright (c) 2026 Elia Kuratli): faq-section.module.css. -->
    <ControlTheme x:Key="{x:Type arc:FaqSection}" TargetType="arc:FaqSection">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Background}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:FaqSection">
                <Border Background="{TemplateBinding Background}">
                    <Border Name="PART_Body" VerticalAlignment="Top">
                        <Panel Name="PART_Host" />
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Border#PART_Body">
            <Setter Property="MaxWidth" Value="{arc:FaqSectionTokenResource StackMaxWidth}" />
        </Style>
        <Style Selector="^:columns /template/ Border#PART_Body">
            <Setter Property="MaxWidth" Value="{arc:FaqSectionTokenResource ColumnsMaxWidth}" />
        </Style>
    </ControlTheme>

    <!-- One question. The answer's opacity, travel and blur open on the enter curve and close in 120 ms. -->
    <ControlTheme x:Key="{x:Type arc:FaqRow}" TargetType="arc:FaqRow">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:FaqRow">
                <arc:SpringSizeDecorator Name="PART_Presence" Axis="Height" Spring="Smooth" IsExpanded="{TemplateBinding IsPresent}">
                    <Border BorderThickness="0,0,0,1" BorderBrush="{arc:ArcDesignTokenResource Border}">
                        <StackPanel>
                            <arc:FaqTrigger Name="PART_Trigger">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <arc:DecoratedTextBlock Name="PART_Question"
                                                            IsHitTestVisible="False"
                                                            TextWrapping="Wrap"
                                                            VerticalAlignment="Center"
                                                            FontSize="{arc:ArcDesignTokenResource TypeBase}"
                                                            FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                                            LineHeight="24"
                                                            Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                    <arc:ArcGlyph Name="PART_Icon"
                                                  Grid.Column="1"
                                                  Data="{x:Static arc:ArcIcons.Plus}"
                                                  Size="18"
                                                  StrokeThickness="1.75"
                                                  VerticalAlignment="Center"
                                                  RenderTransformOrigin="50%,50%" />
                                </Grid>
                            </arc:FaqTrigger>
                            <arc:SpringSizeDecorator Axis="Height" Spring="Smooth" IsExpanded="{TemplateBinding HasHint}">
                                <arc:DecoratedTextBlock Name="PART_Hint"
                                                        IsHitTestVisible="False"
                                                        TextWrapping="Wrap"
                                                        Padding="{arc:FaqSectionTokenResource HintPadding}"
                                                        FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                        Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                            </arc:SpringSizeDecorator>
                            <arc:SpringSizeDecorator Name="PART_Panel" Axis="Height" Spring="Smooth" IsExpanded="{TemplateBinding IsOpen}">
                                <Border Name="PART_AnswerBody">
                                    <arc:DecoratedTextBlock Name="PART_Answer"
                                                            TextWrapping="Wrap"
                                                            FontSize="{arc:ArcDesignTokenResource TypeBase}"
                                                            LineHeight="25.6"
                                                            Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                </Border>
                            </arc:SpringSizeDecorator>
                        </StackPanel>
                    </Border>
                </arc:SpringSizeDecorator>
            </ControlTemplate>
        </Setter>
        <Setter Property="MarkBrush" Value="{arc:ArcDesignTokenResource AccentSubtle}" />

        <Style Selector="^ /template/ arc|SpringSizeDecorator#PART_Presence">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:absent /template/ arc|SpringSizeDecorator#PART_Presence">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^ /template/ Border#PART_AnswerBody">
            <Setter Property="Padding" Value="{arc:FaqSectionTokenResource AnswerPadding}" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translateY(-6px)" />
            <Setter Property="Effect">
                <BlurEffect Radius="2" />
            </Setter>
        </Style>
        <Style Selector="^:narrow /template/ Border#PART_AnswerBody">
            <Setter Property="Padding" Value="{arc:FaqSectionTokenResource AnswerPaddingNarrow}" />
        </Style>
        <Style Selector="^:open /template/ Border#PART_AnswerBody">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="translateY(0px)" />
            <Setter Property="Effect" Value="{x:Null}" />
        </Style>
        <Style Selector="^ /template/ arc|ArcGlyph#PART_Icon">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>
        <Style Selector="^:open /template/ arc|ArcGlyph#PART_Icon">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Setter Property="RenderTransform" Value="rotate(45deg)" />
        </Style>

        <Style Selector="^:motion-full /template/ arc|SpringSizeDecorator#PART_Presence">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-full:not(:absent) /template/ arc|SpringSizeDecorator#PART_Presence">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-full /template/ Border#PART_AnswerBody">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Instant" />
                    <arc:ArcTransformOperationsTransition Property="RenderTransform" Tween="Instant" />
                    <arc:ArcEffectTransition Property="Effect" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-full:open /template/ Border#PART_AnswerBody">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast">
                        <arc:ArcDoubleTransition.Easing>
                            <SplineEasing X1="0.16" Y1="1" X2="0.3" Y2="1" />
                        </arc:ArcDoubleTransition.Easing>
                    </arc:ArcDoubleTransition>
                    <arc:SpringTransformOperationsTransition Property="RenderTransform" Spring="Smooth" />
                    <arc:ArcEffectTransition Property="Effect" Tween="Fast">
                        <arc:ArcEffectTransition.Easing>
                            <SplineEasing X1="0.16" Y1="1" X2="0.3" Y2="1" />
                        </arc:ArcEffectTransition.Easing>
                    </arc:ArcEffectTransition>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-full /template/ arc|ArcGlyph#PART_Icon">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcTransformOperationsTransition Property="RenderTransform" Tween="Spring" />
                    <arc:ArcBrushTransition Property="Foreground" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type arc:FaqTrigger}" TargetType="arc:FaqTrigger">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="{arc:FaqSectionTokenResource TriggerMinHeight}" />
        <Setter Property="Padding" Value="{arc:FaqSectionTokenResource TriggerPadding}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:FaqTrigger">
                <Panel Background="{TemplateBinding Background}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Center" />
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep8}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type arc:FaqCategoryButton}" TargetType="arc:FaqCategoryButton">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="{arc:FaqSectionTokenResource CategoryHeight}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:FaqCategoryButton">
                <Panel Background="{TemplateBinding Background}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="12,0">
                        <TextBlock Text="{TemplateBinding Topic}"
                                   VerticalAlignment="Center"
                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                   FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                   Foreground="{TemplateBinding Foreground}" />
                        <TextBlock Grid.Column="1"
                                   Text="{TemplateBinding Count}"
                                   VerticalAlignment="Center"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                    </Grid>
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep12}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:active">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type arc:FaqContactButton}" TargetType="arc:FaqContactButton">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="RenderTransform" Value="scale(1)" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:FaqContactButton">
                <Panel>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep20}"
                            Padding="{arc:FaqSectionTokenResource ContactPadding}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Label}"
                                           TextWrapping="Wrap"
                                           FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                           FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                           Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                <TextBlock Text="{TemplateBinding Description}"
                                           TextWrapping="Wrap"
                                           FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                            </StackPanel>
                            <arc:ArcGlyph Name="PART_Arrow"
                                          Grid.Column="1"
                                          Data="{x:Static arc:ArcIcons.ArrowRight}"
                                          Size="16"
                                          StrokeThickness="1.75"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            Margin="-2"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep22}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ arc|ArcGlyph#PART_Arrow">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
            <Setter Property="RenderTransform" Value="translateX(0px)" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:pointerover /template/ arc|ArcGlyph#PART_Arrow">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Setter Property="RenderTransform" Value="translateX(2px)" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:motion-full:pressed">
            <Setter Property="RenderTransform" Value="scale(0.99)" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                    <arc:ArcTransformOperationsTransition Property="RenderTransform" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-full /template/ arc|ArcGlyph#PART_Arrow">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcTransformOperationsTransition Property="RenderTransform" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
