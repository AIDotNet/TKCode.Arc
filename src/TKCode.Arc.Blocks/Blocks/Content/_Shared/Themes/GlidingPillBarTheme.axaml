<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.GlidingPillBarTheme">

    <!-- The highlight's colors per look; its radius is a pill. -->
    <ControlTheme x:Key="{x:Type arc:GlidingPillBar}" TargetType="arc:GlidingPillBar">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="IndicatorFill" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Style Selector="^:solid-bar">
            <Setter Property="IndicatorFill" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
    </ControlTheme>

    <!-- height 36, padding 0 16, small medium text; the text color moves in 160 ms standard. -->
    <ControlTheme x:Key="{x:Type arc:GlidingPillButton}" TargetType="arc:GlidingPillButton">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:GlidingPillButton">
                <Panel Name="PART_Root" Background="Transparent">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Padding="{TemplateBinding Padding}"
                                      Content="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:checked">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:solid:checked">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Background}" />
        </Style>
        <Style Selector="^:raised">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
