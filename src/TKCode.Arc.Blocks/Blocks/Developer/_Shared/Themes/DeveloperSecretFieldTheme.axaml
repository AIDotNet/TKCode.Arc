<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal">
    <!--
        The Developer secret field (Arc API keys / Webhooks one-time secret and Env variables' masked value, design
        reference). OneTime: label 14/19.6 500; box padding 6 6 6 14, radius 12, 1px Accent 45% into Border (set in code),
        Surface, min 50 high, value mono 14/21 wrapping anywhere, Copy button 12 to its right; warning line 16 below
        (TriangleAlert 16 Warning, 14/19.6 TextSecondary). Masked: 36px slot, 16 bullets mono 12 (spacing .96) TextMuted,
        value mono 12/16.8 Foreground with an ellipsis, icon copy button and a 36px eye toggle (radius 10) 2 apart;
        sensitive: Lock 14 + "Sensitive" 12/16.8 TextSecondary, 8 from the right.
    -->
    <ControlTheme x:Key="{x:Type arc:DeveloperSecretField}" TargetType="arc:DeveloperSecretField">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:DeveloperSecretField">
                <StackPanel>
                    <TextBlock Name="PART_Label"
                               Text="{TemplateBinding Label}"
                               IsVisible="{TemplateBinding Label, Converter={x:Static ObjectConverters.IsNotNull}}"
                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                               FontWeight="Medium"
                               LineHeight="19.6"
                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                    <Border Name="PART_Box"
                            MinHeight="50"
                            Padding="14,6,6,6"
                            BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep12}"
                            Background="{arc:ArcDesignTokenResource Surface}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Name="PART_Secret"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                       FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                       LineHeight="21"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
                            <arc:CopyButton Name="PART_Copy" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Grid Name="PART_Notice"
                          Margin="0,16,0,0"
                          ColumnDefinitions="Auto,*"
                          ColumnSpacing="8"
                          IsVisible="{TemplateBinding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <arc:ArcGlyph Data="{x:Static arc:ArcIcons.TriangleAlert}"
                                      Size="16"
                                      Margin="0,2,0,0"
                                      VerticalAlignment="Top"
                                      Foreground="{arc:ArcDesignTokenResource Warning}" />
                        <TextBlock Grid.Column="1"
                                   Text="{TemplateBinding Notice}"
                                   TextWrapping="Wrap"
                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                   LineHeight="19.6"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                    </Grid>
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[Mode=Masked]">
            <Setter Property="Template">
                <ControlTemplate TargetType="arc:DeveloperSecretField">
                    <Grid Height="36" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="2">
                        <Panel VerticalAlignment="Center" ClipToBounds="False">
                            <TextBlock Name="PART_Mask"
                                       VerticalAlignment="Center"
                                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       LetterSpacing="0.96"
                                       LineHeight="16.8"
                                       Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                            <TextBlock Name="PART_Secret"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       LineHeight="16.8"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
                        </Panel>
                        <Panel Name="PART_CopySlot" Grid.Column="1" IsVisible="False">
                            <arc:CopyButton Name="PART_Copy" IsIconOnly="True" Variant="Plain" VerticalAlignment="Center" />
                        </Panel>
                        <arc:DeveloperIconToggle Name="PART_Reveal"
                                                 Grid.Column="2"
                                                 IsVisible="{TemplateBinding IsSensitive, Converter={x:Static BoolConverters.Not}}">
                            <arc:ArcGlyph Name="PART_RevealIcon" Data="{x:Static arc:ArcIcons.Eye}" Size="16" />
                        </arc:DeveloperIconToggle>
                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    IsVisible="{TemplateBinding IsSensitive}">
                            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Lock}"
                                          Size="14"
                                          VerticalAlignment="Center"
                                          Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                            <TextBlock Text="{TemplateBinding SensitiveText}"
                                       VerticalAlignment="Center"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       LineHeight="16.8"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- The 36px icon toggle: radius 10, TextSecondary glyph turning Foreground on hover and while on; fills set in code. -->
    <ControlTheme x:Key="{x:Type arc:DeveloperIconToggle}" TargetType="arc:DeveloperIconToggle">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:DeveloperIconToggle">
                <Panel>
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            Margin="-4"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep14}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep10}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:checked">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                    <arc:ArcBrushTransition Property="Foreground" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
