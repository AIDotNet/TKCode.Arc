<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.BudgetVarianceTheme">
    <!--
        Budget variance: a bordered card with the title, the period switch, the table (built in code from the internal
        parts below) and the legend. Rows share one set of column widths from the token, so the budget ticks line up.
    -->
    <ControlTheme x:Key="{x:Type arc:BudgetVariance}" TargetType="arc:BudgetVariance">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:BudgetVarianceTokenResource CardRadius}" />
        <Setter Property="Padding" Value="{arc:BudgetVarianceTokenResource CardPadding}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="TableThreshold" Value="{arc:BudgetVarianceTokenResource TableThreshold}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:BudgetVariance">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Panel>
                        <StackPanel Spacing="{arc:BudgetVarianceTokenResource SectionGap}">
                            <DockPanel Name="PART_Header">
                                <arc:SegmentedControl Name="PART_Periods"
                                                      DockPanel.Dock="Right"
                                                      VerticalAlignment="Top"
                                                      Margin="24,0,0,0" />
                                <StackPanel VerticalAlignment="Top">
                                    <TextBlock Name="PART_Title"
                                               Text="{TemplateBinding Title}"
                                               TextWrapping="Wrap"
                                               FontFamily="{arc:ArcDesignTokenResource DisplayFontFamily}"
                                               FontSize="{arc:ArcDesignTokenResource TypeBase}"
                                               FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                    <TextBlock Name="PART_Description"
                                               Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                               Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                </StackPanel>
                            </DockPanel>
                            <StackPanel Name="PART_Table" />
                            <WrapPanel Name="PART_Legend" Margin="{arc:BudgetVarianceTokenResource LegendMargin}" />
                        </StackPanel>
                        <arc:FinanceAnnouncer Name="PART_Announcer" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- One row's layout: the shared column widths, and the space each kind of row keeps around its cells. -->
    <ControlTheme x:Key="{x:Type arc:BudgetVarianceRowPanel}" TargetType="arc:BudgetVarianceRowPanel">
        <Setter Property="ColumnGap" Value="{arc:BudgetVarianceTokenResource ColumnGap}" />
        <Setter Property="AmountWidth" Value="{arc:BudgetVarianceTokenResource AmountColumnWidth}" />
        <Setter Property="VarianceWidth" Value="{arc:BudgetVarianceTokenResource VarianceColumnWidth}" />
        <Setter Property="ChevronWidth" Value="{arc:BudgetVarianceTokenResource ChevronColumnWidth}" />
        <Setter Property="NameShare" Value="{arc:BudgetVarianceTokenResource NameColumnShare}" />
        <Style Selector="^.header">
            <Setter Property="Margin" Value="{arc:BudgetVarianceTokenResource HeaderRowMargin}" />
        </Style>
        <Style Selector="^.total">
            <Setter Property="Margin" Value="{arc:BudgetVarianceTokenResource TotalRowMargin}" />
        </Style>
        <Style Selector="^.line">
            <Setter Property="Margin" Value="{arc:BudgetVarianceTokenResource LineRowMargin}" />
            <Setter Property="LeadInset" Value="{arc:BudgetVarianceTokenResource LineIndent}" />
        </Style>
    </ControlTheme>

    <!-- A bullet chart: bands from the token, the bar in the text color, the overspend in danger. Heights by level. -->
    <ControlTheme x:Key="{x:Type arc:BudgetBulletBar}" TargetType="arc:BudgetBulletBar">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="BandLowBrush" Value="{arc:BudgetVarianceTokenResource BandLowColor}" />
        <Setter Property="BandMidBrush" Value="{arc:BudgetVarianceTokenResource BandMidColor}" />
        <Setter Property="BandHighBrush" Value="{arc:BudgetVarianceTokenResource BandHighColor}" />
        <Setter Property="BarBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="OverBrush" Value="{arc:ArcDesignTokenResource Danger}" />
        <Setter Property="TickBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="BandRadius" Value="{arc:BudgetVarianceTokenResource BandRadius}" />
        <Setter Property="TickOverhang" Value="{arc:BudgetVarianceTokenResource TickOverhang}" />
        <Setter Property="TickWidth" Value="{arc:BudgetVarianceTokenResource TickWidth}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BandHeight" Value="{arc:BudgetVarianceTokenResource DepartmentBandHeight}" />
        <Setter Property="BarHeight" Value="{arc:BudgetVarianceTokenResource DepartmentBarHeight}" />
        <Style Selector="^.total">
            <Setter Property="BandHeight" Value="{arc:BudgetVarianceTokenResource TotalBandHeight}" />
            <Setter Property="BarHeight" Value="{arc:BudgetVarianceTokenResource TotalBarHeight}" />
        </Style>
        <Style Selector="^.line">
            <Setter Property="BandHeight" Value="{arc:BudgetVarianceTokenResource LineBandHeight}" />
            <Setter Property="BarHeight" Value="{arc:BudgetVarianceTokenResource LineBarHeight}" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:SpringDoubleTransition Property="Fraction" Spring="Smooth" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type arc:BudgetVarianceTotalHost}" TargetType="arc:BudgetVarianceTotalHost">
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThicknessBottom}" />
        <Setter Property="Margin" Value="{arc:BudgetVarianceTokenResource TotalRowGap}" />
    </ControlTheme>

    <!-- A department and its lines: clear while closed, the muted surface while open. -->
    <ControlTheme x:Key="{x:Type arc:BudgetVarianceItemHost}" TargetType="arc:BudgetVarianceItemHost">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{arc:BudgetVarianceTokenResource RowRadius}" />
        <Style Selector="^.expanded">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- The disclosure row: filled on hover and keyboard focus, Arc's focus ring on keyboard focus only. -->
    <ControlTheme x:Key="{x:Type arc:BudgetVarianceRowButton}" TargetType="arc:BudgetVarianceRowButton">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Padding" Value="{arc:BudgetVarianceTokenResource RowPadding}" />
        <Setter Property="CornerRadius" Value="{arc:BudgetVarianceTokenResource RowRadius}" />
        <Setter Property="MinHeight" Value="{arc:BudgetVarianceTokenResource RowMinHeight}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:BudgetVarianceRowButton">
                <Panel>
                    <Border Name="PART_FocusRing"
                            Margin="-2"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep14}"
                            Opacity="0"
                            IsHitTestVisible="False" />
                    <Border Name="PART_Fill"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover:not(:expanded)">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:focus-visible">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Style Selector="^ /template/ Border#PART_FocusRing">
                <Setter Property="Opacity" Value="1" />
            </Style>
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- An open department's lines: a hairline on top; they fade in with the height spring and out faster. -->
    <ControlTheme x:Key="{x:Type arc:BudgetVarianceLinesHost}" TargetType="arc:BudgetVarianceLinesHost">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Margin" Value="{arc:BudgetVarianceTokenResource LinesMargin}" />
        <Setter Property="Padding" Value="{arc:BudgetVarianceTokenResource LinesPadding}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThicknessTop}" />
        <Setter Property="Opacity" Value="0" />
        <Style Selector="^.expanded">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Considered" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-full:not(.expanded)">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type arc:BudgetVarianceLineHost}" TargetType="arc:BudgetVarianceLineHost">
        <Setter Property="Background" Value="Transparent" />
    </ControlTheme>

    <!-- The chevron turns half a turn on the CSS spring curve and takes the accent while its department is open. -->
    <ControlTheme x:Key="{x:Type arc:BudgetVarianceChevron}" TargetType="arc:BudgetVarianceChevron">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Size" Value="16" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="StrokeThickness" Value="{arc:ArcDesignTokenResource IconStrokeWidth}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="RenderTransform" Value="rotate(0deg)" />
        <Style Selector="^.expanded">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcTransformOperationsTransition Property="RenderTransform" Tween="Spring" />
                    <arc:ArcBrushTransition Property="Foreground" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- Legend marks. -->
    <ControlTheme x:Key="{x:Type arc:BudgetVarianceSwatch}" TargetType="arc:BudgetVarianceSwatch">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep1}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Style Selector="^.budget">
            <Setter Property="Width" Value="2" />
            <Setter Property="Height" Value="12" />
        </Style>
        <Style Selector="^.over">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Danger}" />
        </Style>
        <Style Selector="^.band">
            <Setter Property="Height" Value="10" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep2}" />
            <Setter Property="Background" Value="{arc:BudgetVarianceTokenResource BandMidColor}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
