<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.AvailabilityPickerTheme">

    <!--
        A day card: weekday, number and count, centered, inside a 1px Border with radius 14 (12 compact). Selected: the
        border clears and the text turns AccentForeground over the strip's gliding Accent fill. Text color and border change
        in 240ms, the press scales to .97 in 160ms (full motion only).
    -->
    <ControlTheme x:Key="{x:Type arc:AvailabilityDayButton}" TargetType="arc:AvailabilityDayButton">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Padding" Value="{arc:AvailabilityPickerTokenResource DayPadding}" />
        <Setter Property="CornerRadius" Value="{arc:AvailabilityPickerTokenResource DayRadius}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightRegular}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AvailabilityDayButton">
                <Panel>
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            Margin="{arc:AvailabilityPickerTokenResource FocusRingMargin}"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Spacing="{arc:AvailabilityPickerTokenResource DayLineGap}" HorizontalAlignment="Center">
                            <TextBlock Name="PART_Name"
                                       Text="{TemplateBinding DayName}"
                                       HorizontalAlignment="Center"
                                       LineHeight="{arc:AvailabilityPickerTokenResource CaptionLineHeight}"
                                       Opacity="{arc:AvailabilityPickerTokenResource DayCaptionOpacity}" />
                            <TextBlock Name="PART_Number"
                                       Text="{TemplateBinding DayNumber}"
                                       HorizontalAlignment="Center"
                                       FontFamily="{arc:ArcDesignTokenResource DisplayFontFamily}"
                                       FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                       FontFeatures="tnum" />
                            <TextBlock Name="PART_Open"
                                       Text="{TemplateBinding OpenText}"
                                       HorizontalAlignment="Center"
                                       LineHeight="{arc:AvailabilityPickerTokenResource CaptionLineHeight}"
                                       Opacity="{arc:AvailabilityPickerTokenResource DayCaptionOpacity}" />
                        </StackPanel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Border#PART_FocusRing">
            <Setter Property="CornerRadius" Value="{arc:AvailabilityPickerTokenResource DayFocusRadius}" />
        </Style>
        <Style Selector="^ /template/ TextBlock#PART_Number">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXL}" />
            <Setter Property="LineHeight" Value="{arc:AvailabilityPickerTokenResource DayNumberLineHeight}" />
            <Setter Property="LetterSpacing" Value="{arc:AvailabilityPickerTokenResource DayNumberLetterSpacing}" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        </Style>
        <Style Selector="^:checked">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentForeground}" />
        </Style>
        <Style Selector="^:compact">
            <Setter Property="Padding" Value="{arc:AvailabilityPickerTokenResource CompactDayPadding}" />
            <Setter Property="CornerRadius" Value="{arc:AvailabilityPickerTokenResource CompactDayRadius}" />
        </Style>
        <Style Selector="^:compact /template/ Border#PART_FocusRing">
            <Setter Property="CornerRadius" Value="{arc:AvailabilityPickerTokenResource CompactDayFocusRadius}" />
        </Style>
        <Style Selector="^:compact /template/ TextBlock#PART_Number">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeLG}" />
            <Setter Property="LineHeight" Value="{arc:AvailabilityPickerTokenResource CompactDayNumberLineHeight}" />
            <Setter Property="LetterSpacing" Value="{arc:AvailabilityPickerTokenResource CompactDayNumberLetterSpacing}" />
        </Style>
        <Style Selector="^:narrow /template/ TextBlock#PART_Open">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="BorderBrush" Tween="Standard" />
                    <arc:ArcBrushTransition Property="Foreground" Tween="Standard" />
                    <arc:ArcTransformOperationsTransition Property="RenderTransform" Tween="Fast" />
                </Transitions>
            </Setter>
            <Style Selector="^:pressed">
                <Setter Property="RenderTransform" Value="scale(0.97)" />
            </Style>
        </Style>
    </ControlTheme>

    <!--
        A time row: 48 high, Surface with a 1px Border, radius 14. Selected: AccentSubtle with an Accent border and a check;
        hovering a selected row changes nothing. Busy rows mute their line; rows that cannot be booked are at half opacity.
        Colors change in 160ms and the press scales to .98 (full motion only).
    -->
    <ControlTheme x:Key="{x:Type arc:AvailabilitySlotButton}" TargetType="arc:AvailabilitySlotButton">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Height" Value="{arc:AvailabilityPickerTokenResource SlotHeight}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Padding" Value="{arc:AvailabilityPickerTokenResource SlotPadding}" />
        <Setter Property="CornerRadius" Value="{arc:AvailabilityPickerTokenResource SlotRadius}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightRegular}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AvailabilitySlotButton">
                <Panel>
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            Margin="{arc:AvailabilityPickerTokenResource FocusRingMargin}"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            CornerRadius="{arc:AvailabilityPickerTokenResource SlotFocusRadius}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <arc:AvailabilitySlotLayout Name="PART_Layout"
                                                    Gap="{arc:AvailabilityPickerTokenResource SlotContentGap}"
                                                    TimeMinWidth="{arc:AvailabilityPickerTokenResource SlotTimeMinWidth}">
                            <TextBlock Name="PART_Time"
                                       Text="{TemplateBinding TimeText}"
                                       FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                       FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                       LineHeight="{arc:AvailabilityPickerTokenResource TimeLineHeight}"
                                       FontFeatures="tnum" />
                            <TextBlock Name="PART_Note"
                                       Text="{TemplateBinding NoteText}"
                                       LineHeight="{arc:AvailabilityPickerTokenResource CaptionLineHeight}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap" />
                            <arc:AvailabilityMarks Name="PART_Marks"
                                                   FreeBrush="{arc:ArcDesignTokenResource Success}"
                                                   BusyBrush="{arc:ArcDesignTokenResource BorderStrong}"
                                                   MarkWidth="{arc:AvailabilityPickerTokenResource MarkWidth}"
                                                   MarkHeight="{arc:AvailabilityPickerTokenResource MarkHeight}"
                                                   MarkRadius="{arc:AvailabilityPickerTokenResource MarkRadius}"
                                                   MarkGap="{arc:AvailabilityPickerTokenResource MarkGap}" />
                            <arc:ArcGlyph Name="PART_Check"
                                          Data="{x:Static arc:ArcIcons.Check}"
                                          Size="{arc:AvailabilityPickerTokenResource CheckGlyphSize}"
                                          StrokeThickness="2"
                                          IsHitTestVisible="False"
                                          AutomationProperties.AccessibilityView="Raw" />
                        </arc:AvailabilitySlotLayout>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ TextBlock#PART_Note">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="^:busy /template/ TextBlock#PART_Note">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        </Style>
        <Style Selector="^:checked">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Opacity" Value="{arc:AvailabilityPickerTokenResource DisabledSlotOpacity}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                    <arc:ArcBrushTransition Property="BorderBrush" Tween="Fast" />
                    <arc:ArcTransformOperationsTransition Property="RenderTransform" Tween="Fast" />
                </Transitions>
            </Setter>
            <Style Selector="^:pressed">
                <Setter Property="RenderTransform" Value="scale(0.98)" />
            </Style>
        </Style>
    </ControlTheme>

    <!-- The line shown in place of the times on a day without any. -->
    <ControlTheme x:Key="{x:Type arc:AvailabilityEmptyNote}" TargetType="arc:AvailabilityEmptyNote">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="LineHeight" Value="{arc:AvailabilityPickerTokenResource TimeLineHeight}" />
        <Setter Property="MinHeight" Value="{arc:AvailabilityPickerTokenResource SlotHeight}" />
        <Setter Property="Padding" Value="0,14,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </ControlTheme>

    <!--
        The picker. Framed (default): 1px Border, radius RadiusSurface (34), Surface, a BorderSubtle line above the slots
        heading and above the footer, and a SurfaceMuted footer. Flat: none of these. From the top: header (title, subtitle,
        avatars), day strip, slots heading with the legend, the times (height springs when the number of rows changes),
        footer (summary and the book button) and the hidden live region. Below 520 (:compact) paddings tighten, the times
        take one column and the footer stacks over a full-width button; at 360 and below (:narrow) the legend goes.
    -->
    <ControlTheme x:Key="{x:Type arc:AvailabilityPicker}" TargetType="arc:AvailabilityPicker">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightRegular}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusSurface}" />
        <Setter Property="CompactWidth" Value="{arc:AvailabilityPickerTokenResource CompactWidth}" />
        <Setter Property="NarrowWidth" Value="{arc:AvailabilityPickerTokenResource NarrowWidth}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AvailabilityPicker">
                <Border Name="PART_Frame"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <StackPanel>
                        <Grid Name="PART_Header" ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="{arc:AvailabilityPickerTokenResource TitleGap}" VerticalAlignment="Center">
                                <TextBlock Name="PART_Title"
                                           FontFamily="{arc:ArcDesignTokenResource DisplayFontFamily}"
                                           FontSize="{arc:ArcDesignTokenResource TypeXL}"
                                           FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                           LineHeight="{arc:AvailabilityPickerTokenResource TitleLineHeight}"
                                           LetterSpacing="{arc:AvailabilityPickerTokenResource TitleLetterSpacing}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.HeadingLevel="2" />
                                <TextBlock Name="PART_Subtitle"
                                           LineHeight="{arc:AvailabilityPickerTokenResource SubtitleLineHeight}"
                                           TextWrapping="Wrap"
                                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                            </StackPanel>
                            <arc:ProjectsAvatarStack Name="PART_Attendees"
                                                     Grid.Column="1"
                                                     Margin="{arc:AvailabilityPickerTokenResource AttendeesMargin}"
                                                     VerticalAlignment="Center" />
                        </Grid>
                        <arc:AvailabilityDayStrip Name="PART_DayStrip"
                                                  HighlightFill="{arc:ArcDesignTokenResource Accent}" />
                        <Border Name="PART_SlotsHead"
                                Margin="{arc:AvailabilityPickerTokenResource HeadMargin}"
                                BorderThickness="{arc:ArcDesignTokenResource EdgeThicknessTop}">
                            <Grid ColumnDefinitions="*,Auto">
                                <arc:AvailabilityTextSwap Name="PART_DayTitle"
                                                          VerticalAlignment="Bottom"
                                                          TextElement.FontFamily="{arc:ArcDesignTokenResource DisplayFontFamily}"
                                                          TextElement.FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                                          LineHeight="{arc:AvailabilityPickerTokenResource HeadingLineHeight}"
                                                          TextLetterSpacing="{arc:AvailabilityPickerTokenResource HeadingLetterSpacing}"
                                                          TextTrimming="CharacterEllipsis"
                                                          AutomationProperties.HeadingLevel="3" />
                                <StackPanel Name="PART_Legend"
                                            Grid.Column="1"
                                            Margin="{arc:AvailabilityPickerTokenResource LegendMargin}"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Bottom"
                                            Spacing="{arc:AvailabilityPickerTokenResource LegendGap}"
                                            TextElement.FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                            TextElement.Foreground="{arc:ArcDesignTokenResource TextMuted}">
                                    <Border Width="{arc:AvailabilityPickerTokenResource MarkWidth}"
                                            Height="{arc:AvailabilityPickerTokenResource MarkHeight}"
                                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep2}"
                                            VerticalAlignment="Center"
                                            Background="{arc:ArcDesignTokenResource Success}" />
                                    <TextBlock Name="PART_FreeLegend"
                                               VerticalAlignment="Center"
                                               LineHeight="{arc:AvailabilityPickerTokenResource CaptionLineHeight}" />
                                    <Border Width="{arc:AvailabilityPickerTokenResource MarkWidth}"
                                            Height="{arc:AvailabilityPickerTokenResource MarkHeight}"
                                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep2}"
                                            Margin="{arc:AvailabilityPickerTokenResource LegendSecondMargin}"
                                            VerticalAlignment="Center"
                                            Background="{arc:ArcDesignTokenResource BorderStrong}" />
                                    <TextBlock Name="PART_BusyLegend"
                                               VerticalAlignment="Center"
                                               LineHeight="{arc:AvailabilityPickerTokenResource CaptionLineHeight}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Name="PART_Stage">
                            <arc:SpringSizeDecorator Name="PART_StageSize"
                                                     Axis="Height"
                                                     Spring="Smooth"
                                                     CrossClipOverflow="{arc:AvailabilityPickerTokenResource StageClipOverflow}">
                                <arc:AvailabilitySlotSwap Name="PART_Slots"
                                                          ItemGap="{arc:AvailabilityPickerTokenResource SlotGap}" />
                            </arc:SpringSizeDecorator>
                        </Border>
                        <Border Name="PART_Footer" BorderThickness="{arc:ArcDesignTokenResource EdgeThicknessTop}">
                            <Grid Name="PART_FooterGrid" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <StackPanel Name="PART_Selection"
                                            VerticalAlignment="Center"
                                            Spacing="{arc:AvailabilityPickerTokenResource SelectionLineGap}">
                                    <arc:AvailabilityTextSwap Name="PART_SelectionLabel"
                                                              TextElement.FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                              TextElement.Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                              LineHeight="{arc:AvailabilityPickerTokenResource CaptionLineHeight}"
                                                              TextTrimming="CharacterEllipsis" />
                                    <arc:AvailabilityTextSwap Name="PART_SelectionValue"
                                                              TextElement.FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                                              TextElement.FontFeatures="tnum"
                                                              LineHeight="{arc:AvailabilityPickerTokenResource ValueLineHeight}" />
                                </StackPanel>
                                <arc:Button Name="PART_Confirm"
                                            Grid.Column="1"
                                            Variant="Primary"
                                            VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <arc:ProjectsAnnouncer Name="PART_Announcer" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- Wide geometry; values that change with a state live in styles, not on the template parts. -->
        <Style Selector="^ /template/ Grid#PART_Header">
            <Setter Property="Margin" Value="{arc:AvailabilityPickerTokenResource HeaderPadding}" />
        </Style>
        <Style Selector="^ /template/ arc|AvailabilityDayStrip#PART_DayStrip">
            <Setter Property="Margin" Value="{arc:AvailabilityPickerTokenResource StripMargin}" />
            <Setter Property="Gap" Value="{arc:AvailabilityPickerTokenResource DayGap}" />
            <Setter Property="HighlightRadius" Value="{arc:AvailabilityPickerTokenResource DayRadius}" />
        </Style>
        <Style Selector="^ /template/ Border#PART_SlotsHead">
            <Setter Property="Padding" Value="{arc:AvailabilityPickerTokenResource HeadPadding}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="^ /template/ Border#PART_Stage">
            <Setter Property="Padding" Value="{arc:AvailabilityPickerTokenResource StagePadding}" />
        </Style>
        <Style Selector="^ /template/ Border#PART_Footer">
            <Setter Property="Padding" Value="{arc:AvailabilityPickerTokenResource FooterPadding}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^ /template/ arc|AvailabilityTextSwap#PART_SelectionValue">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style Selector="^ /template/ arc|Button#PART_Confirm">
            <Setter Property="Margin" Value="{arc:AvailabilityPickerTokenResource ConfirmMargin}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <!-- Framed: the dividers and the muted footer. -->
        <Style Selector="^:framed /template/ Border#PART_SlotsHead">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        </Style>
        <Style Selector="^:framed /template/ Border#PART_Footer">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:not(:framed)">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <!-- Compact (below 520). -->
        <Style Selector="^:compact /template/ Grid#PART_Header">
            <Setter Property="Margin" Value="{arc:AvailabilityPickerTokenResource CompactHeaderPadding}" />
        </Style>
        <Style Selector="^:compact /template/ arc|AvailabilityDayStrip#PART_DayStrip">
            <Setter Property="Margin" Value="{arc:AvailabilityPickerTokenResource CompactStripMargin}" />
            <Setter Property="Gap" Value="{arc:AvailabilityPickerTokenResource CompactDayGap}" />
            <Setter Property="HighlightRadius" Value="{arc:AvailabilityPickerTokenResource CompactDayRadius}" />
        </Style>
        <Style Selector="^:compact /template/ Border#PART_SlotsHead">
            <Setter Property="Padding" Value="{arc:AvailabilityPickerTokenResource CompactHeadPadding}" />
        </Style>
        <Style Selector="^:compact /template/ Border#PART_Stage">
            <Setter Property="Padding" Value="{arc:AvailabilityPickerTokenResource CompactStagePadding}" />
        </Style>
        <Style Selector="^:compact /template/ Border#PART_Footer">
            <Setter Property="Padding" Value="{arc:AvailabilityPickerTokenResource CompactFooterPadding}" />
        </Style>
        <Style Selector="^:compact /template/ StackPanel#PART_Selection">
            <Setter Property="Grid.ColumnSpan" Value="2" />
        </Style>
        <Style Selector="^:compact /template/ arc|AvailabilityTextSwap#PART_SelectionValue">
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="^:compact /template/ arc|Button#PART_Confirm">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="Margin" Value="{arc:AvailabilityPickerTokenResource CompactConfirmMargin}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!-- Narrow (360 and below), or hidden by the app. -->
        <Style Selector="^:narrow /template/ StackPanel#PART_Legend">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^[IsLegendVisible=False] /template/ StackPanel#PART_Legend">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
