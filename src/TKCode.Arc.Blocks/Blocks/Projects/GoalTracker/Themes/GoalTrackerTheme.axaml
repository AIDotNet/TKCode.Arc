<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.GoalTrackerTheme">

    <!--
        GoalTracker. Framed: a card with a 1px Border, radius 20, Surface and no shadow; flat: no frame. The body (header,
        content) is built in code; padding 24, 16 at the compact width.
    -->
    <ControlTheme x:Key="{x:Type arc:GoalTracker}" TargetType="arc:GoalTracker">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep20}" />
        <Setter Property="Padding" Value="{arc:GoalTrackerTokenResource Padding}" />
        <Setter Property="CompactWidth" Value="{arc:GoalTrackerTokenResource CompactWidth}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:GoalTracker">
                <Border Name="PART_Shell"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Panel>
                        <Decorator Name="PART_Body" />
                        <arc:ProjectsAnnouncer Name="PART_Announcer" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:not(:framed)">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="^:framed:compact">
            <Setter Property="Padding" Value="{arc:GoalTrackerTokenResource CompactPadding}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
