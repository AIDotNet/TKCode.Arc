<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.SmartSchedulerTheme">

    <!--
        The scheduler (an original TKCode design): a Surface card at most 1040 wide with a 1px Border, the panel radius and
        the resting shadow. The form (300 wide) on the left: who, how long, the limits with the chips read from them, and
        the find button. The week on the right with the status line above it and the proposals and the book button under
        it. At 760 wide or less (:compact) the form moves above the week.
    -->
    <ControlTheme x:Key="{x:Type arc:SmartScheduler}" TargetType="arc:SmartScheduler">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
        <Setter Property="Padding" Value="{arc:SmartSchedulerTokenResource CardPadding}" />
        <Setter Property="CompactWidth" Value="{arc:SmartSchedulerTokenResource CompactWidth}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:SmartScheduler">
                <Border Name="PART_Card"
                        MaxWidth="{arc:SmartSchedulerTokenResource SchedulerMaxWidth}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{arc:ArcDesignTokenResource ShadowResting}"
                        Padding="{TemplateBinding Padding}">
                    <StackPanel Spacing="{arc:SmartSchedulerTokenResource SectionGap}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="32"
                                    Height="32"
                                    CornerRadius="{arc:ArcDesignTokenResource RadiusStep10}"
                                    Background="{arc:ArcDesignTokenResource AccentSubtle}">
                                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.CalendarCheck}"
                                              Size="18"
                                              Foreground="{arc:ArcDesignTokenResource AccentStrong}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Name="PART_Title"
                                       FontFamily="{arc:ArcDesignTokenResource DisplayFontFamily}"
                                       FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                       FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                       VerticalAlignment="Center"
                                       AutomationProperties.HeadingLevel="2" />
                        </StackPanel>
                        <DockPanel>
                            <StackPanel Name="PART_Form" Spacing="{arc:SmartSchedulerTokenResource SectionGap}">
                                <StackPanel Spacing="{arc:SmartSchedulerTokenResource HeadingGap}">
                                    <TextBlock Name="PART_PeopleHeading" Classes="scheduler-heading" AutomationProperties.HeadingLevel="3" />
                                    <StackPanel Name="PART_People" Spacing="10" />
                                </StackPanel>
                                <StackPanel Spacing="{arc:SmartSchedulerTokenResource HeadingGap}">
                                    <TextBlock Name="PART_DurationHeading" Classes="scheduler-heading" AutomationProperties.HeadingLevel="3" />
                                    <arc:SegmentedControl Name="PART_Duration" HorizontalAlignment="Left" />
                                </StackPanel>
                                <StackPanel Spacing="{arc:SmartSchedulerTokenResource HeadingGap}">
                                    <TextBlock Name="PART_ConstraintsHeading" Classes="scheduler-heading" AutomationProperties.HeadingLevel="3" />
                                    <arc:Textarea Name="PART_Constraints" IsLabelVisible="False" />
                                    <WrapPanel Name="PART_Chips" ItemSpacing="6" LineSpacing="6" />
                                </StackPanel>
                                <arc:Button Name="PART_Find" Variant="Primary" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Spacing="12">
                                <TextBlock Name="PART_Status"
                                           Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                           TextWrapping="Wrap" />
                                <arc:SmartSchedulerWeek Name="PART_Week"
                                                        Height="{arc:SmartSchedulerTokenResource WeekHeight}"
                                                        FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                        GridBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                        TextBrush="{arc:ArcDesignTokenResource TextMuted}"
                                                        BusyBrush="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                        SlotBrush="{arc:ArcDesignTokenResource AccentSubtle}"
                                                        SlotTextBrush="{arc:ArcDesignTokenResource AccentStrong}"
                                                        SelectedBrush="{arc:ArcDesignTokenResource Accent}"
                                                        SelectedTextBrush="{arc:ArcDesignTokenResource AccentForeground}"
                                                        FocusBrush="{arc:ArcDesignTokenResource FocusRing}"
                                                        SlotRadius="{arc:ArcDesignTokenResource RadiusStep8}" />
                                <StackPanel Name="PART_Proposals" Spacing="{arc:SmartSchedulerTokenResource HeadingGap}">
                                    <TextBlock Name="PART_ProposalsHeading" Classes="scheduler-heading" AutomationProperties.HeadingLevel="3" />
                                    <StackPanel Name="PART_Options" Spacing="4" />
                                    <arc:Button Name="PART_Book" Variant="Primary" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                </StackPanel>
                                <arc:Button Name="PART_StartOver" Variant="Secondary" Size="Small" HorizontalAlignment="Left" />
                            </StackPanel>
                        </DockPanel>
                        <arc:AiAnnouncer Name="PART_Announcer" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ StackPanel#PART_Form">
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="Width" Value="{arc:SmartSchedulerTokenResource FormWidth}" />
            <Setter Property="Margin" Value="0,0,28,0" />
        </Style>
        <Style Selector="^:compact">
            <Setter Property="Padding" Value="{arc:SmartSchedulerTokenResource CompactCardPadding}" />
            <Style Selector="^ /template/ StackPanel#PART_Form">
                <Setter Property="DockPanel.Dock" Value="Top" />
                <Setter Property="Width" Value="NaN" />
                <Setter Property="Margin" Value="0,0,0,24" />
            </Style>
        </Style>
        <Style Selector="^ /template/ TextBlock.scheduler-heading">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
            <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="^ /template/ TextBlock#PART_Status.error">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
        </Style>
        <Style Selector="^:booked /template/ TextBlock#PART_Status">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Success}" />
        </Style>
        <Style Selector="^ /template/ StackPanel#PART_Proposals">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:proposed /template/ StackPanel#PART_Proposals">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^ /template/ arc|Button#PART_StartOver">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:booked /template/ arc|Button#PART_StartOver">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>

    <!-- A proposal: rank disc, the time (14, medium) and the reasons (12, muted); hover tints it, selected takes the soft accent. -->
    <ControlTheme x:Key="{x:Type arc:SmartSchedulerOption}" TargetType="arc:SmartSchedulerOption">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="{arc:SmartSchedulerTokenResource OptionPadding}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:SmartSchedulerOption">
                <Panel Name="PART_Root">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep14}"
                            Padding="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Name="PART_Rank"
                                    Width="{arc:SmartSchedulerTokenResource RankSize}"
                                    Height="{arc:SmartSchedulerTokenResource RankSize}"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Top"
                                    CornerRadius="{arc:ArcDesignTokenResource RadiusPill}">
                                <TextBlock Name="PART_RankText"
                                           Text="{TemplateBinding Rank}"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{TemplateBinding Title}"
                                           FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{TemplateBinding Reasons}"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ Border#PART_Rank">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
        </Style>
        <Style Selector="^ /template/ TextBlock#PART_RankText">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentStrong}" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
            <Style Selector="^ /template/ Border#PART_Rank">
                <Setter Property="Background" Value="{arc:ArcDesignTokenResource Accent}" />
            </Style>
            <Style Selector="^ /template/ TextBlock#PART_RankText">
                <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentForeground}" />
            </Style>
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- A limit chip: a pill in the soft accent with 12px text. -->
    <ControlTheme x:Key="{x:Type arc:SmartSchedulerChip}" TargetType="arc:SmartSchedulerChip">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:SmartSchedulerChip">
                <Border Padding="{arc:SmartSchedulerTokenResource ChipPadding}"
                        CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                        Background="{arc:ArcDesignTokenResource AccentSubtle}">
                    <TextBlock Text="{TemplateBinding Text}"
                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                               Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
