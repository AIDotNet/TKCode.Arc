<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.SettingsRowTheme">
    <!--
        A settings row: hairline on top (not on the first row), icon tile, header and description, and the control on
        the right; under :stacked the control drops below the text, aligned with it.
    -->
    <ControlTheme x:Key="{x:Type arc:SettingsRow}" TargetType="arc:SettingsRow">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:SettingsRow">
                <Panel Background="{TemplateBinding Background}">
                    <Border Name="PART_Divider"
                            Height="1"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False"
                            Background="{arc:ArcDesignTokenResource BorderSubtle}" />
                    <Grid Name="PART_Layout"
                          Margin="{TemplateBinding Padding}"
                          ColumnDefinitions="Auto,*,Auto"
                          RowDefinitions="Auto,Auto">
                        <Border Name="PART_IconTile"
                                IsVisible="False"
                                VerticalAlignment="Center"
                                Width="{arc:SettingsRowTokenResource IconTile}"
                                Height="{arc:SettingsRowTokenResource IconTile}"
                                CornerRadius="{arc:SettingsRowTokenResource IconTileRadius}"
                                Background="{arc:ArcDesignTokenResource SurfaceMuted}">
                            <arc:ArcGlyph Data="{TemplateBinding Icon}"
                                          Size="{arc:SettingsRowTokenResource IconGlyph}"
                                          Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                        </Border>
                        <!-- Transparent so a click anywhere on the text toggles a toggle control. -->
                        <StackPanel Name="PART_Label"
                                    Grid.Column="1"
                                    Background="Transparent"
                                    VerticalAlignment="Center"
                                    Spacing="{arc:SettingsRowTokenResource TextGap}">
                            <TextBlock Name="PART_Header"
                                       Text="{TemplateBinding Header}"
                                       IsVisible="{TemplateBinding Header, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       TextWrapping="Wrap"
                                       FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                       FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                       LineHeight="{arc:SettingsRowTokenResource BodyLineHeight}"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
                            <TextBlock Name="PART_Description"
                                       Text="{TemplateBinding Description}"
                                       IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       TextWrapping="Wrap"
                                       FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                       LineHeight="{arc:SettingsRowTokenResource BodyLineHeight}"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        </StackPanel>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Grid.Column="2"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="{arc:SettingsRowTokenResource RowInset}" />
        <Setter Property="StackWidth" Value="{arc:SettingsRowTokenResource StackThreshold}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />

        <Style Selector="^:nth-child(1) /template/ Border#PART_Divider">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:icon /template/ Border#PART_IconTile">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^ /template/ Border#PART_IconTile">
            <Setter Property="Margin" Value="{arc:SettingsRowTokenResource IconTileMargin}" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Margin" Value="{arc:SettingsRowTokenResource ControlMargin}" />
        </Style>
        <Style Selector="^:stacked">
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Grid.Column" Value="1" />
                <Setter Property="Grid.ColumnSpan" Value="2" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="{arc:SettingsRowTokenResource StackedControlMargin}" />
            </Style>
            <Style Selector="^ /template/ Border#PART_IconTile">
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
