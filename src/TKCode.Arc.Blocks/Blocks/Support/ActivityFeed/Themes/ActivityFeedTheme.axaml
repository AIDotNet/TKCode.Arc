<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.ActivityFeedTheme">

    <!--
        Activity feed: a panel (Surface, 1px Border, RadiusPanel) at most 640 wide with 20 padding. The header with the
        live chip, the filters, the timeline (at most 560 tall, then it scrolls) and the "new updates" pill are built in
        code and placed in PART_Host.
    -->
    <ControlTheme x:Key="{x:Type arc:ActivityFeed}" TargetType="arc:ActivityFeed">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="MaxWidth" Value="{arc:ActivityFeedTokenResource FeedMaxWidth}" />
        <Setter Property="Padding" Value="{arc:ActivityFeedTokenResource FeedPadding}" />
        <Setter Property="FeedMaxHeight" Value="{arc:ActivityFeedTokenResource FeedMaxHeight}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:ActivityFeed">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Decorator Name="PART_Host" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
