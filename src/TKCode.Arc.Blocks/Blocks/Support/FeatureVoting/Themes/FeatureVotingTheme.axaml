<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.FeatureVotingTheme">

    <!--
        Feature voting: a card (Surface, 1px Border, RadiusPanel, resting shadow) at most 420 wide with 20 padding. The
        header, the options, the footer and the live region are built in code and placed in PART_Host.
    -->
    <ControlTheme x:Key="{x:Type arc:FeatureVoting}" TargetType="arc:FeatureVoting">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="MaxWidth" Value="{arc:FeatureVotingTokenResource CardMaxWidth}" />
        <Setter Property="Padding" Value="{arc:FeatureVotingTokenResource CardPadding}" />
        <Setter Property="BarHeight" Value="{arc:FeatureVotingTokenResource BarHeight}" />
        <Setter Property="IndicatorSize" Value="{arc:FeatureVotingTokenResource IndicatorSize}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:FeatureVoting">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{arc:ArcDesignTokenResource ShadowResting}"
                        Padding="{TemplateBinding Padding}">
                    <Decorator Name="PART_Host" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
