<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.SupportWidgetTheme">

    <!--
        Support widget: no frame of its own; it fills the space it is given and keeps the round launcher (56) and the
        panel above it (380 × 560, Surface, radius 20, floating shadow) in the bottom-right corner, 20 from the edges.
        Everything is built in code and placed in PART_Host. The space around it takes no input.
    -->
    <ControlTheme x:Key="{x:Type arc:SupportWidget}" TargetType="arc:SupportWidget">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{arc:SupportWidgetTokenResource CornerMargin}" />
        <Setter Property="PanelWidth" Value="{arc:SupportWidgetTokenResource PanelWidth}" />
        <Setter Property="PanelHeight" Value="{arc:SupportWidgetTokenResource PanelHeight}" />
        <Setter Property="LauncherSize" Value="{arc:SupportWidgetTokenResource LauncherSize}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:SupportWidget">
                <Decorator Name="PART_Host" Margin="{TemplateBinding Padding}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
