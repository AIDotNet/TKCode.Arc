<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(ArcTargetFrameworks)</TargetFrameworks>
        <AssemblyName>TKCode.Arc.Blocks</AssemblyName>
        <RootNamespace>TKCode.Arc</RootNamespace>
        <PackageId>TKCode.Arc.Blocks</PackageId>
        <Description>Page-level block compositions for TKCode.Arc, built from Arc components. Ports Arc's free blocks and adds original ones.</Description>
        <!-- TKCode.Arc and Core contain generated types with identical names. -->
        <NoWarn>$(NoWarn);CS0436</NoWarn>
        <ArcFoundationGenerator>true</ArcFoundationGenerator>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../TKCode.Arc/TKCode.Arc.csproj" />
        <!-- MediaPlayer plays through the audio abstraction; platform backends ship in their own packages (ADR 0028). -->
        <ProjectReference Include="../TKCode.Arc.Audio/TKCode.Arc.Audio.csproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- Natural Earth 1:110m Land (public domain), rasterized by tools/geo/generate_land_mask.py: RevenueGlobe's land dots. -->
        <EmbeddedResource Include="Blocks/Showpieces/RevenueGlobe/Resources/land-mask.bin" LogicalName="TKCode.Arc.Blocks.RevenueGlobe.LandMask" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="TKCode.Arc.Tests" />
    </ItemGroup>
</Project>
