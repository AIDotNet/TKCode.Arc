<!--
    Base theme (design/architecture/foundation.md, "基础主题"): OverlayPopupHost, the host Avalonia creates for popups on the overlay layer.
    The overlay host is exactly as large as the surface, and ArcPopup paints the floating shadow past its bounds, so
    neither the host nor its LayoutTransformControl may clip (both clip by default); otherwise the shadow is cut to a
    hard rectangle and the surface's rounded corners look square.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:Class="TKCode.Arc.OverlayPopupHostBaseTheme"
                    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type OverlayPopupHost}" TargetType="OverlayPopupHost">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontStyle" Value="Normal" />
        <Setter Property="Template">
            <ControlTemplate TargetType="OverlayPopupHost">
                <LayoutTransformControl LayoutTransform="{TemplateBinding Transform}" ClipToBounds="False">
                    <VisualLayerManager Name="PART_VisualLayerManager">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Padding="{TemplateBinding Padding}"
                                          Background="{TemplateBinding Background}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </VisualLayerManager>
                </LayoutTransformControl>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
