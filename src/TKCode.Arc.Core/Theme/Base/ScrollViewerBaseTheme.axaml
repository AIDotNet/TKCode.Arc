<!--
    Base theme (design/architecture/foundation.md, "基础主题"): the default ScrollViewer and ScrollBar for an app that
    has no other theme. Arc's ScrollArea look: the bars overlay the content (it always spans the whole viewer), each bar
    is an 11px hit area around a 5px pill of the foreground at 30%, 3px from the edges, that thickens to 7px and 46%
    under the pointer or while dragged. Like ScrollArea's bars they are hidden at rest and show while a mouse is over
    the viewer, while it scrolls and for 900ms after, and while a thumb is dragged (ScrollViewerAutoHide); fading in on
    the fast duration and out on the considered one. AllowAutoHide="False" keeps them shown. A ScrollBar outside a
    ScrollViewer is always shown. Registered by ArcBaseTheme, not by the theme-file table: it yields to Fluent, Simple
    or any other theme that already styles ScrollViewer.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:Class="TKCode.Arc.ScrollViewerBaseTheme"
                    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type ScrollViewer}" TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="arc:ScrollViewerAutoHide.IsEnabled" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ScrollViewer">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
                    <ScrollContentPresenter Name="PART_ContentPresenter"
                                            Grid.RowSpan="2"
                                            Grid.ColumnSpan="2"
                                            Background="{TemplateBinding Background}"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            Padding="{TemplateBinding Padding}"
                                            HorizontalSnapPointsType="{TemplateBinding HorizontalSnapPointsType}"
                                            VerticalSnapPointsType="{TemplateBinding VerticalSnapPointsType}"
                                            HorizontalSnapPointsAlignment="{TemplateBinding HorizontalSnapPointsAlignment}"
                                            VerticalSnapPointsAlignment="{TemplateBinding VerticalSnapPointsAlignment}"
                                            IsScrollChainingEnabled="{TemplateBinding IsScrollChainingEnabled}"
                                            ScrollViewer.IsScrollInertiaEnabled="{TemplateBinding IsScrollInertiaEnabled}">
                        <ScrollContentPresenter.GestureRecognizers>
                            <ScrollGestureRecognizer CanHorizontallyScroll="{Binding CanHorizontallyScroll, ElementName=PART_ContentPresenter}"
                                                     CanVerticallyScroll="{Binding CanVerticallyScroll, ElementName=PART_ContentPresenter}"
                                                     IsScrollInertiaEnabled="{Binding (ScrollViewer.IsScrollInertiaEnabled), ElementName=PART_ContentPresenter}"
                                                     Offset="{Binding Offset, ElementName=PART_ContentPresenter}"
                                                     Viewport="{Binding Viewport, ElementName=PART_ContentPresenter}"
                                                     Extent="{Binding Extent, ElementName=PART_ContentPresenter}" />
                        </ScrollContentPresenter.GestureRecognizers>
                    </ScrollContentPresenter>
                    <ScrollBar Name="PART_HorizontalScrollBar" Grid.Row="1" Grid.Column="0" Orientation="Horizontal" />
                    <ScrollBar Name="PART_VerticalScrollBar" Grid.Row="0" Grid.Column="1" Orientation="Vertical" />
                </Grid>
            </ControlTemplate>
        </Setter>

        <!-- Hidden at rest: transparent and out of hit testing, so a touch on the bar's strip reaches the content. -->
        <Style Selector="^ /template/ ScrollBar">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="^[(arc|ScrollViewerAutoHide.IsShown)=True] /template/ ScrollBar">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <!-- In on the fast duration, out on the considered one (ScrollArea); Reduced keeps a short fade both ways.
             The bar's own ArcMotion.Tracks gives it the motion pseudo-classes. -->
        <Style Selector="^ /template/ ScrollBar:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Considered" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^[(arc|ScrollViewerAutoHide.IsShown)=True] /template/ ScrollBar:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^ /template/ ScrollBar:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="ScrollBar">
                <Border Background="{TemplateBinding Background}">
                    <Track Name="PART_Track"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           ViewportSize="{TemplateBinding ViewportSize}"
                           Orientation="{TemplateBinding Orientation}"
                           DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}">
                        <Track.DecreaseButton>
                            <RepeatButton Name="PART_PageUpButton" Classes="page" Focusable="False" />
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton Name="PART_PageDownButton" Classes="page" Focusable="False" />
                        </Track.IncreaseButton>
                        <Thumb Name="thumb" />
                    </Track>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:vertical">
            <Setter Property="Width" Value="11" />
            <Style Selector="^ /template/ Track#PART_Track">
                <Setter Property="IsDirectionReversed" Value="True" />
                <Setter Property="Margin" Value="0,3" />
            </Style>
            <Style Selector="^ /template/ Thumb#thumb">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="3,0" />
            </Style>
            <Style Selector="^:pointerover /template/ Thumb#thumb, ^ /template/ Thumb#thumb:pressed">
                <Setter Property="Padding" Value="2,0" />
            </Style>
        </Style>
        <Style Selector="^:horizontal">
            <Setter Property="Height" Value="11" />
            <Style Selector="^ /template/ Track#PART_Track">
                <Setter Property="Margin" Value="3,0" />
            </Style>
            <Style Selector="^ /template/ Thumb#thumb">
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="Padding" Value="0,3" />
            </Style>
            <Style Selector="^:pointerover /template/ Thumb#thumb, ^ /template/ Thumb#thumb:pressed">
                <Setter Property="Padding" Value="0,2" />
            </Style>
        </Style>

        <!-- The thumb fills the 11px hit area; the pill is its template's border, inset by the thumb's Padding. -->
        <Style Selector="^ /template/ Thumb#thumb">
            <Setter Property="Background" Value="{Binding $parent[ScrollBar].Foreground}" />
            <Setter Property="Opacity" Value="0.30" />
            <Setter Property="Template">
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent">
                        <Border Name="PART_Pill"
                                Margin="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{arc:ArcDesignTokenResource RadiusPill}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="^:pointerover /template/ Thumb#thumb, ^ /template/ Thumb#thumb:pressed">
            <Setter Property="Opacity" Value="0.46" />
        </Style>
        <!-- Pressing the track pages toward the pointer. -->
        <Style Selector="^ /template/ RepeatButton.page">
            <Setter Property="Template">
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- The pill thickens and darkens on the fast duration (ScrollArea's hot state). -->
        <Style Selector="^:motion-full /template/ Thumb#thumb">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                    <arc:ArcThicknessTransition Property="Padding" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced /template/ Thumb#thumb">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
