<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.DockPaneSwitcherTheme">
    <ControlTheme x:Key="{x:Type arc:DockPaneSwitcherItem}" TargetType="arc:DockPaneSwitcherItem">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:DockPaneSwitcherItem">
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Panel Width="{arc:DockPaneSwitcherTokenResource IconSize}" VerticalAlignment="Center">
                            <arc:ArcGlyph Data="{TemplateBinding Icon}"
                                          Size="{arc:DockPaneSwitcherTokenResource IconSize}"
                                          IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </Panel>
                        <TextBlock Text="{TemplateBinding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Height" Value="{arc:DockPaneSwitcherTokenResource RowHeight}" />
        <Setter Property="Padding" Value="{arc:DockPaneSwitcherTokenResource RowPadding}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep8}" />
        <Setter Property="FontSize" Value="{arc:DockPaneSwitcherTokenResource FontSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentStrong}" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" />
                    <arc:ArcBrushTransition Property="Foreground" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type arc:DockPaneSwitcher}" TargetType="arc:DockPaneSwitcher">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:DockPaneSwitcher">
                <Panel Background="Transparent">
                    <Border Name="PART_Card"
                            Width="{arc:DockPaneSwitcherTokenResource Width}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="{arc:DockPaneSwitcherTokenResource Padding}"
                            Background="{arc:ArcDesignTokenResource SurfaceRaised}"
                            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                            BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep12}"
                            BoxShadow="{arc:ArcDesignTokenResource ShadowFloating}"
                            arc:ArcSurface.Elevation="Raised">
                        <DockPanel>
                            <TextBlock Name="PART_Caption"
                                       DockPanel.Dock="Top"
                                       Height="{arc:DockPaneSwitcherTokenResource CaptionHeight}"
                                       Padding="10,7,10,0"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                       Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                            <ScrollViewer MaxHeight="{arc:DockPaneSwitcherTokenResource MaxListHeight}"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Name="PART_Items" Spacing="2" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
    </ControlTheme>
</ResourceDictionary>
