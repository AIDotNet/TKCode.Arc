<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.DockTabTheme">
    <!-- The 16px close button of a document tab, made by the tab only when it has one. Not focusable: Delete or Ctrl+F4 on
         the tab closes it. -->
    <ControlTheme x:Key="{x:Type arc:DockTabCloseButton}" TargetType="arc:DockTabCloseButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:DockTabCloseButton">
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <arc:ArcGlyph Data="{x:Static arc:ArcIcons.X}"
                                  Size="{arc:DockTabTokenResource CloseGlyphSize}"
                                  StrokeThickness="2"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Width" Value="{arc:DockTabTokenResource CloseSize}" />
        <Setter Property="Height" Value="{arc:DockTabTokenResource CloseSize}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep4}" />
        <Setter Property="Cursor" Value="Hand" />
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type arc:DockTab}" TargetType="arc:DockTab">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:DockTab">
                <Border Name="PART_Frame"
                        Background="Transparent"
                        Padding="{TemplateBinding Padding}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <!-- The icon (before the title) and a document's close slot (after it) are added by the tab only when
                         it has them: most tabs have neither, and a strip of 200 tabs paid for hidden parts. -->
                    <arc:ArcShrinkRow Name="PART_Items"
                                Spacing="{arc:DockTabTokenResource ItemGap}"
                                VerticalAlignment="Center">
                        <TextBlock Name="PART_Title"
                                   Text="{TemplateBinding Title}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" arc:ArcShrinkRow.IsShrinkable="True" />
                    </arc:ArcShrinkRow>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Height" Value="{arc:DockTabTokenResource Height}" />
        <Setter Property="Padding" Value="{arc:DockTabTokenResource InlinePadding}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep8}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:DockTabTokenResource FontSize}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ClipToBounds" Value="False" />

        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:selected:group-active">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentStrong}" />
        </Style>
        <!-- The pane is being docked elsewhere: its tab stays in place, dimmed, until the drop. -->
        <Style Selector="^:dragging">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
