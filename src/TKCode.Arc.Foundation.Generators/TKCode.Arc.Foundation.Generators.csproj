<!-- Publish properties given on the command line (dotnet publish -r … -p:PublishAot=true) would reach this project
     through a reference; the compiler loads it, so it is never published itself. -->
<Project Sdk="Microsoft.NET.Sdk"
         TreatAsLocalProperty="PublishAot;PublishTrimmed;PublishSingleFile;SelfContained;RuntimeIdentifier;IsAotCompatible;IsTrimmable">
    <!-- Roslyn generator of TKCode.Arc.Foundation: token kinds, keys, markup extensions, writers, override parsers and
         the lazy control-theme table (design/architecture/foundation.md). Packed into the Foundation package as an
         analyzer; it is not a package of its own. -->
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <PublishAot>false</PublishAot>
        <PublishTrimmed>false</PublishTrimmed>
        <PublishSingleFile>false</PublishSingleFile>
        <SelfContained>false</SelfContained>
        <RuntimeIdentifier></RuntimeIdentifier>
        <IsAotCompatible>false</IsAotCompatible>
        <IsTrimmable>false</IsTrimmable>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <EmitCompilerGeneratedFiles>false</EmitCompilerGeneratedFiles>
        <RootNamespace>TKCode.Arc.Foundation.Generators</RootNamespace>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <ImplicitUsings>disable</ImplicitUsings>
        <!-- Release tracking files are for shipped analyzers. -->
        <NoWarn>$(NoWarn);RS2008</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="TKCode.Arc.Foundation.Tests" />
    </ItemGroup>
</Project>
