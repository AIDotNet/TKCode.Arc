<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(ArcTargetFrameworks)</TargetFrameworks>
        <AssemblyName>TKCode.Arc.Graphics3D.WebGpu</AssemblyName>
        <RootNamespace>TKCode.Arc.Graphics3D.Rhi.WebGpu</RootNamespace>
        <PackageId>TKCode.Arc.Graphics3D.WebGpu</PackageId>
        <!-- Preview-only version line, independent of ArcVersion (ADR 0051). -->
        <Version>$(ArcGraphics3DVersion)</Version>
        <Description>WebGPU backend for TKCode.Arc.Graphics3D: a GraphicsDevice over wgpu-native (Metal, Vulkan, Direct3D 12, OpenGL ES) with compute shaders. The native library is not included: pass its path to WgpuDevice.Create. Preview: the API may change between previews.</Description>
        <PackageTags>3d;rendering;engine;webgpu;wgpu;compute;graphics</PackageTags>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- The API is still moving (preview only, ADR 0051): no public API baseline yet. -->
        <ArcPublicApi>false</ArcPublicApi>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../TKCode.Arc.Graphics3D/TKCode.Arc.Graphics3D.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="TKCode.Arc.Graphics3D.Tests" />
    </ItemGroup>
</Project>
