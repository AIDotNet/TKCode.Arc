<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(ArcTargetFrameworks)</TargetFrameworks>
        <AssemblyName>TKCode.Arc.Highlighting</AssemblyName>
        <RootNamespace>TKCode.Arc</RootNamespace>
        <PackageId>TKCode.Arc.Highlighting</PackageId>
        <Description>Syntax highlighting for TKCode.Arc: TextMate grammars painted in Arc's role palette for CodeBlock, the rich text editor's code blocks and Markdown's fenced code. Set ArcHighlightLanguages to keep only the grammars an app needs when it is trimmed.</Description>
        <!-- TKCode.Arc and Core contain generated types with identical names. -->
        <NoWarn>$(NoWarn);CS0436</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <!-- TextMateSharp, its grammars and the native Oniguruma (Onigwrap) come with StreamMark's TextMate package (ADR 0011). -->
        <PackageReference Include="TKCode.StreamMark.Highlighting.TextMate" />
        <ProjectReference Include="../TKCode.Arc/TKCode.Arc.csproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- ArcHighlightLanguages: keeps only the listed grammars in a trimmed publish (ADR 0050). -->
        <None Include="buildTransitive/TKCode.Arc.Highlighting.targets" Pack="true" PackagePath="build/;buildTransitive/" />
        <None Include="buildTransitive/TKCode.Arc.Highlighting.Grammars.targets" Pack="true" PackagePath="build/;buildTransitive/" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="TKCode.Arc.Tests" />
        <InternalsVisibleTo Include="TKCode.Arc.Gallery.Tests" />
    </ItemGroup>
</Project>
