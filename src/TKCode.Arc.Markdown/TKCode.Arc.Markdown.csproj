<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(ArcTargetFrameworks)</TargetFrameworks>
        <AssemblyName>TKCode.Arc.Markdown</AssemblyName>
        <RootNamespace>TKCode.Arc</RootNamespace>
        <PackageId>TKCode.Arc.Markdown</PackageId>
        <Description>Markdown for TKCode.Arc: the Markdown document control (streaming, links, selection) and the ChatThread conversation view, rendered by StreamMark. Fenced code is highlighted when TKCode.Arc.Highlighting is enabled.</Description>
        <!-- TKCode.Arc and Core contain generated types with identical names. -->
        <NoWarn>$(NoWarn);CS0436</NoWarn>
        <ArcFoundationGenerator>true</ArcFoundationGenerator>
    </PropertyGroup>
    <ItemGroup>
        <!-- StreamMark (ADR 0011) renders the Markdown; no TextMate here: highlighting is TKCode.Arc.Highlighting (ADR 0050). -->
        <PackageReference Include="TKCode.StreamMark.Avalonia" />
        <ProjectReference Include="../TKCode.Arc/TKCode.Arc.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="TKCode.Arc.Tests" />
        <InternalsVisibleTo Include="TKCode.Arc.Gallery.Tests" />
    </ItemGroup>
</Project>
