<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    xmlns:arcm="https://github.com/AIDotNet/TKCode.Arc.Mobile"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.Mobile.SegmentedTheme">

    <!-- Segmented: a SurfaceMuted track; the segments share the width; the selected one is marked by the track's glider (a Surface block with an outline) and Foreground text. -->
    <ControlTheme x:Key="{x:Type arcm:Segmented}" TargetType="arcm:Segmented">
        <Setter Property="Template">
            <ControlTemplate TargetType="arcm:Segmented">
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{arcm:SegmentedTokenResource TrackRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Panel>
                        <!-- P7: one raised block glides behind the labels (drawn in render, never relayouts). -->
                        <arc:GlidingIndicator Name="PART_Glider"
                                              Fill="{arc:ArcDesignTokenResource Surface}"
                                              Stroke="{arc:ArcDesignTokenResource Border}"
                                              StrokeThickness="1"
                                              CornerRadius="{arcm:SegmentedItemTokenResource ItemRadius}" />
                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Padding" Value="{arcm:SegmentedTokenResource TrackPadding}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="SelectionMode" Value="Single" />
    </ControlTheme>

    <ControlTheme x:Key="{x:Type arcm:SegmentedItem}" TargetType="arcm:SegmentedItem">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arcm:SegmentedItem">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{arcm:SegmentedItemTokenResource ItemRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="MinHeight" Value="{arcm:SegmentedItemTokenResource ItemHeight}" />
        <Setter Property="Padding" Value="{arcm:SegmentedItemTokenResource ItemPadding}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <!-- No :pointerover style on purpose. -->
        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:pressed:not(:selected)">
            <Setter Property="Opacity" Value="{arcm:SegmentedItemTokenResource PressedOpacity}" />
        </Style>

        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" Tween="Fast" />
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" Tween="Instant" />
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
