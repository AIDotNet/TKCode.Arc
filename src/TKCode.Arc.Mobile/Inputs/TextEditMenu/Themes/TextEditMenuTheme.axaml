<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    xmlns:arcm="https://github.com/AIDotNet/TKCode.Arc.Mobile"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.Mobile.TextEditMenuTheme">

    <!-- Edit menu surface: a SurfaceRaised pill with a Border edge and the floating shadow, holding the actions in a row.
         The items are built in code (TextEditMenuPresenter) and added to PART_Items. -->
    <ControlTheme x:Key="{x:Type arcm:TextEditMenuPresenter}" TargetType="arcm:TextEditMenuPresenter">
        <Setter Property="Template">
            <ControlTemplate TargetType="arcm:TextEditMenuPresenter">
                <Border Name="PART_Frame"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{arc:ArcDesignTokenResource ShadowFloating}">
                    <!-- The shadow sits outside the frame, so only this inner border clips (a pressed action's shade to the corners). -->
                    <Border Name="PART_Clip"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <StackPanel Name="PART_Items" Orientation="Horizontal" />
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusControl}" />
    </ControlTheme>

    <!-- Edit menu action: a 44 high label in Foreground after a Border hairline that the first shown action omits; a
         finger on it shades it with SurfaceMuted; no hover state. -->
    <ControlTheme x:Key="{x:Type arcm:TextEditMenuItem}" TargetType="arcm:TextEditMenuItem">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arcm:TextEditMenuItem">
                <Border Name="PART_Separator"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        VerticalAlignment="Stretch">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      Padding="{TemplateBinding Padding}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Setter Property="MinHeight" Value="{arcm:TextEditMenuTokenResource ItemHeight}" />
        <Setter Property="Padding" Value="{arcm:TextEditMenuTokenResource ItemPadding}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThicknessLeft}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />

        <!-- No :pointerover style on purpose: a finger does not hover. -->
        <Style Selector="^:leading">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>

        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
