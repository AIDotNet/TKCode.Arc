<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    xmlns:arcm="https://github.com/AIDotNet/TKCode.Arc.Mobile"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.Mobile.TouchSliderTheme">

    <!-- TouchSlider: 44px touch target over a 6px track with a 28px thumb and a floating value bubble while dragging. -->
    <ControlTheme x:Key="{x:Type arcm:TouchSlider}" TargetType="arcm:TouchSlider">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arcm:TouchSlider">
                <Grid Name="PART_Root"
                      MinHeight="{arcm:TouchSliderTokenResource TouchTarget}"
                      Background="Transparent">
                    <Border Name="PART_Track"
                            Height="{arcm:TouchSliderTokenResource TrackHeight}"
                            VerticalAlignment="Center"
                            Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                            ClipToBounds="True">
                        <Border Name="PART_Fill"
                                HorizontalAlignment="Left"
                                Background="{arc:ArcDesignTokenResource Accent}"
                                CornerRadius="{arc:ArcDesignTokenResource RadiusPill}" />
                    </Border>
                    <Canvas Name="PART_Overlay"
                            IsHitTestVisible="False">
                        <Border Name="PART_Bubble"
                                Background="{arc:ArcDesignTokenResource Foreground}"
                                CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                                Padding="8,3"
                                IsVisible="False">
                            <TextBlock Name="PART_BubbleText"
                                       Foreground="{arc:ArcDesignTokenResource Background}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                       Text="{TemplateBinding FormattedValue}" />
                        </Border>
                        <Border Name="PART_Thumb"
                                Width="{arcm:TouchSliderTokenResource ThumbSize}"
                                Height="{arcm:TouchSliderTokenResource ThumbSize}"
                                CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                                Background="{arc:ArcDesignTokenResource Surface}"
                                BorderBrush="{arc:ArcDesignTokenResource BorderStrong}"
                                BorderThickness="1"
                                BoxShadow="{arc:ArcDesignTokenResource ControlThumbShadow}" />
                    </Canvas>
                </Grid>
            </ControlTemplate>
        </Setter>

        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />

        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="{arcm:TouchSliderTokenResource DisabledOpacity}" />
        </Style>

        <Style Selector="^:dragging /template/ Border#PART_Thumb">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
