<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    xmlns:arcm="https://github.com/AIDotNet/TKCode.Arc.Mobile"
                    x:ClassModifier="internal">

    <!-- Navbar: 44 high, Surface fill with a Border hairline under it; back button + leading / centered title / trailing, and an optional large title row under it that collapses into the bar. -->
    <ControlTheme x:Key="{x:Type arcm:Navbar}" TargetType="arcm:Navbar">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arcm:Navbar">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <StackPanel>
                    <Grid ColumnDefinitions="*,Auto,*" Height="{arcm:NavbarTokenResource BarContentHeight}">
                        <StackPanel Name="PART_LeadingHost"
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <arcm:Button Name="PART_Back"
                                         Variant="Plain"
                                         Command="{TemplateBinding BackCommand}"
                                         IsVisible="{TemplateBinding ShowBack}">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronLeft}"
                                                  Foreground="{Binding $parent[arcm:Button].Foreground}"
                                                  Size="{arcm:NavbarTokenResource BackIconExtent}"
                                                  VerticalAlignment="Center" />
                                    <TextBlock Text="{TemplateBinding BackText}"
                                               IsVisible="{Binding !!BackText, RelativeSource={RelativeSource TemplatedParent}}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </arcm:Button>
                            <ContentPresenter Name="PART_Leading"
                                              MinWidth="{arcm:NavbarTokenResource SlotMinWidth}"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Leading}" />
                        </StackPanel>
                        <!-- P2: a new title rises out of a soft blur while the old one lifts away (first title and reduced motion: no swap). -->
                        <arc:ArcContentSwap Name="PART_Title"
                                            Grid.Column="1"
                                            Mode="BlurSwap"
                                            Content="{TemplateBinding Title}"
                                            HorizontalContentAlignment="Center"
                                            VerticalAlignment="Center"
                                            Opacity="{TemplateBinding BarTitleOpacity}"
                                            HorizontalAlignment="Center">
                            <arc:ArcContentSwap.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontSize="{arc:ArcDesignTokenResource TypeBase}"
                                               FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </arc:ArcContentSwap.ContentTemplate>
                        </arc:ArcContentSwap>
                        <ContentPresenter Name="PART_Trailing"
                                          Grid.Column="2"
                                          MinWidth="{arcm:NavbarTokenResource SlotMinWidth}"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Trailing}" />
                    </Grid>
                    <Border Name="PART_LargeTitleHost"
                            Height="{TemplateBinding LargeTitleHeight}"
                            ClipToBounds="True"
                            IsHitTestVisible="False">
                        <arc:ArcContentSwap Name="PART_LargeTitle"
                                            Mode="BlurSwap"
                                            Content="{TemplateBinding Title}"
                                            Margin="{arcm:NavbarTokenResource LargeTitleMargin}"
                                            HorizontalContentAlignment="Left"
                                            VerticalAlignment="Center">
                            <arc:ArcContentSwap.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontSize="{arcm:NavbarTokenResource LargeTitleFontSize}"
                                               FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </arc:ArcContentSwap.ContentTemplate>
                        </arc:ArcContentSwap>
                    </Border>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Padding" Value="{arcm:NavbarTokenResource BarPadding}" />
        <Setter Property="BorderThickness" Value="{arcm:NavbarTokenResource BarBorderThickness}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />

        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Standard" />
                    <arc:ArcBrushTransition Property="BorderBrush" Tween="Standard" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                    <arc:ArcBrushTransition Property="BorderBrush" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
