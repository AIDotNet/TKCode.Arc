<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    xmlns:arcm="https://github.com/AIDotNet/TKCode.Arc.Mobile"
                    x:ClassModifier="internal">

    <!-- Navigation stack: the page underneath, a dim over it, the top page over that. The code moves the layers (the back swipe
         writes their position on every move); the page underneath never takes touches. -->
    <ControlTheme x:Key="{x:Type arcm:NavigationStack}" TargetType="arcm:NavigationStack">
        <Setter Property="Template">
            <ControlTemplate TargetType="arcm:NavigationStack">
                <Panel Background="{TemplateBinding Background}"
                       ClipToBounds="True">
                    <Panel Name="PART_StaticLayer" IsHitTestVisible="False" />
                    <Border Name="PART_Dim"
                            Background="{arcm:NavigationStackTokenResource DimColor}"
                            Opacity="0"
                            IsHitTestVisible="False" />
                    <Panel Name="PART_TopLayer" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Background}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </ControlTheme>
</ResourceDictionary>
