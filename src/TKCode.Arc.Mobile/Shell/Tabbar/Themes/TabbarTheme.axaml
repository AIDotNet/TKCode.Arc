<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    xmlns:arcm="https://github.com/AIDotNet/TKCode.Arc.Mobile"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.Mobile.TabbarTheme">

    <!-- Tabbar: 49 high, Surface fill with a Border hairline above it; items share the width equally. -->
    <ControlTheme x:Key="{x:Type arcm:Tabbar}" TargetType="arcm:Tabbar">
        <Setter Property="Template">
            <ControlTemplate TargetType="arcm:Tabbar">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <Panel>
                        <!-- P7: one AccentSubtle pill glides behind the selected item's icon (drawn in render, never relayouts). -->
                        <arc:GlidingIndicator Name="PART_Glider"
                                              Fill="{arc:ArcDesignTokenResource AccentSubtle}"
                                              CornerRadius="{arc:ArcDesignTokenResource RadiusPill}" />
                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Height" Value="{arcm:TabbarTokenResource BarHeight}" />
        <Setter Property="BorderThickness" Value="{arcm:TabbarTokenResource BarBorderThickness}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
    </ControlTheme>

    <!-- Item: TextMuted icon over label; selected Foreground (the AccentSubtle pill is the bar's glider); press scales and dims; no hover state. -->
    <ControlTheme x:Key="{x:Type arcm:TabbarItem}" TargetType="arcm:TabbarItem">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arcm:TabbarItem">
                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                    <StackPanel Name="PART_Content"
                                Spacing="{arcm:TabbarItemTokenResource IconGap}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="50%,50%"
                                RenderTransform="scale(1)">
                        <Border Name="PART_Indicator"
                                Background="Transparent"
                                CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                                Padding="{arcm:TabbarItemTokenResource IndicatorPadding}"
                                HorizontalAlignment="Center">
                            <arc:ArcGlyph Name="PART_Icon"
                                          Data="{TemplateBinding Icon}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Size="{arcm:TabbarItemTokenResource IconExtent}"
                                          HorizontalAlignment="Center" />
                        </Border>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center"
                                          FontSize="{arc:ArcDesignTokenResource TypeXS}" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="MinHeight" Value="{arcm:TabbarItemTokenResource TouchTarget}" />
        <Setter Property="Padding" Value="{arcm:TabbarItemTokenResource ItemPadding}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />

        <!-- No :pointerover style on purpose. -->
        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Opacity" Value="{arcm:TabbarItemTokenResource PressedOpacity}" />
        </Style>

        <Style Selector="^:motion-full">
            <!-- P1: a tab is not a row, so a finger also shrinks its content to 0.96; the selection pill is the Tabbar's glider. -->
            <Style Selector="^:pressed /template/ StackPanel#PART_Content">
                <Setter Property="RenderTransform" Value="scale(0.96)" />
            </Style>
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" Tween="Fast" />
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
            <Style Selector="^ /template/ StackPanel#PART_Content">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:SpringTransformOperationsTransition Property="RenderTransform" Spring="Snappy" />
                    </Transitions>
                </Setter>
            </Style>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" Tween="Instant" />
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
