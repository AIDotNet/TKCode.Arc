<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(ArcTargetFrameworks)</TargetFrameworks>
        <AssemblyName>TKCode.Arc.Mobile</AssemblyName>
        <RootNamespace>TKCode.Arc.Mobile</RootNamespace>
        <PackageId>TKCode.Arc.Mobile</PackageId>
        <Description>Touch-first Arc components for Avalonia (shell, navigation stack, sheets, dialogs, lists, pull to refresh, touch inputs, pickers and radio cards) with press states, safe areas, keyboard avoidance and 44px touch targets.</Description>
        <!-- Core contains generated types with identical names. -->
        <NoWarn>$(NoWarn);CS0436</NoWarn>
        <ArcFoundationGenerator>true</ArcFoundationGenerator>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../TKCode.Arc.Core/TKCode.Arc.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="TKCode.Arc.Mobile.Tests" />
    </ItemGroup>
</Project>
