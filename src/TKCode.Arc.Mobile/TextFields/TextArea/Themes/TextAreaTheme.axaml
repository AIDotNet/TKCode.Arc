<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    xmlns:arcm="https://github.com/AIDotNet/TKCode.Arc.Mobile"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.Mobile.TextAreaTheme">

    <!-- TextArea: multiline mobile text input with SurfaceMuted fill, Accent border while focused, optional clear button,
         character counter and long-press TextEditMenu. No hover state. -->
    <ControlTheme x:Key="{x:Type arcm:TextArea}" TargetType="arcm:TextArea">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arcm:TextArea">
                <Border Name="PART_Frame"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,Auto">
                        <ScrollViewer Name="PART_ScrollViewer"
                                      Grid.Row="0"
                                      Grid.Column="0"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <Panel>
                                <TextBlock Name="PART_Placeholder"
                                           Foreground="{TemplateBinding PlaceholderForeground}"
                                           Text="{TemplateBinding PlaceholderText}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Top">
                                    <TextBlock.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding ElementName="PART_TextPresenter" Path="PreeditText" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Text" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                        </MultiBinding>
                                    </TextBlock.IsVisible>
                                </TextBlock>
                                <TextPresenter Name="PART_TextPresenter"
                                               Text="{TemplateBinding Text, Mode=TwoWay}"
                                               CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                               CaretIndex="{TemplateBinding CaretIndex}"
                                               SelectionStart="{TemplateBinding SelectionStart}"
                                               SelectionEnd="{TemplateBinding SelectionEnd}"
                                               TextWrapping="{TemplateBinding TextWrapping}"
                                               SelectionBrush="{TemplateBinding SelectionBrush}"
                                               SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                               CaretBrush="{TemplateBinding CaretBrush}"
                                               VerticalAlignment="Top" />
                            </Panel>
                        </ScrollViewer>
                        <arc:PresenceHost Name="PART_ClearHost"
                                          Grid.Row="0"
                                          Grid.Column="1"
                                          VerticalAlignment="Top"
                                          Mode="Pop"
                                          EnterScale="0.6"
                                          IsPresent="{TemplateBinding IsClearVisible}">
                            <arcm:Button Name="PART_Clear"
                                         Variant="Plain"
                                         Focusable="False"
                                         Padding="4"
                                         Margin="4,-8,-8,0">
                                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.CircleX}"
                                              Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                              Size="{arcm:TextAreaTokenResource GlyphExtent}" />
                            </arcm:Button>
                        </arc:PresenceHost>
                        <TextBlock Name="PART_Counter"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   HorizontalAlignment="Right"
                                   Margin="0,6,0,0"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                   Text="{TemplateBinding CounterText}"
                                   IsVisible="{TemplateBinding IsCounterVisible}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{arcm:TextAreaTokenResource BorderWidth}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusControl}" />
        <Setter Property="Padding" Value="{arcm:TextAreaTokenResource ContentPadding}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeBase}" />
        <Setter Property="CaretBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="SelectionBrush" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
        <Setter Property="SelectionForegroundBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="PlaceholderForeground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="ContextFlyout">
            <arcm:TextEditMenu />
        </Setter>
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />

        <Style Selector="^:focus">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="{arcm:TextAreaTokenResource DisabledOpacity}" />
        </Style>
        <Style Selector="^:at-limit /template/ TextBlock#PART_Counter">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
        </Style>

        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="BorderBrush" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="BorderBrush" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
