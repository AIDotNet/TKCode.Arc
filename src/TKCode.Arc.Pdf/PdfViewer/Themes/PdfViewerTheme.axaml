<!--
    PdfViewer (design/components/pdf/pdf.md): the PageViewer template as it is, filled through its extension points, plus the
    themes of the parts those points hold: toolbar toggle, search bar, sidebar, thumbnails, state cover, password form.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.PdfViewerTheme">
    <ControlTheme x:Key="{x:Type arc:PdfViewer}" TargetType="arc:PdfViewer" BasedOn="{StaticResource {x:Type arc:PageViewer}}" />

    <ControlTheme x:Key="{x:Type arc:PdfToolbarToggle}" TargetType="arc:PdfToolbarToggle" BasedOn="{StaticResource {x:Type arc:Button}}">
        <Setter Property="Variant" Value="Ghost" />
        <Setter Property="Size" Value="Small" />
        <Setter Property="Width" Value="{arc:ArcDesignTokenResource ControlSizeSM}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="arc:Tooltip.Tip" Value="{arc:PdfViewerLangResource Sidebar}" />
        <Setter Property="AutomationProperties.Name" Value="{arc:PdfViewerLangResource Sidebar}" />
        <Style Selector="^.search">
            <Setter Property="arc:Tooltip.Tip" Value="{arc:PdfViewerLangResource Search}" />
            <Setter Property="AutomationProperties.Name" Value="{arc:PdfViewerLangResource Search}" />
        </Style>
        <Style Selector="^:active">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentStrong}" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
        </Style>
    </ControlTheme>

    <!-- Floats over the pages at the top right; narrow, it spans the viewer (the host stretches, so no fixed width then). -->
    <ControlTheme x:Key="{x:Type arc:PdfSearchBar}" TargetType="arc:PdfSearchBar">
        <Setter Property="Width" Value="{arc:PdfViewerTokenResource SearchBarWidth}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PdfSearchBar">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        BoxShadow="{arc:ArcDesignTokenResource ShadowRaised}">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto">
                        <arc:Input Name="PART_Input"
                                   Size="Small"
                                   MinWidth="0"
                                   VerticalAlignment="Center"
                                   Placeholder="{arc:PdfViewerLangResource Search}"
                                   AutomationProperties.Name="{arc:PdfViewerLangResource Search}" />
                        <TextBlock Name="PART_Count"
                                   Grid.Column="1"
                                   Margin="8,0,4,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{arc:ArcDesignTokenResource BodyFontFamily}"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                   AutomationProperties.LiveSetting="Polite" />
                        <arc:Button Name="PART_Previous"
                                    Grid.Column="2"
                                    Classes="pdf-search-tool"
                                    Variant="Ghost"
                                    Size="Small"
                                    Padding="0"
                                    arc:Tooltip.Tip="{arc:PdfViewerLangResource PreviousMatch}"
                                    AutomationProperties.Name="{arc:PdfViewerLangResource PreviousMatch}">
                            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronUp}" />
                        </arc:Button>
                        <arc:Button Name="PART_Next"
                                    Grid.Column="3"
                                    Classes="pdf-search-tool"
                                    Variant="Ghost"
                                    Size="Small"
                                    Padding="0"
                                    arc:Tooltip.Tip="{arc:PdfViewerLangResource NextMatch}"
                                    AutomationProperties.Name="{arc:PdfViewerLangResource NextMatch}">
                            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronDown}" />
                        </arc:Button>
                        <arc:PdfToolbarToggle Name="PART_MatchCase"
                                              Grid.Column="4"
                                              Classes="pdf-search-tool"
                                              arc:Tooltip.Tip="{arc:PdfViewerLangResource MatchCase}"
                                              AutomationProperties.Name="{arc:PdfViewerLangResource MatchCase}">
                            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ALargeSmall}" />
                        </arc:PdfToolbarToggle>
                        <arc:PdfToolbarToggle Name="PART_WholeWord"
                                              Grid.Column="5"
                                              Classes="pdf-search-tool"
                                              arc:Tooltip.Tip="{arc:PdfViewerLangResource WholeWord}"
                                              AutomationProperties.Name="{arc:PdfViewerLangResource WholeWord}">
                            <arc:ArcGlyph Data="{x:Static arc:PdfSearchBar.WholeWordGlyph}" />
                        </arc:PdfToolbarToggle>
                        <arc:Button Name="PART_Close"
                                    Grid.Column="6"
                                    Classes="pdf-search-tool"
                                    Variant="Ghost"
                                    Size="Small"
                                    Padding="0"
                                    arc:Tooltip.Tip="{arc:PdfViewerLangResource CloseSearch}"
                                    AutomationProperties.Name="{arc:PdfViewerLangResource CloseSearch}">
                            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.X}" />
                        </arc:Button>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ arc|Button.pdf-search-tool">
            <Setter Property="Width" Value="{arc:ArcDesignTokenResource ControlSizeSM}" />
        </Style>
        <Style Selector="^ /template/ arc|PdfToolbarToggle.pdf-search-tool">
            <Setter Property="Width" Value="{arc:ArcDesignTokenResource ControlSizeSM}" />
        </Style>
        <Style Selector="^:narrow">
            <Setter Property="Width" Value="NaN" />
        </Style>
        <Style Selector="^:narrow /template/ arc|Button.pdf-search-tool">
            <Setter Property="Width" Value="28" />
        </Style>
        <Style Selector="^:narrow /template/ arc|PdfToolbarToggle.pdf-search-tool">
            <Setter Property="Width" Value="28" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type arc:PdfThumbnailList}" TargetType="arc:PdfThumbnailList">
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <VirtualizingStackPanel />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PdfThumbnailList">
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type arc:PdfThumbnail}" TargetType="arc:PdfThumbnail">
        <Setter Property="ThumbnailWidth" Value="{arc:PdfViewerTokenResource ThumbnailWidth}" />
        <Setter Property="Spacing" Value="{arc:PdfViewerTokenResource ThumbnailSpacing}" />
        <Setter Property="PageShadow" Value="{arc:ArcDesignTokenResource ShadowResting}" />
        <Setter Property="CurrentBrush" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="FocusBrush" Value="{arc:ArcDesignTokenResource FocusRing}" />
        <Setter Property="LabelBrush" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="CurrentLabelBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="LabelFontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="TextElement.FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
    </ControlTheme>

    <ControlTheme x:Key="{x:Type arc:PdfSidebar}" TargetType="arc:PdfSidebar">
        <Setter Property="Width" Value="{arc:PdfViewerTokenResource SidebarWidth}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThicknessRight}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <!-- The floating shadow falls outside; the scrolling parts clip themselves. -->
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PdfSidebar">
                <Border Name="PART_Frame"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <Grid RowDefinitions="Auto,*">
                        <arc:SegmentedControl Name="PART_Tabs"
                                              IsVisible="False"
                                              HorizontalAlignment="Center"
                                              Margin="8">
                            <arc:SegmentedOption Value="Thumbnails" Label="{arc:PdfViewerLangResource Thumbnails}" />
                            <arc:SegmentedOption Value="Outline" Label="{arc:PdfViewerLangResource Outline}" />
                        </arc:SegmentedControl>
                        <ScrollViewer Name="PART_ThumbnailScroll"
                                      Grid.Row="1"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <arc:PdfThumbnailList Name="PART_Thumbnails" Margin="0,0,0,12" />
                        </ScrollViewer>
                        <arc:TreeView Name="PART_Outline"
                                      Grid.Row="1"
                                      IsVisible="False"
                                      ShowIcons="False"
                                      Background="Transparent"
                                      BorderThickness="0" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:floating /template/ Border#PART_Frame">
            <Setter Property="BoxShadow" Value="{arc:ArcDesignTokenResource ShadowRaised}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type arc:PdfStateLayer}" TargetType="arc:PdfStateLayer">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PdfStateLayer">
                <Panel Background="{TemplateBinding Background}">
                    <StackPanel Name="PART_Loading"
                                IsVisible="False"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="{arc:ArcDesignTokenResource Space3}">
                        <arc:ArcSpinner Width="24"
                                        Height="24"
                                        HorizontalAlignment="Center"
                                        Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        <TextBlock Text="{arc:PdfViewerLangResource Loading}"
                                   HorizontalAlignment="Center"
                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                    </StackPanel>
                    <StackPanel Name="PART_Failed"
                                IsVisible="False"
                                MaxWidth="{arc:PdfViewerTokenResource PasswordFormWidth}"
                                Margin="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="{arc:ArcDesignTokenResource Space2}">
                        <arc:ArcGlyph Data="{x:Static arc:ArcIcons.CircleAlert}"
                                      Width="24"
                                      Height="24"
                                      HorizontalAlignment="Center"
                                      Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        <TextBlock Text="{TemplateBinding Message}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="{arc:ArcDesignTokenResource TypeBase}"
                                   Foreground="{arc:ArcDesignTokenResource Foreground}" />
                        <TextBlock Name="PART_Detail"
                                   Text="{TemplateBinding Detail}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                    </StackPanel>
                    <ContentPresenter Name="PART_Form"
                                      IsVisible="False"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:loading /template/ StackPanel#PART_Loading">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:failed /template/ StackPanel#PART_Failed">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:password /template/ ContentPresenter#PART_Form">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type arc:PdfPasswordForm}" TargetType="arc:PdfPasswordForm">
        <Setter Property="Width" Value="{arc:PdfViewerTokenResource PasswordFormWidth}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PdfPasswordForm">
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        BoxShadow="{arc:ArcDesignTokenResource ShadowRaised}">
                    <StackPanel Spacing="{arc:ArcDesignTokenResource Space4}">
                        <StackPanel Spacing="{arc:ArcDesignTokenResource Space2}">
                            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Lock}"
                                          Width="24"
                                          Height="24"
                                          HorizontalAlignment="Left"
                                          Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                            <TextBlock Text="{arc:PdfViewerLangResource Protected}"
                                       TextWrapping="Wrap"
                                       FontSize="{arc:ArcDesignTokenResource TypeBase}"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}" />
                        </StackPanel>
                        <arc:PasswordField Name="PART_Password"
                                           Label="{arc:PdfViewerLangResource Password}"
                                           IsUndoEnabled="False" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="{arc:ArcDesignTokenResource Space2}">
                            <arc:Button Name="PART_Cancel"
                                        Variant="Ghost"
                                        Content="{arc:PdfViewerLangResource Cancel}" />
                            <arc:Button Name="PART_Open"
                                        Variant="Primary"
                                        Content="{arc:PdfViewerLangResource Open}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
