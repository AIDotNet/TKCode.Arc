<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(ArcTargetFrameworks)</TargetFrameworks>
        <AssemblyName>TKCode.Arc.Pdf</AssemblyName>
        <RootNamespace>TKCode.Arc</RootNamespace>
        <PackageId>TKCode.Arc.Pdf</PackageId>
        <Description>PDF viewing for TKCode.Arc: PdfViewer (PageViewer plus a sidebar with thumbnails and outline, search, text selection, links and the states of opening a document, password included) and Pdf.Source for a plain PageViewer, over a pluggable backend (IPdfBackend). Without a backend a real document reports that none is set up; SimulatedPdfDocument serves tests and design time. Backends ship separately: TKCode.Arc.Pdf.Native (PDFium) and TKCode.Arc.Pdf.Browser (pdf.js).</Description>
        <PackageTags>$(PackageTags);pdf;viewer;document</PackageTags>
        <!-- TKCode.Arc and Core contain generated types with identical names. -->
        <NoWarn>$(NoWarn);CS0436</NoWarn>
        <ArcFoundationGenerator>true</ArcFoundationGenerator>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../TKCode.Arc/TKCode.Arc.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="TKCode.Arc.Tests" />
        <InternalsVisibleTo Include="TKCode.Arc.Gallery.Tests" />
        <InternalsVisibleTo Include="TKCode.Arc.Pdf.Native.Tests" />
        <!-- PdfDateText, shared by the backends. -->
        <InternalsVisibleTo Include="TKCode.Arc.Pdf.Native" />
        <InternalsVisibleTo Include="TKCode.Arc.Pdf.Browser" />
    </ItemGroup>
</Project>
