<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.RibbonTheme">
    <ControlTheme x:Key="{x:Type arc:Ribbon}" TargetType="arc:Ribbon">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThicknessBottom}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:Ribbon">
                <!-- The tab headers are built by the ribbon (one per tab) into PART_TabStrip, and the selected tab is shown in
                     PART_ContentSlot (or in the pop-up of a collapsed ribbon). -->
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <DockPanel>
                        <Grid Name="PART_TabRow"
                              DockPanel.Dock="Top"
                              Height="{arc:RibbonTokenResource TabRowHeight}"
                              Margin="{arc:RibbonTokenResource TabRowPadding}"
                              ColumnDefinitions="Auto,*,Auto,Auto">
                            <ContentPresenter Name="PART_LeftContent"
                                              Content="{TemplateBinding LeftContent}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0" />
                            <!-- Tabs that do not fit are cut off at the end of the column; the selected tab stays reachable
                                 from the keyboard. -->
                            <Panel Grid.Column="1" ClipToBounds="True">
                                <arc:GlidingIndicator Name="PART_SelectionIndicator"
                                                      Fill="{arc:ArcDesignTokenResource Accent}"
                                                      CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                                                      Spring="Morph" />
                                <StackPanel Name="PART_TabStrip"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Spacing="{arc:RibbonTokenResource TabGap}" />
                            </Panel>
                            <ContentPresenter Name="PART_RightContent"
                                              Grid.Column="2"
                                              Content="{TemplateBinding RightContent}"
                                              VerticalAlignment="Center"
                                              Margin="8,0,4,0" />
                            <arc:RibbonChromeButton Name="PART_MinimizeButton"
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center" />
                        </Grid>
                        <Border Name="PART_ContentArea"
                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                BorderThickness="{arc:ArcDesignTokenResource EdgeThicknessTop}"
                                Padding="{arc:RibbonTokenResource ContentPadding}">
                            <arc:RibbonVisualSlot Name="PART_ContentSlot" />
                        </Border>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type arc:RibbonTabHeader}" TargetType="arc:RibbonTabHeader">
        <!-- Arc draws its own focus ring; suppress the window's default focus adorner. -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Height" Value="{arc:RibbonTokenResource TabHeight}" />
        <Setter Property="Padding" Value="{arc:RibbonTokenResource TabPadding}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:RibbonTokenResource TabFontSize}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep8}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:RibbonTabHeader">
                <Border Name="PART_Frame"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <TextBlock Text="{TemplateBinding Text}" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:contextual">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentStrong}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="{arc:RibbonButtonTokenResource DisabledOpacity}" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" />
                    <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
