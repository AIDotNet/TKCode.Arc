<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.RibbonSeparatorTheme">
    <ControlTheme x:Key="{x:Type arc:RibbonSeparator}" TargetType="arc:RibbonSeparator">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Width" Value="{arc:RibbonSeparatorTokenResource LineWidth}" />
        <Setter Property="Margin" Value="{arc:RibbonSeparatorTokenResource LineMargin}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:RibbonSeparator">
                <Border Background="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
