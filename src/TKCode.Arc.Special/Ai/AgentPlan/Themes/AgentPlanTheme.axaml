<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal">

    <!-- The card: a 1px bordered Surface panel (radius 26, no shadow) of header, step list and footer. -->
    <ControlTheme x:Key="{x:Type arc:AgentPlan}" TargetType="arc:AgentPlan">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MaxWidth" Value="{arc:AgentPlanTokenResource CardMaxWidth}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="ForegroundInk" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="SecondaryInk" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="MutedInk" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AgentPlan">
                <Border Name="PART_Frame"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="False">
                    <StackPanel>
                        <Panel>
                            <Border Name="PART_Header" BorderThickness="0,0,0,1" BorderBrush="{arc:ArcDesignTokenResource Border}">
                                <StackPanel>
                                    <Panel Name="PART_HeadRow" />
                                    <TextBlock Name="PART_Goal"
                                               FontSize="14"
                                               LineHeight="20"
                                               LetterSpacing="-0.14"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                </StackPanel>
                            </Border>
                            <arc:AgentPlanProgress Name="PART_Progress" Height="2" VerticalAlignment="Bottom" />
                        </Panel>
                        <Border Name="PART_ListWrap">
                            <StackPanel Name="PART_ListHost" />
                        </Border>
                        <Border Name="PART_Footer" BorderThickness="0,1,0,0" BorderBrush="{arc:ArcDesignTokenResource Border}" />
                        <arc:ExplainerAnnouncer Name="PART_Announcer" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <!-- Values that states change live in styles (a value written on a template element would win over them). -->
        <Style Selector="^ /template/ Border#PART_Header">
            <Setter Property="Padding" Value="{arc:AgentPlanTokenResource HeaderPadding}" />
        </Style>
        <Style Selector="^ /template/ Border#PART_ListWrap">
            <Setter Property="Padding" Value="{arc:AgentPlanTokenResource ListPadding}" />
        </Style>
        <Style Selector="^ /template/ Border#PART_Footer">
            <Setter Property="Padding" Value="{arc:AgentPlanTokenResource FooterPadding}" />
        </Style>
        <Style Selector="^ /template/ TextBlock#PART_Goal">
            <Setter Property="Margin" Value="{arc:AgentPlanTokenResource GoalMargin}" />
        </Style>
        <Style Selector="^:narrow /template/ Border#PART_Header">
            <Setter Property="Padding" Value="{arc:AgentPlanTokenResource NarrowHeaderPadding}" />
        </Style>
        <Style Selector="^:narrow /template/ Border#PART_ListWrap">
            <Setter Property="Padding" Value="{arc:AgentPlanTokenResource NarrowListPadding}" />
        </Style>
        <Style Selector="^:narrow /template/ Border#PART_Footer">
            <Setter Property="Padding" Value="{arc:AgentPlanTokenResource NarrowFooterPadding}" />
        </Style>
    </ControlTheme>

    <!--
        A draft step's title: no frame of its own. Padding 4 8 (3 7 plus the 1px line) inside the margin -4 -8 the row gives it,
        radius 8; SurfaceMuted under the pointer, Surface with an inset 1px BorderStrong line while focused (no focus ring).
    -->
    <ControlTheme x:Key="{x:Type arc:AgentPlanTitleBox}" TargetType="arc:AgentPlanTitleBox">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="CaretBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="SelectionBrush" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
        <Setter Property="SelectionForegroundBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="PlaceholderForeground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AgentPlanTitleBox">
                <Border Name="PART_Frame"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Panel>
                        <TextBlock Name="PART_Placeholder"
                                   Foreground="{TemplateBinding PlaceholderForeground}"
                                   Text="{TemplateBinding PlaceholderText}"
                                   LineHeight="{TemplateBinding LineHeight}"
                                   LetterSpacing="{TemplateBinding LetterSpacing}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Top"
                                   IsVisible="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                        <TextPresenter Name="PART_TextPresenter"
                                       Text="{TemplateBinding Text, Mode=TwoWay}"
                                       CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                       CaretIndex="{TemplateBinding CaretIndex}"
                                       SelectionStart="{TemplateBinding SelectionStart}"
                                       SelectionEnd="{TemplateBinding SelectionEnd}"
                                       TextAlignment="{TemplateBinding TextAlignment}"
                                       TextWrapping="{TemplateBinding TextWrapping}"
                                       LineHeight="{TemplateBinding LineHeight}"
                                       LetterSpacing="{TemplateBinding LetterSpacing}"
                                       SelectionBrush="{TemplateBinding SelectionBrush}"
                                       SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                       CaretBrush="{TemplateBinding CaretBrush}"
                                       VerticalAlignment="Top" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Frame">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:focus /template/ Border#PART_Frame">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        </Style>
        <Style Selector="^:motion-full /template/ Border#PART_Frame">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                    <arc:ArcBrushTransition Property="BorderBrush" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- The drag handle: 24 x 28, radius 8, the grip in TextMuted; SurfaceMuted (and a Foreground grip) while hovered or dragged. -->
    <ControlTheme x:Key="{x:Type arc:AgentPlanGrip}" TargetType="arc:AgentPlanGrip">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AgentPlanGrip">
                <Panel>
                    <Border Name="PART_Frame" Background="{TemplateBinding Background}" CornerRadius="8">
                        <arc:ArcGlyph Name="PART_Glyph"
                                      Data="{x:Static arc:ArcIcons.GripVertical}"
                                      Size="16"
                                      StrokeThickness="1.75"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                    </Border>
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            CornerRadius="8"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ arc|ArcGlyph#PART_Glyph">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#PART_Frame">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:dragging /template/ Border#PART_Frame">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:pointerover /template/ arc|ArcGlyph#PART_Glyph">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:dragging /template/ arc|ArcGlyph#PART_Glyph">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:dragging">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:motion-full /template/ Border#PART_Frame">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!--
        The plan's small in-place buttons, told apart by class: remove (24 x 24, an x that shows while the row is hovered or
        focused), add (the Add step row), retry and skip (28 high, radius 10, 12 / 500). Their keyboard ring is inset because
        the rows clip what overflows them.
    -->
    <ControlTheme x:Key="{x:Type arc:AgentPlanButton}" TargetType="arc:AgentPlanButton">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AgentPlanButton">
                <Panel>
                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^.remove">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,-4,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Style Selector="^.revealed">
                <Setter Property="Opacity" Value="1" />
            </Style>
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            </Style>
            <Style Selector="^:pointerover /template/ Border#PART_Frame">
                <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            </Style>
        </Style>

        <Style Selector="^.add">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
            <Style Selector="^:pointerover /template/ Border#PART_Frame">
                <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            </Style>
        </Style>

        <Style Selector="^.retry, ^.skip">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="^.retry">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Accent}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentForeground}" />
            <Style Selector="^:pointerover /template/ Border#PART_Frame">
                <Setter Property="BoxShadow" Value="{arc:ArcDesignTokenResource ShadowResting}" />
            </Style>
        </Style>
        <Style Selector="^.skip">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Style Selector="^:pointerover /template/ Border#PART_Frame">
                <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            </Style>
        </Style>

        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
            <Style Selector="^ /template/ Border#PART_Frame">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                    </Transitions>
                </Setter>
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
