<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.AiWorkflowTheme">

    <!--
        The workflow card: a 1px bordered Surface panel (radius 16, no shadow) that fills its container up to 640px. A header
        (the name, its line of context, the Simulated note and Test run), the steps on their rail (or the empty state, or
        three skeleton steps), and a footer under a hairline with Add step and the last run's outcome.
    -->
    <ControlTheme x:Key="{x:Type arc:AiWorkflow}" TargetType="arc:AiWorkflow">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MaxWidth" Value="{arc:AiWorkflowTokenResource CardMaxWidth}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep16}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AiWorkflow">
                <Border Name="PART_Frame"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="False">
                    <StackPanel>
                        <Border Name="PART_Header">
                            <Grid Name="PART_HeaderGrid" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                <StackPanel Name="PART_Heading" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Name="PART_Title"
                                               FontSize="{arc:AiWorkflowTokenResource TitleFontSize}"
                                               LineHeight="{arc:AiWorkflowTokenResource TitleLineHeight}"
                                               FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                               LetterSpacing="-0.14"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                    <TextBlock Name="PART_Description"
                                               FontSize="{arc:AiWorkflowTokenResource DescriptionFontSize}"
                                               LineHeight="{arc:AiWorkflowTokenResource DescriptionLineHeight}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                </StackPanel>
                                <StackPanel Name="PART_Actions"
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <Border Name="PART_Simulated"
                                            Height="22"
                                            Padding="8,0"
                                            VerticalAlignment="Center"
                                            CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                                            BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
                                            BorderBrush="{arc:ArcDesignTokenResource Border}">
                                        <TextBlock FontSize="11.5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                    </Border>
                                    <arc:Button Name="PART_RunButton" Variant="Secondary" Size="Small" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Name="PART_Body">
                            <Panel>
                                <arc:AiWorkflowRail Name="PART_Rail"
                                                    LineBrush="{arc:ArcDesignTokenResource Border}"
                                                    FillBrush="{arc:ArcDesignTokenResource Accent}" />
                                <StackPanel Name="PART_Empty" Spacing="2" IsVisible="False" />
                                <StackPanel Name="PART_Skeleton" Spacing="4" IsVisible="False" />
                            </Panel>
                        </Border>
                        <Border Name="PART_Footer"
                                BorderThickness="{arc:ArcDesignTokenResource EdgeThicknessTop}"
                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
                            <Grid ColumnDefinitions="Auto,*">
                                <arc:Button Name="PART_AddButton" Variant="Ghost" Size="Small" />
                                <TextBlock Name="PART_Summary"
                                           Grid.Column="1"
                                           Margin="12,0,6,0"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="{arc:AiWorkflowTokenResource SummaryFontSize}"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                            </Grid>
                        </Border>
                        <arc:ExplainerAnnouncer Name="PART_Announcer" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <!-- Values that states change live in styles (a value written on a template element would win over them). -->
        <Style Selector="^ /template/ Border#PART_Header">
            <Setter Property="Padding" Value="{arc:AiWorkflowTokenResource HeaderPadding}" />
        </Style>
        <Style Selector="^ /template/ Border#PART_Body">
            <Setter Property="Padding" Value="{arc:AiWorkflowTokenResource BodyPadding}" />
        </Style>
        <Style Selector="^ /template/ Border#PART_Footer">
            <Setter Property="Padding" Value="{arc:AiWorkflowTokenResource FooterPadding}" />
        </Style>
        <Style Selector="^:narrow /template/ Border#PART_Header">
            <Setter Property="Padding" Value="{arc:AiWorkflowTokenResource NarrowHeaderPadding}" />
        </Style>
        <Style Selector="^:narrow /template/ Border#PART_Body">
            <Setter Property="Padding" Value="{arc:AiWorkflowTokenResource NarrowBodyPadding}" />
        </Style>
        <Style Selector="^:narrow /template/ Border#PART_Footer">
            <Setter Property="Padding" Value="{arc:AiWorkflowTokenResource NarrowFooterPadding}" />
        </Style>
    </ControlTheme>

    <!-- A step's remove button: 24 x 24, radius 8, an x in TextMuted; hidden until its row is hovered or it has keyboard focus. -->
    <ControlTheme x:Key="{x:Type arc:AiWorkflowIconButton}" TargetType="arc:AiWorkflowIconButton">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AiWorkflowIconButton">
                <Panel>
                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep8}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep8}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^.revealed">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:focus-visible">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#PART_Frame">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Instant" />
                </Transitions>
            </Setter>
            <Style Selector="^ /template/ Border#PART_Frame">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                    </Transitions>
                </Setter>
            </Style>
        </Style>
    </ControlTheme>

    <!-- A branch path tab: 24 high, 10 in from the sides, 12 / 500; TextMuted, the selected one Foreground on the highlight. -->
    <ControlTheme x:Key="{x:Type arc:AiWorkflowPathTab}" TargetType="arc:AiWorkflowPathTab">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AiWorkflowPathTab">
                <Panel>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      Padding="{TemplateBinding Padding}"
                                      Background="{TemplateBinding Background}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep6}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!--
        A row of the add step menu (32 high, 8 in from the sides, radius 8): its highlight is the menu's gliding block. The
        empty state's trigger rows (class trigger, 36 high) have their own SurfaceMuted hover and a keyboard ring.
    -->
    <ControlTheme x:Key="{x:Type arc:AiWorkflowMenuRow}" TargetType="arc:AiWorkflowMenuRow">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:AiWorkflowMenuRow">
                <Panel>
                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep8}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center" />
                    </Border>
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep8}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^.trigger">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0,0,8,0" />
            <Style Selector="^:pointerover /template/ Border#PART_Frame">
                <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            </Style>
            <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>
        <Style Selector="^:motion-full /template/ Border#PART_Frame">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
