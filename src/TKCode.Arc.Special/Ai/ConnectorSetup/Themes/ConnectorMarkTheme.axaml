<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.ConnectorMarkTheme">

    <!-- An app's mark: a neutral glyph (or a letter) in a quiet rounded tile with a hairline edge. -->
    <ControlTheme x:Key="{x:Type arc:ConnectorMark}" TargetType="arc:ConnectorMark">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ConnectorMarkTokenResource TileCornerRadius}" />
        <Setter Property="Padding" Value="{arc:ConnectorMarkTokenResource TilePadding}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:ConnectorMark">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Panel>
                        <arc:ArcGlyph Name="PART_Glyph"
                                      StrokeThickness="{arc:ConnectorMarkTokenResource GlyphStrokeWidth}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        <TextBlock Name="PART_Monogram"
                                   TextAlignment="Center"
                                   FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                   Foreground="{TemplateBinding Foreground}"
                                   IsVisible="False" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ arc|ArcGlyph#PART_Glyph">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
