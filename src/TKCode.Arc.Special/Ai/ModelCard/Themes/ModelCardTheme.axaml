<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.ModelCardTheme">

    <!--
        The model card: a quiet surface up to 640px wide. Its parts (header, the stacked panels and the footer) are built in
        code into PART_Root and laid out from the card's own width; the theme gives the frame and the narrow padding.
    -->
    <ControlTheme x:Key="{x:Type arc:ModelCard}" TargetType="arc:ModelCard">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="MaxWidth" Value="{arc:ModelCardTokenResource CardMaxWidth}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
        <Setter Property="Padding" Value="{arc:ModelCardTokenResource CardPadding}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:ModelCard">
                <Border Name="PART_Card"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Panel Name="PART_Root" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:narrow">
            <Setter Property="Padding" Value="{arc:ModelCardTokenResource NarrowCardPadding}" />
        </Style>
    </ControlTheme>

    <!--
        A benchmark row: transparent at rest, SurfaceMuted under the pointer or keyboard focus while the other rows fade to
        half opacity (both 160ms); a 2px keyboard ring inside its edge.
    -->
    <ControlTheme x:Key="{x:Type arc:ModelCardBenchmarkRow}" TargetType="arc:ModelCardBenchmarkRow">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:ModelCardBenchmarkRow">
                <Panel>
                    <Border Name="PART_Tint"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep8}" />
                    <Border Name="PART_FocusRing"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep8}"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}"
                            IsVisible="False"
                            IsHitTestVisible="False" />
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      Padding="{TemplateBinding Padding}"
                                      VerticalContentAlignment="Center"
                                      HorizontalContentAlignment="Stretch" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:highlighted">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:dimmed">
            <Setter Property="Opacity" Value="{arc:ModelCardTokenResource DimmedOpacity}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
