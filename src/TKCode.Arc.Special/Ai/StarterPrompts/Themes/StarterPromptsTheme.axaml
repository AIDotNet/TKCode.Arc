<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.StarterPromptsTheme">

    <!--
        The empty state of an AI app on one surface: the greeting and a quiet line, a row with the category tabs (they scroll
        inside themselves with edge fades) and Shuffle, a grid of starter cards with fixed slots, and the composer: a bare
        text area over a footer with the model, the status and the round send button. A polite live region (zero height)
        announces picks, shuffles and sends.
    -->
    <ControlTheme x:Key="{x:Type arc:StarterPrompts}" TargetType="arc:StarterPrompts">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:StarterPrompts">
                <arc:StarterPromptsSurface Name="PART_Surface"
                                           Background="{TemplateBinding Background}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BorderThickness="{TemplateBinding BorderThickness}"
                                           CompactWidth="{arc:StarterPromptsTokenResource CompactShuffleWidth}"
                                           NarrowWidth="{arc:StarterPromptsTokenResource NarrowWidth}">
                    <Panel>
                        <arc:ExplainerAnnouncer Name="PART_Announcer" />
                        <StackPanel>
                            <TextBlock Name="PART_Greeting"
                                       Text="{TemplateBinding Greeting}"
                                       TextWrapping="Wrap"
                                       FontFamily="{arc:ArcDesignTokenResource DisplayFontFamily}"
                                       FontWeight="SemiBold"
                                       LetterSpacing="{arc:StarterPromptsTokenResource GreetingLetterSpacing}"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}"
                                       AutomationProperties.HeadingLevel="2" />
                            <TextBlock Name="PART_Description"
                                       Text="{TemplateBinding Description}"
                                       TextWrapping="Wrap"
                                       Margin="{arc:StarterPromptsTokenResource DescriptionMargin}"
                                       LineHeight="{arc:StarterPromptsTokenResource DescriptionLineHeight}"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                            <Grid ColumnDefinitions="*,Auto" Margin="{arc:StarterPromptsTokenResource ToolbarMargin}">
                                <arc:Tabs Name="PART_Tabs"
                                          ContentMargin="0"
                                          VerticalAlignment="Center" />
                                <arc:Button Name="PART_Shuffle"
                                            Grid.Column="1"
                                            Variant="Ghost"
                                            Size="Small"
                                            Margin="{arc:StarterPromptsTokenResource ShuffleMargin}"
                                            VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <arc:ArcGlyph Name="PART_ShuffleGlyph" Size="16" VerticalAlignment="Center" />
                                        <TextBlock Name="PART_ShuffleLabel" VerticalAlignment="Center" />
                                    </StackPanel>
                                </arc:Button>
                            </Grid>
                            <arc:StarterPromptsGrid Name="PART_Grid"
                                                    Margin="{arc:StarterPromptsTokenResource GridMargin}"
                                                    Gap="{arc:StarterPromptsTokenResource GridGap}"
                                                    TwoColumnMinWidth="{arc:StarterPromptsTokenResource TwoColumnMinWidth}" />
                            <Border Name="PART_Composer"
                                    IsVisible="{TemplateBinding ShowsComposer}"
                                    Margin="{arc:StarterPromptsTokenResource ComposerMargin}"
                                    Padding="{arc:StarterPromptsTokenResource ComposerPadding}"
                                    CornerRadius="{arc:StarterPromptsTokenResource ComposerCornerRadius}"
                                    BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
                                    Background="{arc:ArcDesignTokenResource Surface}"
                                    BoxShadow="{arc:ArcDesignTokenResource ShadowResting}">
                                <StackPanel>
                                    <arc:StarterPromptsInput Name="PART_Input"
                                                             PlaceholderText="{TemplateBinding Placeholder}"
                                                             MinHeight="{arc:StarterPromptsTokenResource ComposerMinHeight}"
                                                             MaxHeight="{arc:StarterPromptsTokenResource ComposerMaxHeight}"
                                                             LineHeight="{arc:StarterPromptsTokenResource ComposerLineHeight}" />
                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                          Height="{arc:StarterPromptsTokenResource FooterHeight}"
                                          Margin="{arc:StarterPromptsTokenResource FooterMargin}">
                                        <StackPanel Name="PART_Model"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    Margin="2,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Focusable="False">
                                            <arc:ArcGlyph Name="PART_ModelMark"
                                                          Data="{TemplateBinding ModelMark}"
                                                          Size="{arc:StarterPromptsTokenResource ModelMarkSize}"
                                                          Foreground="{arc:ArcDesignTokenResource Accent}"
                                                          VerticalAlignment="Center" />
                                            <TextBlock Text="{TemplateBinding ModelName}"
                                                       FontSize="{arc:StarterPromptsTokenResource StatusFontSize}"
                                                       FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <arc:ArcContentSwap Name="PART_Status"
                                                            Grid.Column="1"
                                                            Mode="Crossfade"
                                                            Margin="12,0,8,0"
                                                            ClipToBounds="True"
                                                            HorizontalContentAlignment="Left"
                                                            VerticalContentAlignment="Center"
                                                            TextElement.FontSize="{arc:StarterPromptsTokenResource StatusFontSize}"
                                                            AutomationProperties.LiveSetting="Off" />
                                        <arc:StarterPromptsSendButton Name="PART_Send"
                                                                      Grid.Column="2"
                                                                      VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Panel>
                </arc:StarterPromptsSurface>
            </ControlTemplate>
        </Setter>

        <!-- Non-triggered values of template parts, so the narrow step below can override them. -->
        <Style Selector="^ /template/ arc|StarterPromptsSurface#PART_Surface">
            <Setter Property="CornerRadius" Value="{arc:StarterPromptsTokenResource SurfaceCornerRadius}" />
            <Setter Property="Padding" Value="{arc:StarterPromptsTokenResource SurfacePadding}" />
        </Style>
        <Style Selector="^ /template/ TextBlock#PART_Greeting">
            <Setter Property="FontSize" Value="{arc:StarterPromptsTokenResource GreetingFontSize}" />
            <Setter Property="LineHeight" Value="{arc:StarterPromptsTokenResource GreetingLineHeight}" />
        </Style>
        <Style Selector="^ /template/ Border#PART_Composer">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        </Style>
        <Style Selector="^ /template/ Border#PART_Composer:focus-within">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        </Style>
        <Style Selector="^ /template/ arc|Button#PART_Shuffle">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>

        <Style Selector="^:no-description /template/ TextBlock#PART_Description">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:compact /template/ TextBlock#PART_ShuffleLabel">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:narrow /template/ arc|StarterPromptsSurface#PART_Surface">
            <Setter Property="CornerRadius" Value="{arc:StarterPromptsTokenResource SurfaceCornerRadiusNarrow}" />
            <Setter Property="Padding" Value="{arc:StarterPromptsTokenResource SurfacePaddingNarrow}" />
        </Style>
        <Style Selector="^:narrow /template/ TextBlock#PART_Greeting">
            <Setter Property="FontSize" Value="{arc:StarterPromptsTokenResource GreetingFontSizeNarrow}" />
            <Setter Property="LineHeight" Value="{arc:StarterPromptsTokenResource GreetingLineHeightNarrow}" />
        </Style>

        <Style Selector="^:motion-full /template/ Border#PART_Composer">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="BorderBrush" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!--
        A starter card: a fixed frame (1px border, hover fill, a 2px keyboard ring 3px outside) around the content that
        crossfades on a swap: the mark in a tinted square with the app's name beside it, the title (one line) and the
        description (one line). Loading shows bars with the same rhythm that breathe once every 1.6s (full motion only).
    -->
    <ControlTheme x:Key="{x:Type arc:StarterPromptCard}" TargetType="arc:StarterPromptCard">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:StarterPromptsTokenResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{arc:StarterPromptsTokenResource CardPadding}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:StarterPromptCard">
                <Panel>
                    <Border Name="PART_FocusRing"
                            Margin="{arc:StarterPromptsTokenResource CardFocusRingMargin}"
                            CornerRadius="{arc:StarterPromptsTokenResource CardFocusRingRadius}"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}"
                            IsVisible="False"
                            IsHitTestVisible="False" />
                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Panel>
                            <StackPanel Name="PART_Content">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Name="PART_Mark"
                                            Width="{arc:StarterPromptsTokenResource MarkSize}"
                                            Height="{arc:StarterPromptsTokenResource MarkSize}"
                                            CornerRadius="{arc:StarterPromptsTokenResource MarkCornerRadius}"
                                            Background="{arc:ArcDesignTokenResource SurfaceMuted}">
                                        <Panel>
                                            <arc:ArcGlyph Name="PART_MarkGlyph"
                                                          Data="{TemplateBinding Mark}"
                                                          Size="{arc:StarterPromptsTokenResource MarkGlyphSize}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            <TextBlock Name="PART_MarkLetter"
                                                       Text="{TemplateBinding MarkLetter}"
                                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsVisible="False" />
                                        </Panel>
                                    </Border>
                                    <TextBlock Name="PART_App"
                                               Text="{TemplateBinding AppName}"
                                               FontSize="{arc:StarterPromptsTokenResource AppFontSize}"
                                               LineHeight="{arc:StarterPromptsTokenResource AppLineHeight}"
                                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               IsVisible="False" />
                                </StackPanel>
                                <TextBlock Name="PART_Title"
                                           Text="{TemplateBinding Title}"
                                           Margin="{arc:StarterPromptsTokenResource TitleMargin}"
                                           Height="{arc:StarterPromptsTokenResource TitleLineHeight}"
                                           LineHeight="{arc:StarterPromptsTokenResource TitleLineHeight}"
                                           FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                           FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                           Foreground="{arc:ArcDesignTokenResource Foreground}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1" />
                                <TextBlock Name="PART_Description"
                                           Text="{TemplateBinding Description}"
                                           Height="{arc:StarterPromptsTokenResource CardDescriptionLineHeight}"
                                           LineHeight="{arc:StarterPromptsTokenResource CardDescriptionLineHeight}"
                                           FontSize="{arc:StarterPromptsTokenResource CardDescriptionFontSize}"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="1" />
                            </StackPanel>
                            <StackPanel Name="PART_Skeleton" IsVisible="False">
                                <Border Width="{arc:StarterPromptsTokenResource MarkSize}"
                                        Height="{arc:StarterPromptsTokenResource MarkSize}"
                                        HorizontalAlignment="Left"
                                        CornerRadius="{arc:StarterPromptsTokenResource MarkCornerRadius}"
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}" />
                                <Grid ColumnDefinitions="3*,2*"
                                      Margin="{arc:StarterPromptsTokenResource TitleMargin}"
                                      Height="{arc:StarterPromptsTokenResource TitleLineHeight}">
                                    <Border Height="{arc:StarterPromptsTokenResource SkeletonTitleHeight}"
                                            VerticalAlignment="Center"
                                            CornerRadius="{arc:StarterPromptsTokenResource SkeletonCornerRadius}"
                                            Background="{arc:ArcDesignTokenResource SurfaceMuted}" />
                                </Grid>
                                <Grid ColumnDefinitions="4*,1*" Height="{arc:StarterPromptsTokenResource CardDescriptionLineHeight}">
                                    <Border Height="{arc:StarterPromptsTokenResource SkeletonLineHeight}"
                                            VerticalAlignment="Center"
                                            CornerRadius="{arc:StarterPromptsTokenResource SkeletonCornerRadius}"
                                            Background="{arc:ArcDesignTokenResource SurfaceMuted}" />
                                </Grid>
                            </StackPanel>
                        </Panel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ arc|ArcGlyph#PART_MarkGlyph">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="^ /template/ TextBlock#PART_MarkLetter">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="^:app /template/ arc|ArcGlyph#PART_MarkGlyph">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
        </Style>
        <Style Selector="^:app /template/ Border#PART_Mark">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
        </Style>
        <Style Selector="^:app /template/ TextBlock#PART_App">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:letter /template/ TextBlock#PART_MarkLetter">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
        </Style>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:empty">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:loading">
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:loading /template/ StackPanel#PART_Content">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:loading /template/ StackPanel#PART_Skeleton">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:loading:motion-full /template/ StackPanel#PART_Skeleton">
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.5" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                    <arc:ArcBrushTransition Property="BorderBrush" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- The composer's text area: no frame of its own, 14/22 text, Enter sends (see StarterPromptsInput). -->
    <ControlTheme x:Key="{x:Type arc:StarterPromptsInput}" TargetType="arc:StarterPromptsInput">
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:StarterPromptsInput">
                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                    <ScrollViewer Name="PART_ScrollViewer"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <Panel>
                            <TextBlock Name="PART_Placeholder"
                                       Foreground="{TemplateBinding PlaceholderForeground}"
                                       Text="{TemplateBinding PlaceholderText}"
                                       LineHeight="{TemplateBinding LineHeight}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Top">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding ElementName="PART_TextPresenter" Path="PreeditText" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Text" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>
                            <TextPresenter Name="PART_TextPresenter"
                                           Text="{TemplateBinding Text, Mode=TwoWay}"
                                           CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                           CaretIndex="{TemplateBinding CaretIndex}"
                                           SelectionStart="{TemplateBinding SelectionStart}"
                                           SelectionEnd="{TemplateBinding SelectionEnd}"
                                           TextWrapping="Wrap"
                                           LineHeight="{TemplateBinding LineHeight}"
                                           SelectionBrush="{TemplateBinding SelectionBrush}"
                                           SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                           CaretBrush="{TemplateBinding CaretBrush}"
                                           VerticalAlignment="Top" />
                        </Panel>
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="CaretBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="SelectionBrush" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
        <Setter Property="SelectionForegroundBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="PlaceholderForeground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Cursor" Value="IBeam" />
    </ControlTheme>

    <!--
        The round send button: the accent with an up arrow; while sending the arrow crossfades to a stop square (160ms).
        Empty composer: muted and disabled. A 2px keyboard ring 4px outside.
    -->
    <ControlTheme x:Key="{x:Type arc:StarterPromptsSendButton}" TargetType="arc:StarterPromptsSendButton">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Width" Value="{arc:StarterPromptsTokenResource SendSize}" />
        <Setter Property="Height" Value="{arc:StarterPromptsTokenResource SendSize}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentForeground}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:StarterPromptsSendButton">
                <Panel>
                    <Border Name="PART_FocusRing"
                            Margin="-4"
                            CornerRadius="{arc:StarterPromptsTokenResource SendFocusRingRadius}"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}"
                            IsVisible="False"
                            IsHitTestVisible="False" />
                    <Border Name="PART_Fill"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusPill}">
                        <Panel>
                            <arc:ArcGlyph Name="PART_SendGlyph"
                                          Data="{x:Static arc:ArcIcons.ArrowUp}"
                                          Size="{arc:StarterPromptsTokenResource SendGlyphSize}"
                                          StrokeThickness="2"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            <Border Name="PART_StopGlyph"
                                    Width="10"
                                    Height="10"
                                    CornerRadius="{arc:ArcDesignTokenResource RadiusStep2}"
                                    Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                        </Panel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ arc|ArcGlyph#PART_SendGlyph">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^ /template/ Border#PART_StopGlyph">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:sending /template/ arc|ArcGlyph#PART_SendGlyph">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:sending /template/ Border#PART_StopGlyph">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentStrong}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                    <arc:ArcBrushTransition Property="Foreground" Tween="Fast" />
                </Transitions>
            </Setter>
            <Style Selector="^ /template/ arc|ArcGlyph#PART_SendGlyph">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ Border#PART_StopGlyph">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                    </Transitions>
                </Setter>
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
