<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.LiquidTabBarTheme">

    <!--
        The bar draws its track itself; the tabs sit on it and the lens is drawn above them, clipped to its pill, with
        the tabs it covers redrawn inverted. The lens is the foreground color and what it covers the background color.
    -->
    <ControlTheme x:Key="{x:Type arc:LiquidTabBar}" TargetType="arc:LiquidTabBar">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        <Setter Property="LensBackground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="LensForeground" Value="{arc:ArcDesignTokenResource Background}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="BadgeFontSize" Value="{arc:LiquidTabBarTokenResource BadgeFontSize}" />
        <Setter Property="AutomationProperties.Name" Value="Sections" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:LiquidTabBar">
                <Panel>
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                    <arc:LiquidTabBarLens Name="PART_Lens" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- A tab: secondary glyph and label at rest, full foreground under the mouse. It draws itself. -->
    <ControlTheme x:Key="{x:Type arc:LiquidTabBarItem}" TargetType="arc:LiquidTabBarItem">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:LiquidTabBarItem">
                <!-- Only holds the keyboard focus ring; the tab draws itself and takes the pointer itself. -->
                <Panel Name="PART_Root" IsHitTestVisible="False" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:hover">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
