<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal">

    <!-- The drawn tree: its inks follow the theme and the accent (the card passes its AccentBrush). -->
    <ControlTheme x:Key="{x:Type arc:ReasoningTreeStage}" TargetType="arc:ReasoningTreeStage">
        <Setter Property="SurfaceInk" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="SurfaceMutedInk" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="BorderInk" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderStrongInk" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        <Setter Property="ForegroundInk" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="SecondaryInk" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="MutedInk" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="SuccessInk" Value="{arc:ArcDesignTokenResource Success}" />
        <Setter Property="FocusInk" Value="{arc:ArcDesignTokenResource FocusRing}" />
        <Setter Property="BackgroundInk" Value="{arc:ArcDesignTokenResource Background}" />
    </ControlTheme>

    <!-- The card: header (model, title, status), the stage, and the footer (playback and beam width) across a rule. -->
    <ControlTheme x:Key="{x:Type arc:ReasoningTree}" TargetType="arc:ReasoningTree">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusSurface}" />
        <Setter Property="Padding" Value="{arc:ReasoningTreeTokenResource CardPadding}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="AccentBrush" Value="{arc:ArcDesignTokenResource Series1}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:ReasoningTree">
                <Border Name="PART_Frame"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="False">
                    <Grid RowDefinitions="Auto,Auto,Auto" Margin="{TemplateBinding Padding}">
                        <Grid Name="PART_Header"
                              Height="{arc:ReasoningTreeTokenResource HeaderRowHeight}"
                              ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="{arc:ReasoningTreeTokenResource TitleGap}"
                                        VerticalAlignment="Center"
                                        ClipToBounds="True">
                                <arc:ExplainerModelLabel Model="{TemplateBinding Model}"
                                                         FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                         FontWeight="Medium"
                                                         VerticalAlignment="Center" />
                                <TextBlock Name="PART_Title"
                                           Text="{TemplateBinding Title}"
                                           FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <arc:ReasoningTreeStatus Name="PART_Status"
                                                     Grid.Column="1"
                                                     Margin="{arc:ReasoningTreeTokenResource StatusMargin}"
                                                     HorizontalAlignment="Right"
                                                     VerticalAlignment="Center" />
                        </Grid>
                        <arc:ReasoningTreeStage Name="PART_Stage"
                                                Grid.Row="1"
                                                Margin="{arc:ReasoningTreeTokenResource StageMargin}"
                                                AccentInk="{TemplateBinding AccentBrush}" />
                        <Border Name="PART_Footer"
                                Grid.Row="2"
                                IsVisible="{TemplateBinding AreControlsVisible}"
                                BorderThickness="{arc:ArcDesignTokenResource EdgeThicknessTop}"
                                BorderBrush="{arc:ArcDesignTokenResource Border}">
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                <StackPanel Name="PART_Transport"
                                            Orientation="Horizontal"
                                            Spacing="{arc:ReasoningTreeTokenResource TransportGap}"
                                            VerticalAlignment="Center">
                                    <arc:ExplainerIconButton Name="PART_PlayButton" />
                                    <arc:ExplainerIconButton Name="PART_StepButton" />
                                    <arc:ExplainerIconButton Name="PART_RestartButton" />
                                </StackPanel>
                                <StackPanel Name="PART_BeamGroup"
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="{arc:ReasoningTreeTokenResource BeamGap}"
                                            VerticalAlignment="Center">
                                    <TextBlock Name="PART_BeamLabel"
                                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                               VerticalAlignment="Center" />
                                    <arc:SegmentedControl Name="PART_Beam" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <arc:ExplainerAnnouncer Name="PART_Announcer" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <!-- Values that states change live in styles (a value written on a template element would win over them). -->
        <Style Selector="^ /template/ Border#PART_Footer">
            <Setter Property="Margin" Value="{arc:ReasoningTreeTokenResource FooterBleed}" />
            <Setter Property="Padding" Value="{arc:ReasoningTreeTokenResource FooterPadding}" />
        </Style>
        <Style Selector="^ /template/ StackPanel#PART_BeamGroup">
            <Setter Property="Margin" Value="{arc:ReasoningTreeTokenResource BeamGroupMargin}" />
        </Style>
        <Style Selector="^:compact">
            <Setter Property="Padding" Value="{arc:ReasoningTreeTokenResource CompactCardPadding}" />
        </Style>
        <Style Selector="^:compact /template/ TextBlock#PART_Title">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:compact /template/ Border#PART_Footer">
            <Setter Property="Margin" Value="{arc:ReasoningTreeTokenResource CompactFooterBleed}" />
            <Setter Property="Padding" Value="{arc:ReasoningTreeTokenResource CompactFooterPadding}" />
        </Style>
        <Style Selector="^:tiny /template/ StackPanel#PART_BeamGroup">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="Margin" Value="{arc:ReasoningTreeTokenResource StackedBeamGroupMargin}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
