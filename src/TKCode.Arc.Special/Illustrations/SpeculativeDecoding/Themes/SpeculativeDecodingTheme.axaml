<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal">

    <!-- One statistic: a muted dash until the first round settles, then rolling digits and a secondary suffix over a label. -->
    <ControlTheme x:Key="{x:Type arc:SpeculativeDecodingStat}" TargetType="arc:SpeculativeDecodingStat">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:SpeculativeDecodingStat">
                <StackPanel Spacing="{arc:SpeculativeDecodingTokenResource StatLabelGap}">
                    <Panel Height="{arc:SpeculativeDecodingTokenResource StatValueLineHeight}" HorizontalAlignment="Left">
                        <TextBlock Name="PART_Dash"
                                   Text="–"
                                   FontSize="{arc:ArcDesignTokenResource TypeXL}"
                                   Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                   VerticalAlignment="Center" />
                        <StackPanel Name="PART_Value" Orientation="Horizontal" VerticalAlignment="Center">
                            <arc:RollingDigits Name="PART_Digits"
                                               Value="{TemplateBinding Value}"
                                               Decimals="{TemplateBinding Decimals}"
                                               UseGrouping="False"
                                               FontSize="{arc:ArcDesignTokenResource TypeXL}"
                                               FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                               Foreground="{arc:ArcDesignTokenResource Foreground}"
                                               VerticalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding Suffix}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXL}"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Panel>
                    <TextBlock Text="{TemplateBinding Label}"
                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                               LineHeight="{arc:SpeculativeDecodingTokenResource StatLabelLineHeight}"
                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ StackPanel#PART_Value">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:value /template/ StackPanel#PART_Value">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:value /template/ TextBlock#PART_Dash">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:motion-full /template/ TextBlock#PART_Dash">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-full /template/ StackPanel#PART_Value">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- The card: header (title, status line, playback buttons), the drawn stage, then statistics and controls. -->
    <ControlTheme x:Key="{x:Type arc:SpeculativeDecoding}" TargetType="arc:SpeculativeDecoding">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusSurface}" />
        <Setter Property="Padding" Value="{arc:SpeculativeDecodingTokenResource CardInset}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:SpeculativeDecoding">
                <Border Name="PART_Card"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Grid Name="PART_Layout" RowDefinitions="Auto,Auto,Auto">
                        <Grid Name="PART_Header" ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="{arc:SpeculativeDecodingTokenResource TitleGap}">
                                <TextBlock Name="PART_Title"
                                           Text="{TemplateBinding Title}"
                                           FontSize="{arc:ArcDesignTokenResource TypeBase}"
                                           FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                           LineHeight="{arc:SpeculativeDecodingTokenResource TitleLineHeight}"
                                           Foreground="{arc:ArcDesignTokenResource Foreground}"
                                           TextTrimming="CharacterEllipsis" />
                                <arc:SpeculativeDecodingStatusLine Name="PART_Status" />
                            </StackPanel>
                            <StackPanel Name="PART_Actions"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Top"
                                        Spacing="{arc:SpeculativeDecodingTokenResource ActionGap}">
                                <arc:Button Name="PART_Retry" Variant="Secondary" Size="Small" />
                                <arc:ExplainerIconButton Name="PART_PlayButton" IsVisible="{TemplateBinding AreControlsVisible}" />
                                <arc:ExplainerIconButton Name="PART_RestartButton" IsVisible="{TemplateBinding AreControlsVisible}" />
                            </StackPanel>
                        </Grid>
                        <Panel Grid.Row="1">
                            <arc:SpeculativeDecodingStage Name="PART_Stage"
                                                          AutomationProperties.AccessibilityView="Raw"
                                                          DraftInk="{arc:ArcDesignTokenResource Series2}"
                                                          TargetInk="{arc:ArcDesignTokenResource Series1}"
                                                          ForegroundInk="{arc:ArcDesignTokenResource Foreground}"
                                                          SecondaryInk="{arc:ArcDesignTokenResource TextSecondary}"
                                                          MutedInk="{arc:ArcDesignTokenResource TextMuted}"
                                                          GhostInk="{arc:SpeculativeDecodingTokenResource GhostText}"
                                                          SurfaceInk="{arc:ArcDesignTokenResource Surface}"
                                                          SurfaceMutedInk="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                          BorderInk="{arc:ArcDesignTokenResource Border}"
                                                          BorderStrongInk="{arc:ArcDesignTokenResource BorderStrong}"
                                                          SuccessInk="{arc:ArcDesignTokenResource Success}"
                                                          DangerInk="{arc:ArcDesignTokenResource Danger}" />
                            <StackPanel VerticalAlignment="Top">
                                <arc:SpeculativeDecodingSpeech Name="PART_RoundSpeech" />
                                <arc:SpeculativeDecodingSpeech Name="PART_OutputSpeech" />
                                <arc:SpeculativeDecodingSpeech Name="PART_CompareSpeech" />
                            </StackPanel>
                        </Panel>
                        <Border Name="PART_Footer"
                                Grid.Row="2"
                                BorderBrush="{arc:ArcDesignTokenResource Border}"
                                BorderThickness="0,1,0,0">
                            <StackPanel Spacing="{arc:SpeculativeDecodingTokenResource FooterGap}">
                                <Grid Name="PART_Stats" ColumnDefinitions="*,*,*">
                                    <arc:SpeculativeDecodingStat Name="PART_Speedup" Decimals="1" Suffix="×" />
                                    <arc:SpeculativeDecodingStat Name="PART_Acceptance" Grid.Column="1" Decimals="0" Suffix="%" />
                                    <arc:SpeculativeDecodingStat Name="PART_TokensPerPass" Grid.Column="2" Decimals="1" />
                                </Grid>
                                <Grid Name="PART_Controls" RowDefinitions="Auto,Auto">
                                    <Grid.ColumnDefinitions>
                                        <!-- The slider takes up to 320 px (the heavy star wins), the light star keeps the switch at the right. -->
                                        <ColumnDefinition Width="1000*" MaxWidth="{arc:SpeculativeDecodingTokenResource SliderMaxWidth}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <arc:Slider Name="PART_DraftLength" Grid.ColumnSpan="1" />
                                    <arc:Switch Name="PART_Compare" Grid.Column="2" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <arc:ExplainerAnnouncer Name="PART_Announcer" Grid.Row="2" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- Spacing that changes on narrow cards is set here, not on the template elements, so the narrow styles win. -->
        <Style Selector="^ /template/ Grid#PART_Layout">
            <Setter Property="RowSpacing" Value="{arc:SpeculativeDecodingTokenResource SectionGap}" />
        </Style>
        <Style Selector="^ /template/ Grid#PART_Header">
            <Setter Property="ColumnSpacing" Value="{arc:SpeculativeDecodingTokenResource HeaderGap}" />
        </Style>
        <Style Selector="^ /template/ arc|SpeculativeDecodingStatusLine#PART_Status">
            <Setter Property="MinHeight" Value="{arc:SpeculativeDecodingTokenResource StatusLineHeight}" />
        </Style>
        <Style Selector="^ /template/ Border#PART_Footer">
            <Setter Property="Padding" Value="{arc:SpeculativeDecodingTokenResource FooterInset}" />
        </Style>
        <Style Selector="^ /template/ Grid#PART_Stats">
            <Setter Property="ColumnSpacing" Value="{arc:SpeculativeDecodingTokenResource StatColumnGap}" />
        </Style>
        <Style Selector="^ /template/ Grid#PART_Controls">
            <Setter Property="ColumnSpacing" Value="{arc:SpeculativeDecodingTokenResource ControlColumnGap}" />
            <Setter Property="RowSpacing" Value="0" />
        </Style>
        <Style Selector="^ /template/ arc|Switch#PART_Compare">
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="^ /template/ arc|Button#PART_Retry">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:retry /template/ arc|Button#PART_Retry">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:replay /template/ arc|Slider#PART_DraftLength">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:narrow">
            <Setter Property="Padding" Value="{arc:SpeculativeDecodingTokenResource NarrowCardInset}" />
        </Style>
        <Style Selector="^:narrow /template/ Grid#PART_Layout">
            <Setter Property="RowSpacing" Value="{arc:SpeculativeDecodingTokenResource NarrowSectionGap}" />
        </Style>
        <Style Selector="^:narrow /template/ arc|SpeculativeDecodingStatusLine#PART_Status">
            <Setter Property="MinHeight" Value="{arc:SpeculativeDecodingTokenResource NarrowStatusMinHeight}" />
        </Style>
        <Style Selector="^:narrow /template/ Border#PART_Footer">
            <Setter Property="Padding" Value="{arc:SpeculativeDecodingTokenResource NarrowFooterInset}" />
        </Style>
        <Style Selector="^:narrow /template/ Grid#PART_Stats">
            <Setter Property="ColumnSpacing" Value="{arc:SpeculativeDecodingTokenResource NarrowStatColumnGap}" />
        </Style>
        <Style Selector="^:narrow /template/ Grid#PART_Controls">
            <Setter Property="RowSpacing" Value="{arc:SpeculativeDecodingTokenResource ControlRowGap}" />
        </Style>
        <Style Selector="^:narrow /template/ arc|Slider#PART_DraftLength">
            <Setter Property="Grid.ColumnSpan" Value="3" />
        </Style>
        <Style Selector="^:narrow /template/ arc|Switch#PART_Compare">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- Loading and error dim the lanes (the skeleton); controls are disabled in code. -->
        <Style Selector="^ /template/ arc|SpeculativeDecodingStage#PART_Stage">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:loading /template/ arc|SpeculativeDecodingStage#PART_Stage">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="^:error /template/ arc|SpeculativeDecodingStage#PART_Stage">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="^:motion-full /template/ arc|SpeculativeDecodingStage#PART_Stage">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Standard" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced /template/ arc|SpeculativeDecodingStage#PART_Stage">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
