<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.OrbitMenuTheme">

    <!--
        The trigger's box is the menu's box. The actions live in a panel of no size on the trigger's center, drawn
        before the trigger so they come out from under it; nothing clips, so they can travel outside the box.
    -->
    <ControlTheme x:Key="{x:Type arc:OrbitMenu}" TargetType="arc:OrbitMenu">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <arc:OrbitMenuOrbit />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:OrbitMenu">
                <Panel ClipToBounds="False">
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" ClipToBounds="False" />
                    <arc:OrbitMenuTrigger Name="PART_Trigger" Glyph="{TemplateBinding Glyph}" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- The trigger: an accent circle with a raised shadow; its glyph turns a quarter of a half turn while the menu is open. -->
    <ControlTheme x:Key="{x:Type arc:OrbitMenuTrigger}" TargetType="arc:OrbitMenuTrigger">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="{arc:OrbitMenuTokenResource TriggerSize}" />
        <Setter Property="Height" Value="{arc:OrbitMenuTokenResource TriggerSize}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentForeground}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:OrbitMenuTrigger">
                <Panel Name="PART_Root">
                    <Border Name="PART_Face"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BoxShadow="{arc:ArcDesignTokenResource ShadowRaised}">
                        <arc:ArcGlyph Name="PART_Glyph"
                                      Data="{TemplateBinding Glyph}"
                                      Size="{arc:OrbitMenuTokenResource TriggerGlyphSize}"
                                      StrokeThickness="2"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      RenderTransform="rotate(0deg)" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentStrong}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#PART_Face">
            <Setter Property="RenderTransform" Value="scale(0.95)" />
        </Style>
        <Style Selector="^:open /template/ arc|ArcGlyph#PART_Glyph">
            <Setter Property="RenderTransform" Value="rotate(45deg)" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-full /template/ arc|ArcGlyph#PART_Glyph">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:SpringTransformOperationsTransition Property="RenderTransform" Spring="Snappy" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-full /template/ Border#PART_Face">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:SpringTransformOperationsTransition Property="RenderTransform" Spring="Snappy" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- An action: a raised surface circle with a glyph; hover and press tint it. -->
    <ControlTheme x:Key="{x:Type arc:OrbitMenuAction}" TargetType="arc:OrbitMenuAction">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Size" Value="{arc:OrbitMenuTokenResource ActionSize}" />
        <Setter Property="GlyphSize" Value="{arc:OrbitMenuTokenResource ActionGlyphSize}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceRaised}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="Shadow" Value="{arc:ArcDesignTokenResource ShadowRaised}" />
        <Setter Property="FocusRingBrush" Value="{arc:ArcDesignTokenResource FocusRing}" />
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
