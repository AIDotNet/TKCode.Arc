<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.EmojiPickerTheme">
    <!-- Search and skin tones, the category strip, the grid, the preview line; on a raised panel. -->
    <ControlTheme x:Key="{x:Type arc:EmojiPicker}" TargetType="arc:EmojiPicker">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Width" Value="{arc:EmojiPickerTokenResource PanelWidth}" />
        <Setter Property="Padding" Value="{arc:EmojiPickerTokenResource PanelPadding}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:EmojiPicker">
                <Border Name="PART_Surface"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <DockPanel>
                        <Grid Name="PART_Header"
                              DockPanel.Dock="Top"
                              ColumnDefinitions="*,Auto"
                              IsVisible="{TemplateBinding IsSearchVisible}"
                              Margin="0,0,0,6">
                            <arc:SearchField Name="PART_Search" Size="Small" />
                            <arc:SpringSizeDecorator Grid.Column="1"
                                                     Axis="Width"
                                                     Spring="Snappy"
                                                     HorizontalAlignment="Right"
                                                     Margin="{arc:EmojiPickerTokenResource TonesMargin}">
                                <arc:EmojiPickerTones Name="PART_Tones"
                                                      CellSize="{arc:EmojiPickerTokenResource ToneCellSize}"
                                                      EmojiFontSize="{arc:EmojiPickerTokenResource ToneFontSize}"
                                                      EmojiFontFamily="{arc:EmojiPickerTokenResource EmojiFontFamily}"
                                                      HoverFill="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                      SelectedFill="{arc:ArcDesignTokenResource AccentSubtle}"
                                                      FocusRing="{arc:ArcDesignTokenResource FocusRing}" />
                            </arc:SpringSizeDecorator>
                        </Grid>
                        <arc:EmojiPickerTabs Name="PART_Tabs"
                                             DockPanel.Dock="Top"
                                             TabSize="{arc:EmojiPickerTokenResource TabSize}"
                                             GlyphSize="{arc:EmojiPickerTokenResource TabGlyphSize}"
                                             GlyphBrush="{arc:ArcDesignTokenResource TextMuted}"
                                             ActiveGlyphBrush="{arc:ArcDesignTokenResource Foreground}"
                                             IndicatorBrush="{arc:ArcDesignTokenResource Accent}"
                                             HoverFill="{arc:ArcDesignTokenResource SurfaceMuted}"
                                             FocusRing="{arc:ArcDesignTokenResource FocusRing}" />
                        <Border Name="PART_Preview"
                                DockPanel.Dock="Bottom"
                                Height="{arc:EmojiPickerTokenResource PreviewHeight}"
                                IsVisible="{TemplateBinding IsPreviewVisible}"
                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                BorderThickness="0,1,0,0"
                                Padding="6,0">
                            <DockPanel>
                                <TextBlock Name="PART_PreviewGlyph"
                                           DockPanel.Dock="Left"
                                           FontSize="{arc:EmojiPickerTokenResource PreviewEmojiSize}"
                                           FontFamily="{arc:EmojiPickerTokenResource EmojiFontFamily}"
                                           VerticalAlignment="Center"
                                           AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Name="PART_PreviewName"
                                           Margin="{arc:EmojiPickerTokenResource PreviewNameMargin}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                           AutomationProperties.AccessibilityView="Raw" />
                            </DockPanel>
                        </Border>
                        <Panel Height="{arc:EmojiPickerTokenResource GridHeight}" Margin="0,4,0,4">
                            <ScrollViewer Name="PART_Scroll"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <arc:EmojiPickerGrid Name="PART_Grid"
                                                     CellSize="{arc:EmojiPickerTokenResource CellSize}"
                                                     EmojiFontSize="{arc:EmojiPickerTokenResource EmojiFontSize}"
                                                     EmojiFontFamily="{arc:EmojiPickerTokenResource EmojiFontFamily}"
                                                     HeaderHeight="{arc:EmojiPickerTokenResource HeaderHeight}"
                                                     HeaderFontSize="{arc:EmojiPickerTokenResource HeaderFontSize}"
                                                     HeaderForeground="{arc:ArcDesignTokenResource TextMuted}"
                                                     Background="{TemplateBinding Background}"
                                                     HoverFill="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                     FocusRing="{arc:ArcDesignTokenResource FocusRing}" />
                            </ScrollViewer>
                            <TextBlock Name="PART_Empty"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                       IsVisible="False" />
                        </Panel>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- Non-triggered values of the parts; the states below change them. -->
        <Style Selector="^ /template/ arc|EmojiPickerGrid#PART_Grid">
            <Setter Property="CellCornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep8}" />
        </Style>
        <Style Selector="^ /template/ arc|EmojiPickerTabs#PART_Tabs">
            <Setter Property="TabCornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep8}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^ /template/ arc|EmojiPickerTones#PART_Tones">
            <Setter Property="CellCornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep8}" />
        </Style>
        <Style Selector="^ /template/ arc|SearchField#PART_Search">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <!-- While searching the strip steps back: a tab clears the search and jumps. -->
        <Style Selector="^:searching /template/ arc|EmojiPickerTabs#PART_Tabs">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="^:no-results /template/ TextBlock#PART_Empty">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:tones-open /template/ arc|SearchField#PART_Search">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:motion-full /template/ arc|EmojiPickerTabs#PART_Tabs">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced /template/ arc|EmojiPickerTabs#PART_Tabs">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
