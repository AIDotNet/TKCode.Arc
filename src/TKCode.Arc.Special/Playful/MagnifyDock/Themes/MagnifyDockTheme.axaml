<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.MagnifyDockTheme">

    <!--
        The dock: a raised shelf with a hairline edge that widens with the magnified row and marks running icons with a
        dot, the icons on it, and the label pill above the active icon (the tooltip's inverted colors).
    -->
    <ControlTheme x:Key="{x:Type arc:MagnifyDock}" TargetType="arc:MagnifyDock">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:MagnifyDock">
                <Panel>
                    <arc:MagnifyDockShelf Name="PART_Shelf"
                                          Fill="{arc:ArcDesignTokenResource SurfaceRaised}"
                                          Stroke="{arc:ArcDesignTokenResource Border}"
                                          DotFill="{arc:ArcDesignTokenResource TextSecondary}"
                                          Shadow="{arc:ArcDesignTokenResource ShadowRaised}"
                                          CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}" />
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                    <arc:MagnifyDockLabels Name="PART_Labels"
                                           AutomationProperties.AccessibilityView="Raw"
                                           Fill="{arc:ArcDesignTokenResource Foreground}"
                                           Foreground="{arc:ArcDesignTokenResource Background}"
                                           FontFamily="{arc:ArcDesignTokenResource BodyFontFamily}"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                                           Shadow="{arc:ArcDesignTokenResource ShadowFloating}" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--
        An icon: its content on a muted tile with rounded corners. It grows from its bottom edge under the lens (the dock
        writes its render transform); the focus ring is created on the first keyboard focus and grows with it.
    -->
    <ControlTheme x:Key="{x:Type arc:MagnifyDockItem}" TargetType="arc:MagnifyDockItem">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep12}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:MagnifyDockItem">
                <Panel Name="PART_Root">
                    <Border Name="PART_Tile"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pressed /template/ Border#PART_Tile">
            <Setter Property="Opacity" Value="{arc:MagnifyDockTokenResource PressedOpacity}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
