<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.SandTextTheme">

    <!--
        The text draws itself (letters at rest, grains while it moves); the template only hosts the focus ring, which is
        created the first time keyboard focus arrives.
    -->
    <ControlTheme x:Key="{x:Type arc:SandText}" TargetType="arc:SandText">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="{arc:SandTextTokenResource DefaultFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:SandText">
                <Panel Name="PART_Root" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
