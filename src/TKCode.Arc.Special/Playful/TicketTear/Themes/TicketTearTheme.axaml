<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.TicketTearTheme">

    <!--
        Two pieces of paper side by side, with the flap over the stub while it is torn. Nothing clips here: holes show
        what is behind the ticket, and a falling stub leaves the ticket's box. The status line is read by screen readers
        and never seen.
    -->
    <ControlTheme x:Key="{x:Type arc:TicketTear}" TargetType="arc:TicketTear">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="MinHeight" Value="{arc:TicketTearTokenResource TicketMinHeight}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusControl}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Padding" Value="{arc:TicketTearTokenResource BodyPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:TicketTear">
                <Grid ColumnDefinitions="*,Auto">
                    <arc:TicketTearPiece Name="PART_Body" Grid.Column="0">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </arc:TicketTearPiece>
                    <arc:TicketTearStub Name="PART_Stub"
                                        Grid.Column="1"
                                        Width="{TemplateBinding StubWidth}"
                                        Content="{TemplateBinding Stub}"
                                        ContentTemplate="{TemplateBinding StubTemplate}" />
                    <arc:TicketTearFlap Name="PART_Flap"
                                        Grid.Column="1"
                                        IsVisible="False"
                                        IsHitTestVisible="False"
                                        AutomationProperties.AccessibilityView="Raw"
                                        ShadowBrush="{arc:TicketTearTokenResource FlapShadowColor}" />
                    <TextBlock Name="PART_Status"
                               Grid.ColumnSpan="2"
                               Width="1"
                               Height="1"
                               Opacity="0"
                               IsHitTestVisible="False"
                               HorizontalAlignment="Left"
                               AutomationProperties.LiveSetting="Polite" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- The stub takes input across its whole box; the paper inside is clipped to what is still on the ticket. -->
    <ControlTheme x:Key="{x:Type arc:TicketTearStub}" TargetType="arc:TicketTearStub">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="NotchRadius" Value="{arc:TicketTearTokenResource NotchRadius}" />
        <Setter Property="HoleRadius" Value="{arc:TicketTearTokenResource HoleRadius}" />
        <Setter Property="HolePitch" Value="{arc:TicketTearTokenResource HolePitch}" />
        <Setter Property="Padding" Value="{arc:TicketTearTokenResource StubPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:TicketTearStub">
                <Panel Name="PART_Root" Background="Transparent">
                    <arc:TicketTearPiece Name="PART_Piece">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </arc:TicketTearPiece>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
