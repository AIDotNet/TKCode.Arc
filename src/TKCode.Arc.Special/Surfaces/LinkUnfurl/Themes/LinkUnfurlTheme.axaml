<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.LinkUnfurlTheme">

    <!--
        Arc Link unfurl (design reference): a composer at most 576 wide (surface, 1px border that turns border-strong in
        160ms while focus is inside, radius 26); the message (Inter 16/26, -0.16, padding 18 22 14, at least 84 high);
        the lane of cards (padding 0 16); the toolbar (58 high: Try, the sample buttons, the 36px send button). Under a
        560 wide composer the paddings step down (16 18 12 / 0 12 / 8 10 10 14); under 360 "Try" hides.
        The error under the composer is an alert. Cards, chips and the send's content exit are driven from code.
    -->
    <ControlTheme x:Key="{x:Type arc:LinkUnfurl}" TargetType="arc:LinkUnfurl">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="ChipFillInk" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="ChipRingInk" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        <Setter Property="ChipTextInk" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="ChipMutedInk" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="ChipStrongInk" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="ChipSurfaceInk" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="AccentInk" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="SweepInk" Value="{arc:LinkUnfurlTokenResource SweepColor}" />
        <Setter Property="AccentFillAmount" Value="{arc:LinkUnfurlTokenResource LinkAccentFill}" />
        <Setter Property="AccentRingAmount" Value="{arc:LinkUnfurlTokenResource LinkAccentRing}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:LinkUnfurl">
                <StackPanel Spacing="8">
                    <Border Name="PART_Composer"
                            HorizontalAlignment="Stretch"
                            ClipToBounds="False"
                            BorderThickness="1">
                        <DockPanel>
                            <Grid Name="PART_Toolbar" DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto">
                                <!-- The viewer clips, so it reaches 4px past the row on every side and the samples sit 4px in:
                                     their focus rings (4px outside each sample) stay whole. -->
                                <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              VerticalAlignment="Center"
                                              Margin="-4,-4,8,-4">
                                    <StackPanel Name="PART_Samples" Orientation="Horizontal" Spacing="4" Margin="4">
                                        <TextBlock Name="PART_Try"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"
                                                   LineHeight="16.8"
                                                   AutomationProperties.AccessibilityView="Raw" />
                                    </StackPanel>
                                </ScrollViewer>
                                <arc:LinkUnfurlSendButton Name="PART_Send" Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                            <arc:LinkUnfurlHeightHost Name="PART_Body" ClipToBounds="False">
                                <StackPanel Name="PART_Content" ClipToBounds="False">
                                    <arc:TokenTextEditor Name="PART_Editor"
                                                         MinLines="2"
                                                         MaxLines="12"
                                                         SubmitOnEnter="True" />
                                    <arc:LinkUnfurlLane Name="PART_Lane" />
                                </StackPanel>
                            </arc:LinkUnfurlHeightHost>
                        </DockPanel>
                    </Border>
                    <TextBlock Name="PART_Error"
                               IsVisible="False"
                               TextWrapping="Wrap"
                               LineHeight="16.8"
                               AutomationProperties.LiveSetting="Assertive" />
                    <arc:ExplainerAnnouncer Name="PART_Announcer" />
                </StackPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Border#PART_Composer">
            <Setter Property="MaxWidth" Value="{arc:LinkUnfurlTokenResource ComposerMaxWidth}" />
            <Setter Property="CornerRadius" Value="{arc:LinkUnfurlTokenResource ComposerCornerRadius}" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        </Style>
        <Style Selector="^:focus-within /template/ Border#PART_Composer">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        </Style>
        <Style Selector="^ /template/ arc|TokenTextEditor#PART_Editor">
            <Setter Property="Padding" Value="{arc:LinkUnfurlTokenResource EditorPadding}" />
            <Setter Property="LineHeight" Value="{arc:LinkUnfurlTokenResource EditorLineHeight}" />
            <Setter Property="LetterSpacing" Value="{arc:LinkUnfurlTokenResource EditorLetterSpacing}" />
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeBase}" />
        </Style>
        <Style Selector="^ /template/ arc|LinkUnfurlLane#PART_Lane">
            <Setter Property="Margin" Value="{arc:LinkUnfurlTokenResource LanePadding}" />
        </Style>
        <Style Selector="^ /template/ Grid#PART_Toolbar">
            <Setter Property="Margin" Value="{arc:LinkUnfurlTokenResource ToolbarPadding}" />
        </Style>
        <Style Selector="^ /template/ TextBlock#PART_Try">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="^ /template/ TextBlock#PART_Error">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
            <Setter Property="Margin" Value="12,0" />
        </Style>
        <Style Selector="^:compact">
            <Style Selector="^ /template/ arc|TokenTextEditor#PART_Editor">
                <Setter Property="Padding" Value="{arc:LinkUnfurlTokenResource EditorPaddingCompact}" />
            </Style>
            <Style Selector="^ /template/ arc|LinkUnfurlLane#PART_Lane">
                <Setter Property="Margin" Value="{arc:LinkUnfurlTokenResource LanePaddingCompact}" />
            </Style>
            <Style Selector="^ /template/ Grid#PART_Toolbar">
                <Setter Property="Margin" Value="{arc:LinkUnfurlTokenResource ToolbarPaddingCompact}" />
            </Style>
        </Style>
        <Style Selector="^:tight /template/ TextBlock#PART_Try">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:motion-full /template/ Border#PART_Composer">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="BorderBrush" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced /template/ Border#PART_Composer">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="BorderBrush" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- A card's plate: surface-raised, a 1px border ring, and the lift shadow (its strength is sin(πp), drawn in code). -->
    <ControlTheme x:Key="{x:Type arc:LinkUnfurlCardHost}" TargetType="arc:LinkUnfurlCardHost">
        <Setter Property="PlateFill" Value="{arc:ArcDesignTokenResource SurfaceRaised}" />
        <Setter Property="PlateBorder" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="LiftShadow" Value="{arc:LinkUnfurlTokenResource LiftShadow}" />
    </ControlTheme>

    <!-- A card's 30px round icon button with a 44px target; hover and keyboard focus fill it surface-muted. -->
    <ControlTheme x:Key="{x:Type arc:LinkUnfurlIconButton}" TargetType="arc:LinkUnfurlIconButton">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="-7" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:LinkUnfurlIconButton">
                <Panel Background="Transparent">
                    <Border Name="PART_Frame"
                            Width="30"
                            Height="30"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                            Background="{TemplateBinding Background}">
                        <arc:ArcGlyph HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="{TemplateBinding Glyph}"
                                      Size="16"
                                      StrokeThickness="1.75"
                                      Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <Border Name="PART_FocusRing"
                            Width="38"
                            Height="38"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:focus-visible">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Style Selector="^ /template/ Border#PART_FocusRing">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                    <arc:ArcBrushTransition Property="Foreground" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- The card title: a real link, Inter 16/22.4 medium, wrapping, underlined on hover. -->
    <ControlTheme x:Key="{x:Type arc:LinkUnfurlTitleLink}" TargetType="arc:LinkUnfurlTitleLink">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeBase}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:LinkUnfurlTitleLink">
                <Panel Background="Transparent">
                    <TextBlock Name="PART_Text"
                               Text="{TemplateBinding Content}"
                               TextWrapping="Wrap"
                               LineHeight="22.4"
                               Foreground="{TemplateBinding Foreground}" />
                    <Border Name="PART_FocusRing"
                            Margin="-4,-2"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep6}"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ TextBlock#PART_Text">
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>

    <!-- A sample button: 32 high, pill, padding 0 11 0 9, an inner border-subtle ring until its link is in the message. -->
    <ControlTheme x:Key="{x:Type arc:LinkUnfurlSampleButton}" TargetType="arc:LinkUnfurlSampleButton">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="9,0,11,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="RenderTransform" Value="scale(1)" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:LinkUnfurlSampleButton">
                <Panel>
                    <Border Name="PART_Frame"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <Border Name="PART_FocusRing"
                            Margin="-4"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:added">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:focus-visible">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Style Selector="^ /template/ Border#PART_FocusRing">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                    <arc:ArcBrushTransition Property="Foreground" Tween="Fast" />
                    <arc:ArcTransformOperationsTransition Property="RenderTransform" Tween="Spring" />
                </Transitions>
            </Setter>
            <Style Selector="^:pressed">
                <Setter Property="RenderTransform" Value="scale(0.94)" />
            </Style>
        </Style>
    </ControlTheme>

    <!-- The send button: a 36px circle in the text color with an 18px arrow; success with a check once sent. -->
    <ControlTheme x:Key="{x:Type arc:LinkUnfurlSendButton}" TargetType="arc:LinkUnfurlSendButton">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Background}" />
        <Setter Property="RenderTransform" Value="scale(1)" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:LinkUnfurlSendButton">
                <Panel>
                    <Border Name="PART_Frame" CornerRadius="{arc:ArcDesignTokenResource RadiusPill}" Background="{TemplateBinding Background}" />
                    <arc:ArcGlyph HorizontalAlignment="Center" VerticalAlignment="Center" Name="PART_Arrow"
                                  Data="{x:Static arc:ArcIcons.ArrowUp}"
                                  Size="18"
                                  StrokeThickness="1.75"
                                  Foreground="{TemplateBinding Foreground}" />
                    <arc:ArcGlyph HorizontalAlignment="Center" VerticalAlignment="Center" Name="PART_Check"
                                  Data="{x:Static arc:ArcIcons.Check}"
                                  Size="18"
                                  StrokeThickness="1.75"
                                  Foreground="{TemplateBinding Foreground}" />
                    <arc:ArcSpinner Name="PART_Spinner"
                                    Width="16"
                                    Height="16"
                                    IsVisible="False"
                                    Foreground="{TemplateBinding Foreground}" />
                    <Border Name="PART_FocusRing"
                            Margin="-4"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ arc|ArcGlyph#PART_Arrow">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="^ /template/ arc|ArcGlyph#PART_Check">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="scale(0.6)" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:sent">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Success}" />
            <Style Selector="^ /template/ arc|ArcGlyph#PART_Arrow">
                <Setter Property="Opacity" Value="0" />
                <Setter Property="RenderTransform" Value="scale(0.6)" />
            </Style>
            <Style Selector="^ /template/ arc|ArcGlyph#PART_Check">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="RenderTransform" Value="scale(1)" />
            </Style>
        </Style>
        <Style Selector="^:sending">
            <Style Selector="^ /template/ arc|ArcGlyph#PART_Arrow">
                <Setter Property="Opacity" Value="0" />
            </Style>
            <Style Selector="^ /template/ arc|ArcSpinner#PART_Spinner">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                    <arc:ArcTransformOperationsTransition Property="RenderTransform" Tween="Spring" />
                </Transitions>
            </Setter>
            <Style Selector="^:pressed">
                <Setter Property="RenderTransform" Value="scale(0.94)" />
            </Style>
            <Style Selector="^ /template/ arc|ArcGlyph">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                        <arc:ArcTransformOperationsTransition Property="RenderTransform" Tween="Spring" />
                    </Transitions>
                </Setter>
            </Style>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                </Transitions>
            </Setter>
            <Style Selector="^ /template/ arc|ArcGlyph">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                    </Transitions>
                </Setter>
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
