<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(ArcTargetFrameworks)</TargetFrameworks>
        <AssemblyName>TKCode.Arc.Special</AssemblyName>
        <RootNamespace>TKCode.Arc</RootNamespace>
        <PackageId>TKCode.Arc.Special</PackageId>
        <Description>Special components for TKCode.Arc, the uiarc.dev "Special components" section: animated AI explainers (prompt cache, reasoning tree, speculative decoding, mixture of experts, agent loop) and pointer effects (dot grid, gravity well, ink fluid).</Description>
        <!-- TKCode.Arc and Core contain generated types with identical names. -->
        <NoWarn>$(NoWarn);CS0436</NoWarn>
        <ArcFoundationGenerator>true</ArcFoundationGenerator>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../TKCode.Arc/TKCode.Arc.csproj" />
        <!-- Markdown rendering and code highlighting are their own packages (ADR 0050). -->
        <ProjectReference Include="../TKCode.Arc.Markdown/TKCode.Arc.Markdown.csproj" />
        <ProjectReference Include="../TKCode.Arc.Highlighting/TKCode.Arc.Highlighting.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="TKCode.Arc.Tests" />
        <InternalsVisibleTo Include="TKCode.Arc.Blocks.Tests" />
        <InternalsVisibleTo Include="TKCode.Arc.Special.Tests" />
        <InternalsVisibleTo Include="TKCode.Arc.Extras.Tests" />
        <InternalsVisibleTo Include="TKCode.Arc.Integration.Tests" />
        <InternalsVisibleTo Include="TKCode.Arc.Gallery.Tests" />
    </ItemGroup>
    <ItemGroup>
        <!-- Unicode emoji-test.txt and CLDR annotations (Unicode License v3), built by tools/emoji/generate_emoji.py. -->
        <EmbeddedResource Include="Pickers/EmojiPicker/Data/emoji.txt" LogicalName="TKCode.Arc.Special.EmojiPicker.Emoji" />
    </ItemGroup>
</Project>
