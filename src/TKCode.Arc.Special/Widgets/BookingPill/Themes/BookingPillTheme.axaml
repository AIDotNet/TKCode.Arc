<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.BookingPillTheme">

    <!--
        The pill is a shell around one row: the raised chip, three segments with a line between each two, and the search
        button, in that order (BookingPillRow reads them by position). The open picker floats under the pill in an
        ArcPopup; its content crossfades when another segment opens. The announcer reads picks and opened segments.
    -->
    <ControlTheme x:Key="{x:Type arc:BookingPill}" TargetType="arc:BookingPill">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="OpenGrow" Value="{arc:BookingPillTokenResource OpenGrow}" />
        <Setter Property="DayCellSize" Value="{arc:BookingPillTokenResource DayCellSize}" />
        <Setter Property="DayFontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="WeekdayFontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="MutedBrush" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="RangeBrush" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
        <Setter Property="PreviewBrush" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="EndFillBrush" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="EndTextBrush" Value="{arc:ArcDesignTokenResource AccentForeground}" />
        <Setter Property="HoverBrush" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="FocusBrush" Value="{arc:ArcDesignTokenResource FocusRing}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:BookingPill">
                <Panel>
                    <Border Name="PART_Shell"
                            Height="{arc:BookingPillTokenResource PillHeight}"
                            Padding="{arc:BookingPillTokenResource PillPadding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                            BoxShadow="{arc:ArcDesignTokenResource ShadowResting}">
                        <arc:BookingPillRow Name="PART_Row" OpenGrow="{TemplateBinding OpenGrow}">
                            <Border Name="PART_Chip"
                                    Opacity="0"
                                    IsHitTestVisible="False"
                                    Background="{arc:ArcDesignTokenResource SurfaceRaised}"
                                    CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                                    BoxShadow="{arc:ArcDesignTokenResource ShadowRaised}" />
                            <arc:BookingPillSegmentButton Name="PART_Place" Part="Place" />
                            <Border Width="1"
                                    Height="{arc:BookingPillTokenResource DividerHeight}"
                                    IsHitTestVisible="False"
                                    Background="{arc:ArcDesignTokenResource Border}" />
                            <arc:BookingPillSegmentButton Name="PART_Dates" Part="Dates" />
                            <Border Width="1"
                                    Height="{arc:BookingPillTokenResource DividerHeight}"
                                    IsHitTestVisible="False"
                                    Background="{arc:ArcDesignTokenResource Border}" />
                            <arc:BookingPillSegmentButton Name="PART_Guests" Part="Guests" />
                            <arc:BookingPillSearchButton Name="PART_Search" />
                        </arc:BookingPillRow>
                    </Border>
                    <arc:ArcPopup Name="PART_Popup" MarginToAnchor="{arc:BookingPillTokenResource PopupGap}">
                        <Border Width="{arc:BookingPillTokenResource PanelWidth}"
                                Padding="{arc:BookingPillTokenResource PanelPadding}"
                                Background="{arc:ArcDesignTokenResource SurfaceRaised}"
                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
                                CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                                TextElement.FontFamily="{TemplateBinding FontFamily}">
                            <arc:ArcContentSwap Name="PART_Swap" />
                        </Border>
                    </arc:ArcPopup>
                    <arc:ExplainerAnnouncer Name="PART_Live" Width="1" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:open">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- A segment: a small label over the value, a soft fill under the pointer, the keyboard ring outside it. -->
    <ControlTheme x:Key="{x:Type arc:BookingPillSegmentButton}" TargetType="arc:BookingPillSegmentButton">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="Padding" Value="{arc:BookingPillTokenResource SegmentPadding}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:BookingPillSegmentButton">
                <Panel Name="PART_Root">
                    <Border Name="PART_Fill" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
                    <StackPanel Margin="{TemplateBinding Padding}" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Name="PART_Label"
                                   Text="{TemplateBinding Label}"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{arc:ArcDesignTokenResource Foreground}" />
                        <TextBlock Name="PART_Value"
                                   Text="{TemplateBinding Value}"
                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ TextBlock#PART_Value">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:empty /template/ TextBlock#PART_Value">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="^:pointerover:not(:open)">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- The search button: round at rest, a pill with its word while a picker is open. -->
    <ControlTheme x:Key="{x:Type arc:BookingPillSearchButton}" TargetType="arc:BookingPillSearchButton">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentForeground}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="Height" Value="{arc:BookingPillTokenResource SearchSize}" />
        <Setter Property="MinWidth" Value="{arc:BookingPillTokenResource SearchSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:BookingPillSearchButton">
                <Panel Name="PART_Root">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <arc:SpringSizeDecorator Axis="Width" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="15,0" VerticalAlignment="Center">
                                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Search}"
                                              Size="{arc:BookingPillTokenResource GlyphSize}"
                                              Foreground="{TemplateBinding Foreground}"
                                              VerticalAlignment="Center" />
                                <TextBlock Name="PART_Text"
                                           Text="{TemplateBinding Text}"
                                           FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                           FontWeight="SemiBold"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </arc:SpringSizeDecorator>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^ /template/ TextBlock#PART_Text">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:expanded /template/ TextBlock#PART_Text">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentStrong}" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- A place row: the name over its detail, a soft fill under the pointer or the keyboard. -->
    <ControlTheme x:Key="{x:Type arc:BookingPillOption}" TargetType="arc:BookingPillOption">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep12}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:BookingPillOption">
                <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                    <StackPanel Spacing="1">
                        <TextBlock Text="{TemplateBinding Title}"
                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                   FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{arc:ArcDesignTokenResource Foreground}" />
                        <TextBlock Text="{TemplateBinding Detail}"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover, ^:focus-visible, ^:current">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
