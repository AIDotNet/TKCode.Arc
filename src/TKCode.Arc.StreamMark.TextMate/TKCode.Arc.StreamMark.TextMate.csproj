<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(ArcTargetFrameworks)</TargetFrameworks>
        <AssemblyName>TKCode.Arc.StreamMark.TextMate</AssemblyName>
        <RootNamespace>StreamMark.Highlighting.TextMate</RootNamespace>
        <PackageId>TKCode.Arc.StreamMark.TextMate</PackageId>
        <Description>TextMate-based incremental syntax highlighting for StreamMark code blocks (TextMateSharp and its grammars).</Description>
        <PackageTags>$(PackageTags);markdown;streammark;textmate;highlighting</PackageTags>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="TextMateSharp" />
        <PackageReference Include="TextMateSharp.Grammars" />
        <ProjectReference Include="../TKCode.Arc.StreamMark/TKCode.Arc.StreamMark.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="TKCode.Arc.StreamMark.Tests" />
    </ItemGroup>
</Project>
