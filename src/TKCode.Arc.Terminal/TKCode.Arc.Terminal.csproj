<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- GCHandle<T> and by-ref-like generics need .NET 9+, so no net8.0 asset. -->
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <AssemblyName>TKCode.Arc.Terminal</AssemblyName>
        <RootNamespace>TKCode.Terminal</RootNamespace>
        <PackageId>TKCode.Arc.Terminal</PackageId>
        <Description>Terminal emulator for Avalonia: the TerminalView control and a managed facade over libghostty-vt (VT parsing, screen state, selection, input encoding). The native library ships in the package under runtimes/&lt;rid&gt;/native: Windows, macOS and Linux (x64, arm64), Android (arm64, x64, arm; API 29+) and iOS (an xcframework for devices and the simulator).</Description>
        <PackageTags>$(PackageTags);terminal;ghostty;vt</PackageTags>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" />
    </ItemGroup>
    <ItemGroup>
        <!-- The terminal test suites stay with the TKCode app, which owns the native build and the pty host. -->
        <InternalsVisibleTo Include="TKCode.Terminal.Core.Tests" />
        <InternalsVisibleTo Include="TKCode.Terminal.Avalonia.Tests" />
        <InternalsVisibleTo Include="TKCode.Arc.Tests" />
        <InternalsVisibleTo Include="TKCode.Arc.Blocks.Tests" />
        <InternalsVisibleTo Include="TKCode.Arc.Special.Tests" />
        <InternalsVisibleTo Include="TKCode.Arc.Extras.Tests" />
        <InternalsVisibleTo Include="TKCode.Arc.Integration.Tests" />
        <InternalsVisibleTo Include="TKCode.Arc.Gallery.Tests" />
    </ItemGroup>
    <!-- libghostty-vt per RID. The binaries are not committed: tools/terminal/build-ghostty.sh (+ build-ghostty-ios.sh) builds them
         and tools/terminal/sync-native.sh copies them in. Apps pick them up without any build targets from this package:
         desktop through deps.json; Android apps take runtimes/android-<abi>/native, which NuGet prefers over the linux-*
         fallback of the android RIDs; iOS apps embed runtimes/ios/native/ghostty-vt.xcframework as a framework (the iOS SDK
         does that for an xcframework among a package's native assets), and GhosttyLibrary loads it from Frameworks/. -->
    <ItemGroup>
        <None Include="runtimes/**" Pack="true" PackagePath="runtimes/" Visible="false" />
    </ItemGroup>
    <Target Name="WarnMissingTerminalNative" BeforeTargets="Pack">
        <ItemGroup>
            <_TerminalNative Include="$(MSBuildProjectDirectory)/runtimes/*/native/*" />
        </ItemGroup>
        <Warning Condition="'@(_TerminalNative)' == ''" Text="No libghostty-vt under runtimes/&lt;rid&gt;/native: the package would ship without the native library. Run tools/terminal/sync-native.sh." />
    </Target>
</Project>
