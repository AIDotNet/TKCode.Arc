<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.WorkflowZoomControlsTheme">

    <!-- The zoom bar: Surface, 1px Border, radius 10, ShadowResting, 2px padding and gaps; − / readout / + / fit. -->
    <ControlTheme x:Key="{x:Type arc:WorkflowZoomControls}" TargetType="arc:WorkflowZoomControls">
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:WorkflowZoomControls">
                <Border Name="PART_Bar"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        BoxShadow="{arc:ArcDesignTokenResource ShadowResting}">
                    <StackPanel Orientation="Horizontal" Spacing="{arc:WorkflowZoomControlsTokenResource ItemGap}">
                        <arc:WorkflowZoomButton Name="PART_ZoomOut" Glyph="{x:Static arc:ArcIcons.Minus}" />
                        <arc:WorkflowZoomButton Name="PART_Reset" Width="{arc:WorkflowZoomControlsTokenResource ReadoutWidth}" />
                        <arc:WorkflowZoomButton Name="PART_ZoomIn" Glyph="{x:Static arc:ArcIcons.Plus}" />
                        <arc:WorkflowZoomButton Name="PART_Fit" Glyph="{x:Static arc:ArcIcons.Maximize2}" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:WorkflowZoomControlsTokenResource BarRadius}" />
        <Setter Property="Padding" Value="{arc:WorkflowZoomControlsTokenResource BarPadding}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </ControlTheme>

    <!-- 28px button: TextSecondary glyph or readout; hover / press SurfaceMuted + Foreground; disabled 35%; 2px ring 2px out. -->
    <ControlTheme x:Key="{x:Type arc:WorkflowZoomButton}" TargetType="arc:WorkflowZoomButton">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:WorkflowZoomButton">
                <Panel>
                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Panel>
                            <arc:ArcGlyph Name="PART_Glyph"
                                          Data="{TemplateBinding Glyph}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Size="{arc:WorkflowZoomControlsTokenResource ButtonGlyphSize}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            <TextBlock Name="PART_Text"
                                       Text="{TemplateBinding Text}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                       TextElement.FontFeatures="tnum"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw" />
                        </Panel>
                    </Border>
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            Margin="{arc:WorkflowZoomControlsTokenResource FocusRingMargin}"
                            CornerRadius="{arc:WorkflowZoomControlsTokenResource FocusRingRadius}"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Setter Property="Width" Value="{arc:WorkflowZoomControlsTokenResource ButtonExtent}" />
        <Setter Property="Height" Value="{arc:WorkflowZoomControlsTokenResource ButtonExtent}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{arc:WorkflowZoomControlsTokenResource ButtonRadius}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="{arc:WorkflowZoomControlsTokenResource DisabledOpacity}" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- Color, background and opacity on Arc's 160ms standard curve. -->
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Fast" />
                    <arc:ArcBrushTransition Property="Foreground" Tween="Fast" />
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                    <arc:ArcBrushTransition Property="Foreground" Tween="Instant" />
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
