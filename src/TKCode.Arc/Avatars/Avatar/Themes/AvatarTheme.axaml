<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.AvatarTheme">
    <ControlTheme x:Key="{x:Type arc:Avatar}" TargetType="arc:Avatar">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:Avatar">
                <Panel>
                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <Panel>
                            <TextBlock Name="PART_Initials"
                                       Text="{TemplateBinding Initials}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <arc:ArcImage Name="PART_Image"
                                          IsVisible="False"
                                          Source="{TemplateBinding Source}"
                                          Stretch="UniformToFill" />
                        </Panel>
                    </Border>
                    <!-- The presence dot (PART_StatusHost > PART_Status, an AvatarStatusDot) is built by the avatar the
                         first time it has a status; its theme is below. -->
                </Panel>
            </ControlTemplate>
        </Setter>

        <Setter Property="Width" Value="{arc:AvatarTokenResource DiameterMD}" />
        <Setter Property="Height" Value="{arc:AvatarTokenResource DiameterMD}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />

        <Style Selector="^:small">
            <Setter Property="Width" Value="{arc:AvatarTokenResource DiameterSM}" />
            <Setter Property="Height" Value="{arc:AvatarTokenResource DiameterSM}" />
            <Setter Property="FontSize" Value="{arc:AvatarTokenResource InitialsFontSizeSM}" />
        </Style>
        <Style Selector="^:large">
            <Setter Property="Width" Value="{arc:AvatarTokenResource DiameterLG}" />
            <Setter Property="Height" Value="{arc:AvatarTokenResource DiameterLG}" />
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        </Style>
        <Style Selector="^:xlarge">
            <Setter Property="Width" Value="{arc:AvatarTokenResource DiameterXL}" />
            <Setter Property="Height" Value="{arc:AvatarTokenResource DiameterXL}" />
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXL}" />
            <!-- The dot's XLarge inset (StatusMarginXL) is applied by the avatar to the host it builds. -->
        </Style>

        <Style Selector="^:show-image">
            <Style Selector="^ /template/ TextBlock#PART_Initials">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ arc|ArcImage#PART_Image">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>
        <!-- Set only while a photo is still downloading after mount, so cached photos never fade. -->
        <Style Selector="^:image-loading /template/ arc|ArcImage#PART_Image">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Effect">
                <BlurEffect Radius="4" />
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced:image-loading /template/ arc|ArcImage#PART_Image">
            <Setter Property="Effect" Value="{x:Null}" />
        </Style>

        <Style Selector="^:motion-full">
            <Style Selector="^:not(:image-loading) /template/ arc|ArcImage#PART_Image">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcDoubleTransition Property="Opacity" Tween="Enter" />
                        <arc:ArcEffectTransition Property="Effect" Tween="Enter" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^:fallback /template/ TextBlock#PART_Initials">
                <Style.Animations>
                    <Animation Duration="0:0:0.24" Easing="0.16,1,0.3,1" FillMode="Both">
                        <KeyFrame Cue="0%">
                            <Setter Property="Opacity" Value="0" />
                        </KeyFrame>
                        <KeyFrame Cue="100%">
                            <Setter Property="Opacity" Value="1" />
                        </KeyFrame>
                    </Animation>
                </Style.Animations>
            </Style>
        </Style>
    </ControlTheme>

    <!-- The presence dot the avatar builds on demand (PART_Status). The dot keeps the medium size and ring whatever the
         avatar's size, as the template part did (its token values were local and the size styles never overrode them);
         the avatar mirrors Online into :online. -->
    <ControlTheme x:Key="{x:Type arc:AvatarStatusDot}" TargetType="arc:AvatarStatusDot">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Width" Value="{arc:AvatarTokenResource StatusSizeMD}" />
        <Setter Property="Height" Value="{arc:AvatarTokenResource StatusSizeMD}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="BorderThickness" Value="{arc:AvatarTokenResource StatusRing}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BoxShadow" Value="{arc:AvatarTokenResource StatusHalo}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Style Selector="^:online">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Success}" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
