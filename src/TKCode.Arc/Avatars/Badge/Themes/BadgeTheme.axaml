<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.BadgeTheme">
    <ControlTheme x:Key="{x:Type arc:Badge}" TargetType="arc:Badge">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:Badge">
                <Panel>
                    <Border Name="PART_Frame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                    <!-- Info tone: accent mixes (PART_Wash, PART_ToneRing: BadgeToneLayer, themed below) are laid over the
                         neutral fill and border here, between the frame and the clip, by the badge the first time it is Info. -->
                    <Border Name="PART_Clip"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <arc:SpringSizeDecorator Name="PART_Body"
                                                 Axis="Width"
                                                 Spring="Morph"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center">
                            <StackPanel Name="PART_Content" Orientation="Horizontal">
                                <arc:ArcContentSwap Name="PART_Icon"
                                                    Mode="Pop"
                                                    IsVisible="False"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    Content="{TemplateBinding Icon}" />
                                <arc:ArcContentSwap Name="PART_Label"
                                                    Mode="None"
                                                    VerticalAlignment="Center"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </StackPanel>
                        </arc:SpringSizeDecorator>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="{arc:BadgeTokenResource PillHeightMD}" />
        <Setter Property="Padding" Value="{arc:BadgeTokenResource InlinePaddingMD}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <!-- Neutral -->
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />

        <!-- Base part values live in styles (not the template) so state styles can override them. -->
        <Style Selector="^ /template/ StackPanel#PART_Content">
            <Setter Property="Spacing" Value="{arc:BadgeTokenResource ContentGapMD}" />
        </Style>
        <Style Selector="^:small">
            <Setter Property="MinHeight" Value="{arc:BadgeTokenResource PillHeightSM}" />
            <Setter Property="Padding" Value="{arc:BadgeTokenResource InlinePaddingSM}" />
            <Setter Property="FontSize" Value="{arc:BadgeTokenResource LabelFontSizeSM}" />
            <Style Selector="^ /template/ StackPanel#PART_Content">
                <Setter Property="Spacing" Value="{arc:BadgeTokenResource ContentGapSM}" />
            </Style>
        </Style>

        <Style Selector="^:icon /template/ arc|ArcContentSwap#PART_Icon">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:text /template/ arc|ArcContentSwap#PART_Label">
            <Setter Property="Mode" Value="BlurSwap" />
        </Style>

        <!-- Tones: the icon takes the tone color, the label the tone foreground. -->
        <Style Selector="^ /template/ arc|ArcContentSwap#PART_Icon">
            <Setter Property="TextElement.Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="^:success">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Success}" />
            <Setter Property="Background" Value="{arc:BadgeTokenResource SuccessBackground}" />
            <Setter Property="BorderBrush" Value="{arc:BadgeTokenResource SuccessBorder}" />
            <Style Selector="^ /template/ arc|ArcContentSwap#PART_Icon">
                <Setter Property="TextElement.Foreground" Value="{arc:ArcDesignTokenResource Success}" />
            </Style>
        </Style>
        <Style Selector="^:info">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentStrong}" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Style Selector="^ /template/ arc|ArcContentSwap#PART_Icon">
                <Setter Property="TextElement.Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
            </Style>
        </Style>
        <Style Selector="^:warning">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Warning}" />
            <Setter Property="Background" Value="{arc:BadgeTokenResource WarningBackground}" />
            <Setter Property="BorderBrush" Value="{arc:BadgeTokenResource WarningBorder}" />
            <Style Selector="^ /template/ arc|ArcContentSwap#PART_Icon">
                <Setter Property="TextElement.Foreground" Value="{arc:ArcDesignTokenResource Warning}" />
            </Style>
        </Style>
        <Style Selector="^:danger">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
            <Setter Property="Background" Value="{arc:BadgeTokenResource DangerBackground}" />
            <Setter Property="BorderBrush" Value="{arc:BadgeTokenResource DangerBorder}" />
            <Style Selector="^ /template/ arc|ArcContentSwap#PART_Icon">
                <Setter Property="TextElement.Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
            </Style>
        </Style>

        <!-- Hover (fine pointers): 32% tone color into the border, 10% into the surface. -->
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{arc:BadgeTokenResource NeutralHoverBackground}" />
            <Setter Property="BorderBrush" Value="{arc:BadgeTokenResource NeutralHoverBorder}" />
        </Style>
        <Style Selector="^:success:pointerover">
            <Setter Property="Background" Value="{arc:BadgeTokenResource SuccessHoverBackground}" />
            <Setter Property="BorderBrush" Value="{arc:BadgeTokenResource SuccessHoverBorder}" />
        </Style>
        <Style Selector="^:warning:pointerover">
            <Setter Property="Background" Value="{arc:BadgeTokenResource WarningHoverBackground}" />
            <Setter Property="BorderBrush" Value="{arc:BadgeTokenResource WarningHoverBorder}" />
        </Style>
        <Style Selector="^:danger:pointerover">
            <Setter Property="Background" Value="{arc:BadgeTokenResource DangerHoverBackground}" />
            <Setter Property="BorderBrush" Value="{arc:BadgeTokenResource DangerHoverBorder}" />
        </Style>
        <Style Selector="^:info:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        </Style>

        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Standard" />
                    <arc:ArcBrushTransition Property="BorderBrush" Tween="Standard" />
                    <arc:ArcBrushTransition Property="Foreground" Tween="Standard" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                    <arc:ArcBrushTransition Property="BorderBrush" Tween="Instant" />
                    <arc:ArcBrushTransition Property="Foreground" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- The Info tone's accent layers the badge builds on demand: the wash (1px inside, hidden until hover: 32% tone into the
         border, 10% into the surface) and the ring (the accent edge at InfoRingOpacity, stronger on hover). The badge
         mirrors its :pointerover into :hover; the opacity fades on standard under full motion, as the template parts did. -->
    <ControlTheme x:Key="{x:Type arc:BadgeToneLayer}" TargetType="arc:BadgeToneLayer">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Style Selector="^:wash">
            <Setter Property="Margin" Value="1" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Accent}" />
        </Style>
        <Style Selector="^:wash:hover">
            <Setter Property="Opacity" Value="{arc:BadgeTokenResource InfoHoverWashOpacity}" />
        </Style>
        <Style Selector="^:ring">
            <Setter Property="Opacity" Value="{arc:BadgeTokenResource InfoRingOpacity}" />
            <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
        </Style>
        <Style Selector="^:ring:hover">
            <Setter Property="Opacity" Value="{arc:BadgeTokenResource InfoHoverRingOpacity}" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" Tween="Standard" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
