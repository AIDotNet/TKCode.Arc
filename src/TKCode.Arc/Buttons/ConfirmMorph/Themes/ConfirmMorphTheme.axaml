<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal">
    <!-- Inner buttons: keyboard focus reads through fill, never a ring. -->
    <ControlTheme x:Key="ConfirmMorphTriggerTheme" TargetType="Button">
        <!-- Arc draws its own focus ring; suppress the window's default focus adorner. -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Padding" Value="{arc:ConfirmMorphTokenResource TriggerInset}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Style Selector="^:focus-visible">
            <Setter Property="Background" Value="{arc:ConfirmMorphTokenResource TriggerFocusColor}" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{arc:ConfirmMorphTokenResource TriggerHoverColor}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{arc:ConfirmMorphTokenResource TriggerPressColor}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
            <Setter Property="Cursor" Value="No" />
        </Style>
        <Style Selector="^:motion-full:not(:pressed)">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" />
                    <arc:ArcBrushTransition Property="Foreground" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="ConfirmMorphAnswerTheme" TargetType="Button">
        <!-- Arc draws its own focus ring; suppress the window's default focus adorner. -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="Height" Value="{arc:ConfirmMorphTokenResource InnerButtonExtent}" />
        <Setter Property="Padding" Value="{arc:ConfirmMorphTokenResource AnswerInset}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Style Selector="^.result">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:focus-visible">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Setter Property="Background" Value="{arc:ConfirmMorphTokenResource AnswerFocusColor}" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Setter Property="Background" Value="{arc:ConfirmMorphTokenResource AnswerHoverColor}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Setter Property="Background" Value="{arc:ConfirmMorphTokenResource AnswerPressColor}" />
        </Style>
        <Style Selector="^:motion-full:not(:pressed)">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" />
                    <arc:ArcBrushTransition Property="Foreground" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- The only colored thing in the control. Hold mode reveals a solid copy, label and all, from the left. -->
    <ControlTheme x:Key="ConfirmMorphConfirmDangerTheme" TargetType="Button">
        <!-- Arc draws its own focus ring; suppress the window's default focus adorner. -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Panel>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <Border Name="PART_HoldFill"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{arc:ArcDesignTokenResource Danger}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{arc:ArcDesignTokenResource Background}" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Setter Property="Background" Value="{arc:ConfirmMorphTokenResource ConfirmRestColor}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
        <Setter Property="Height" Value="{arc:ConfirmMorphTokenResource InnerButtonExtent}" />
        <Setter Property="Padding" Value="{arc:ConfirmMorphTokenResource AnswerInset}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Style Selector="^:focus-visible">
            <Setter Property="Background" Value="{arc:ConfirmMorphTokenResource ConfirmFocusColor}" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{arc:ConfirmMorphTokenResource ConfirmHoverColor}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{arc:ConfirmMorphTokenResource ConfirmPressColor}" />
        </Style>
        <Style Selector="^:motion-full:not(:pressed)">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="ConfirmMorphConfirmNeutralTheme" TargetType="Button">
        <!-- Arc draws its own focus ring; suppress the window's default focus adorner. -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Button">
                <Panel>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <Border Name="PART_HoldFill"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{arc:ArcDesignTokenResource AccentStrong}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{arc:ArcDesignTokenResource AccentForeground}" />
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentForeground}" />
        <Setter Property="Height" Value="{arc:ConfirmMorphTokenResource InnerButtonExtent}" />
        <Setter Property="Padding" Value="{arc:ConfirmMorphTokenResource AnswerInset}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Style Selector="^:focus-visible, ^:pointerover, ^:pressed">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentStrong}" />
        </Style>
        <Style Selector="^:motion-full:not(:pressed)">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type arc:ConfirmMorph}" TargetType="arc:ConfirmMorph">
        <!-- Arc draws its own focus ring; suppress the window's default focus adorner. -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:ConfirmMorph">
                <Panel>
                    <!-- One neutral pill for every state; only its width moves. The border is an overlay. -->
                    <Panel HorizontalAlignment="Left" Height="{arc:ArcDesignTokenResource ControlSizeSM}">
                        <Border Name="PART_Pill"
                                Background="{arc:ArcDesignTokenResource SurfaceRaised}"
                                BoxShadow="{arc:ArcDesignTokenResource ShadowResting}"
                                CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                                ClipToBounds="True">
                            <Panel Name="PART_Stage" HorizontalAlignment="Left">
                                <StackPanel Name="PART_IdleFace" Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Button Name="PART_Trigger" Theme="{StaticResource ConfirmMorphTriggerTheme}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <arc:ArcGlyph Name="PART_TriggerIcon"
                                                          Data="{TemplateBinding Icon}"
                                                          Size="16"
                                                          VerticalAlignment="Center"
                                                          IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <TextBlock Text="{TemplateBinding Label}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Name="PART_ConfirmFace"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            Margin="{arc:ConfirmMorphTokenResource FaceInset}"
                                            Spacing="{arc:ConfirmMorphTokenResource FaceGap}">
                                    <TextBlock Name="PART_Prompt"
                                               Text="{TemplateBinding ShownPrompt}"
                                               Margin="{arc:ConfirmMorphTokenResource PromptInset}"
                                               MaxWidth="{arc:ConfirmMorphTokenResource PromptMaxWidth}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <Button Name="PART_Cancel"
                                            Theme="{StaticResource ConfirmMorphAnswerTheme}"
                                            Content="{TemplateBinding CancelLabel}" />
                                    <Button Name="PART_Confirm"
                                            Theme="{StaticResource ConfirmMorphConfirmDangerTheme}"
                                            Content="{TemplateBinding ConfirmLabel}" />
                                </StackPanel>
                                <StackPanel Name="PART_CountFace"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            Margin="{arc:ConfirmMorphTokenResource FaceInset}"
                                            Spacing="{arc:ConfirmMorphTokenResource FaceGap}">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="{arc:ConfirmMorphTokenResource StatusGap}"
                                                Margin="{arc:ConfirmMorphTokenResource CountingStatusInset}"
                                                VerticalAlignment="Center">
                                        <arc:ConfirmMorphRing Name="PART_Ring"
                                                              Progress="{TemplateBinding CountdownProgress}"
                                                              TrackBrush="{arc:ArcDesignTokenResource Border}"
                                                              FillBrush="{arc:ArcDesignTokenResource Danger}"
                                                              VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{TemplateBinding ShownCountdownLabel}"
                                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                       VerticalAlignment="Center" />
                                            <arc:ArcContentSwap Name="PART_Seconds"
                                                                Mode="Roll"
                                                                Content="{TemplateBinding SecondsLeft}"
                                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Name="PART_CountCancel"
                                            Theme="{StaticResource ConfirmMorphAnswerTheme}"
                                            Content="{TemplateBinding CancelLabel}" />
                                </StackPanel>
                                <StackPanel Name="PART_PendingFace"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            Margin="{arc:ConfirmMorphTokenResource FaceInset}">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="{arc:ConfirmMorphTokenResource StatusGap}"
                                                Margin="{arc:ConfirmMorphTokenResource PendingStatusInset}"
                                                VerticalAlignment="Center">
                                        <arc:ArcGlyph Name="PART_Spinner"
                                                      Data="{x:Static arc:ArcIcons.LoaderCircle}"
                                                      Size="16"
                                                      RenderTransformOrigin="50%,50%"
                                                      Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                      VerticalAlignment="Center">
                                            <arc:ArcGlyph.RenderTransform>
                                                <RotateTransform />
                                            </arc:ArcGlyph.RenderTransform>
                                        </arc:ArcGlyph>
                                        <TextBlock Text="{TemplateBinding WorkingLabel}"
                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Name="PART_DoneFace"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            Margin="{arc:ConfirmMorphTokenResource FaceInset}"
                                            Spacing="{arc:ConfirmMorphTokenResource FaceGap}">
                                    <StackPanel Name="PART_DoneStatus"
                                                Orientation="Horizontal"
                                                Spacing="{arc:ConfirmMorphTokenResource StatusGap}"
                                                Margin="{arc:ConfirmMorphTokenResource SoloStatusInset}"
                                                VerticalAlignment="Center">
                                        <arc:ConfirmMorphCheck Name="PART_Check"
                                                               DiscBrush="{arc:ArcDesignTokenResource Success}"
                                                               TickBrush="{arc:ArcDesignTokenResource Background}"
                                                               VerticalAlignment="Center" />
                                        <TextBlock Text="{TemplateBinding DoneLabel}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Name="PART_Undo"
                                            Classes="result"
                                            Theme="{StaticResource ConfirmMorphAnswerTheme}"
                                            Content="{TemplateBinding UndoLabel}"
                                            IsVisible="{TemplateBinding UndoAction, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                </StackPanel>
                                <StackPanel Name="PART_ErrorFace"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            Margin="{arc:ConfirmMorphTokenResource FaceInset}"
                                            Spacing="{arc:ConfirmMorphTokenResource FaceGap}">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="{arc:ConfirmMorphTokenResource StatusGap}"
                                                Margin="{arc:ConfirmMorphTokenResource StatusInset}"
                                                VerticalAlignment="Center">
                                        <arc:ArcGlyph Data="{x:Static arc:ArcIcons.CircleAlert}"
                                                      Size="16"
                                                      Foreground="{arc:ArcDesignTokenResource Danger}"
                                                      VerticalAlignment="Center" />
                                        <TextBlock Text="{TemplateBinding ErrorLabel}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Name="PART_Retry"
                                            Classes="result"
                                            Theme="{StaticResource ConfirmMorphAnswerTheme}"
                                            Content="{TemplateBinding RetryLabel}" />
                                </StackPanel>
                            </Panel>
                        </Border>
                        <Border Name="PART_Outline"
                                IsHitTestVisible="False"
                                BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
                                BorderBrush="{arc:ArcDesignTokenResource Border}"
                                CornerRadius="{arc:ArcDesignTokenResource RadiusPill}" />
                    </Panel>
                    <arc:ButtonsLiveRegion Name="PART_Status" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />

        <Style Selector="^ /template/ arc|ArcGlyph#PART_TriggerIcon">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="^:has-undo /template/ StackPanel#PART_DoneStatus">
            <Setter Property="Margin" Value="{arc:ConfirmMorphTokenResource StatusInset}" />
        </Style>
        <Style Selector="^[Tone=Neutral]">
            <Style Selector="^ /template/ Button#PART_Confirm">
                <Setter Property="Theme" Value="{StaticResource ConfirmMorphConfirmNeutralTheme}" />
            </Style>
            <Style Selector="^ /template/ arc|ConfirmMorphRing#PART_Ring">
                <Setter Property="FillBrush" Value="{arc:ArcDesignTokenResource Accent}" />
            </Style>
        </Style>
        <Style Selector="^:disabled:idle">
            <Style Selector="^ /template/ Border#PART_Pill">
                <Setter Property="BoxShadow" Value="none" />
            </Style>
            <Style Selector="^ /template/ Border#PART_Outline">
                <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
            </Style>
            <Style Selector="^ /template/ arc|ArcGlyph#PART_TriggerIcon">
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
            </Style>
        </Style>

        <Style Selector="^:pending:motion-full /template/ arc|ArcGlyph#PART_Spinner">
            <Style.Animations>
                <Animation Duration="0:0:0.7" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- Reduced motion slows the spinner instead of stopping it. -->
        <Style Selector="^:pending:motion-reduced /template/ arc|ArcGlyph#PART_Spinner">
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </ControlTheme>
</ResourceDictionary>
