<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
                    x:ClassModifier="internal">
    <!-- A flat pill on the surface; the actions' widths are the animation. -->
    <ControlTheme x:Key="{x:Type arc:ExpandingButtonGroup}" TargetType="arc:ExpandingButtonGroup">
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:ExpandingButtonGroup">
                <Panel>
                    <Border Name="PART_Pill"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Border>
                    <arc:ButtonsLiveRegion Name="PART_Status" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="{arc:ExpandingButtonGroupTokenResource ActionGap}" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="Padding" Value="{arc:ExpandingButtonGroupTokenResource PillInset}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Style Selector="^:small">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
