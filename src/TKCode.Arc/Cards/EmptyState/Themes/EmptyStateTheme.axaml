<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.EmptyStateTheme">
    <ControlTheme x:Key="{x:Type arc:EmptyState}" TargetType="arc:EmptyState">
        <!-- Shadows, transforms and focus rings reach past the bounds (stated explicitly so an app style that turns clipping on cannot cut them). -->
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:EmptyState">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding ContentPadding}">
                    <StackPanel HorizontalAlignment="Stretch">
                        <Border Name="PART_IconBlock"
                                HorizontalAlignment="Center"
                                BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
                                BorderBrush="{arc:ArcDesignTokenResource Border}"
                                Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                TextElement.Foreground="{arc:ArcDesignTokenResource TextSecondary}">
                            <arc:ArcContentSwap Name="PART_Icon"
                                                Mode="Pop"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Content="{TemplateBinding IconContent}" />
                        </Border>
                        <!-- The copy column follows its content height, so a longer message grows instead of snapping. -->
                        <arc:SpringSizeDecorator Name="PART_CopyFrame" Axis="Height" Spring="Smooth" CrossClipOverflow="12">
                            <StackPanel>
                                <arc:MessagesTextSwap Name="PART_Title"
                                                      Text="{TemplateBinding Title}"
                                                      TextAlignment="Center"
                                                      TextWrapping="Wrap"
                                                      IsBalanced="True"
                                                      LineHeight="{arc:EmptyStateTokenResource TitleLineHeight}"
                                                      TextElement.FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                                      TextElement.Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                <arc:MessagesTextSwap Name="PART_Description"
                                                      Margin="{arc:EmptyStateTokenResource DescriptionMargin}"
                                                      MaxWidth="{arc:EmptyStateTokenResource DescriptionMaxWidth}"
                                                      Text="{TemplateBinding Description}"
                                                      TextAlignment="Center"
                                                      TextWrapping="Wrap"
                                                      IsBalanced="True"
                                                      LineHeight="{arc:EmptyStateTokenResource DescriptionLineHeight}"
                                                      TextElement.FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                      TextElement.Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                            </StackPanel>
                        </arc:SpringSizeDecorator>
                        <ContentPresenter Name="PART_Action"
                                          IsVisible="False"
                                          HorizontalAlignment="Center"
                                          Content="{TemplateBinding Action}" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="InlinePadding" Value="{arc:EmptyStateTokenResource InlinePadding}" />
        <Setter Property="CompactBlockPadding" Value="{arc:EmptyStateTokenResource BlockPaddingSmall}" />
        <!-- Values the compact state overrides live in styles (a template value would outrank them). -->
        <Style Selector="^ /template/ Border#PART_IconBlock">
            <Setter Property="Width" Value="{arc:EmptyStateTokenResource IconBlockSize}" />
            <Setter Property="Height" Value="{arc:EmptyStateTokenResource IconBlockSize}" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
        </Style>
        <Style Selector="^ /template/ arc|MessagesTextSwap#PART_Title">
            <Setter Property="Margin" Value="{arc:EmptyStateTokenResource TitleMargin}" />
            <Setter Property="TextElement.FontSize" Value="{arc:ArcDesignTokenResource TypeBase}" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#PART_Action">
            <Setter Property="Margin" Value="{arc:EmptyStateTokenResource ActionMargin}" />
        </Style>
        <Style Selector="^:has-action /template/ ContentPresenter#PART_Action">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:small">
            <Style Selector="^ /template/ Border#PART_IconBlock">
                <Setter Property="Width" Value="{arc:EmptyStateTokenResource IconBlockSizeSmall}" />
                <Setter Property="Height" Value="{arc:EmptyStateTokenResource IconBlockSizeSmall}" />
                <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusControl}" />
            </Style>
            <Style Selector="^ /template/ arc|MessagesTextSwap#PART_Title">
                <Setter Property="Margin" Value="{arc:EmptyStateTokenResource TitleMarginSmall}" />
                <Setter Property="TextElement.FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_Action">
                <Setter Property="Margin" Value="{arc:EmptyStateTokenResource ActionMarginSmall}" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
