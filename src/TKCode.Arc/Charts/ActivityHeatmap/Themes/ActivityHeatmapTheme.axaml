<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type arc:ActivityHeatmap}" TargetType="arc:ActivityHeatmap">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="CellGap" Value="{arc:ActivityHeatmapTokenResource CellGap}" />
        <Setter Property="CellMin" Value="{arc:ActivityHeatmapTokenResource CellMin}" />
        <Setter Property="CellMax" Value="{arc:ActivityHeatmapTokenResource CellMax}" />
        <Setter Property="WeekdayColumn" Value="{arc:ActivityHeatmapTokenResource WeekdayColumn}" />
    </ControlTheme>
</ResourceDictionary>
