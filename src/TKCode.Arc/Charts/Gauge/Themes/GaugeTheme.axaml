<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type arc:Gauge}" TargetType="arc:Gauge">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="DialMaxWidth" Value="{arc:GaugeTokenResource DialMaxWidth}" />
        <Setter Property="RingThickness" Value="{arc:GaugeTokenResource RingThickness}" />
        <Setter Property="CaptionGap" Value="{arc:GaugeTokenResource CaptionGap}" />
    </ControlTheme>
</ResourceDictionary>
