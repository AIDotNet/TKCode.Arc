<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type arc:Ridgeline}" TargetType="arc:Ridgeline">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Lift" Value="{arc:RidgelineTokenResource Lift}" />
        <Setter Property="AxisHeight" Value="{arc:RidgelineTokenResource AxisHeight}" />
        <Setter Property="TickSpacing" Value="{arc:RidgelineTokenResource TickSpacing}" />
    </ControlTheme>
</ResourceDictionary>
