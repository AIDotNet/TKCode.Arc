<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.SlopeChartTheme">
    <ControlTheme x:Key="{x:Type arc:SlopeChart}" TargetType="arc:SlopeChart">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="RowPitch" Value="{arc:SlopeChartTokenResource RowPitch}" />
        <Setter Property="LabelGap" Value="{arc:SlopeChartTokenResource LabelGap}" />
        <Setter Property="NarrowBreakpoint" Value="{arc:SlopeChartTokenResource NarrowBreakpoint}" />
    </ControlTheme>
</ResourceDictionary>
