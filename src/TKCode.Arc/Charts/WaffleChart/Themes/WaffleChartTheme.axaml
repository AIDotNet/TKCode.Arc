<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type arc:WaffleChart}" TargetType="arc:WaffleChart">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="CellGap" Value="{arc:WaffleChartTokenResource CellGap}" />
        <Setter Property="GridMaxSize" Value="{arc:WaffleChartTokenResource GridMaxSize}" />
        <Setter Property="SideLegendBreakpoint" Value="{arc:WaffleChartTokenResource SideLegendBreakpoint}" />
    </ControlTheme>
</ResourceDictionary>
