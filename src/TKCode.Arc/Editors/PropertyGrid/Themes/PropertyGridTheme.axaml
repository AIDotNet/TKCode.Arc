<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.PropertyGridTheme">
    <ControlTheme x:Key="{x:Type arc:PropertyGrid}" TargetType="arc:PropertyGrid">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PropertyGrid">
                <Border Name="PART_Frame"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <DockPanel>
                        <arc:SearchField Name="PART_Search"
                                         DockPanel.Dock="Top"
                                         Size="Small"
                                         Margin="{arc:PropertyGridTokenResource SearchMargin}"
                                         Label="{TemplateBinding SearchPlaceholder}"
                                         IsLabelVisible="False"
                                         Placeholder="{TemplateBinding SearchPlaceholder}"
                                         Text="{TemplateBinding FilterText, Mode=TwoWay}"
                                         IsVisible="{TemplateBinding IsSearchVisible}" />
                        <Border Name="PART_Description"
                                DockPanel.Dock="Bottom"
                                Height="{arc:PropertyGridTokenResource DescriptionHeight}"
                                Padding="{arc:PropertyGridTokenResource DescriptionPadding}"
                                BorderThickness="0,1,0,0"
                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                IsVisible="{TemplateBinding IsDescriptionVisible}">
                            <StackPanel Spacing="{arc:PropertyGridTokenResource DescriptionGap}">
                                <TextBlock Name="PART_DescriptionTitle"
                                           Text="{TemplateBinding DescriptionTitle}"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                           FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                           Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                <TextBlock Name="PART_DescriptionText"
                                           Text="{TemplateBinding DescriptionText}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="2"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                            </StackPanel>
                        </Border>
                        <Panel>
                            <arc:PropertyGridItemsHost Name="PART_Items" />
                            <TextBlock Name="PART_Empty"
                                       Text="{TemplateBinding EmptyText}"
                                       IsVisible="False"
                                       Margin="{arc:PropertyGridTokenResource EmptyPadding}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                       Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                        </Panel>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="MinWidth" Value="240" />

        <Style Selector="^:empty /template/ TextBlock#PART_Empty">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>

    <!-- The list: a scroll viewer around a virtualizing stack of rows and headers. -->
    <ControlTheme x:Key="{x:Type arc:PropertyGridItemsHost}" TargetType="arc:PropertyGridItemsHost">
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PropertyGridItemsHost">
                <ScrollViewer Name="PART_ScrollViewer"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    Margin="{arc:PropertyGridTokenResource ListPadding}"
                                    ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
            </ControlTemplate>
        </Setter>
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <VirtualizingStackPanel />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Focusable" Value="False" />
    </ControlTheme>

    <ControlTheme x:Key="{x:Type arc:PropertyGridItem}" TargetType="arc:PropertyGridItem">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PropertyGridItem">
                <Panel>
                    <Border Name="PART_Root"
                            MinHeight="{arc:PropertyGridItemTokenResource RowHeight}"
                            Padding="{arc:PropertyGridItemTokenResource RowPadding}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep12}"
                            Background="Transparent">
                        <DockPanel>
                            <Panel Name="PART_LabelHost"
                                   DockPanel.Dock="Left"
                                   Width="{TemplateBinding LabelWidth}"
                                   Background="Transparent">
                                <DockPanel Margin="{TemplateBinding Indent}">
                                    <Border Name="PART_Expander"
                                            DockPanel.Dock="Left"
                                            Width="{arc:PropertyGridItemTokenResource ExpanderWidth}"
                                            Background="Transparent">
                                        <arc:ArcGlyph Name="PART_Chevron"
                                                      Data="{x:Static arc:ArcIcons.ChevronRight}"
                                                      Size="{arc:PropertyGridItemTokenResource ChevronSize}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      RenderTransformOrigin="50%,50%"
                                                      RenderTransform="rotate(0deg)"
                                                      IsVisible="False"
                                                      Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                    </Border>
                                    <TextBlock Name="PART_Label"
                                               Text="{TemplateBinding Label}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,10,0" />
                                </DockPanel>
                                <Border Name="PART_Splitter"
                                        Width="{arc:PropertyGridItemTokenResource SplitterWidth}"
                                        HorizontalAlignment="Right"
                                        Background="Transparent"
                                        Cursor="SizeWestEast">
                                    <Border Name="PART_SplitterLine"
                                            Width="1"
                                            Margin="0,6"
                                            HorizontalAlignment="Center"
                                            Background="{arc:ArcDesignTokenResource BorderSubtle}" />
                                </Border>
                            </Panel>
                            <StackPanel Name="PART_Actions"
                                        DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        Spacing="2"
                                        VerticalAlignment="Center">
                                <arc:Button Name="PART_Add"
                                            Classes="property-grid-action"
                                            Variant="Ghost"
                                            Size="Small"
                                            IsVisible="False">
                                    <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Plus}" Size="16" />
                                </arc:Button>
                                <arc:Button Name="PART_Remove"
                                            Classes="property-grid-action"
                                            Variant="Ghost"
                                            Size="Small"
                                            IsVisible="False">
                                    <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Minus}" Size="16" />
                                </arc:Button>
                            </StackPanel>
                            <ContentPresenter Name="PART_Editor"
                                              Margin="4,0,0,0"
                                              VerticalAlignment="Center"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            Margin="{arc:PropertyGridItemTokenResource FocusRingMargin}"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep14}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Setter Property="IndentStep" Value="{arc:PropertyGridItemTokenResource IndentStep}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />

        <Style Selector="^ /template/ TextBlock#PART_Label">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="^ /template/ Border#PART_SplitterLine">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#PART_SplitterLine">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^ /template/ Border#PART_Splitter:pointerover > Border#PART_SplitterLine">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#PART_Root">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_Root">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:selected /template/ TextBlock#PART_Label">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:expandable /template/ arc|ArcGlyph#PART_Chevron">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:expandable /template/ Border#PART_Expander">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="^:expanded /template/ arc|ArcGlyph#PART_Chevron">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
        <Style Selector="^:invalid /template/ TextBlock#PART_Label">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^ /template/ arc|Button.property-grid-action">
            <Setter Property="Width" Value="{arc:PropertyGridItemTokenResource ActionSize}" />
            <Setter Property="Height" Value="{arc:PropertyGridItemTokenResource ActionSize}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusStep10}" />
        </Style>

        <Style Selector="^:motion-full">
            <Style Selector="^ /template/ Border#PART_Root">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ arc|ArcGlyph#PART_Chevron">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcTransformOperationsTransition Property="RenderTransform" Tween="Spring" />
                    </Transitions>
                </Setter>
            </Style>
        </Style>
        <Style Selector="^:motion-reduced">
            <Style Selector="^ /template/ Border#PART_Root">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                    </Transitions>
                </Setter>
            </Style>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type arc:PropertyGridCategoryItem}" TargetType="arc:PropertyGridCategoryItem">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PropertyGridCategoryItem">
                <Panel Margin="{arc:PropertyGridCategoryItemTokenResource HeaderMargin}">
                    <Border Name="PART_Root"
                            Height="{arc:PropertyGridCategoryItemTokenResource HeaderHeight}"
                            Padding="{arc:PropertyGridCategoryItemTokenResource HeaderPadding}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep10}"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="{arc:PropertyGridCategoryItemTokenResource ChevronGap}"
                                    VerticalAlignment="Center">
                            <arc:ArcGlyph Name="PART_Chevron"
                                          Data="{x:Static arc:ArcIcons.ChevronRight}"
                                          Size="{arc:PropertyGridCategoryItemTokenResource ChevronSize}"
                                          VerticalAlignment="Center"
                                          RenderTransformOrigin="50%,50%"
                                          RenderTransform="rotate(0deg)"
                                          Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                            <TextBlock Name="PART_Header"
                                       Text="{TemplateBinding Header}"
                                       VerticalAlignment="Center"
                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                       FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        </StackPanel>
                    </Border>
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            Margin="{arc:PropertyGridCategoryItemTokenResource FocusRingMargin}"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusStep12}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />

        <Style Selector="^ /template/ Border#PART_Root">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#PART_Root">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:pointerover /template/ TextBlock#PART_Header">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:expanded /template/ arc|ArcGlyph#PART_Chevron">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^:motion-full">
            <Style Selector="^ /template/ arc|ArcGlyph#PART_Chevron">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcTransformOperationsTransition Property="RenderTransform" Tween="Spring" />
                    </Transitions>
                </Setter>
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
