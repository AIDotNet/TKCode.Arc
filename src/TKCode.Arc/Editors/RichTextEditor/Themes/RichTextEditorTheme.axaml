<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal">
    <!-- The editor: a writing surface that draws its own text, caret and selection, plus a hidden live region. -->
    <ControlTheme x:Key="{x:Type arc:RichTextEditor}" TargetType="arc:RichTextEditor">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:RichTextEditor">
                <Panel>
                    <arc:RichTextEditorSurface Name="PART_Surface"
                                               MinHeight="{arc:RichTextEditorTokenResource SurfaceMinHeight}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               MonoFontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                               AccentBrush="{arc:ArcDesignTokenResource Accent}"
                                               SecondaryBrush="{arc:ArcDesignTokenResource TextSecondary}"
                                               MutedBrush="{arc:ArcDesignTokenResource TextMuted}"
                                               LinkBrush="{arc:ArcDesignTokenResource AccentStrong}"
                                               CodeBackground="{arc:ArcDesignTokenResource SurfaceMuted}"
                                               CodeBorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                               QuoteBarBrush="{arc:ArcDesignTokenResource BorderStrong}"
                                               RuleBrush="{arc:ArcDesignTokenResource Border}"
                                               BaseFontSize="{arc:ArcDesignTokenResource TypeBase}"
                                               Heading1FontSize="{arc:ArcDesignTokenResource Type2XL}"
                                               Heading2FontSize="{arc:ArcDesignTokenResource TypeXL}"
                                               Heading3FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                               CodeFontSize="{arc:ArcDesignTokenResource TypeSM}"
                                               Tracking="{arc:ArcDesignTokenResource TrackingBody}" />
                    <arc:EditorsLiveRegion Name="PART_LiveRegion" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[IsReadOnly=True] /template/ arc|RichTextEditorSurface#PART_Surface">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </ControlTheme>

    <!-- Toolbar and link field buttons: 32px, 11px corners, accent when pressed. -->
    <ControlTheme x:Key="{x:Type arc:RichTextEditorToolButton}" TargetType="arc:RichTextEditorToolButton">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Width" Value="{arc:RichTextEditorTokenResource ToolButtonSize}" />
        <Setter Property="Height" Value="{arc:RichTextEditorTokenResource ToolButtonSize}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="CornerRadius" Value="{arc:RichTextEditorTokenResource ToolButtonRadius}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:RichTextEditorToolButton">
                <Border Name="PART_Frame"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:focus-visible">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:checked">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentStrong}" />
        </Style>
        <Style Selector="^.apply">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="^.apply.ready">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Accent}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentForeground}" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" />
                    <arc:ArcBrushTransition Property="Foreground" />
                    <arc:ArcTransformOperationsTransition Property="RenderTransform" Tween="Instant" />
                </Transitions>
            </Setter>
            <Style Selector="^:down">
                <Setter Property="RenderTransform" Value="scale(0.92)" />
            </Style>
        </Style>
        <Style Selector="^:motion-full.apply">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Standard" />
                    <arc:ArcBrushTransition Property="Foreground" Tween="Standard" />
                    <arc:ArcTransformOperationsTransition Property="RenderTransform" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" Tween="Instant" />
                    <arc:ArcBrushTransition Property="Foreground" Tween="Instant" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <!-- The floating toolbar: one raised surface (16px corners, floating shadow). -->
    <ControlTheme x:Key="{x:Type arc:RichTextEditorToolbar}" TargetType="arc:RichTextEditorToolbar">
        <Setter Property="SurfaceBackground" Value="{arc:ArcDesignTokenResource SurfaceRaised}" />
        <Setter Property="SurfaceBorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="SurfaceShadow" Value="{arc:ArcDesignTokenResource ShadowFloating}" />
        <Setter Property="SurfaceRadius" Value="{arc:RichTextEditorTokenResource ToolbarRadius}" />
        <Setter Property="TextElement.FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="TextElement.FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
    </ControlTheme>

    <!-- The slash menu: a 240px raised panel with 18px corners. -->
    <ControlTheme x:Key="{x:Type arc:RichTextEditorSlashMenu}" TargetType="arc:RichTextEditorSlashMenu">
        <Setter Property="SurfaceBackground" Value="{arc:ArcDesignTokenResource SurfaceRaised}" />
        <Setter Property="SurfaceBorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="SurfaceShadow" Value="{arc:ArcDesignTokenResource ShadowFloating}" />
        <Setter Property="SurfaceRadius" Value="{arc:RichTextEditorTokenResource SlashMenuRadius}" />
        <Setter Property="HighlightBrush" Value="{arc:RichTextEditorTokenResource SlashHighlightColor}" />
    </ControlTheme>

    <ControlTheme x:Key="{x:Type arc:RichTextEditorSlashRow}" TargetType="arc:RichTextEditorSlashRow">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Height" Value="{arc:RichTextEditorTokenResource SlashRowHeight}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:RichTextEditorSlashRow">
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{arc:RichTextEditorTokenResource SlashRowRadius}"
                        Padding="10,0">
                    <Grid ColumnDefinitions="20,*,Auto" VerticalAlignment="Center">
                        <arc:ArcGlyph Data="{TemplateBinding Icon}"
                                      Size="16"
                                      StrokeThickness="1.75"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Margin="10,0"
                                   Text="{TemplateBinding Label}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{TemplateBinding Hint}"
                                   Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                   FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:active">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
