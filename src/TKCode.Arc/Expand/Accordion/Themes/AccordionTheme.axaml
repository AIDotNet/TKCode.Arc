<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
                    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type arc:Accordion}" TargetType="arc:Accordion">
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:Accordion">
                <Border BorderThickness="{arc:AccordionTokenResource ListBorderThickness}"
                        BorderBrush="{arc:ArcDesignTokenResource Border}"
                        Background="{TemplateBinding Background}">
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
    </ControlTheme>
</ResourceDictionary>
