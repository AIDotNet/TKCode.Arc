<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.ResizablePanelsTheme">
    <ControlTheme x:Key="{x:Type arc:ResizablePanels}" TargetType="arc:ResizablePanels">
        <Setter Property="HandleLineBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="HandleLineHotBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        <Setter Property="GripBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        <Setter Property="GripActiveBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="RestoreFill" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="RestoreStroke" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="RestoreStrokeHot" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        <Setter Property="RestoreGlyph" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="RestoreGlyphHot" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="RestoreShadow" Value="{arc:ArcDesignTokenResource ShadowResting}" />
        <Setter Property="TextElement.FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="TextElement.FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="TextElement.Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Style Selector="^:resizing">
            <Setter Property="Cursor" Value="SizeWestEast" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
