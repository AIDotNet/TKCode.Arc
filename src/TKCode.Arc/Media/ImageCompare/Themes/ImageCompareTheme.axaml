<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    xmlns:atom="https://atomui.net"
                    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type arc:ImageCompare}" TargetType="arc:ImageCompare">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:ImageCompare">
                <Border Name="PART_Frame"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <Panel>
                        <!-- The result fills the frame; the original sits on top, cut by the divider (a render clip). -->
                        <Panel Name="PART_AfterLayer">
                            <ContentPresenter Name="PART_AfterContent"
                                              Content="{TemplateBinding After}"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Stretch" />
                            <atom:AsyncImage Name="PART_AfterImage"
                                             Source="{TemplateBinding AfterSource}"
                                             Stretch="UniformToFill" />
                        </Panel>
                        <Panel Name="PART_BeforeLayer">
                            <ContentPresenter Name="PART_BeforeContent"
                                              Content="{TemplateBinding Before}"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Stretch" />
                            <atom:AsyncImage Name="PART_BeforeImage"
                                             Source="{TemplateBinding BeforeSource}"
                                             Stretch="UniformToFill" />
                        </Panel>
                        <!-- Captions sit on a frosted chip so they read over any photo, below the divider. -->
                        <Border Name="PART_BeforeChip"
                                Classes="chip"
                                IsVisible="{TemplateBinding ShowLabels}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                            <TextBlock Text="{TemplateBinding BeforeLabel}" />
                        </Border>
                        <Border Name="PART_AfterChip"
                                Classes="chip"
                                IsVisible="{TemplateBinding ShowLabels}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                            <TextBlock Text="{TemplateBinding AfterLabel}" />
                        </Border>
                        <Border Name="PART_AfterBottomChip"
                                Classes="chip"
                                IsVisible="{TemplateBinding ShowLabels}"
                                Opacity="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom">
                            <TextBlock Text="{TemplateBinding AfterLabel}" />
                        </Border>
                        <arc:ImageCompareDivider Name="PART_Divider"
                                                 LineBrush="{arc:ImageCompareTokenResource DividerColor}"
                                                 EdgeBrush="{arc:ImageCompareTokenResource DividerEdgeColor}" />
                        <arc:ImageCompareHandle Name="PART_Handle"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top" />
                        <!-- A hairline keeps light photos from bleeding into the page. -->
                        <Border Name="PART_Hairline"
                                IsHitTestVisible="False"
                                BorderThickness="1"
                                BorderBrush="{arc:ImageCompareTokenResource HairlineColor}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="Cursor" Value="SizeWestEast" />
        <!-- The height comes from the aspect ratio, not from the parent. -->
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="ClipToBounds" Value="False" />
        <Style Selector="^[Orientation=Vertical]">
            <Setter Property="Cursor" Value="SizeNorthSouth" />
        </Style>

        <Style Selector="^ /template/ Border.chip">
            <Setter Property="Margin" Value="{arc:ImageCompareTokenResource ChipMargin}" />
            <Setter Property="Padding" Value="{arc:ImageCompareTokenResource ChipPadding}" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
            <Setter Property="Background" Value="{arc:ImageCompareTokenResource ChipBackground}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <!-- Captions are decoration (aria-hidden); the images carry their own names. -->
            <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
        </Style>
        <Style Selector="^ /template/ Border.chip > TextBlock">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
            <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
            <Setter Property="LineHeight" Value="{arc:ImageCompareTokenResource ChipLineHeight}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>

        <Style Selector="^ /template/ arc|ImageCompareHandle#PART_Handle">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Setter Property="BoxShadow" Value="{arc:ArcDesignTokenResource ShadowRaised}" />
            <Setter Property="FocusRingBrush" Value="{arc:ArcDesignTokenResource FocusRing}" />
        </Style>
        <!-- Hover hint: the handle border strengthens while the pointer is over the frame. -->
        <Style Selector="^:pointerover /template/ arc|ImageCompareHandle#PART_Handle">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        </Style>

        <Style Selector="^ /template/ atom|AsyncImage">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:before-image /template/ atom|AsyncImage#PART_BeforeImage">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:after-image /template/ atom|AsyncImage#PART_AfterImage">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <!-- Set only while a picture is still downloading after mount, so cached pictures never fade. -->
        <Style Selector="^:before-loading /template/ atom|AsyncImage#PART_BeforeImage">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Effect">
                <BlurEffect Radius="4" />
            </Setter>
        </Style>
        <Style Selector="^:after-loading /template/ atom|AsyncImage#PART_AfterImage">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Effect">
                <BlurEffect Radius="4" />
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced /template/ atom|AsyncImage">
            <Setter Property="Effect" Value="{x:Null}" />
        </Style>

        <Style Selector="^:motion-full">
            <Style Selector="^ /template/ arc|ImageCompareHandle#PART_Handle">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcBrushTransition Property="BorderBrush" Tween="Fast" />
                    </Transitions>
                </Setter>
            </Style>
            <!-- Only the arrival fades (from a soft blur); a new download starts hidden at once. -->
            <Style Selector="^:not(:before-loading) /template/ atom|AsyncImage#PART_BeforeImage">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcDoubleTransition Property="Opacity" Tween="Enter" />
                        <arc:ArcEffectTransition Property="Effect" Tween="Enter" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^:not(:after-loading) /template/ atom|AsyncImage#PART_AfterImage">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcDoubleTransition Property="Opacity" Tween="Enter" />
                        <arc:ArcEffectTransition Property="Effect" Tween="Enter" />
                    </Transitions>
                </Setter>
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
