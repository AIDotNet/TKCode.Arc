<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type arc:ToastStack}" TargetType="arc:ToastStack">
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:ToastStack">
                <Panel>
                    <arc:ToastStackPanel Name="PART_List" />
                    <arc:MessagesLiveRegion Name="PART_PoliteRegion" />
                    <arc:MessagesLiveRegion Name="PART_AssertiveRegion" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Setter Property="MaxListWidth" Value="{arc:ToastStackTokenResource MaxListWidth}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="ClipToBounds" Value="False" />

    </ControlTheme>

    <!-- One toast card of a ToastStack: the card itself is drawn by the item at its animated height. -->
    <ControlTheme x:Key="{x:Type arc:ToastStackItem}" TargetType="arc:ToastStackItem">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="CardBackground" Value="{arc:ArcDesignTokenResource SurfaceRaised}" />
        <Setter Property="CardBorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="CardShadow" Value="{arc:ArcDesignTokenResource ShadowRaised}" />
        <Setter Property="CardRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:ToastStackItem">
                <Border Name="PART_Content"
                        Margin="1"
                        Background="Transparent"
                        Padding="{arc:ToastStackTokenResource ContentPadding}">
                    <Grid Name="PART_Layout" ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
                        <arc:MessagesGlyphSwap Name="PART_Icon"
                                               Width="{arc:ToastStackTokenResource IconSlotWidth}"
                                               Height="{arc:ToastStackTokenResource IconSlotHeight}"
                                               Margin="{arc:ToastStackTokenResource IconMargin}"
                                               VerticalAlignment="Top"
                                               Data="{TemplateBinding Glyph}"
                                               IsSpinner="{TemplateBinding IsLoading}"
                                               GlyphSize="18"
                                               StrokeThickness="1.75"
                                               SpinnerSize="15" />
                        <StackPanel Name="PART_Copy" Grid.Column="1">
                            <arc:MessagesTextSwap Name="PART_Title"
                                                  Text="{TemplateBinding Title}"
                                                  TextWrapping="Wrap"
                                                  LineHeight="{arc:ToastStackTokenResource CopyLineHeight}"
                                                  TextElement.FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                  TextElement.FontWeight="{arc:ArcDesignTokenResource WeightMedium}" />
                            <arc:MessagesTextSwap Name="PART_Description"
                                                  Text="{TemplateBinding Description}"
                                                  Margin="{TemplateBinding DescriptionMargin}"
                                                  TextWrapping="Wrap"
                                                  LineHeight="{arc:ToastStackTokenResource CopyLineHeight}"
                                                  TextElement.FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                  TextElement.Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        </StackPanel>
                        <!-- The action folds its width away when an update removes it, so the copy widens instead of snapping. -->
                        <arc:MessagesPresenceFrame Name="PART_ActionFrame"
                                                   Grid.Column="2"
                                                   Orientation="Horizontal"
                                                   IsOpen="{TemplateBinding HasAction}"
                                                   VerticalAlignment="Top">
                            <arc:Button Name="PART_Action"
                                        Classes="toast-action"
                                        Variant="Secondary"
                                        Size="Small"
                                        Content="{TemplateBinding ActionLabel}" />
                        </arc:MessagesPresenceFrame>
                        <arc:Button Name="PART_Close"
                                    Classes="toast-close"
                                    Grid.Column="3"
                                    Variant="Ghost"
                                    VerticalAlignment="Top">
                            <arc:ArcGlyph Data="{x:Static arc:MessagesIcons.X}" Size="16" StrokeThickness="1.75" />
                        </arc:Button>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <!-- The front toast and an open stack float; tucked toasts sit a step back in tone as well as scale. -->
        <Style Selector="^:front">
            <Setter Property="CardShadow" Value="{arc:ArcDesignTokenResource ShadowFloating}" />
        </Style>
        <Style Selector="^:expanded">
            <Setter Property="CardShadow" Value="{arc:ArcDesignTokenResource ShadowFloating}" />
        </Style>
        <Style Selector="^:tucked">
            <Setter Property="CardBackground" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:dragging">
            <Setter Property="Cursor" Value="SizeWestEast" />
        </Style>

        <Style Selector="^ /template/ arc|MessagesGlyphSwap#PART_Icon">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="^[Kind=Success] /template/ arc|MessagesGlyphSwap#PART_Icon">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Success}" />
        </Style>
        <Style Selector="^[Kind=Info] /template/ arc|MessagesGlyphSwap#PART_Icon">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
        </Style>
        <Style Selector="^[Kind=Warning] /template/ arc|MessagesGlyphSwap#PART_Icon">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Warning}" />
        </Style>
        <Style Selector="^[Kind=Error] /template/ arc|MessagesGlyphSwap#PART_Icon">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
        </Style>

        <Style Selector="^ /template/ arc|MessagesPresenceFrame#PART_ActionFrame">
            <Setter Property="Margin" Value="{arc:ToastStackTokenResource ActionSlotMargin}" />
        </Style>
        <Style Selector="^ /template/ arc|Button#PART_Action">
            <Setter Property="Margin" Value="{arc:ToastStackTokenResource ActionMargin}" />
        </Style>

        <!-- A narrow card keeps its copy wide: the action drops under the copy instead of squeezing it. -->
        <Style Selector="^:narrow /template/ arc|MessagesPresenceFrame#PART_ActionFrame">
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="{arc:ToastStackTokenResource NarrowActionSlotMargin}" />
        </Style>
        <Style Selector="^:narrow /template/ arc|Button#PART_Action">
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="^ /template/ arc|Button.toast-action">
            <Setter Property="Height" Value="{arc:ToastStackTokenResource ActionHeight}" />
            <Setter Property="MinHeight" Value="{arc:ToastStackTokenResource ActionHeight}" />
            <Setter Property="Padding" Value="{arc:ToastStackTokenResource ActionPadding}" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        </Style>
        <Style Selector="^ /template/ arc|Button.toast-action:pointerover">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        </Style>
        <Style Selector="^ /template/ arc|Button.toast-close">
            <Setter Property="Width" Value="{arc:ToastStackTokenResource CloseDiameter}" />
            <Setter Property="Height" Value="{arc:ToastStackTokenResource CloseDiameter}" />
            <Setter Property="MinHeight" Value="{arc:ToastStackTokenResource CloseDiameter}" />
            <Setter Property="Margin" Value="{arc:ToastStackTokenResource CloseMargin}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="^ /template/ arc|Button.toast-close:pointerover">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>

        <!-- Card tone changes ease over standard; the icon color over fast. Reduced motion switches at once. -->
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="CardBackground" Tween="Standard" />
                    <arc:ArcBrushTransition Property="CardBorderBrush" Tween="Standard" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-full /template/ arc|MessagesGlyphSwap#PART_Icon">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
