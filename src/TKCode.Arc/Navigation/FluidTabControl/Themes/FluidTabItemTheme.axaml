<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.FluidTabItemTheme">
    <ControlTheme x:Key="{x:Type arc:FluidTabItem}" TargetType="arc:FluidTabItem">
        <!-- Arc draws its own focus ring; suppress the window's default focus adorner. -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:FluidTabItem">
                <!-- The focus ring is built by the tab the first time it is keyboard focused and hosted over this frame.
                     The tab's content is not shown here: FluidTabControl shows it as the tab's section. -->
                <Border Name="PART_Frame"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{arc:FluidTabItemTokenResource ItemRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="Auto,*">
                        <ContentPresenter Name="PART_IconPresenter"
                                          VerticalAlignment="Center"
                                          IsVisible="False"
                                          Content="{TemplateBinding Icon}"
                                          ContentTemplate="{TemplateBinding IconTemplate}" />
                        <ContentPresenter Name="PART_HeaderPresenter"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Setter Property="MinHeight" Value="{arc:ArcDesignTokenResource ControlSizeSM}" />
        <Setter Property="Padding" Value="{arc:FluidTabItemTokenResource InlinePadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ClipToBounds" Value="False" />

        <Style Selector="^:has-icon /template/ ContentPresenter#PART_IconPresenter">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Margin" Value="{arc:FluidTabItemTokenResource IconMargin}" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentStrong}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="{arc:FluidTabItemTokenResource DisabledOpacity}" />
            <Setter Property="Cursor" Value="No" />
        </Style>

        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" />
                    <arc:ArcBrushTransition Property="Background" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
