<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.TabsTheme">
    <ControlTheme x:Key="{x:Type arc:Tabs}" TargetType="arc:Tabs">
        <!-- Arc draws its own focus ring; suppress the window's default focus adorner. -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ContentMargin" Value="{arc:TabsTokenResource ContentMargin}" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="{arc:ArcDesignTokenResource Space1}" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:Tabs">
                <StackPanel Orientation="Vertical">
                    <Border Name="PART_ListShell"
                            HorizontalAlignment="Left"
                            BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
                            BorderBrush="{arc:ArcDesignTokenResource Border}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                            Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                            ClipToBounds="True">
                        <!-- The scroll buttons (PART_ScrollLeft, PART_ScrollRight) are built in code the first time the list
                             overflows; most tab lists never do. -->
                        <Panel>
                            <ScrollViewer Name="PART_ListViewport"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          BringIntoViewOnFocusChange="False">
                                <arc:TabsListPanel Name="PART_ListPanel" Margin="{arc:TabsTokenResource ListPadding}">
                                    <arc:GlidingIndicator Name="PART_SelectionPill"
                                                          Fill="{arc:ArcDesignTokenResource Surface}"
                                                          Stroke="{arc:ArcDesignTokenResource Border}"
                                                          StrokeThickness="1"
                                                          CornerRadius="{arc:TabsTokenResource PillRadius}"
                                                          BoxShadow="{arc:ArcDesignTokenResource ShadowResting}"
                                                          Spring="Morph" />
                                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                                </arc:TabsListPanel>
                            </ScrollViewer>
                        </Panel>
                    </Border>
                    <arc:TabsPanelHost Name="PART_ContentHost"
                                       Margin="{TemplateBinding ContentMargin}"
                                       TextElement.Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                       TextElement.FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                       TextBlock.LineHeight="{arc:TabsTokenResource ContentLineHeight}"
                                       FocusRingBrush="{arc:ArcDesignTokenResource FocusRing}"
                                       FocusRingRadius="{arc:TabsTokenResource ContentFocusRingRadius}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>

        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />

    </ControlTheme>
</ResourceDictionary>
