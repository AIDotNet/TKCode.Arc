<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal">
    <!-- The declarative dialog renders nothing in place; its DialogSurface is shown on the overlay layer. -->
    <ControlTheme x:Key="{x:Type arc:Dialog}" TargetType="arc:Dialog">
        <Setter Property="ScrimBrush" Value="{arc:DialogTokenResource ScrimColor}" />
        <Setter Property="BackdropBlur" Value="{arc:ArcDesignTokenResource BackdropBlurDialog}" />
    </ControlTheme>
</ResourceDictionary>
