<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.DrawerTheme">
    <!-- The declarative drawer renders nothing in place; its DrawerSurface slides in on the overlay layer. -->
    <ControlTheme x:Key="{x:Type arc:Drawer}" TargetType="arc:Drawer">
        <Setter Property="ScrimBrush" Value="{arc:DrawerTokenResource ScrimColor}" />
        <Setter Property="BackdropBlur" Value="{arc:ArcDesignTokenResource BackdropBlurDrawer}" />
    </ControlTheme>
</ResourceDictionary>
