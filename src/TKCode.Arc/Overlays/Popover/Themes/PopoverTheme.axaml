<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
                    x:ClassModifier="internal">
    <!-- In place the popover shows only its Trigger; its Content opens in an anchored PopoverSurface. -->
    <ControlTheme x:Key="{x:Type arc:Popover}" TargetType="arc:Popover">
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:Popover">
                <ContentPresenter Name="PART_TriggerPresenter" Content="{TemplateBinding Trigger}" />
            </ControlTemplate>
        </Setter>
        <Setter Property="Offset" Value="{arc:PopoverTokenResource SideOffset}" />
    </ControlTheme>
</ResourceDictionary>
