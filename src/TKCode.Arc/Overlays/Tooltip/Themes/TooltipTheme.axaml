<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
                    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type arc:Tooltip}" TargetType="arc:Tooltip">
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:Tooltip">
                <Border Name="PART_Frame"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        MaxWidth="{arc:TooltipTokenResource BubbleMaxWidth}">
                    <arc:SpringSizeDecorator Axis="Both" Spring="Morph" IsExpanded="True" ClipOverflow="8">
                        <arc:ArcContentSwap Name="PART_Content"
                                            Mode="BlurSwap"
                                            HorizontalContentAlignment="Left"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </arc:SpringSizeDecorator>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="ContentTemplate">
            <arc:TooltipTextTemplate />
        </Setter>
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Background}" />
        <Setter Property="BorderBrush" Value="{arc:TooltipTokenResource BubbleBorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusControl}" />
        <Setter Property="Padding" Value="{arc:TooltipTokenResource BubblePadding}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightRegular}" />
    </ControlTheme>
</ResourceDictionary>
