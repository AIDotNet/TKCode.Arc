<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.CascaderTheme">
    <ControlTheme x:Key="{x:Type arc:Cascader}" TargetType="arc:Cascader">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:Cascader">
                <StackPanel Spacing="{arc:ArcDesignTokenResource Space2}">
                    <TextBlock Name="PART_Label"
                               Text="{TemplateBinding Label}"
                               IsVisible="{TemplateBinding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                               FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                    <Panel>
                        <TextBlock Name="PART_Announcer"
                                   Width="1"
                                   Height="1"
                                   Opacity="0"
                                   IsHitTestVisible="False"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Border Name="PART_Trigger"
                                MinHeight="{arc:ArcDesignTokenResource ControlSizeMD}"
                                Padding="{arc:CascaderTokenResource TriggerPadding}"
                                BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
                                CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                Background="{arc:ArcDesignTokenResource Surface}"
                                BorderBrush="{arc:ArcDesignTokenResource Border}"
                                Cursor="Hand">
                            <DockPanel>
                                <arc:ArcGlyph Name="PART_Chevron"
                                              DockPanel.Dock="Right"
                                              Data="{x:Static arc:ArcIcons.ChevronDown}"
                                              Size="16"
                                              Margin="12,0,0,0"
                                              VerticalAlignment="Center"
                                              RenderTransformOrigin="50%,50%"
                                              RenderTransform="rotate(0deg)"
                                              Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                <arc:PresenceHost Name="PART_ClearHost"
                                                  DockPanel.Dock="Right"
                                                  Mode="Pop"
                                                  EnterScale="0.6"
                                                  Spring="Snappy"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center">
                                    <Button Name="PART_Clear"
                                            Width="{arc:CascaderTokenResource ClearButtonSize}"
                                            Height="{arc:CascaderTokenResource ClearButtonSize}"
                                            Padding="0"
                                            Background="Transparent"
                                            Cursor="Hand"
                                            AutomationProperties.Name="Clear selection">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Panel>
                                                    <Border Name="PART_ClearRing"
                                                            Margin="-3"
                                                            CornerRadius="{arc:CascaderTokenResource ClearRingRadius}"
                                                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                                                            BorderBrush="{TemplateBinding BorderBrush}" />
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="{arc:CascaderTokenResource ClearGlyphRadius}">
                                                        <arc:ArcGlyph Data="{x:Static arc:SelectGlyphs.X}"
                                                                      Size="16"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="{TemplateBinding Foreground}" />
                                                    </Border>
                                                </Panel>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </arc:PresenceHost>
                                <arc:SelectValueRoll Name="PART_Value"
                                                     VerticalAlignment="Center"
                                                     EnterTravel="0.35"
                                                     ExitTravel="0.3"
                                                     Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                     PlaceholderForeground="{arc:ArcDesignTokenResource TextMuted}" />
                            </DockPanel>
                        </Border>
                        <Border Name="PART_FocusRing"
                                IsVisible="False"
                                IsHitTestVisible="False"
                                Margin="{arc:CascaderTokenResource FocusRingMargin}"
                                BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                                CornerRadius="{arc:CascaderTokenResource FocusRingRadius}"
                                BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                        <arc:ArcPopup Name="PART_Popup"
                                      Placement="Bottom"
                                      MarginToAnchor="4"
                                      EnterOffset="6"
                                      EnterScale="0.97"
                                      IsExitInstant="True"
                                      IsLightDismissEnabled="True"
                                      TakesFocusFromNativeControl="False"
                                      WindowManagerAddShadowHint="False">
                            <Border Name="PART_Surface"
                                    Padding="{arc:CascaderTokenResource MenuPadding}"
                                    BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
                                    CornerRadius="{arc:CascaderTokenResource MenuCornerRadius}"
                                    Background="{arc:ArcDesignTokenResource SurfaceRaised}"
                                    BorderBrush="{arc:ArcDesignTokenResource Border}">
                                <arc:CascaderColumnsPanel Name="PART_Columns"
                                                          RowHeight="{arc:CascaderTokenResource OptionHeight}"
                                                          RowCornerRadius="{arc:CascaderTokenResource OptionCornerRadius}"
                                                          RowPadding="{arc:CascaderTokenResource OptionPadding}"
                                                          ChevronInset="{arc:CascaderTokenResource ChevronInset}"
                                                          DisabledOpacity="{arc:CascaderTokenResource OptionDisabledOpacity}"
                                                          MinColumnWidth="{arc:CascaderTokenResource MinColumnWidth}"
                                                          MaxColumnWidth="{arc:CascaderTokenResource MaxColumnWidth}"
                                                          ColumnGap="{arc:CascaderTokenResource ColumnGap}"
                                                          HighlightBrush="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                          PathBrush="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                          Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                          MutedForeground="{arc:ArcDesignTokenResource TextMuted}"
                                                          DividerBrush="{arc:ArcDesignTokenResource Border}" />
                            </Border>
                        </arc:ArcPopup>
                    </Panel>
                    <TextBlock Name="PART_Description"
                               Text="{TemplateBinding Description}"
                               IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap"
                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                               Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>

        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />

        <!-- Hover, press and open answer in color only: the trigger anchors the menu and never scales. -->
        <Style Selector="^ /template/ Border#PART_Trigger:pointerover">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#PART_Trigger, ^:open /template/ Border#PART_Trigger">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_Trigger">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:open /template/ arc|ArcGlyph#PART_Chevron">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <Style Selector="^ /template/ Button#PART_Clear">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="^ /template/ Button#PART_Clear:pointerover">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^ /template/ Button#PART_Clear:focus-visible">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource FocusRing}" />
        </Style>
        <Style Selector="^:readonly /template/ arc|ArcGlyph#PART_Chevron">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="^:disabled /template/ Border#PART_Trigger">
            <Setter Property="Opacity" Value="{arc:CascaderTokenResource DisabledOpacity}" />
            <Setter Property="Cursor" Value="No" />
        </Style>

        <Style Selector="^:motion-full">
            <Style Selector="^ /template/ Border#PART_Trigger">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcBrushTransition Property="Background" />
                        <arc:ArcBrushTransition Property="BorderBrush" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ arc|ArcGlyph#PART_Chevron">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcTransformOperationsTransition Property="RenderTransform" Tween="Spring" />
                    </Transitions>
                </Setter>
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
