<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.ComboboxTheme">
    <ControlTheme x:Key="{x:Type arc:Combobox}" TargetType="arc:Combobox">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:Combobox">
                <StackPanel Spacing="{arc:ArcDesignTokenResource Space2}">
                    <TextBlock Name="PART_Label"
                               Text="{TemplateBinding Label}"
                               IsVisible="{TemplateBinding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                               FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                    <Panel>
                        <TextBlock Name="PART_Announcer"
                                   Width="1"
                                   Height="1"
                                   Opacity="0"
                                   IsHitTestVisible="False"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Border Name="PART_Frame"
                                Padding="{arc:ComboboxTokenResource FieldPadding}"
                                BorderThickness="{arc:ArcDesignTokenResource EdgeThickness}"
                                CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                Background="{arc:ArcDesignTokenResource Surface}"
                                BorderBrush="{arc:ArcDesignTokenResource Border}">
                            <DockPanel>
                                <arc:ArcGlyph DockPanel.Dock="Left"
                                              Data="{x:Static arc:ArcIcons.Search}"
                                              Size="16"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                <arc:ArcGlyph Name="PART_Chevron"
                                              DockPanel.Dock="Right"
                                              Data="{x:Static arc:ArcIcons.ChevronDown}"
                                              Size="16"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center"
                                              RenderTransformOrigin="50%,50%"
                                              RenderTransform="rotate(0deg)"
                                              Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                <arc:PresenceHost Name="PART_ClearHost"
                                                  DockPanel.Dock="Right"
                                                  Mode="Pop"
                                                  EnterScale="0.6"
                                                  Spring="Snappy"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center">
                                    <Button Name="PART_Clear"
                                            Width="{arc:ComboboxTokenResource ClearButtonSize}"
                                            Height="{arc:ComboboxTokenResource ClearButtonSize}"
                                            Padding="0"
                                            Background="Transparent"
                                            Cursor="Hand"
                                            ClipToBounds="False"
                                            RenderTransformOrigin="50%,50%"
                                            RenderTransform="scale(1)"
                                            AutomationProperties.Name="Clear selection">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Panel>
                                                    <Border Name="PART_ClearRing"
                                                            Margin="-3"
                                                            CornerRadius="{arc:ComboboxTokenResource ClearRingRadius}"
                                                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                                                            BorderBrush="{TemplateBinding BorderBrush}" />
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="{arc:ComboboxTokenResource ClearGlyphRadius}">
                                                        <arc:ArcGlyph Data="{x:Static arc:SelectGlyphs.X}"
                                                                      Size="16"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Foreground="{TemplateBinding Foreground}" />
                                                    </Border>
                                                </Panel>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </arc:PresenceHost>
                                <Decorator Name="PART_InputHost" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </Panel>
                    <TextBlock Name="PART_Description"
                               Text="{TemplateBinding Description}"
                               IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap"
                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                               Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                    <arc:ArcPopup Name="PART_Popup"
                                  Placement="Bottom"
                                  MarginToAnchor="{arc:ComboboxTokenResource PopoverOffset}"
                                  EnterOffset="6"
                                  EnterScale="0.97"
                                  IsLightDismissEnabled="True"
                                  TakesFocusFromNativeControl="False"
                                  WindowManagerAddShadowHint="False" />
                </StackPanel>
            </ControlTemplate>
        </Setter>

        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />

        <!-- Size: the trigger height of the text fields (Small 36, Medium 44, Large 50). -->
        <Style Selector="^ /template/ Border#PART_Frame">
            <Setter Property="MinHeight" Value="{arc:ArcDesignTokenResource ControlSizeMD}" />
        </Style>
        <Style Selector="^[Size=Small] /template/ Border#PART_Frame">
            <Setter Property="MinHeight" Value="{arc:ArcDesignTokenResource ControlSizeSM}" />
        </Style>
        <Style Selector="^[Size=Large] /template/ Border#PART_Frame">
            <Setter Property="MinHeight" Value="{arc:ArcDesignTokenResource ControlSizeLG}" />
        </Style>

        <Style Selector="^ /template/ Border#PART_Frame:pointerover">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <!-- Arc's focused combobox only strengthens its border (BorderStrong); its 3px halo is transparent. -->
        <Style Selector="^:focus-within /template/ Border#PART_Frame">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        </Style>
        <Style Selector="^:open /template/ Border#PART_Frame">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:open /template/ arc|ArcGlyph#PART_Chevron">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <Style Selector="^:disabled /template/ Border#PART_Frame">
            <Setter Property="Opacity" Value="{arc:ComboboxTokenResource DisabledOpacity}" />
            <Setter Property="Cursor" Value="No" />
        </Style>

        <Style Selector="^ /template/ Button#PART_Clear">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="^ /template/ Button#PART_Clear:pointerover">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^ /template/ Button#PART_Clear:focus-visible">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource FocusRing}" />
        </Style>

        <Style Selector="^:motion-full">
            <Style Selector="^ /template/ Border#PART_Frame">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcBrushTransition Property="Background" />
                        <arc:ArcBrushTransition Property="BorderBrush" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ arc|ArcGlyph#PART_Chevron">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcTransformOperationsTransition Property="RenderTransform" Tween="Spring" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ Button#PART_Clear">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcBrushTransition Property="Background" />
                        <arc:ArcBrushTransition Property="Foreground" />
                        <arc:ArcTransformOperationsTransition Property="RenderTransform" Tween="Instant" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ Button#PART_Clear:pressed">
                <Setter Property="RenderTransform" Value="scale(0.96)" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
