<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type arc:Select}" TargetType="arc:Select">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:Select">
                <StackPanel Spacing="{arc:ArcDesignTokenResource Space2}">
                    <TextBlock Name="PART_Label"
                               Text="{TemplateBinding Label}"
                               IsVisible="{TemplateBinding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               FontSize="{arc:ArcDesignTokenResource TypeSM}"
                               FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                    <Panel>
                        <TextBlock Name="PART_Announcer"
                                   Width="1"
                                   Height="1"
                                   Opacity="0"
                                   IsHitTestVisible="False"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Border Name="PART_Trigger"
                                MinHeight="{arc:ArcDesignTokenResource ControlSizeMD}"
                                Padding="{arc:SelectTokenResource TriggerPadding}"
                                BorderThickness="1"
                                CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                Background="{arc:ArcDesignTokenResource Surface}"
                                BorderBrush="{arc:ArcDesignTokenResource Border}"
                                Cursor="Hand">
                            <DockPanel>
                                <arc:ArcGlyph Name="PART_Chevron"
                                              DockPanel.Dock="Right"
                                              Data="{x:Static arc:ArcIcons.ChevronDown}"
                                              Size="16"
                                              Margin="12,0,0,0"
                                              VerticalAlignment="Center"
                                              RenderTransformOrigin="50%,50%"
                                              RenderTransform="rotate(0deg)"
                                              Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                <arc:SelectValueRoll Name="PART_Value"
                                                     VerticalAlignment="Center"
                                                     EnterTravel="0.35"
                                                     ExitTravel="0.3"
                                                     Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                     PlaceholderForeground="{arc:ArcDesignTokenResource TextMuted}" />
                            </DockPanel>
                        </Border>
                        <Border Name="PART_FocusRing"
                                IsVisible="False"
                                IsHitTestVisible="False"
                                Margin="{arc:SelectTokenResource FocusRingMargin}"
                                BorderThickness="2"
                                CornerRadius="{arc:SelectTokenResource FocusRingRadius}"
                                BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                        <arc:ArcPopup Name="PART_Popup"
                                      Placement="Bottom"
                                      MarginToAnchor="4"
                                      EnterOffset="6"
                                      EnterScale="0.97"
                                      IsLightDismissEnabled="True"
                                      TakesFocusFromNativeControl="False"
                                      WindowManagerAddShadowHint="False">
                            <Border Name="PART_Surface"
                                    Padding="{arc:SelectTokenResource MenuPadding}"
                                    BorderThickness="1"
                                    CornerRadius="{arc:SelectTokenResource MenuCornerRadius}"
                                    Background="{arc:ArcDesignTokenResource SurfaceRaised}"
                                    BorderBrush="{arc:ArcDesignTokenResource Border}">
                                <DockPanel>
                                    <Border Name="PART_ScrollUp"
                                            DockPanel.Dock="Top"
                                            IsVisible="False"
                                            Background="Transparent"
                                            Height="{arc:SelectTokenResource ScrollButtonHeight}">
                                        <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronUp}"
                                                      Size="16"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                    </Border>
                                    <Border Name="PART_ScrollDown"
                                            DockPanel.Dock="Bottom"
                                            IsVisible="False"
                                            Background="Transparent"
                                            Height="{arc:SelectTokenResource ScrollButtonHeight}">
                                        <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronDown}"
                                                      Size="16"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                    </Border>
                                    <ScrollViewer Name="PART_Scroll"
                                                  Padding="{arc:SelectTokenResource ViewportPadding}"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Hidden">
                                        <arc:SelectOptionView Name="PART_Options"
                                                              RowHeight="{arc:SelectTokenResource OptionHeight}"
                                                              RowCornerRadius="{arc:SelectTokenResource OptionCornerRadius}"
                                                              RowPadding="{arc:SelectTokenResource OptionPadding}"
                                                              CheckInset="{arc:SelectTokenResource IndicatorInset}"
                                                              CheckMode="ScaleIn"
                                                              GlideHighlight="True"
                                                              DisabledOpacity="{arc:SelectTokenResource OptionDisabledOpacity}"
                                                              HighlightBrush="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                              Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                              CheckForeground="{arc:ArcDesignTokenResource Foreground}" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </arc:ArcPopup>
                    </Panel>
                    <TextBlock Name="PART_Description"
                               Text="{TemplateBinding Description}"
                               IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap"
                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                               Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>

        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />

        <!-- Hover, press and open answer in color only: the trigger anchors the menu and never scales. -->
        <Style Selector="^ /template/ Border#PART_Trigger:pointerover">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:pressed /template/ Border#PART_Trigger, ^:open /template/ Border#PART_Trigger">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_Trigger">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:open /template/ arc|ArcGlyph#PART_Chevron">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <Style Selector="^:disabled /template/ Border#PART_Trigger">
            <Setter Property="Opacity" Value="{arc:SelectTokenResource DisabledOpacity}" />
            <Setter Property="Cursor" Value="No" />
        </Style>

        <Style Selector="^:motion-full">
            <Style Selector="^ /template/ Border#PART_Trigger">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcBrushTransition Property="Background" />
                        <arc:ArcBrushTransition Property="BorderBrush" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ arc|ArcGlyph#PART_Chevron">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcTransformOperationsTransition Property="RenderTransform" Tween="Spring" />
                    </Transitions>
                </Setter>
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
