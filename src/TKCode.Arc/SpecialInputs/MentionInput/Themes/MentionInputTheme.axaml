<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal">
    <!--
        Arc .field: 1px Border, RadiusControl, Surface; BorderStrong while focused (no hover change); the root fades to
        .55 when disabled. The shell is drawn here rather than with FieldFrame, whose state language differs (BorderStrong
        at rest, Foreground on hover and focus). Its height is driven from code on the smooth spring.
    -->
    <ControlTheme x:Key="{x:Type arc:MentionInput}" TargetType="arc:MentionInput">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:MentionInput">
                <Panel>
                    <Border Name="PART_Shell"
                            BorderThickness="1"
                            VerticalAlignment="Top"
                            ClipToBounds="True">
                        <arc:TokenTextEditor Name="PART_TextBox"
                                             Placeholder="{TemplateBinding Placeholder}"
                                             MinLines="{TemplateBinding MinLines}"
                                             MaxLines="{TemplateBinding MaxLines}"
                                             SubmitOnEnter="{TemplateBinding IsSubmitOnEnter}"
                                             ExpandSelectionToTokens="True"
                                             TokenDecorationBreak="Clone"
                                             VerticalAlignment="Stretch"
                                             ScrollViewer.VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <arc:SpecialInputsLiveRegion Name="PART_LiveRegion" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="SuggestionHighlight" Value="{arc:MentionInputTokenResource SuggestionHighlightFill}" />
        <Setter Property="ChannelTokenFill" Value="{arc:MentionInputTokenResource ChannelTokenFill}" />
        <Setter Property="ChannelTokenForeground" Value="{arc:ArcDesignTokenResource Foreground}" />

        <Style Selector="^ /template/ Border#PART_Shell">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusControl}" />
        </Style>
        <!--
            The shared editor with Arc mention-input metrics: padding 11/14, people tinted AccentSubtle / AccentStrong,
            channels Foreground 7% (a token style from code), tokens padded 1/3 around the glyphs with radius 6, cloned
            per line. Its height springs from code (smooth, 0.4s).
        -->
        <Style Selector="^ /template/ arc|TokenTextEditor#PART_TextBox">
            <Setter Property="Padding" Value="{arc:MentionInputTokenResource EditorPadding}" />
            <Setter Property="LineHeight" Value="{arc:MentionInputTokenResource EditorLineHeight}" />
            <Setter Property="LetterSpacing" Value="{arc:MentionInputTokenResource EditorLetterSpacing}" />
            <Setter Property="TokenFill" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
            <Setter Property="TokenForeground" Value="{arc:ArcDesignTokenResource AccentStrong}" />
            <Setter Property="TokenPadding" Value="{arc:MentionInputTokenResource TokenPadding}" />
            <Setter Property="TokenCornerRadius" Value="{arc:MentionInputTokenResource TokenCornerRadius}" />
            <Setter Property="TokenOutset" Value="0" />
        </Style>
        <Style Selector="^:focus-within /template/ Border#PART_Shell">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="{arc:MentionInputTokenResource DisabledOpacity}" />
        </Style>

        <!-- Arc: border-color and background-color transition fast / standard (kept as short fades when reduced). -->
        <Style Selector="^:motion-full /template/ Border#PART_Shell">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="BorderBrush" />
                    <arc:ArcBrushTransition Property="Background" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced /template/ Border#PART_Shell">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="BorderBrush" />
                    <arc:ArcBrushTransition Property="Background" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

</ResourceDictionary>
