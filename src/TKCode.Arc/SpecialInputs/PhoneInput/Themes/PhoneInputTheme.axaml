<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.PhoneInputTheme">
    <!-- The closed country trigger: no ring; hover, press and keyboard focus read as the same quiet fill. -->
    <ControlTheme x:Key="{x:Type arc:PhoneInputTrigger}" TargetType="arc:PhoneInputTrigger">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PhoneInputTrigger">
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Padding" Value="{arc:PhoneInputTokenResource TriggerPadding}" />
        <Setter Property="CornerRadius" Value="{arc:PhoneInputTokenResource TriggerCornerRadius}" />

        <Style Selector="^:hover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:focus-visible">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="No" />
        </Style>

        <!-- Background on fast + standard ease; Arc keeps it under reduced motion. -->
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Background" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type arc:PhoneInput}" TargetType="arc:PhoneInput">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PhoneInput">
                <Panel>
                    <arc:Field Name="PART_Field"
                               Label="{TemplateBinding Label}"
                               Description="{TemplateBinding DisplayDescription}"
                               ErrorMessage="{TemplateBinding DisplayErrorMessage}"
                               IsLabelVisible="{TemplateBinding IsLabelVisible}">
                        <arc:FieldFrame Name="PART_Frame"
                                        Cursor="IBeam"
                                        Spacing="0"
                                        VerticalContentAlignment="Stretch"
                                        IsInvalid="{TemplateBinding DisplayInvalid}"
                                        IsReadOnly="{TemplateBinding IsReadOnly}"
                                        IsFocusActive="{TemplateBinding IsFocused}">
                            <DockPanel>
                                <!-- The anchor holds the closed trigger's place and springs when the calling code changes length. -->
                                <arc:PhoneInputAnchor Name="PART_Anchor" DockPanel.Dock="Left" Cursor="Hand">
                                    <Panel>
                                        <arc:PhoneInputTrigger Name="PART_Trigger" Margin="{arc:PhoneInputTokenResource TriggerMargin}">
                                            <arc:PhoneInputFace Name="PART_Face"
                                                                Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                TextElement.FontWeight="{arc:ArcDesignTokenResource WeightMedium}" />
                                        </arc:PhoneInputTrigger>
                                        <arc:ArcGlyph Name="PART_Chevron"
                                                      Data="{x:Static arc:ArcIcons.ChevronDown}"
                                                      Size="16"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="{arc:PhoneInputTokenResource ChevronMargin}"
                                                      Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                        <Border Name="PART_Divider"
                                                Width="1"
                                                HorizontalAlignment="Right"
                                                Margin="{arc:PhoneInputTokenResource DividerMargin}"
                                                IsHitTestVisible="False" />
                                    </Panel>
                                </arc:PhoneInputAnchor>
                                <!-- The number and its guide share one box; the valid check sits 12px from the right edge. -->
                                <Panel Name="PART_NumberArea">
                                    <ScrollViewer Name="PART_ScrollViewer"
                                                  Margin="{arc:PhoneInputTokenResource NumberPadding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Disabled"
                                                  BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}">
                                        <Panel>
                                            <arc:PhoneInputGuide Name="PART_Guide"
                                                                 Foreground="{arc:PhoneInputTokenResource GuideColor}"
                                                                 LineHeight="{TemplateBinding LineHeight}"
                                                                 VerticalAlignment="Center" />
                                            <TextPresenter Name="PART_TextPresenter"
                                                           Text="{TemplateBinding Text, Mode=TwoWay}"
                                                           CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                                           CaretIndex="{TemplateBinding CaretIndex}"
                                                           SelectionStart="{TemplateBinding SelectionStart}"
                                                           SelectionEnd="{TemplateBinding SelectionEnd}"
                                                           TextAlignment="{TemplateBinding TextAlignment}"
                                                           TextWrapping="NoWrap"
                                                           LineHeight="{TemplateBinding LineHeight}"
                                                           LetterSpacing="{TemplateBinding LetterSpacing}"
                                                           SelectionBrush="{TemplateBinding SelectionBrush}"
                                                           SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                                           CaretBrush="{TemplateBinding CaretBrush}"
                                                           VerticalAlignment="Center" />
                                        </Panel>
                                    </ScrollViewer>
                                    <arc:PhoneInputPresence Name="PART_Valid"
                                                            Width="{arc:PhoneInputTokenResource ValidSlotSize}"
                                                            Height="{arc:PhoneInputTokenResource ValidSlotSize}"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Margin="{arc:PhoneInputTokenResource ValidMargin}"
                                                            IsHitTestVisible="False">
                                        <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Check}"
                                                      Size="16"
                                                      StrokeThickness="2"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="{arc:ArcDesignTokenResource Success}" />
                                    </arc:PhoneInputPresence>
                                </Panel>
                            </DockPanel>
                        </arc:FieldFrame>
                    </arc:Field>
                    <arc:PhoneInputPopup Name="PART_Popup"
                                         TakesFocusFromNativeControl="False"
                                         WindowManagerAddShadowHint="False" />
                    <arc:SpecialInputsLiveRegion Name="PART_Live" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="LineHeight" Value="{arc:FieldTextBoxTokenResource TextLineHeight}" />
        <Setter Property="CaretBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="SelectionBrush" Value="{arc:FieldTextBoxTokenResource SelectionFill}" />
        <Setter Property="SelectionForegroundBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="OptionHighlight" Value="{arc:PhoneInputTokenResource HighlightColor}" />
        <Setter Property="ControlFill" Value="{arc:PhoneInputTokenResource ControlFillColor}" />

        <!-- The shell: one border, padding 0, the control height. -->
        <Style Selector="^ /template/ arc|FieldFrame#PART_Frame">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Height" Value="{arc:ArcDesignTokenResource ControlSizeMD}" />
        </Style>
        <Style Selector="^ /template/ Border#PART_Divider">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:open /template/ Border#PART_Divider">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <!--
            Arc's shell border: focus on the country button leaves it alone (only the number's focus darkens it);
            invalid shows Danger; hover darkens unless invalid; the number's focus wins over invalid (:has specificity).
        -->
        <Style Selector="^ /template/ arc|FieldFrame#PART_Frame:focus-active">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        </Style>
        <Style Selector="^ /template/ arc|FieldFrame#PART_Frame:invalid">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Danger}" />
        </Style>
        <Style Selector="^ /template/ arc|FieldFrame#PART_Frame:pointerover:not(:invalid):not(:disabled)">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:focus /template/ arc|FieldFrame#PART_Frame">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:disabled /template/ arc|FieldFrame#PART_Frame">
            <Setter Property="Cursor" Value="No" />
        </Style>

        <!-- The divider fades out while open (fast + standard; Arc keeps it under reduced motion). -->
        <Style Selector="^:motion-full /template/ Border#PART_Divider">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:motion-reduced /template/ Border#PART_Divider">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcDoubleTransition Property="Opacity" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
