<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(ArcTargetFrameworks)</TargetFrameworks>
        <AssemblyName>TKCode.Arc</AssemblyName>
        <RootNamespace>TKCode.Arc</RootNamespace>
        <PackageId>TKCode.Arc</PackageId>
        <!-- Core exposes internals to Arc; both assemblies contain generated types with identical names. -->
        <NoWarn>$(NoWarn);CS0436</NoWarn>
        <ArcFoundationGenerator>true</ArcFoundationGenerator>
    </PropertyGroup>
    <ItemGroup>
        <!-- No Markdown or highlighting dependency: TKCode.Arc.Markdown and TKCode.Arc.Highlighting bring them (ADR 0050). -->
        <ProjectReference Include="../TKCode.Arc.Core/TKCode.Arc.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="TKCode.Arc.Tests" />
        <InternalsVisibleTo Include="TKCode.Arc.Blocks.Tests" />
        <InternalsVisibleTo Include="TKCode.Arc.Special.Tests" />
        <InternalsVisibleTo Include="TKCode.Arc.Extras.Tests" />
        <InternalsVisibleTo Include="TKCode.Arc.Integration.Tests" />
        <InternalsVisibleTo Include="TKCode.Arc.Gallery.Tests" />
        <InternalsVisibleTo Include="TKCode.Arc.AdvancedCharts" />
        <!-- The split-out packages (ADR 0050) use the code-highlighting contract, palettes and shared parts. -->
        <InternalsVisibleTo Include="TKCode.Arc.Markdown" />
        <InternalsVisibleTo Include="TKCode.Arc.Highlighting" />
        <!-- Special colors code through the highlighting contract (CodeTokens.CodeTokenHighlighter) without Markdown (#147). -->
        <InternalsVisibleTo Include="TKCode.Arc.Special" />
    </ItemGroup>
</Project>
