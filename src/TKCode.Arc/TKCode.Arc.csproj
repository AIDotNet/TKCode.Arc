<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>$(ArcTargetFrameworks)</TargetFrameworks>
        <AssemblyName>TKCode.Arc</AssemblyName>
        <RootNamespace>TKCode.Arc</RootNamespace>
        <PackageId>TKCode.Arc</PackageId>
        <!-- Core exposes internals to Arc; both assemblies contain generated types with identical names. -->
        <NoWarn>$(NoWarn);CS0436</NoWarn>
        <ArcFoundationGenerator>true</ArcFoundationGenerator>
    </PropertyGroup>
    <ItemGroup>
        <!-- Markdown rendering and TextMate code highlighting (ADR 0011); brings StreamMark.Avalonia and StreamMark.Core. -->
        <PackageReference Include="TKCode.StreamMark.Highlighting.TextMate" />
        <ProjectReference Include="../TKCode.Arc.Core/TKCode.Arc.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="TKCode.Arc.Tests" />
    </ItemGroup>
</Project>
