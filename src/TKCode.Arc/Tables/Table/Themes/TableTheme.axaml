<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.TableTheme">
    <ControlTheme x:Key="{x:Type arc:Table}" TargetType="arc:Table">
        <!-- Arc draws its own focus ring; suppress the window's default focus adorner. -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:Table">
                <Panel>
                <Border Name="PART_Frame"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <!-- PART_Loading (the veil, spinner and message over the body) and PART_Footer (the count line with
                         PART_Clear) are built by the table the first time IsLoading / IsSelectable is true; most tables
                         never show them, and the two subtrees were about 25 template nodes per instance. -->
                    <Grid Name="PART_Body" RowDefinitions="*,Auto">
                        <ScrollViewer Name="PART_ScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto" />
                        <TextBlock Name="PART_Announcer"
                                   Grid.RowSpan="2"
                                   Width="1"
                                   Height="1"
                                   Opacity="0"
                                   IsHitTestVisible="False"
                                   ClipToBounds="True"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                </Border>
                <!-- The outline is drawn over the clipped content so cells never cover its rounded corners. -->
                <Border Name="PART_Outline"
                        IsHitTestVisible="False"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusControl}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="SmallFontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="MediumWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="ColumnTintBrush" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="StripeBrush" Value="{arc:TableTokenResource StripeBackground}" />
        <Setter Property="StripeColumnBrush" Value="{arc:TableTokenResource StripeColumnBackground}" />
        <Setter Property="SecondaryForeground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="MutedForeground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="RuleBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="DividerBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        <Setter Property="CheckboxBorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        <Setter Property="AccentBrush" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="CheckboxOnBrush" Value="{arc:ArcDesignTokenResource ControlOn}" />
        <Setter Property="CheckmarkBrush" Value="{arc:ArcDesignTokenResource ControlGlyph}" />
        <Setter Property="FocusRingBrush" Value="{arc:ArcDesignTokenResource FocusRing}" />
        <Setter Property="RowHeight" Value="{arc:TableTokenResource RowHeight}" />
        <Setter Property="HeaderHeight" Value="{arc:TableTokenResource HeaderHeight}" />
        <Setter Property="CompactRowHeight" Value="{arc:TableTokenResource CompactRowHeight}" />
        <Setter Property="CompactHeaderHeight" Value="{arc:TableTokenResource CompactHeaderHeight}" />
        <Setter Property="EmptyRowHeight" Value="{arc:TableTokenResource EmptyRowHeight}" />
        <Setter Property="CellInlinePadding" Value="{arc:TableTokenResource CellInlinePadding}" />
        <Setter Property="CellBlockPadding" Value="{arc:TableTokenResource CellBlockPadding}" />
        <Setter Property="CompactCellBlockPadding" Value="{arc:TableTokenResource CompactCellBlockPadding}" />
        <Setter Property="WrapColumnMaxWidth" Value="{arc:TableTokenResource WrapColumnMaxWidth}" />
        <Setter Property="PrimaryInsetSelectable" Value="{arc:TableTokenResource PrimaryInsetSelectable}" />
        <Setter Property="SelectColumnWidth" Value="{arc:TableTokenResource SelectColumnWidth}" />
        <Setter Property="MinTableWidth" Value="{arc:TableTokenResource MinTableWidth}" />
        <Setter Property="CompactBreakpoint" Value="{arc:TableTokenResource CompactBreakpoint}" />
    </ControlTheme>
</ResourceDictionary>
