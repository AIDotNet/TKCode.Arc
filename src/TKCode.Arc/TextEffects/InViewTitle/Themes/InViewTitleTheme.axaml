<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.InViewTitleTheme">
    <ControlTheme x:Key="{x:Type arc:InViewTitle}" TargetType="arc:InViewTitle">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource DisplayFontFamily}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource Type3XL}" />
        <Setter Property="Tracking" Value="{arc:ArcDesignTokenResource TrackingDisplay}" />
        <Setter Property="Leading" Value="{arc:InViewTitleTokenResource TitleLeading}" />
        <Setter Property="BlurRadius" Value="{arc:ArcDesignTokenResource BlurText}" />
        <Setter Property="SoftBlurRadius" Value="{arc:ArcDesignTokenResource BlurSoft}" />
        <Style Selector="^[Level=H1]">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource Type4XL}" />
        </Style>
        <Style Selector="^[Level=H3]">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource Type2XL}" />
        </Style>
        <Style Selector="^[Level=Paragraph]">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXL}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
