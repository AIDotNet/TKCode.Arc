<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type arc:ExpandingSearchTrigger}" TargetType="arc:ExpandingSearchTrigger">
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:ExpandingSearchTrigger">
                <Border Background="Transparent" CornerRadius="{arc:ArcDesignTokenResource RadiusPill}" />
            </ControlTemplate>
        </Setter>
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </ControlTheme>

    <ControlTheme x:Key="{x:Type arc:ExpandingSearchInput}" TargetType="arc:ExpandingSearchInput">
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:ExpandingSearchInput">
                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                    <ScrollViewer Name="PART_ScrollViewer"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Center">
                        <Panel>
                            <TextBlock Name="PART_Placeholder"
                                       Foreground="{TemplateBinding PlaceholderForeground}"
                                       Text="{TemplateBinding PlaceholderText}"
                                       LineHeight="{TemplateBinding LineHeight}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding ElementName="PART_TextPresenter" Path="PreeditText" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Text" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>
                            <TextPresenter Name="PART_TextPresenter"
                                           Text="{TemplateBinding Text, Mode=TwoWay}"
                                           CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                           CaretIndex="{TemplateBinding CaretIndex}"
                                           SelectionStart="{TemplateBinding SelectionStart}"
                                           SelectionEnd="{TemplateBinding SelectionEnd}"
                                           TextWrapping="NoWrap"
                                           LineHeight="{TemplateBinding LineHeight}"
                                           SelectionBrush="{TemplateBinding SelectionBrush}"
                                           SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                           CaretBrush="{TemplateBinding CaretBrush}"
                                           VerticalAlignment="Center" />
                        </Panel>
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="LineHeight" Value="{arc:ExpandingSearchTokenResource TextLineHeight}" />
        <Setter Property="CaretBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="SelectionBrush" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
        <Setter Property="SelectionForegroundBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="PlaceholderForeground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </ControlTheme>

    <ControlTheme x:Key="{x:Type arc:ExpandingSearch}" TargetType="arc:ExpandingSearch">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:ExpandingSearch">
                <!-- The lane takes no pointer events; only the shell (and the panel) do, so an idle lane never blocks what is under it. -->
                <Panel Name="PART_Lane" Height="{arc:ArcDesignTokenResource ControlSizeMD}">
                    <!-- The results panel hangs from this fixed, invisible strip: the width the field opens to. -->
                    <Border Name="PART_PanelAnchor"
                            IsHitTestVisible="False"
                            HorizontalAlignment="Right" />
                    <Panel Name="PART_ShellHost"
                           HorizontalAlignment="Right"
                           RenderTransformOrigin="50%,50%">
                        <Border Name="PART_FocusRing"
                                IsHitTestVisible="False"
                                Opacity="0"
                                Margin="{arc:ExpandingSearchTokenResource FocusRingMargin}"
                                BorderThickness="3"
                                BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                        <Border Name="PART_Shell"
                                BorderThickness="1"
                                ClipToBounds="True">
                            <Panel>
                                <arc:ExpandingSearchTrigger Name="PART_Trigger" />
                                <arc:ArcGlyph Name="PART_Icon"
                                              Data="{x:Static arc:ArcIcons.Search}"
                                              Size="{arc:ExpandingSearchTokenResource GlassSize}"
                                              StrokeThickness="1.75"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="{arc:ExpandingSearchTokenResource IconMargin}" />
                                <arc:ExpandingSearchInput Name="PART_Input"
                                                          Padding="{arc:ExpandingSearchTokenResource FieldPadding}" />
                                <arc:PresenceHost Name="PART_ClearPresence"
                                                  Mode="Pop"
                                                  IsPresent="False"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="{arc:ExpandingSearchTokenResource ClearButtonMargin}">
                                    <arc:FieldIconButton Name="PART_ClearButton"
                                                         Focusable="False"
                                                         Width="{arc:ExpandingSearchTokenResource ClearButtonSize}"
                                                         Height="{arc:ExpandingSearchTokenResource ClearButtonSize}"
                                                         CornerRadius="{arc:ArcDesignTokenResource RadiusPill}">
                                        <arc:ArcGlyph Data="{x:Static arc:ArcIcons.X}"
                                                      Size="{arc:ExpandingSearchTokenResource ClearGlassSize}"
                                                      StrokeThickness="1.75" />
                                    </arc:FieldIconButton>
                                </arc:PresenceHost>
                            </Panel>
                        </Border>
                    </Panel>
                    <TextBlock Name="PART_Status"
                               Height="0"
                               Opacity="0"
                               IsHitTestVisible="False"
                               AutomationProperties.LiveSetting="Polite" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="MinWidth" Value="{arc:ArcDesignTokenResource ControlSizeMD}" />

        <Style Selector="^[Anchor=Start] /template/ Panel#PART_ShellHost">
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="^[Anchor=Start] /template/ Border#PART_PanelAnchor">
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- The shell: quiet border and secondary glyph at rest; stronger border and full glyph once open. -->
        <Style Selector="^ /template/ Border#PART_Shell">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        </Style>
        <Style Selector="^ /template/ arc|ArcGlyph#PART_Icon">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="^:expanded">
            <Style Selector="^ /template/ Border#PART_Shell">
                <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
            </Style>
            <Style Selector="^ /template/ arc|ArcGlyph#PART_Icon">
                <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            </Style>
        </Style>
        <Style Selector="^:not(:expanded) /template/ Border#PART_Shell:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="^:not(:expanded) /template/ Border#PART_Shell:pointerover arc|ArcGlyph#PART_Icon">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:expanded:not(:input-focus) /template/ Border#PART_Shell:pointerover">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:input-focus, ^:trigger-focus">
            <Style Selector="^ /template/ Border#PART_Shell">
                <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
            </Style>
            <Style Selector="^ /template/ Border#PART_FocusRing">
                <Setter Property="Opacity" Value="1" />
            </Style>
            <Style Selector="^ /template/ arc|ArcGlyph#PART_Icon">
                <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            </Style>
        </Style>

        <Style Selector="^:motion-full">
            <Style Selector="^ /template/ Border#PART_Shell">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcBrushTransition Property="BorderBrush" />
                        <arc:ArcBrushTransition Property="Background" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ arc|ArcGlyph#PART_Icon">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcBrushTransition Property="Foreground" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ Border#PART_FocusRing">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcDoubleTransition Property="Opacity" Tween="Standard" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ Panel#PART_ShellHost">
                <Setter Property="RenderTransform" Value="scale(1)" />
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcTransformOperationsTransition Property="RenderTransform" Tween="Spring" />
                    </Transitions>
                </Setter>
            </Style>
            <!-- A compact press while it is still a button; the morph takes over on release. -->
            <Style Selector="^:trigger-pressed:not(:expanded) /template/ Panel#PART_ShellHost">
                <Setter Property="RenderTransform" Value="scale(0.97)" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
