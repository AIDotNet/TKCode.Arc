<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type arc:PasswordStrength}" TargetType="arc:PasswordStrength">
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:PasswordStrength">
                <StackPanel>
                    <arc:Field Name="PART_Field"
                               MessageSwap="Whole"
                               Label="{TemplateBinding Label}"
                               Description="{TemplateBinding Description}"
                               ErrorMessage="{TemplateBinding EffectiveErrorMessage}"
                               IsLabelVisible="{TemplateBinding IsLabelVisible}"
                               Size="{TemplateBinding Size}">
                        <arc:FieldFrame Name="PART_Frame"
                                        Cursor="IBeam"
                                        Spacing="{arc:PasswordStrengthTokenResource FrameSpacing}"
                                        Size="{TemplateBinding Size}"
                                        IsInvalid="{TemplateBinding IsInvalid}"
                                        IsReadOnly="{TemplateBinding IsReadOnly}"
                                        IsFocusActive="{TemplateBinding IsFocused}"
                                        Prefix="{TemplateBinding Prefix}">
                            <arc:FieldFrame.Suffix>
                                <arc:FieldIconButton Name="PART_RevealButton"
                                                     IsToggle="True"
                                                     IsOn="{TemplateBinding IsRevealed}"
                                                     Cursor="Hand"
                                                     PressScale="{arc:PasswordStrengthTokenResource RevealPressScale}"
                                                     Width="{arc:PasswordStrengthTokenResource RevealButtonSize}"
                                                     Height="{arc:PasswordStrengthTokenResource RevealButtonSize}"
                                                     CornerRadius="{arc:PasswordStrengthTokenResource RevealButtonRadius}">
                                    <arc:PasswordEyeGlyph Name="PART_Eye"
                                                          SlashInset="3"
                                                          Size="18"
                                                          IsSlashed="{TemplateBinding IsRevealed}" />
                                </arc:FieldIconButton>
                            </arc:FieldFrame.Suffix>
                            <ScrollViewer Name="PART_ScrollViewer"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled"
                                          BringIntoViewOnFocusChange="{TemplateBinding (ScrollViewer.BringIntoViewOnFocusChange)}">
                                <Panel>
                                    <TextBlock Name="PART_Placeholder"
                                               Foreground="{TemplateBinding PlaceholderForeground}"
                                               Text="{TemplateBinding PlaceholderText}"
                                               LineHeight="{TemplateBinding LineHeight}"
                                               VerticalAlignment="Center">
                                        <TextBlock.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding ElementName="PART_TextPresenter" Path="PreeditText" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                                <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Text" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                            </MultiBinding>
                                        </TextBlock.IsVisible>
                                    </TextBlock>
                                    <TextPresenter Name="PART_TextPresenter"
                                                   Text="{TemplateBinding Text, Mode=TwoWay}"
                                                   CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                                   CaretIndex="{TemplateBinding CaretIndex}"
                                                   SelectionStart="{TemplateBinding SelectionStart}"
                                                   SelectionEnd="{TemplateBinding SelectionEnd}"
                                                   TextAlignment="{TemplateBinding TextAlignment}"
                                                   TextWrapping="NoWrap"
                                                   LineHeight="{TemplateBinding LineHeight}"
                                                   LetterSpacing="{TemplateBinding LetterSpacing}"
                                                   PasswordChar="{TemplateBinding PasswordChar}"
                                                   RevealPassword="{TemplateBinding RevealPassword}"
                                                   SelectionBrush="{TemplateBinding SelectionBrush}"
                                                   SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                                   CaretBrush="{TemplateBinding CaretBrush}"
                                                   VerticalAlignment="Center" />
                                </Panel>
                            </ScrollViewer>
                        </arc:FieldFrame>
                    </arc:Field>
                    <Grid Name="PART_MeterRow"
                          ColumnDefinitions="*,Auto"
                          Margin="{arc:PasswordStrengthTokenResource MeterRowMargin}">
                        <arc:PasswordStrengthMeter Name="PART_Meter"
                                                   VerticalAlignment="Center"
                                                   SegmentHeight="{arc:PasswordStrengthTokenResource SegmentHeight}"
                                                   SegmentGap="{arc:PasswordStrengthTokenResource SegmentGap}"
                                                   TrackBrush="{arc:ArcDesignTokenResource Border}"
                                                   EmptyTone="{arc:ArcDesignTokenResource BorderStrong}"
                                                   WeakTone="{arc:ArcDesignTokenResource Danger}"
                                                   FairTone="{arc:ArcDesignTokenResource Warning}"
                                                   StrongTone="{arc:ArcDesignTokenResource Success}" />
                        <arc:FieldSwapText Name="PART_Word"
                                           Grid.Column="1"
                                           Width="{arc:PasswordStrengthTokenResource WordWidth}"
                                           Margin="{arc:PasswordStrengthTokenResource WordMargin}"
                                           TextAlignment="Right"
                                           ClipToBounds="False"
                                           LineHeight="{arc:PasswordStrengthTokenResource WordLineHeight}"
                                           Foreground="{arc:ArcDesignTokenResource Foreground}"
                                           FontFamily="{arc:ArcDesignTokenResource BodyFontFamily}"
                                           FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                           FontWeight="{arc:ArcDesignTokenResource WeightMedium}" />
                    </Grid>
                    <StackPanel Name="PART_Rules"
                                Spacing="{arc:PasswordStrengthTokenResource RulesSpacing}"
                                Margin="{arc:PasswordStrengthTokenResource RulesMargin}" />
                    <TextBlock Name="PART_Status"
                               Height="0"
                               Opacity="0"
                               IsHitTestVisible="False"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </ControlTemplate>
        </Setter>

        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="LineHeight" Value="{arc:FieldTextBoxTokenResource TextLineHeight}" />
        <Setter Property="CaretBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="SelectionBrush" Value="{arc:FieldTextBoxTokenResource SelectionFill}" />
        <Setter Property="SelectionForegroundBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="PlaceholderForeground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />

        <Style Selector="^ /template/ arc|FieldFrame#PART_Frame">
            <Setter Property="Padding" Value="{arc:PasswordStrengthTokenResource FramePadding}" />
        </Style>
        <!-- Hover only hints with TextMuted here; focus still answers with Foreground. -->
        <Style Selector="^ /template/ arc|FieldFrame#PART_Frame:pointerover:not(:focus-active):not(:invalid)">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
