<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
                    x:ClassModifier="internal"
                    x:Class="TKCode.Arc.SegmentedControlTheme">
    <ControlTheme x:Key="{x:Type arc:SegmentedControl}" TargetType="arc:SegmentedControl">
        <!-- Arc draws its own focus ring; suppress the window's default focus adorner. -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:SegmentedControl">
                <Border Name="PART_Frame"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <!-- The track scrolls inside the frame when the options are wider than the control. -->
                    <ScrollViewer Name="PART_ScrollViewer"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <Panel Name="PART_Track" Margin="{arc:SegmentedControlTokenResource TrackInset}">
                            <!-- The pill passes under every label. -->
                            <arc:GlidingIndicator Name="PART_Selection"
                                                  Spring="Morph"
                                                  StrokeThickness="1"
                                                  Stroke="{arc:ArcDesignTokenResource Border}"
                                                  Fill="{arc:ArcDesignTokenResource Surface}"
                                                  BoxShadow="{arc:ArcDesignTokenResource ShadowResting}"
                                                  CornerRadius="{arc:SegmentedControlTokenResource SelectionRadius}" />
                            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                        </Panel>
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="{arc:SegmentedControlTokenResource SegmentGap}" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="EdgeFade" Value="{arc:SegmentedControlTokenResource EdgeFade}" />
        <Setter Property="ScrollRoom" Value="{arc:SegmentedControlTokenResource ScrollRoom}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="{arc:ArcDesignTokenResource EdgeThickness}" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusControl}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="{arc:SegmentedControlTokenResource DisabledOpacity}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type arc:SegmentedItem}" TargetType="arc:SegmentedItem">
        <!-- Arc draws its own focus ring; suppress the window's default focus adorner. -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:SegmentedItem">
                <Panel>
                    <Border Name="PART_Segment"
                            MinHeight="{arc:ArcDesignTokenResource ControlSizeSM}"
                            CornerRadius="{arc:SegmentedControlTokenResource SegmentRadius}"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="{arc:SegmentedControlTokenResource AccessoryGap}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <ContentPresenter Name="PART_Label"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              VerticalAlignment="Center"
                                              TextWrapping="NoWrap" />
                            <ContentPresenter Name="PART_Accessory"
                                              IsVisible="{TemplateBinding Accessory, Converter={x:Static ObjectConverters.IsNotNull}}"
                                              Content="{TemplateBinding Accessory}"
                                              VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Name="PART_FocusRing"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            Margin="{arc:SegmentedControlTokenResource FocusRingMargin}"
                            BorderThickness="{arc:ArcDesignTokenResource FocusEdgeThickness}"
                            CornerRadius="{arc:SegmentedControlTokenResource FocusRingRadius}"
                            BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Setter Property="Padding" Value="{arc:SegmentedControlTokenResource SegmentInset}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Style Selector="^:pointerover, ^:pressed, ^:selected">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Cursor" Value="No" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:ArcBrushTransition Property="Foreground" Tween="Fast" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
