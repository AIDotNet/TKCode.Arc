<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:arc="https://github.com/AtomUICommunity/TKCode.Arc"
                    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type arc:Switch}" TargetType="arc:Switch">
        <!-- Arc draws its own focus ring; suppress the window's default focus adorner. -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="arc:ArcMotion.Tracks" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="arc:Switch">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                    <Panel Name="PART_TrackHost"
                           Width="{arc:SwitchTokenResource TrackWidth}"
                           Height="{arc:SwitchTokenResource TrackHeight}"
                           VerticalAlignment="Center">
                        <Border Name="PART_FocusRing"
                                IsVisible="False"
                                IsHitTestVisible="False"
                                Margin="{arc:SwitchTokenResource FocusRingMargin}"
                                BorderThickness="2"
                                CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                                BorderBrush="{arc:ArcDesignTokenResource FocusRing}" />
                        <Border Name="PART_Track"
                                CornerRadius="{arc:ArcDesignTokenResource RadiusPill}" />
                        <Border Name="PART_TrackOn"
                                Opacity="0"
                                CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                                Background="{arc:ArcDesignTokenResource ControlOn}" />
                        <Panel Margin="{arc:SwitchTokenResource TrackInset}">
                            <Border Name="PART_Thumb"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="{TemplateBinding ThumbMargin}"
                                    Width="{TemplateBinding ThumbWidth}"
                                    Height="{arc:SwitchTokenResource ThumbSize}"
                                    RenderTransformOrigin="50%,50%"
                                    CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                                    BoxShadow="{arc:ArcDesignTokenResource ControlThumbShadow}" />
                        </Panel>
                    </Panel>
                    <ContentPresenter Name="PART_Label"
                                      Margin="{arc:SwitchTokenResource LabelMargin}"
                                      VerticalAlignment="Center"
                                      IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>

        <Setter Property="MinHeight" Value="{arc:ArcDesignTokenResource ControlSizeMD}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ThumbWidth" Value="{arc:SwitchTokenResource ThumbSize}" />
        <!-- The focus ring sits outside the control. -->
        <Setter Property="ClipToBounds" Value="False" />
        <!-- Base fills live in styles (not the template) so state styles can override them. -->
        <Style Selector="^ /template/ Border#PART_Track">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource ControlTrack}" />
        </Style>
        <Style Selector="^ /template/ Border#PART_Thumb">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource ControlThumb}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="ThumbWidth" Value="{arc:SwitchTokenResource ThumbStretchedWidth}" />
        </Style>
        <Style Selector="^:checked">
            <Setter Property="ThumbMargin" Value="{arc:SwitchTokenResource ThumbOnMargin}" />
            <Style Selector="^ /template/ Border#PART_TrackOn">
                <Setter Property="Opacity" Value="1" />
            </Style>
            <Style Selector="^ /template/ Border#PART_Thumb">
                <Setter Property="Background" Value="{arc:ArcDesignTokenResource ControlThumbOn}" />
            </Style>
        </Style>
        <Style Selector="^:checked:pressed">
            <Setter Property="ThumbMargin" Value="{arc:SwitchTokenResource ThumbOnPressedMargin}" />
        </Style>
        <Style Selector="^:not(:checked):pointerover /template/ Border#PART_Track">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource ControlTrackHover}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="{arc:SwitchTokenResource DisabledOpacity}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- Thumb glides on a critically damped 0.3s spring; the press stretch uses snappy. -->
        <Style Selector="^:motion-full">
            <Setter Property="Transitions">
                <Transitions>
                    <arc:SpringThicknessTransition Property="ThumbMargin" VisualDuration="0.3" Bounce="0" />
                    <arc:SpringDoubleTransition Property="ThumbWidth" Spring="Snappy" />
                </Transitions>
            </Setter>
            <Style Selector="^ /template/ Border#PART_Track">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcBrushTransition Property="Background" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ Border#PART_TrackOn">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcDoubleTransition Property="Opacity" Tween="Standard" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^ /template/ Border#PART_Thumb">
                <Setter Property="Transitions">
                    <Transitions>
                        <arc:ArcBrushTransition Property="Background" Tween="Standard" />
                    </Transitions>
                </Setter>
            </Style>
        </Style>
        <!-- Reduced motion: no stretch, the thumb jumps, colors still change instantly. -->
        <Style Selector="^:motion-reduced">
            <Setter Property="ThumbWidth" Value="{arc:SwitchTokenResource ThumbSize}" />
        </Style>
        <Style Selector="^:motion-reduced:checked">
            <Setter Property="ThumbMargin" Value="{arc:SwitchTokenResource ThumbOnMargin}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
