<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:m="using:ArcStarterApp.Models"
             xmlns:vm="using:ArcStarterApp.ViewModels"
             x:Class="ArcStarterApp.Views.MainView"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.muted">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <!-- The top bar: the workspace, the build, the command palette, the layout reset and the light/dark switch. -->
        <Border DockPanel.Dock="Top"
                Height="48"
                Padding="14,0"
                BorderThickness="0,0,0,1"
                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <Border Width="26" Height="26" CornerRadius="8" VerticalAlignment="Center" Background="{arc:ArcDesignTokenResource Foreground}">
                    <lucide:LucideIcon Kind="SquareTerminal"
                                       Size="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{arc:ArcDesignTokenResource Background}" />
                </Border>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontWeight="Medium"
                           Foreground="{arc:ArcDesignTokenResource Foreground}">
                    <Run Text="ArcDisplayName" /><Run Text=" · " Foreground="{arc:ArcDesignTokenResource TextMuted}" /><Run Text="{Binding Workspace.Name}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                </TextBlock>
                <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Status}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                <arc:Button Grid.Column="3" Size="Small" VerticalAlignment="Center" Command="{Binding RunCommand}" ToolTip.Tip="Save the changed files and build">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:LucideIcon Kind="Play" Size="13" />
                        <TextBlock Text="Run" />
                    </StackPanel>
                </arc:Button>
                <arc:Button Grid.Column="4"
                            Size="Small"
                            VerticalAlignment="Center"
                            Variant="Secondary"
                            ToolTip.Tip="Command palette (Cmd+K / Ctrl+K)"
                            arc:CommandPaletteDialog.Opens="{Binding #Palette}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:LucideIcon Kind="Command" Size="13" />
                        <TextBlock Text="Commands" />
                    </StackPanel>
                </arc:Button>
                <arc:Button Grid.Column="5" Content="Reset layout" Variant="Ghost" Size="Small" VerticalAlignment="Center" Click="OnResetLayout" />
                <arc:ThemeSwitcher Grid.Column="6" IsIconOnly="True" />
            </Grid>
        </Border>

        <!-- The panes. Every pane has a stable Id: the saved layout records only ids and places. The tool panes are
             declared here; an editor tab is "doc:<path>", opened by MainView.axaml.cs and re-created from its id by
             PaneResolver when the saved layout is loaded. Size is a share of the parent split. -->
        <arc:DockLayout x:Name="Dock" Margin="8">
            <arc:DockLayout.EmptyDocumentContent>
                <TextBlock Classes="muted" Text="Open a file from the explorer." HorizontalAlignment="Center" VerticalAlignment="Center" />
            </arc:DockLayout.EmptyDocumentContent>
            <arc:DockSplit Orientation="Horizontal">
                <arc:DockGroup Size="20">
                    <arc:DockPane Id="explorer" Title="Explorer" Icon="{x:Static arc:ArcIcons.Folder}" PreferredSide="Left" CanClose="False">
                        <arc:TreeView x:Name="Explorer" Margin="4" SelectionChanged="OnExplorerSelectionChanged" ItemInvoked="OnExplorerItemInvoked" />
                    </arc:DockPane>
                </arc:DockGroup>

                <arc:DockSplit Orientation="Vertical" Size="58">
                    <arc:DockDocumentArea Size="70" />
                    <arc:DockGroup Size="30">
                        <arc:DockPane Id="output" Title="Output" Icon="{x:Static arc:ArcIcons.Terminal}" PreferredSide="Bottom">
                            <ScrollViewer x:Name="OutputScroll">
                                <ItemsControl Margin="12,8" ItemsSource="{Binding Output}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Classes="mono" Text="{Binding}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </arc:DockPane>
                        <arc:DockPane Id="problems" Title="Problems" Icon="{x:Static arc:ArcIcons.TriangleAlert}" PreferredSide="Bottom">
                            <ScrollViewer>
                                <ItemsControl Margin="4" ItemsSource="{Binding Problems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="m:BuildProblem">
                                            <!-- A click opens the file. -->
                                            <arc:Button Variant="Ghost"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Tag="{Binding File}"
                                                        Click="OnProblemClick">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <lucide:LucideIcon Kind="TriangleAlert" Size="14" Foreground="{arc:ArcDesignTokenResource Warning}" />
                                                    <TextBlock Text="{Binding Message}" />
                                                    <TextBlock Classes="muted" Text="{Binding Code}" />
                                                    <TextBlock Classes="muted" Text="{Binding Location}" />
                                                </StackPanel>
                                            </arc:Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </arc:DockPane>
                    </arc:DockGroup>
                </arc:DockSplit>

                <arc:DockGroup Size="22">
                    <!-- The file selected in the explorer or shown in the editor: EditorDocument is a [PropertyGridModel]. -->
                    <arc:DockPane Id="properties" Title="Properties" Icon="{x:Static arc:ArcIcons.SlidersHorizontal}" PreferredSide="Right">
                        <arc:PropertyGrid SelectedObject="{Binding Selected}" IsSearchVisible="False" EmptyText="Select a file." />
                    </arc:DockPane>
                </arc:DockGroup>
            </arc:DockSplit>
        </arc:DockLayout>

        <!-- The command palette (Cmd+K / Ctrl+K). The "Files" entries are added in MainView.axaml.cs. -->
        <arc:CommandPaletteDialog x:Name="Palette" PlaceholderText="Run a command or open a file" ItemSelected="OnCommandSelected">
            <arc:CommandPaletteItem Id="run" Label="Run build" Group="Build" Icon="{x:Static arc:ArcIcons.Play}" />
            <arc:CommandPaletteItem Id="save-all" Label="Save all" Group="File" Icon="{x:Static arc:ArcIcons.Download}" />
            <arc:CommandPaletteItem Id="reset-layout" Label="Reset layout" Group="View" Icon="{x:Static arc:ArcIcons.LayoutGrid}" />
        </arc:CommandPaletteDialog>
    </DockPanel>
</UserControl>
