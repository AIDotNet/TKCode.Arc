<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:nav="using:ArcStarterApp.Navigation"
             xmlns:vm="using:ArcStarterApp.ViewModels"
             x:Class="ArcStarterApp.Views.MainView"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <Style Selector="arc|Sidebar :is(Control).rail-fade">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="arc|Sidebar:collapsed :is(Control).rail-fade">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="arc|Sidebar:motion-full :is(Control).rail-fade">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="arc|Button.icon">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </UserControl.Styles>

    <DockPanel ClipToBounds="True">
        <!-- Every row's Key names a page in Navigation/AppPages.cs. Cmd+B / Ctrl+B folds the sidebar to its icon rail. -->
        <arc:Sidebar x:Name="Nav"
                     DockPanel.Dock="Left"
                     IsCollapseButtonVisible="False"
                     ResizeMode="Overlay"
                     SelectedKey="{Binding SelectedKey}">
            <arc:Sidebar.Header>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,0,0,0">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{arc:ArcDesignTokenResource Foreground}">
                        <lucide:LucideIcon Kind="FolderKanban"
                                           Size="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{arc:ArcDesignTokenResource Background}" />
                    </Border>
                    <TextBlock Classes="rail-fade"
                               Text="ArcDisplayName"
                               VerticalAlignment="Center"
                               FontWeight="Medium"
                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                </StackPanel>
            </arc:Sidebar.Header>

            <arc:SidebarSection Header="{Binding ProjectName}">
                <arc:SidebarItem Key="board" Label="Board" Icon="{lucide:LucideGeometry SquareKanban}" />
                <arc:SidebarItem Key="timeline" Label="Timeline" Icon="{lucide:LucideGeometry ChartGantt}" />
                <arc:SidebarItem Key="calendar" Label="Calendar" Icon="{lucide:LucideGeometry CalendarDays}" />
                <arc:SidebarItem Key="release" Label="Release" Icon="{lucide:LucideGeometry Rocket}" />
            </arc:SidebarSection>
        </arc:Sidebar>

        <!-- The page side. PageShift lets it glide with the sidebar's edge while the sidebar opens or folds. -->
        <Grid RowDefinitions="Auto,*" RenderTransform="{Binding #Nav.PageShift}">
            <Border Height="52"
                    Padding="14,0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <arc:Button Classes="icon" Variant="Ghost" AutomationProperties.Name="Toggle sidebar" Click="OnToggleSidebar">
                        <lucide:LucideIcon Kind="PanelLeft" Size="16" />
                    </arc:Button>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Title}"
                               VerticalAlignment="Center"
                               FontWeight="Medium"
                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                    <arc:ThemeSwitcher Grid.Column="2" IsIconOnly="True" />
                </Grid>
            </Border>
            <nav:PageHost x:Name="PageView" Grid.Row="1" Page="{Binding CurrentPage}" />
        </Grid>
    </DockPanel>
</UserControl>
