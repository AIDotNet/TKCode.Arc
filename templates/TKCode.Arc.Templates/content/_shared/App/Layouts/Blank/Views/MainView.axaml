<!--#if (UsesMvvm) -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
<!--#if (UsesI18n) -->
             xmlns:l="using:ArcStarterApp.Localization"
             xmlns:views="using:ArcStarterApp.Views"
<!--#endif -->
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:vm="using:ArcStarterApp.ViewModels"
             x:Class="ArcStarterApp.Views.MainView"
             x:DataType="vm:MainViewModel">
<!--#else -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
<!--#if (UsesI18n) -->
             xmlns:l="using:ArcStarterApp.Localization"
             xmlns:views="using:ArcStarterApp.Views"
<!--#endif -->
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             x:Class="ArcStarterApp.Views.MainView">
<!--#endif -->
    <DockPanel>
        <!-- The top bar: the app name and the light/dark switch. -->
        <Border DockPanel.Dock="Top"
                Height="56"
                Padding="20,0"
                BorderThickness="0,0,0,1"
                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                <Border Width="28"
                        Height="28"
                        CornerRadius="8"
                        VerticalAlignment="Center"
                        Background="{arc:ArcDesignTokenResource Foreground}">
                    <lucide:LucideIcon Kind="Sparkles"
                                       Size="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{arc:ArcDesignTokenResource Background}" />
                </Border>
                <TextBlock Grid.Column="1"
                           Text="ArcDisplayName"
                           VerticalAlignment="Center"
                           FontWeight="Medium"
                           Foreground="{arc:ArcDesignTokenResource Foreground}" />
                <!-- Applies the other appearance through ArcThemeManager and plays the reveal transition. -->
<!--#if (UsesI18n) -->
                <views:LanguagePicker Grid.Column="2" Width="140" VerticalAlignment="Center" />
<!--#endif -->
                <arc:ThemeSwitcher Grid.Column="3" IsIconOnly="True" />
            </Grid>
        </Border>

        <!-- The page. Replace it with your own content. -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <arc:Card MaxWidth="560" Margin="24,48" VerticalAlignment="Top">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                   FontWeight="Medium"
                                   Foreground="{arc:ArcDesignTokenResource Foreground}">
                            <Run Text="@@WelcomeTo@@" /><Run Text=" ArcDisplayName" />
                        </TextBlock>
                        <TextBlock Text="@@WelcomeDescription@@"
                                   TextWrapping="Wrap"
                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                    </StackPanel>
<!--#if (UsesMvvm) -->
                    <!-- Bound to MainViewModel (ViewModels/) with compiled bindings. -->
                    <arc:Input Label="@@YourName@@"
                               PlaceholderText="Ada Lovelace"
                               Text="{Binding Name}"
                               Description="@@NameDescription@@" />
                    <arc:Switch Content="@@ProductUpdates@@" IsChecked="{Binding SendUpdates}" />
                    <TextBlock Text="{Binding Greeting}"
                               TextWrapping="Wrap"
                               Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <arc:Button Content="@@ReadDocs@@" Variant="Secondary" />
                        <arc:Button Content="@@GetStarted@@" Command="{Binding GetStartedCommand}" />
                    </StackPanel>
<!--#else -->
                    <arc:Input Label="@@YourName@@"
                               PlaceholderText="Ada Lovelace"
                               Description="@@NameDescription@@" />
                    <arc:Switch Content="@@ProductUpdates@@" IsChecked="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <arc:Button Content="@@ReadDocs@@" Variant="Secondary" />
                        <arc:Button Content="@@GetStarted@@" />
                    </StackPanel>
<!--#endif -->
                </StackPanel>
            </arc:Card>
        </ScrollViewer>
    </DockPanel>
</UserControl>
