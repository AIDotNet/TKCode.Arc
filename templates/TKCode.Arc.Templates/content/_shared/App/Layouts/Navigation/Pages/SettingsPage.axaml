<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             x:Class="ArcStarterApp.Pages.SettingsPage">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28" Spacing="20" MaxWidth="640" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="Settings"
                           FontSize="{arc:ArcDesignTokenResource Type2XL}"
                           FontWeight="Medium"
                           Foreground="{arc:ArcDesignTokenResource Foreground}" />
                <TextBlock Text="Preferences for this app."
                           TextWrapping="Wrap"
                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
            </StackPanel>

            <arc:Card Title="Appearance" Description="Light, dark, or follow the system setting. The switch in the top bar changes it too.">
                <arc:SegmentedControl x:Name="AppearanceChoice"
                                      Margin="0,12,0,0"
                                      HorizontalAlignment="Left"
                                      AutomationProperties.Name="Appearance">
                    <arc:SegmentedOption Value="System" Label="System" />
                    <arc:SegmentedOption Value="Light" Label="Light" />
                    <arc:SegmentedOption Value="Dark" Label="Dark" />
                </arc:SegmentedControl>
            </arc:Card>

            <arc:Card Title="Notifications" Description="Choose what this app tells you about.">
                <StackPanel Spacing="14" Margin="0,12,0,0">
                    <arc:Switch Content="Weekly summary" IsChecked="True" />
                    <arc:Switch Content="Mentions and replies" IsChecked="True" />
                    <arc:Switch Content="Product announcements" />
                </StackPanel>
            </arc:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
