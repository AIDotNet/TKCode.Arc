<!--#if (UsesMvvm) -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
<!--#if (UsesI18n) -->
             xmlns:l="using:ArcStarterApp.Localization"
<!--#endif -->
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:nav="using:ArcStarterApp.Navigation"
             xmlns:vm="using:ArcStarterApp.ViewModels"
             x:Class="ArcStarterApp.Views.MainView"
             x:DataType="vm:MainViewModel">
<!--#else -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
<!--#if (UsesI18n) -->
             xmlns:l="using:ArcStarterApp.Localization"
<!--#endif -->
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:nav="using:ArcStarterApp.Navigation"
             x:Class="ArcStarterApp.Views.MainView">
<!--#endif -->
    <UserControl.Styles>
        <!-- On the icon rail the header and footer keep only their leading part (logo, avatar); the rest fades. -->
        <Style Selector="arc|Sidebar :is(Control).rail-fade">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="arc|Sidebar:collapsed :is(Control).rail-fade">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="arc|Sidebar:motion-full :is(Control).rail-fade">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="arc|Button.panel-toggle">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="IsPressScaleEnabled" Value="False" />
        </Style>
    </UserControl.Styles>

    <DockPanel ClipToBounds="True">
        <!-- The navigation. Every row's Key names a page in Navigation/AppPages.cs; choosing a row shows that page.
             The rail toggle lives in the top bar, so the sidebar's own collapse button is hidden. Cmd+B / Ctrl+B
             inside the sidebar toggles it as well. -->
<!--#if (UsesMvvm) -->
        <arc:Sidebar x:Name="Nav"
                     DockPanel.Dock="Left"
                     IsCollapseButtonVisible="False"
                     ResizeMode="Overlay"
                     SelectedKey="{Binding SelectedKey}">
<!--#else -->
        <arc:Sidebar x:Name="Nav"
                     DockPanel.Dock="Left"
                     IsCollapseButtonVisible="False"
                     ResizeMode="Overlay"
                     SelectedKey="home">
<!--#endif -->
            <arc:Sidebar.Header>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,0,0,0">
                    <Border Width="28"
                            Height="28"
                            CornerRadius="8"
                            Background="{arc:ArcDesignTokenResource Foreground}">
                        <lucide:LucideIcon Kind="Sparkles"
                                           Size="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{arc:ArcDesignTokenResource Background}" />
                    </Border>
                    <TextBlock Classes="rail-fade"
                               Text="ArcDisplayName"
                               VerticalAlignment="Center"
                               FontWeight="Medium"
                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
                </StackPanel>
            </arc:Sidebar.Header>

            <arc:SidebarSection>
                <arc:SidebarItem Key="home" Label="@@Home@@" Icon="{lucide:LucideGeometry House}" />
                <arc:SidebarItem Key="projects" Label="@@Projects@@" Icon="{lucide:LucideGeometry FolderKanban}" Badge="3" />
            </arc:SidebarSection>
            <arc:SidebarSection>
                <arc:SidebarItem Key="settings" Label="@@Settings@@" Icon="{lucide:LucideGeometry Settings}" />
            </arc:SidebarSection>

            <arc:Sidebar.Footer>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,0,0,0">
                    <arc:Avatar DisplayName="Ada Lovelace" Size="Small" Status="Online" />
                    <StackPanel Classes="rail-fade" VerticalAlignment="Center">
                        <TextBlock Text="Ada Lovelace"
                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                   Foreground="{arc:ArcDesignTokenResource Foreground}" />
                        <TextBlock Text="@@Owner@@"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                    </StackPanel>
                </StackPanel>
            </arc:Sidebar.Footer>
        </arc:Sidebar>

        <!-- The page side. PageShift lets it glide with the sidebar's edge while the sidebar opens or folds. -->
        <Grid RowDefinitions="Auto,*" RenderTransform="{Binding #Nav.PageShift}">
            <!-- The top bar: the rail toggle, the page title and the light/dark switch. -->
            <Border Height="52"
                    Padding="14,0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <arc:Button Classes="panel-toggle"
                                Variant="Ghost"
                                AutomationProperties.Name="@@ToggleSidebar@@"
                                Click="OnToggleSidebar">
                        <lucide:LucideIcon Kind="PanelLeft" Size="16" />
                    </arc:Button>
<!--#if (UsesMvvm) -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding Title}"
                               VerticalAlignment="Center"
                               FontWeight="Medium"
                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
<!--#else -->
                    <TextBlock x:Name="PageTitle"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontWeight="Medium"
                               Foreground="{arc:ArcDesignTokenResource Foreground}" />
<!--#endif -->
                    <arc:ThemeSwitcher Grid.Column="2" IsIconOnly="True" />
                </Grid>
            </Border>
<!--#if (UsesMvvm) -->
            <nav:PageHost x:Name="PageView" Grid.Row="1" Page="{Binding CurrentPage}" />
<!--#else -->
            <nav:PageHost x:Name="PageView" Grid.Row="1" />
<!--#endif -->
        </Grid>
    </DockPanel>
</UserControl>
