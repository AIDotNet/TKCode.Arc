       "action": {
        "event": {
         "name": "tap"
        }
       },
       "child": "dynamic_btn_label",
       "component": "Button",
       "id": "dynamic_btn"
      },
      {
       "component": "Text",
       "id": "dynamic_btn_label",
       "text": "Dynamic Action"
      },
      {
       "@accessibility": {
        "hidden": {
         "@path": "/isStatusHidden"
        }
       },
       "component": "Text",
       "id": "dynamic_status",
       "text": "Status"
      }
     ],
     "dataModel": {
      "buttonLabel": "Mute Audio",
      "isButtonHidden": false,
      "isStatusHidden": true
     },
     "surfaceId": "a11y_surface"
    },
    "version": "1.0"
   }
  ],
  "name": "test_accessibility_dynamic_label_and_hidden_binding",
  "protocolVersion": "1.0",
  "steps": [
   {
    "assertions": {
     "accessibilityTree": {
      "dynamic_btn": {
       "hidden": false,
       "label": "Mute Audio"
      },
      "dynamic_status": {
       "hidden": true
      }
     },
     "axeCore": [
      "button-name",
      "aria-hidden-focus"
     ]
    },
    "messages": [
     {
      "createSurface": {
       "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
       "components": [
        {
         "children": [
          "dynamic_btn",
          "dynamic_status"
         ],
         "component": "Column",
         "id": "root"
        },
        {
         "@accessibility": {
          "hidden": {
           "@path": "/isButtonHidden"
          },
          "label": {
           "@path": "/buttonLabel"
          }
         },
         "action": {
          "event": {
           "name": "tap"
          }
         },
         "child": "dynamic_btn_label",
         "component": "Button",
         "id": "dynamic_btn"
        },
        {
         "component": "Text",
         "id": "dynamic_btn_label",
         "text": "Dynamic Action"
        },
        {
         "@accessibility": {
          "hidden": {
           "@path": "/isStatusHidden"
          }
         },
         "component": "Text",
         "id": "dynamic_status",
         "text": "Status"
        }
       ],
       "dataModel": {
        "buttonLabel": "Mute Audio",
        "isButtonHidden": false,
        "isStatusHidden": true
       },
       "surfaceId": "a11y_surface"
      },
      "version": "1.0"
     }
    ]
   },
   {
    "assertions": {
     "accessibilityTree": {
      "dynamic_btn": {
       "hidden": true,
       "label": "Unmute Audio"
      },
      "dynamic_status": {
       "hidden": true
      }
     },
     "axeCore": [
      "button-name",
      "aria-hidden-focus"
     ]
    },
    "messages": [
     {
      "updateDataModel": {
       "path": "/buttonLabel",
       "surfaceId": "a11y_surface",
       "value": "Unmute Audio"
      },
      "version": "1.0"
     },
     {
      "updateDataModel": {
       "path": "/isButtonHidden",
       "surfaceId": "a11y_surface",
       "value": true
      },
      "version": "1.0"
     }
    ]
   }
