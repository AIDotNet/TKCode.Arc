   "protocolVersion": "1.0"
  },
  "description": "The same payloads as test_composition_dropped_child_is_not_checked_against_surface, when orphans are not allowed. The topology check reports the dropped child as unreachable from the root; it is not reported as UNALLOWED_PARENT against Surface.",
  "name": "test_composition_dropped_child_is_reported_as_orphan",
  "steps": [
   {
    "payload": [
     {
      "createSurface": {
       "catalogId": "custom",
       "components": [
        {
         "children": [
          "h"
         ],
         "component": "Box",
         "id": "root"
        },
        {
         "component": "Header",
         "id": "h"
        }
       ],
       "surfaceId": "s1"
      },
      "version": "1.0"
     }
    ]
   },
   {
    "expectError": {
     "category": "IntegrityError",
     "message": "Component 'h' is not reachable from 'root'"
    },
    "payload": [
     {
      "updateComponents": {
       "components": [
        {
         "children": [],
         "component": "Box",
         "id": "root"
        }
       ],
       "surfaceId": "s1"
      },
      "version": "1.0"
     }
    ]
   }
  ],
  "validationConfig": {
   "allowOrphanComponents": false
  }
 },
 {
