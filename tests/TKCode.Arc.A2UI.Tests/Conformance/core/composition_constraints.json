 {
  "action": "process_messages",
  "catalog": {
   "catalogId": "custom",
   "components": {
    "Box": {
     "properties": {
      "children": {
       "$ref": "#/$defs/ChildList"
      }
     },
     "type": "object"
    },
    "Header": {
     "allowedParents": [
      "Box"
     ],
     "type": "object"
    }
   },
   "protocolVersion": "1.0"
  },
  "description": "A container rewritten to drop a child leaves a component that nothing references. Only the surface's root is checked against Surface in allowedParents, so when orphans are allowed the update is accepted, even though the child's allowedParents does not include Surface. The other checks are on, so the processor checks the whole surface.",
  "expect": {
   "surfaces": {
    "s1": {
     "components": {
      "h": {
       "component": "Header"
      },
      "root": {
       "children": [],
       "component": "Box"
      }
     }
    }
   }
  },
  "name": "test_composition_dropped_child_is_not_checked_against_surface",
  "steps": [
   {
    "payload": [
     {
      "createSurface": {
       "catalogId": "custom",
       "components": [
        {
         "children": [
          "h"
         ],
         "component": "Box",
         "id": "root"
        },
        {
         "component": "Header",
         "id": "h"
        }
       ],
       "surfaceId": "s1"
      },
      "version": "1.0"
     }
    ]
   },
   {
    "payload": [
     {
      "updateComponents": {
       "components": [
        {
         "children": [],
         "component": "Box",
         "id": "root"
        }
       ],
       "surfaceId": "s1"
      },
      "version": "1.0"
     }
    ]
   }
  ],
  "validationConfig": {
   "allowOrphanComponents": true
  }
 },
 {
  "action": "process_messages",
