    }
   ],
   "message": "Component 'invalid_header' (ColumnHeader) cannot be placed under parent 'root' (Row). Allowed parents: ['Column'].",
   "path": "/components/1",
   "rendererError": {
    "error": {
     "code": "UNALLOWED_PARENT",
     "message": "Component 'invalid_header' (ColumnHeader) cannot be placed under parent 'root' (Row). Allowed parents: ['Column'].",
     "path": "/components/1",
     "surfaceId": "s1"
    },
    "version": "1.0"
   },
   "surfaceId": "s1"
  },
