  "steps": [
   {
    "expectError": {
     "category": "ValidationError",
     "code": "UNALLOWED_PARENT",
     "message": "Component 'root' (Card) cannot be placed under parent 'Surface' (Surface). Allowed parents: ['Box']."
    },
    "payload": [
     {
      "createSurface": {
       "catalogId": "custom",
       "components": [
        {
         "component": "Card",
         "id": "root"
        },
        {
         "children": [
          "root"
         ],
         "component": "Box",
         "id": "box"
        }
       ],
       "surfaceId": "s1"
      },
      "version": "1.0"
     }
    ]
   }
  ],
  "validationConfig": {
   "allowOrphanComponents": true
  }
