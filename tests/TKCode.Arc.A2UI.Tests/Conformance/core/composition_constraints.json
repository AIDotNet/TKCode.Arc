  },
  "description": "The same payloads as test_composition_dropped_child_is_not_checked_against_surface, when references to components that have not arrived are also allowed. An SDK may then check only the components each update changes; the dropped child is still not checked against Surface.",
  "expect": {
   "surfaces": {
    "s1": {
     "components": {
      "h": {
       "component": "Header"
      },
      "root": {
       "children": [],
       "component": "Box"
      }
     }
    }
   }
  },
  "name": "test_composition_dropped_child_is_not_checked_against_surface_when_references_may_dangle",
  "steps": [
   {
    "payload": [
     {
      "createSurface": {
       "catalogId": "custom",
       "components": [
        {
         "children": [
          "h"
         ],
         "component": "Box",
         "id": "root"
        },
        {
         "component": "Header",
         "id": "h"
        }
       ],
       "surfaceId": "s1"
      },
      "version": "1.0"
     }
    ]
   },
   {
    "payload": [
     {
      "updateComponents": {
       "components": [
        {
         "children": [],
         "component": "Box",
         "id": "root"
        }
       ],
       "surfaceId": "s1"
      },
      "version": "1.0"
     }
    ]
   }
  ],
  "validationConfig": {
   "allowDanglingReferences": true,
   "allowOrphanComponents": true
  }
 },
 {
  "action": "process_messages",
  "catalog": {
   "catalogId": "custom",
   "components": {
    "Box": {
     "properties": {
      "children": {
