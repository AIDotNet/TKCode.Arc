[
 {
  "action": "process_messages",
  "catalog": {
   "protocolVersion": "1.0"
  },
  "description": "Verifies root components treating Surface as canonical parent container when allowedParents includes Surface.",
  "expect": {
   "surfaces": {
    "s1": {
     "components": {
      "root": {
       "children": [
        "t1"
       ],
       "component": "Column"
      },
      "t1": {
       "component": "Text",
       "text": "Hello World"
      }
     }
    }
   }
  },
  "features": [
   "F-CORE-11",
   "F-CORE-12"
  ],
  "name": "test_composition_surface_implicit_parent_container",
  "steps": [
   {
    "payload": [
     {
      "createSurface": {
       "catalogId": "basic",
       "components": [
        {
         "children": [
          "t1"
         ],
         "component": "Column",
         "id": "root"
        },
        {
         "component": "Text",
         "id": "t1",
         "text": "Hello World"
        }
       ],
       "surfaceId": "s1"
      },
      "version": "1.0"
     }
    ]
   }
  ],
  "validationConfig": {}
 },
 {
  "action": "process_messages",
  "catalog": {
