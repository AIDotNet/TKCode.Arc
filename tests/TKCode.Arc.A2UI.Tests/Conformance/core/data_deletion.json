       "catalogId": "basic",
       "dataModel": {
        "settings": {
         "notifications": {
          "email": true,
          "push": false,
          "sms": true
         }
        }
       },
       "surfaceId": "s1"
      },
      "version": "1.0"
     }
    ]
   },
   {
    "payload": [
     {
      "updateDataModel": {
       "path": "/settings/notifications/email",
       "surfaceId": "s1",
       "value": null
