[
 {
  "action": "validate",
  "catalog": {
   "protocolVersion": "1.0"
  },
  "description": "Verifies that updateDataModel with value=null deletes the specified JSON Pointer path.",
  "expect": {
   "surfaces": {
    "s1": {
     "dataModel": {
      "user": {
       "profile": {
        "name": "Alice"
       }
      }
     }
    }
   }
  },
  "features": [
   "F-CORE-03"
  ],
  "name": "test_data_deletion_value_null",
  "steps": [
   {
    "payload": [
     {
      "createSurface": {
       "catalogId": "basic",
       "dataModel": {
        "user": {
         "profile": {
          "bio": "Software Engineer",
          "name": "Alice"
         }
        }
       },
       "surfaceId": "s1"
      },
      "version": "1.0"
     }
    ]
   },
   {
    "payload": [
     {
      "updateDataModel": {
       "path": "/user/profile/bio",
       "surfaceId": "s1",
       "value": null
      },
      "version": "1.0"
     }
    ]
   }
  ]
 },
 {
  "action": "validate",
  "catalog": {
   "protocolVersion": "1.0"
  },
  "description": "Verifies deleting a child property via value=null preserves sibling keys in parent object.",
