    "settings": {
     "theme": "dark"
    }
   }
  },
  "name": "test_data_model_replaces_root",
  "steps": [
   {
    "expect_notified": [
     "/"
    ],
    "expect_values": {
     "/": {
      "newRoot": "foo"
     }
    },
    "op": "set",
    "path": "/",
    "value": {
     "newRoot": "foo"
    }
   },
   {
    "expect": {
     "newRoot": "foo"
    },
    "op": "get",
    "path": ""
   }
  ],
  "watch": [
   "/",
   "/unrelated"
  ]
 },
 {
  "action": "data_model",
  "catalog": {
   "protocolVersion": "v0.9"
  },
  "description": "A ~1 escape addresses a key containing a slash (RFC 6901).",
  "initial": {
   "items": [
    "a",
    "b",
    "c"
   ],
   "user": {
    "name": "Alice",
    "settings": {
     "theme": "dark"
    }
   }
  },
  "name": "test_data_model_escaped_slash",
  "steps": [
   {
    "op": "set",
    "path": "/user/detailed~1info",
    "value": "some info"
   },
   {
    "expect": "some info",
    "op": "get",
    "path": "/user/detailed~1info"
   },
   {
    "expect": {
     "detailed/info": "some info",
     "name": "Alice",
     "settings": {
      "theme": "dark"
     }
    },
    "op": "get",
    "path": "/user"
   }
  ]
 },
 {
  "action": "data_model",
  "catalog": {
   "protocolVersion": "v0.9"
  },
  "description": "A ~0 escape addresses a key containing a tilde (RFC 6901).",
  "initial": {
   "items": [
    "a",
    "b",
    "c"
   ],
   "user": {
    "name": "Alice",
    "settings": {
     "theme": "dark"
    }
   }
  },
  "name": "test_data_model_escaped_tilde",
  "steps": [
   {
    "op": "set",
    "path": "/user/profile~0name",
    "value": "profile~name"
   },
   {
    "expect": "profile~name",
    "op": "get",
    "path": "/user/profile~0name"
   },
   {
    "expect": {
     "name": "Alice",
     "profile~name": "profile~name",
     "settings": {
      "theme": "dark"
     }
    },
    "op": "get",
    "path": "/user"
   }
  ]
 },
 {
  "action": "data_model",
  "catalog": {
   "protocolVersion": "v0.9"
  },
