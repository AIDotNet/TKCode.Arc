 {
  "action": "validate",
  "catalogs": [
   {
    "catalogId": "app-cat",
    "components": {
     "Text": {
      "properties": {
       "text": {
        "$ref": "#/$defs/DynamicString"
       }
      },
      "type": "object"
     }
    },
    "protocolVersion": "1.0"
   }
  ],
  "description": "Verifies a function call naming a non-default catalogId is evaluated by that catalog.",
  "expect": {
   "surfaces": {
    "main": {
     "components": {
      "root": {
       "component": "Text",
       "text": "2026-09-04"
      }
     }
    }
   }
  },
  "features": [
   "F-CORE-10"
  ],
  "name": "test_multi_catalog_function_call_catalog_id_override",
  "steps": [
   {
    "payload": [
     {
      "createSurface": {
       "catalogId": "app-cat",
       "components": [
        {
         "component": "Text",
         "id": "root",
         "text": {
          "@call": "formatDate",
          "args": {
           "format": "yyyy-MM-dd",
           "value": "2026-09-04T12:00:00Z"
          },
          "catalogId": "basic"
         }
        }
       ],
       "surfaceId": "main"
      },
      "version": "1.0"
     }
    ]
   }
  ]
 },
 {
  "action": "validate",
  "catalogs": [
   {
    "catalogId": "app-cat",
    "components": {
     "Badge": {
      "properties": {
       "label": {
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "protocolVersion": "1.0"
   }
  ],
  "description": "Verifies @index() stays catalogless while sibling ${pluralize(...)} calls inherit formatString's catalogId on a defaultless v1.0 surface.",
  "expect": {
   "surfaces": {
    "main": {
     "components": {
      "row_0": {
       "text": "Row 0: drop"
      },
      "row_1": {
       "text": "Row 1: drops"
      }
     }
    }
   }
  },
  "name": "test_multi_catalog_format_string_index_and_catalog_call_without_default",
  "steps": [
   {
    "payload": [
     {
      "createSurface": {
       "components": [
        {
         "catalogId": "basic",
         "children": {
          "componentId": "row",
          "path": "/items"
         },
         "component": "List",
         "id": "root"
        },
        {
         "catalogId": "basic",
         "component": "Text",
         "id": "row",
         "text": {
          "@call": "formatString",
          "args": {
           "value": "Row ${@index()}: ${pluralize(value: count, one: 'drop', other: 'drops')}"
          },
          "catalogId": "basic"
         }
        }
       ],
       "dataModel": {
        "items": [
         {
          "count": 1
         },
         {
          "count": 2
         }
        ]
       },
       "surfaceId": "main"
      },
      "version": "1.0"
     }
    ]
   }
  ]
 }
]
