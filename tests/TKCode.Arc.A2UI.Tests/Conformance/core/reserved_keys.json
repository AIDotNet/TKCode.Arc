   {
    "createSurface": {
     "catalogId": "custom",
     "components": [
      {
       "component": "CustomCard",
       "details": {
        "@if": true,
        "then": "active"
       },
       "id": "root"
      }
     ],
     "surfaceId": "s1"
    },
    "version": "1.0"
   }
  ]
 },
 {
