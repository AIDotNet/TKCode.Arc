     "type": "object"
    }
   },
   "protocolVersion": "1.0"
  },
  "description": "Verifies that component-level @-prefixed envelope names (@metadata, @catalogId, @accessibility, @checks) remain disallowed as unescaped single-@ keys inside nested dynamic objects such as component property maps or action contexts.",
  "expectError": {
   "category": "ValidationError"
  },
  "name": "test_disallowed_nested_at_envelope_keys_in_dynamic_object",
  "payload": [
   {
    "createSurface": {
     "catalogId": "custom",
     "components": [
      {
       "component": "CustomCard",
       "details": {
        "@metadata": {
         "extensions": {
          "com_example_nested": "disallowed"
         }
        }
       },
       "id": "root"
      }
     ],
     "surfaceId": "s1"
    },
    "version": "1.0"
   }
  ]
 },
 {
