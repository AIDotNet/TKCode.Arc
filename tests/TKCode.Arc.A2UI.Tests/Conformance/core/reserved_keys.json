   "F-CORE-34"
  ],
  "name": "test_reserved_at_call_index",
  "payload": [
   {
    "createSurface": {
     "catalogId": "basic",
     "components": [
      {
       "children": {
        "componentId": "itemTemplate",
        "path": "/items"
       },
       "component": "List",
       "id": "root"
      },
      {
       "component": "Text",
       "id": "itemTemplate",
       "text": {
        "@call": "@index",
        "args": {
         "offset": 1
        }
       }
      }
     ],
     "surfaceId": "s1"
    },
    "version": "1.0"
   }
  ]
