<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>$(ArcTestTargetFramework)</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- xUnit1051: the calls under test take a token of their own; these tests have timeouts instead of the test context's token. -->
        <NoWarn>$(NoWarn);CS0436;xUnit1051</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="Shouldly" />
        <!-- PageImage holds a real Bitmap, so the tests need the Skia render interface; Avalonia.Desktop brings it. -->
        <PackageReference Include="Avalonia.Desktop" />
        <PackageReference Include="Avalonia.Headless" />
        <ProjectReference Include="../../src/TKCode.Arc.Pdf.Native/TKCode.Arc.Pdf.Native.csproj" />
    </ItemGroup>
    <ItemGroup>
        <!-- Generated by tools/pdf/make-sample.py and committed. -->
        <None Include="Fixtures/*" CopyToOutputDirectory="PreserveNewest" />
        <None Include="../../gallery/TKCode.Arc.Gallery/Assets/Pdf/*.pdf" Link="Samples/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
