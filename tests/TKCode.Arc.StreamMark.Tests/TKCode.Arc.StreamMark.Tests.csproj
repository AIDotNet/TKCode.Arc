<Project Sdk="Microsoft.NET.Sdk">
    <!-- StreamMark and its plugins (TextMate, RaTeX, Mermaid): Core/ needs no UI, Avalonia/ renders headlessly with Skia.
         The RaTeX tests need libratex_ffi: tools/streammark/build-ratex.sh builds it into artifacts/native/<rid>. -->
    <PropertyGroup>
        <TargetFramework>$(ArcTestTargetFramework)</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);xUnit1051</NoWarn>
        <ArcStreamMarkNative>true</ArcStreamMarkNative>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="Avalonia.Headless" />
        <PackageReference Include="Avalonia.Skia" />
        <PackageReference Include="Avalonia.Themes.Fluent" />
        <ProjectReference Include="../../src/TKCode.Arc.StreamMark/TKCode.Arc.StreamMark.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.StreamMark.TextMate/TKCode.Arc.StreamMark.TextMate.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.StreamMark.RaTeX/TKCode.Arc.StreamMark.RaTeX.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.StreamMark.Mermaid/TKCode.Arc.StreamMark.Mermaid.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Include="Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
