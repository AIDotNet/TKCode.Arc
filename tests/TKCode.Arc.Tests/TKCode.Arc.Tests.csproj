<Project Sdk="Microsoft.NET.Sdk">
    <!-- The controls of TKCode.Arc (with Markdown and Highlighting) in a headless app that enables only those packages. Blocks,
         Special, the extra packages and the cross-package tests have their own projects (#145). -->
    <PropertyGroup>
        <TargetFramework>$(ArcTestTargetFramework)</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);CS0436</NoWarn>
        <!-- The Lucide generator compiles in the icons the tests use (LucideIconTests) plus the declared ones below. -->
        <ArcLucideGenerator>true</ArcLucideGenerator>
    </PropertyGroup>
    <ItemGroup>
        <!-- A declared-only icon (LucideIconTests). -->
        <LucideIcon Include="Sparkles;circle-dashed" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="Avalonia.Headless.XUnit" />
        <PackageReference Include="Avalonia.Markup.Xaml.Loader" />
        <ProjectReference Include="../../src/TKCode.Arc/TKCode.Arc.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.Markdown/TKCode.Arc.Markdown.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.Highlighting/TKCode.Arc.Highlighting.csproj" />
        <!-- LucideIconTests and the XAML loaded at run time need the Lucide assembly. -->
        <ProjectReference Include="../../src/TKCode.Arc.Icons.Lucide/TKCode.Arc.Icons.Lucide.csproj" />
        <!-- PropertyGrid tests use [PropertyGridModel] types: the Foundation generator registers them (no themes or tokens here). -->
        <ProjectReference Include="../../src/TKCode.Arc.Foundation.Generators/TKCode.Arc.Foundation.Generators.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>
    <ItemGroup>
        <!-- The allow-lists of DuplicateHelperTests (#148). -->
        <None Include="Architecture/Allowlists/*.txt" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <ItemGroup>
        <!-- Helpers shared by the headless test projects (source, so each assembly keeps its own InternalsVisibleTo access). -->
        <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
    </ItemGroup>
</Project>
