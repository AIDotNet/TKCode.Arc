<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>$(ArcTestTargetFramework)</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);CS0436</NoWarn>
        <!-- The Lucide generator compiles in the icons the tests use (LucideIconTests) plus the declared ones below. -->
        <ArcLucideGenerator>true</ArcLucideGenerator>
    </PropertyGroup>
    <ItemGroup>
        <!-- A declared-only icon (LucideIconTests). -->
        <LucideIcon Include="Sparkles;circle-dashed" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="Avalonia.Headless.XUnit" />
        <PackageReference Include="Avalonia.Markup.Xaml.Loader" />
        <ProjectReference Include="../../src/TKCode.Arc/TKCode.Arc.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.Blocks/TKCode.Arc.Blocks.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.Mobile/TKCode.Arc.Mobile.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.AdvancedCharts/TKCode.Arc.AdvancedCharts.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.Special/TKCode.Arc.Special.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.Workflow/TKCode.Arc.Workflow.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.Dock/TKCode.Arc.Dock.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.Terminal/TKCode.Arc.Terminal.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.Video/TKCode.Arc.Video.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.Pdf/TKCode.Arc.Pdf.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.Themes.Corners/TKCode.Arc.Themes.Corners.csproj" />
        <ProjectReference Include="../../src/TKCode.Arc.Themes.Pixel/TKCode.Arc.Themes.Pixel.csproj" />
        <!-- LucideIconTests and the XAML loaded at run time need the Lucide assembly. -->
        <ProjectReference Include="../../src/TKCode.Arc.Icons.Lucide/TKCode.Arc.Icons.Lucide.csproj" />
        <!-- PropertyGrid tests use [PropertyGridModel] types: the Foundation generator registers them (no themes or tokens here). -->
        <ProjectReference Include="../../src/TKCode.Arc.Foundation.Generators/TKCode.Arc.Foundation.Generators.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    </ItemGroup>
    <ItemGroup>
        <!-- The browser backend's arithmetic: the package itself is for browsers only, this part runs anywhere. -->
        <Compile Include="../../src/TKCode.Arc.Pdf.Browser/PdfJs/*.cs" Link="Pdf/PdfJs/%(Filename)%(Extension)" />
    </ItemGroup>
</Project>
