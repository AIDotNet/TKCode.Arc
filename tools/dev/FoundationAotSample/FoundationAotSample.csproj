<Project Sdk="Microsoft.NET.Sdk">
    <!-- Not shipped, not in the solution: proves TKCode.Arc.Foundation publishes with Native AOT without trim or AOT
         warnings, and measures the token pipeline and lazy theme loading at Arc's size (Scale/, from
         generate_scale.py; run it first, Scale/ is not checked in).
         Publish: python3 generate_scale.py && dotnet publish -c Release -r osx-arm64 (or the current RID). -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>TKCode.Arc.FoundationAotSample</RootNamespace>
        <PublishAot>true</PublishAot>
        <InvariantGlobalization>true</InvariantGlobalization>
        <TrimmerSingleWarn>false</TrimmerSingleWarn>
        <IsPackable>false</IsPackable>
        <!-- .NET SDK 11's optimized AOT publish (_PublishOptimizedBuildAlternative) runs PrepareResources before
             ResolveReferences; Avalonia 12.1 adds its !AvaloniaResources blob in a BeforeTargets="ResolveReferences"
             target, so the blob is not embedded and no XAML is compiled (any Avalonia app, not only Foundation). -->
        <UseOptimizedPublish>false</UseOptimizedPublish>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Headless" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../../src/TKCode.Arc.Foundation/TKCode.Arc.Foundation.csproj" />
        <ProjectReference Include="../../../src/TKCode.Arc.Foundation.Generators/TKCode.Arc.Foundation.Generators.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>
    <Import Project="../../../src/TKCode.Arc.Foundation/buildTransitive/TKCode.Arc.Foundation.targets" />
</Project>
