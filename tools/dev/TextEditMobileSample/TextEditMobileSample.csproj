<Project Sdk="Microsoft.NET.Sdk">
    <!-- Not shipped, not in the solution: checks the iOS edit actions of TKCode.Arc.Mobile.iOS on a simulator and prints
         "TEXTEDIT-SAMPLE: PASS|FAIL ..." (App.cs), then leaves the system edit menu open for a screenshot (issue #137).
         Needs the .NET ios workload.
         iOS simulator:  dotnet build -t:Run -f net11.0-ios -p:RuntimeIdentifier=iossimulator-arm64
         or build, then  xcrun simctl install booted bin/Debug/net11.0-ios/iossimulator-arm64/TKCode.Arc.TextEditMobileSample.app
                         xcrun simctl launch -console-pty booted dev.tkcode.arc.texteditsample -->
    <PropertyGroup>
        <TargetFramework>net11.0-ios</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>TKCode.Arc.TextEditMobileSample</RootNamespace>
        <AssemblyName>TKCode.Arc.TextEditMobileSample</AssemblyName>
        <ApplicationId>dev.tkcode.arc.texteditsample</ApplicationId>
        <ApplicationTitle>Arc Text Edit Sample</ApplicationTitle>
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
        <AppBundleManifest>iOS/Info.plist</AppBundleManifest>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia.iOS" />
        <ProjectReference Include="../../../src/TKCode.Arc.Mobile/TKCode.Arc.Mobile.csproj" />
        <ProjectReference Include="../../../src/TKCode.Arc.Mobile.iOS/TKCode.Arc.Mobile.iOS.csproj" />
    </ItemGroup>
</Project>
