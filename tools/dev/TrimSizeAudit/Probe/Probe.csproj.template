<Project Sdk="Microsoft.NET.Sdk">
    <!-- Materialized outside the checkout; each variant has an independent source snapshot. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>full</TrimMode>
        <SelfContained>true</SelfContained>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <RuntimeFrameworkVersion>10.0.15</RuntimeFrameworkVersion>
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="$(ArcSourceRoot)/src/TKCode.Arc/TKCode.Arc.csproj" />
    </ItemGroup>
</Project>
